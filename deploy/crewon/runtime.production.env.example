# Runtime Release and Worker share database/route authority, not BFF credentials.
CREWON_CONTROL_SECURITY_MODE=production
CREWON_CONTROL_DATABASE_URL=postgresql://crewon:<password>@127.0.0.1:5432/crewon
CREWON_CONTROL_DATABASE_SCHEMA=crewon
CREWON_ARTIFACT_ROOT=/var/lib/crewon/artifacts/files
CREWON_ARTIFACT_DB_PATH=/var/lib/crewon/artifacts/metadata.sqlite3
CREWON_ARTIFACT_ENCRYPTION_KEY_PATH=/run/secrets/crewon-artifact-key
CREWON_ARTIFACT_ENCRYPTION_KEY_ID=production-artifact-key-v1
CREWON_AGENT_VERSION_RUNTIME_BINDINGS_PATH=/run/config/agent-version-runtime-bindings.json
CREWON_RUNTIME_READINESS_FILE=/tmp/crewon-runtime-worker.ready

CREWON_RUNTIME_PROVIDER_PROBE_CONFIG_JSON={"schemaVersion":"crewon.runtime-provider-probe.v1","port":3221,"tokenEnvironment":"CREWON_PROVIDER_ROUTE_TOKEN","tenantId":"tenant-1","expectedCatalogRevision":0,"providerId":"openai","runtimeBindingId":"runtime-1","endpoint":"https://api.openai.com/v1","credentialEnvironment":"OPENAI_API_KEY"}
CREWON_PROVIDER_ROUTE_TOKEN=<at-least-32-random-bytes>
OPENAI_API_KEY=<provider-secret>

CREWON_RUNTIME_WORKSPACE_CONFIG_JSON={"schemaVersion":"crewon.runtime-workspace.v0","trustedLocalPath":"/workspace","deadlineMs":30000,"privateServer":{"port":3222,"tokenEnvironment":"CREWON_WORKSPACE_ROUTE_TOKEN"},"authority":{"tenantId":"tenant-1","spaceId":"space-1","workspaceBindingId":"workspace-1","workspaceIncarnationId":"workspace-incarnation-1","runtimeBindingId":"runtime-1","policySnapshotId":"policy-1"}}
CREWON_WORKSPACE_ROUTE_TOKEN=<different-at-least-32-random-bytes>

CREWON_TENANT_ID=tenant-1
CREWON_RELEASE_PRINCIPAL_ID=production-release-principal
CREWON_RELEASE_ACTOR_ID=production-release-actor
CREWON_AUTHORITY_ID=production-authority-1
CREWON_RUNTIME_GENERATION=runtime-1
CREWON_AGENT_VERSION_ID=default-agent-v1
CREWON_POLICY_SNAPSHOT_ID=policy-1
CREWON_WORKSPACE_BINDING_ID=workspace-1
CREWON_RESPONSES_ENDPOINT=https://api.openai.com/v1/responses
CREWON_MODEL_ID=gpt-5.6
CREWON_MODEL_API_KEY=<provider-secret>
CREWON_WORKER_OWNER_ID=production-worker-1
