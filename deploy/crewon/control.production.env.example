# Control receives only Control/route credentials. Copy outside source control.
CREWON_CONTROL_SECURITY_MODE=production
CREWON_CONTROL_DATABASE_URL=postgresql://crewon:<password>@127.0.0.1:5432/crewon
CREWON_CONTROL_DATABASE_SCHEMA=crewon
CREWON_CONTROL_PORT=3210
CREWON_ARTIFACT_ROOT=/var/lib/crewon/artifacts/files
CREWON_ARTIFACT_DB_PATH=/var/lib/crewon/artifacts/metadata.sqlite3
CREWON_ARTIFACT_ENCRYPTION_KEY_PATH=/run/secrets/crewon-artifact-key
CREWON_ARTIFACT_ENCRYPTION_KEY_ID=production-artifact-key-v1

CREWON_CONTROL_BFF_TOKEN=<at-least-32-random-bytes>
CREWON_BFF_ALLOWED_ORIGINS=https://crewon.example.com
CREWON_BFF_ALLOWED_REMOTE_ADDRESSES=127.0.0.1,::1
CREWON_IDENTITY_VERIFY_URL=https://identity.internal.example/v1/control-token:verify
CREWON_IDENTITY_SERVICE_TOKEN=<control-to-identity-secret-at-least-32-bytes>
CREWON_IDENTITY_EXPECTED_ISSUER=https://identity.example.com
CREWON_IDENTITY_EXPECTED_AUDIENCE=crewon-control
CREWON_POLICY_DECISION_URL=https://policy.internal.example/v1/authorize
CREWON_POLICY_SERVICE_TOKEN=<different-at-least-32-random-bytes>

# Ports 3221/3222 are distinct from Control 3210 and Web BFF 3211.
CREWON_PROVIDER_PROBE_TENANT_ROUTES_JSON=[{"tenantId":"tenant-1","runtimeBindingId":"runtime-1","origin":"http://127.0.0.1:3221","tokenEnvironment":"CREWON_PROVIDER_ROUTE_TOKEN"}]
CREWON_PROVIDER_ROUTE_TOKEN=<different-at-least-32-random-bytes>
CREWON_WORKSPACE_TENANT_ROUTES_JSON=[{"tenantId":"tenant-1","runtimeBindingId":"runtime-1","workspaceBindingId":"workspace-1","origin":"http://127.0.0.1:3222","tokenEnvironment":"CREWON_WORKSPACE_ROUTE_TOKEN"}]
CREWON_WORKSPACE_ROUTE_TOKEN=<different-at-least-32-random-bytes>
