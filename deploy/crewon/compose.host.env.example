# Used only by Docker Compose for host paths and image identities.
CREWON_CONTROL_ENV_FILE=./control.production.env
CREWON_RUNTIME_ENV_FILE=./runtime.production.env
CREWON_WEB_BFF_ENV_FILE=./web-bff.production.env

CREWON_ARTIFACT_KEY_FILE=/run/crewon-secrets/artifact-encryption.key
CREWON_AGENT_BINDINGS_FILE=/etc/crewon/agent-version-runtime-bindings.json
CREWON_WORKSPACE_ROOT=/srv/crewon/workspace
CREWON_TLS_CERT_FILE=/etc/crewon/tls/fullchain.pem
CREWON_TLS_KEY_FILE=/etc/crewon/tls/privkey.pem

CREWON_CONTROL_API_IMAGE=registry.example.com/crewon/control-api:<immutable-digest>
CREWON_RUNTIME_WORKER_IMAGE=registry.example.com/crewon/runtime-worker:<immutable-digest>
CREWON_WEB_BFF_IMAGE=registry.example.com/crewon/web-bff:<immutable-digest>
CREWON_WEB_IMAGE=registry.example.com/crewon/web:<immutable-digest>
