# Used only by Docker Compose for host paths and image identities.
CREWON_CONTROL_ENV_FILE=./control.production.env
CREWON_RUNTIME_ENV_FILE=./runtime.production.env
CREWON_WEB_BFF_ENV_FILE=./web-bff.production.env
CREWON_BACKUP_ENV_FILE=./backup.production.env

CREWON_ARTIFACT_KEY_FILE=/run/crewon-secrets/artifact-encryption.key
CREWON_AGENT_BINDINGS_FILE=/etc/crewon/agent-version-runtime-bindings.json
CREWON_WORKSPACE_ROOT=/srv/crewon/workspace
CREWON_BACKUP_ROOT=/srv/crewon/backups
CREWON_SERVER_RELEASE_MANIFEST_FILE=/etc/crewon/server-release-manifest.json
CREWON_SERVER_RELEASE_SIGNATURE_FILE=/etc/crewon/server-release-manifest.sigstore.json
CREWON_TLS_CERT_FILE=/etc/crewon/tls/fullchain.pem
CREWON_TLS_KEY_FILE=/etc/crewon/tls/privkey.pem

CREWON_CONTROL_API_IMAGE=ghcr.io/example/crewon-control-api@sha256:1111111111111111111111111111111111111111111111111111111111111111
CREWON_RUNTIME_WORKER_IMAGE=ghcr.io/example/crewon-runtime-worker@sha256:2222222222222222222222222222222222222222222222222222222222222222
CREWON_WEB_BFF_IMAGE=ghcr.io/example/crewon-web-bff@sha256:3333333333333333333333333333333333333333333333333333333333333333
CREWON_WEB_IMAGE=ghcr.io/example/crewon-web@sha256:4444444444444444444444444444444444444444444444444444444444444444
