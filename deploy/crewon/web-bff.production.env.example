# BFF receives browser-session credentials, never PostgreSQL or Provider secrets.
CREWON_WEB_PUBLIC_ORIGIN=https://crewon.example.com
CREWON_WEB_BFF_PORT=3211
CREWON_CONTROL_TARGET=http://127.0.0.1:3210
CREWON_CONTROL_BFF_TOKEN=<same-value-as-control-at-least-32-random-bytes>
CREWON_CONTROL_CSRF_TOKEN=<different-at-least-32-random-bytes>
CREWON_WEB_CSRF_SECRET=<different-at-least-32-random-bytes>
CREWON_IDENTITY_SESSION_URL=https://identity.internal.example/v1/crewon/session
CREWON_IDENTITY_SERVICE_TOKEN=<bff-to-identity-secret-at-least-32-bytes>
