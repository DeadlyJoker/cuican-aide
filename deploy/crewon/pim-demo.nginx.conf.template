map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 6175 ssl;
    server_name _;

    ssl_certificate /etc/crewon/tls/crewon-ip.pem;
    ssl_certificate_key /etc/crewon/tls/crewon-ip.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /usr/share/nginx/html;
    index index.html;
    include /etc/nginx/mime.types;
    client_max_body_size 100m;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types application/javascript application/json image/svg+xml text/css;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    location = /healthz {
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    location = /_crewon_pim_auth {
        internal;
        proxy_pass http://127.0.0.1:8000/api/v1/auth/me;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-PIM-Launch-Token $http_x_pim_launch_token;
        proxy_set_header X-Original-URI $request_uri;
    }

    location = /control-api/session {
        auth_request /_crewon_pim_auth;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        limit_except GET { deny all; }
        alias /etc/crewon/control-session.json;
    }

    location /api/v1/ {
        auth_request /_crewon_pim_auth;
        proxy_pass http://127.0.0.1:3210;
        proxy_http_version 1.1;
        proxy_set_header Authorization "Bearer ${CREWON_CONTROL_SESSION_TOKEN}";
        proxy_set_header Origin "${CREWON_CONTROL_ORIGIN}";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /agent-platform-api/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location = /app-server/principal-session {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 410 '{"error":"legacy_app_server_disabled","runtime":"typescript_control"}';
    }

    location /app-server {
        return 410;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store";
    }
}
