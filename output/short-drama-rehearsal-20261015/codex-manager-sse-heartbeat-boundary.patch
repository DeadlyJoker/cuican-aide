+++ b/crates/service/src/gateway/observability/http_bridge/stream_readers/sse_boundary.rs
@@ -0,0 +1,86 @@
+/// Constant-space framing state for raw passthrough bytes. A keepalive is a
+/// complete SSE comment event and may be inserted only between events.
+pub(super) struct SseEventBoundary {
+    line_has_content: bool,
+    previous_cr: bool,
+    between_events: bool,
+}
+
+impl Default for SseEventBoundary {
+    fn default() -> Self {
+        Self {
+            line_has_content: false,
+            previous_cr: false,
+            between_events: true,
+        }
+    }
+}
+
+impl SseEventBoundary {
+    pub(super) fn observe(&mut self, bytes: &[u8]) {
+        for &byte in bytes {
+            if self.previous_cr {
+                self.previous_cr = false;
+                if byte == b'\n' {
+                    continue;
+                }
+            }
+            match byte {
+                b'\r' | b'\n' => {
+                    self.between_events = !self.line_has_content;
+                    self.line_has_content = false;
+                    self.previous_cr = byte == b'\r';
+                }
+                _ => {
+                    self.line_has_content = true;
+                    self.between_events = false;
+                }
+            }
+        }
+    }
+    pub(super) fn can_emit_keepalive(&self) -> bool {
+        self.between_events
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn all_legal_line_endings_survive_every_byte_split() {
+        for ending in [
+            "\n\n", "\r\r", "\r\n\r\n", "\n\r", "\n\r\n", "\r\n\n", "\r\r\n", "\r\n\r",
+        ] {
+            let bytes = format!("data: {{\"named\":true}}{ending}").into_bytes();
+            for split in 0..=bytes.len() {
+                let mut boundary = SseEventBoundary::default();
+                boundary.observe(&bytes[..split]);
+                boundary.observe(&bytes[split..]);
+                assert!(boundary.can_emit_keepalive(), "{ending:?} split {split}");
+            }
+        }
+    }
+    #[test]
+    fn one_line_ending_and_partial_data_never_open_an_event_boundary() {
+        for ending in ["\n", "\r", "\r\n"] {
+            let mut boundary = SseEventBoundary::default();
+            for byte in format!("data: {{\"named\":true}}{ending}").bytes() {
+                boundary.observe(&[byte]);
+                assert!(!boundary.can_emit_keepalive());
+            }
+            boundary.observe(b"data: remaining");
+            assert!(!boundary.can_emit_keepalive());
+        }
+    }
+    #[test]
+    fn a_new_fragment_closes_the_previous_boundary_without_buffering_payload() {
+        let mut boundary = SseEventBoundary::default();
+        assert!(boundary.can_emit_keepalive());
+        boundary.observe(b"data: {}\n\n");
+        assert!(boundary.can_emit_keepalive());
+        boundary.observe(b"data: {\"unfinished\":");
+        assert!(!boundary.can_emit_keepalive());
+        boundary.observe(b"true}\r\n\r\n");
+        assert!(boundary.can_emit_keepalive());
+    }
+}
