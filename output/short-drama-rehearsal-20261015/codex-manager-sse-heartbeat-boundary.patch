+#[cfg(test)]
+mod heartbeat_boundary_regression_tests {
+    use super::super::SseKeepaliveRuntimeGuard;
+    use super::*;
+    use crate::http::gateway_response_body::GatewayResponseBody;
+    use bytes::Bytes;
+    use std::time::Duration;
+
+    #[test]
+    fn heartbeat_cannot_split_a_responses_json_event() {
+        let _env = crate::test_env_guard();
+        let _keepalive = SseKeepaliveRuntimeGuard::enabled_with_interval(10);
+        crate::gateway::response_test_runtime().unwrap().block_on(async {
+            let (sender, receiver) = tokio::sync::mpsc::channel(4);
+            let prefix = b"data: {\"type\":\"response.completed\",\"sequence_number\":1,\"response\":{\"id\":\"named_response\",";
+            let suffix = b"\"status\":\"completed\",\"output\":[]}}\n\n";
+            sender.send(GatewayByteStreamItem::Chunk(Bytes::from_static(prefix))).await.unwrap();
+            let producer = tokio::spawn(async move {
+                tokio::time::sleep(Duration::from_millis(55)).await;
+                sender.send(GatewayByteStreamItem::Chunk(Bytes::from_static(suffix))).await.unwrap();
+                sender.send(GatewayByteStreamItem::Eof).await.unwrap();
+            });
+            let usage = Arc::new(Mutex::new(PassthroughSseCollector::default()));
+            let mut reader = OpenAIResponsesPassthroughSseReader::from_stream_response(
+                GatewayStreamResponse::new(reqwest::StatusCode::OK, reqwest::header::HeaderMap::new(),
+                    GatewayByteStream::from_receiver(receiver)), usage.clone(), SseKeepAliveFrame::Comment, Instant::now());
+            let mut all = Vec::new();
+            let mut buffer = [0_u8; 7];
+            tokio::time::timeout(Duration::from_secs(2), async {
+                loop { let n = reader.read_async(&mut buffer).await.unwrap(); if n == 0 { break; } all.extend_from_slice(&buffer[..n]); }
+            }).await.unwrap();
+            producer.await.unwrap();
+            assert!(usage.lock().unwrap().saw_terminal, "sidecar saw a complete upstream terminal");
+            let mut expected = prefix.to_vec(); expected.extend_from_slice(suffix);
+            assert_eq!(all, expected, "heartbeat must not enter an unfinished SSE event");
+            // Named synthetic bytes for the downstream client protocol check.
+            std::fs::write("named-forwarded-sse.bin", &all).unwrap();
+        });
+    }
+}
diff --git a/crates/service/src/gateway/observability/http_bridge/stream_readers/sse_boundary.rs b/crates/service/src/gateway/observability/http_bridge/stream_readers/sse_boundary.rs
