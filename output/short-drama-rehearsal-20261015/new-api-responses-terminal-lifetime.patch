+// Actual upstream HTTP and gateway adapter, with a terminal but neither EOF nor [DONE].
+// These named response fixtures have no credentials, model calls or database writes.
+func TestResponsesTerminalClosesHeldOpenUpstream(t *testing.T) {
+	oldTimeout := constant.StreamingTimeout
+	constant.StreamingTimeout = 30
+	t.Cleanup(func() { constant.StreamingTimeout = oldTimeout })
+
+	for _, fixture := range []struct {
+		name   string
+		handle func(*gin.Context, *relaycommon.RelayInfo, *http.Response) (*dto.Usage, *types.NewAPIError)
+	}{
+		{"responses", OaiResponsesStreamHandler},
+		{"responses-to-chat", OaiResponsesToChatStreamHandler},
+	} {
+		t.Run(fixture.name, func(t *testing.T) {
+			upstreamClosed := make(chan struct{})
+			upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Content-Type", "text/event-stream")
+				fmt.Fprint(w, "data: {\"type\":\"response.created\",\"sequence_number\":0,\"response\":{\"id\":\"named-terminal\"}}\n\n")
+				fmt.Fprint(w, "data: {\"type\":\"response.completed\",\"sequence_number\":1,\"response\":{\"id\":\"named-terminal\",\"status\":\"completed\",\"output\":[],\"usage\":{\"input_tokens\":1,\"output_tokens\":2,\"total_tokens\":3}}}\n\n")
+				w.(http.Flusher).Flush()
+				<-r.Context().Done()
+				close(upstreamClosed)
+			}))
+			defer upstream.Close()
+			resp, err := upstream.Client().Get(upstream.URL)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer resp.Body.Close()
+			recorder := httptest.NewRecorder()
+			c, _ := gin.CreateTestContext(recorder)
+			c.Request = httptest.NewRequest(http.MethodPost, "/v1/responses", nil)
+			info := &relaycommon.RelayInfo{ChannelMeta: &relaycommon.ChannelMeta{}, DisablePing: true, RelayFormat: types.RelayFormatOpenAI}
+			var usage *dto.Usage
+			var apiErr *types.NewAPIError
+			done := make(chan struct{})
+			started := time.Now()
+			go func() { usage, apiErr = fixture.handle(c, info, resp); close(done) }()
+			select {
+			case <-done:
+			case <-time.After(time.Second):
+				t.Error("gateway waited for EOF after an already-forwarded response.completed")
+				// Release the fixture on red runs; never leave a goroutine/upstream live.
+				resp.Body.Close()
+				select {
+				case <-done:
+				case <-time.After(7 * time.Second):
+					t.Fatal("gateway did not join fixture")
+				}
+			}
+			t.Logf("gateway returned after %s, reason=%s", time.Since(started), info.StreamStatus.EndReason)
+			if apiErr != nil {
+				t.Fatalf("unexpected API error: %v", apiErr)
+			}
+			if usage == nil || usage.PromptTokens != 1 || usage.CompletionTokens != 2 || usage.TotalTokens != 3 {
+				t.Fatalf("terminal usage changed: %+v", usage)
+			}
+			if info.StreamStatus.EndReason != relaycommon.StreamEndReasonDone {
+				t.Errorf("terminal end reason: %s", info.StreamStatus.EndReason)
+			}
+			if fixture.name == "responses" && strings.Count(recorder.Body.String(), "\"type\":\"response.completed\"") != 1 {
+				t.Fatalf("completed event was lost/duplicated: %s", recorder.Body.String())
+			}
+			if dir := os.Getenv("CREWON_TEST_GATEWAY_FIXTURE_DIR"); dir != "" && !t.Failed() {
+				if err := os.WriteFile(filepath.Join(dir, fixture.name+"-terminal.sse"), recorder.Body.Bytes(), 0600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			select {
+			case <-upstreamClosed:
+			case <-time.After(time.Second):
+				t.Fatal("upstream was not physically closed")
+			}
+		})
+	}
+}
+
+// A complete output item does not complete the provider response.
+func TestResponsesItemDoneDoesNotCompleteResponse(t *testing.T) {
+	oldTimeout := constant.StreamingTimeout
+	constant.StreamingTimeout = 30
+	defer func() { constant.StreamingTimeout = oldTimeout }()
+	reader, writer := io.Pipe()
+	defer reader.Close()
+	defer writer.Close()
+	recorder := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(recorder)
+	c.Request = httptest.NewRequest(http.MethodPost, "/v1/responses", nil)
+	info := &relaycommon.RelayInfo{ChannelMeta: &relaycommon.ChannelMeta{}, DisablePing: true}
+	done := make(chan struct{})
+	go func() { OaiResponsesStreamHandler(c, info, &http.Response{Body: reader}); close(done) }()
+	fmt.Fprint(writer, "data: {\"type\":\"response.output_item.done\",\"sequence_number\":0,\"item\":{\"id\":\"named-item\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[]}}\n\n")
+	select {
+	case <-done:
+		t.Fatal("output_item.done completed a response without terminal")
+	case <-time.After(50 * time.Millisecond):
+	}
+	writer.Close()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("fixture EOF did not finish")
+	}
+}
+
+func TestResponsesCancellationClosesHeldOpenUpstream(t *testing.T) {
+	oldTimeout := constant.StreamingTimeout
+	constant.StreamingTimeout = 30
+	defer func() { constant.StreamingTimeout = oldTimeout }()
+	closed := make(chan struct{})
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "text/event-stream")
+		w.(http.Flusher).Flush()
+		<-r.Context().Done()
+		close(closed)
+	}))
+	defer upstream.Close()
+	resp, err := upstream.Client().Get(upstream.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	c, _ := gin.CreateTestContext(httptest.NewRecorder())
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	c.Request = httptest.NewRequest(http.MethodPost, "/v1/responses", nil).WithContext(ctx)
+	info := &relaycommon.RelayInfo{ChannelMeta: &relaycommon.ChannelMeta{}, DisablePing: true}
+	done := make(chan struct{})
+	go func() { OaiResponsesStreamHandler(c, info, resp); close(done) }()
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		resp.Body.Close()
+		<-done
+		t.Fatal("client cancellation did not join upstream scanner")
+	}
+	if info.StreamStatus.EndReason != relaycommon.StreamEndReasonClientGone {
+		t.Fatalf("cancellation became %s", info.StreamStatus.EndReason)
+	}
+	select {
+	case <-closed:
+	case <-time.After(time.Second):
+		t.Fatal("canceled upstream remained open")
+	}
+}
