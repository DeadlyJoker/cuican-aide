{
  "schemaVersion": "crewon.provider-usage-validation.v0",
  "cases": [
    {
      "caseId": "negative-input",
      "usage": {
        "input_tokens": -1,
        "input_tokens_details": { "cached_tokens": 0 },
        "output_tokens": 1,
        "total_tokens": 0
      },
      "expected": "rejected"
    },
    {
      "caseId": "negative-cached-input",
      "usage": {
        "input_tokens": 1,
        "input_tokens_details": { "cached_tokens": -1 },
        "output_tokens": 1,
        "total_tokens": 2
      },
      "expected": "rejected"
    },
    {
