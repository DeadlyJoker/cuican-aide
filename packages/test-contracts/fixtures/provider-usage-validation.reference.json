      "usage": {
        "input_tokens": 1,
        "input_tokens_details": { "cached_tokens": 2 },
        "output_tokens": 1,
        "total_tokens": 2
      },
      "expected": "rejected"
    },
    {
      "caseId": "negative-output",
      "usage": {
        "input_tokens": 1,
        "output_tokens": -1,
        "total_tokens": 0
      },
      "expected": "rejected"
    },
    {
      "caseId": "negative-total",
      "usage": {
        "input_tokens": 0,
        "output_tokens": 0,
        "total_tokens": -1
      },
      "expected": "rejected"
    },
    {
      "caseId": "total-mismatch",
