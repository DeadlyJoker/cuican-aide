        "responseId": null
      }
    },
    {
      "name": "incomplete",
      "terminal": {
        "type": "response.incomplete",
        "sequence_number": 0,
        "response": {
          "incomplete_details": { "reason": "content_filter" }
        }
      },
      "expected": {
        "stableEvents": ["failed"],
        "partialOutput": "",
        "completedHistory": [],
        "terminal": "failed",
        "usage": null,
        "errorCategory": "incomplete",
        "retryable": false,
        "responseId": null
