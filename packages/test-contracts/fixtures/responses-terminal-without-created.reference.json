        "sequence_number": 0,
        "response": {
          "error": { "code": "server_error", "message": "provider busy" }
        }
      },
      "expected": {
        "stableEvents": ["failed"],
        "partialOutput": "",
        "completedHistory": [],
        "terminal": "failed",
        "usage": null,
        "errorCategory": "provider",
