{
  "name": "@crewon/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.ts",
    "./plugins": "./src/plugins.ts",
    "./project-tools": "./src/plugin-project-tools-service.ts",
    "./project-texts-ui": "./src/project-texts-ui.ts",
    "./project-text-recovery": "./src/project-text-recovery.ts",
    "./project-conversations": "./src/project-conversations.ts",
    "./project-context": "./src/project-context.ts",
    "./project-text-plans": "./src/project-text-plans.ts",
    "./project-planning": "./src/project-planning.ts",
    "./project-historical-queries": "./src/project-historical-queries.ts"
  },
  "scripts": {
    "generate": "node scripts/generate-control-api-types.mjs",
    "generate:check": "node scripts/generate-control-api-types.mjs --check",
    "license:check": "node scripts/check-development-licenses.mjs",
    "test": "pnpm license:check && pnpm generate:check && node --experimental-strip-types --test src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.5.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
