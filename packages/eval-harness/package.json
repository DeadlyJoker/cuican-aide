{
  "name": "@crewon/eval-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts",
    "./fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "compare": "node --experimental-strip-types src/cli.ts compare",
    "evaluate": "node --experimental-strip-types src/cli.ts evaluate",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
