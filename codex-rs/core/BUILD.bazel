load("//:defs.bzl", "crewon_rust_crate")

crewon_rust_crate(
    name = "core",
    crate_name = "crewon_core",
    compile_data = glob(
        include = ["**"],
        exclude = [
            "**/* *",
            "BUILD.bazel",
            "Cargo.toml",
        ],
        allow_empty = True,
    ) + [
        "//:packages/test-contracts/fixtures/context-normalization.reference.json",
        "//:packages/test-contracts/fixtures/thread-rollback-parity.reference.json",
    ],
    rustc_env = {
        # Keep manifest-root path lookups inside the Bazel execroot for code
        # that relies on env!("CARGO_MANIFEST_DIR").
        "CARGO_MANIFEST_DIR": "codex-rs/core",
    },
    integration_test_timeout = "long",
    test_data_extra = [
        "config.schema.json",
        "//:packages/test-contracts/fixtures/agent-text-turn.reference.json",
        "//:packages/test-contracts/fixtures/aborted-tool-history.reference.json",
        "//:packages/test-contracts/fixtures/canonical-history-dedupe.reference.json",
        "//:packages/test-contracts/fixtures/content-filter-incomplete.reference.json",
        "//:packages/test-contracts/fixtures/context-normalization.reference.json",
        "//:packages/test-contracts/fixtures/context-window-compaction.reference.json",
        "//:packages/test-contracts/fixtures/governed-context.reference.json",
        "//:packages/test-contracts/fixtures/legacy-rollout-resume-fork.reference.json",
        "//:packages/test-contracts/fixtures/mcp-tool-scheduling.reference.json",
        "//:packages/test-contracts/fixtures/model-switch-compaction.reference.json",
        "//:packages/test-contracts/fixtures/prompt-tool-stability.reference.json",
        "//:packages/test-contracts/fixtures/responses-lite-request.reference.json",
        "//:packages/test-contracts/fixtures/shell-tool-output.reference.json",
        "//:packages/test-contracts/fixtures/stream-early-close-retry.reference.json",
        "//:packages/test-contracts/fixtures/stream-partial-close-retry.reference.json",
        "//:packages/test-contracts/fixtures/tool-cancel.reference.json",
        "//:packages/test-contracts/fixtures/tool-output-truncation.reference.json",
        "//:packages/test-contracts/fixtures/token-limit-compaction.reference.json",
        "//:packages/test-contracts/fixtures/thread-rollback-parity.reference.json",
        "//:packages/test-contracts/fixtures/typed-policy-failure.reference.json",
        "//:packages/test-contracts/fixtures/turn-error-release.reference.json",
        "//:packages/test-contracts/fixtures/unknown-custom-tool.reference.json",
        "//:packages/test-contracts/fixtures/usage-limit-reached.reference.json",
        "//:packages/test-contracts/fixtures/websocket-transport.reference.json",
    ] + glob([
        "src/**/snapshots/**",
    ]) + [
        # This is a bit of a hack, but empirically, some of our integration tests
        # are relying on the presence of this file as a repo root marker. When
        # running tests locally, this "just works," but in remote execution,
        # the working directory is different and so the file is not found unless it
        # is explicitly added as test data.
        #
        # TODO(aibrahim): Update the tests so that `just bazel-remote-test`
        # succeeds without this workaround.
        "//:AGENTS.md",
    ],
    test_shard_counts = {
        "core-all-test": 16,
        "core-unit-tests": 8,
    },
    test_tags = ["no-sandbox"],
    unit_test_timeout = "long",
    extra_binaries = [
        "//codex-rs/bwrap:bwrap",
        "//codex-rs/linux-sandbox:crewon-linux-sandbox",
        "//codex-rs/rmcp-client:test_stdio_server",
        "//codex-rs/rmcp-client:test_streamable_http_server",
        "//codex-rs/windows-sandbox-rs:crewon-command-runner",
        "//codex-rs/windows-sandbox-rs:crewon-windows-sandbox-setup",
    ],
)
