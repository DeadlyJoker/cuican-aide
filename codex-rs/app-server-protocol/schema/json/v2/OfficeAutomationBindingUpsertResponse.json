{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "OfficeAutomationBinding": {
      "additionalProperties": false,
      "properties": {
        "automationFilePath": {
          "type": "string"
        },
        "automationIdentity": {
          "type": "string"
        },
        "automationTitle": {
          "type": "string"
        },
        "bindingId": {
          "type": "string"
        },
        "bindingVersion": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "createdAt": {
          "format": "int64",
          "type": "integer"
        },
        "policy": {
          "$ref": "#/definitions/OfficeAutomationBindingPolicy"
        },
        "updatedAt": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "automationFilePath",
        "automationIdentity",
        "automationTitle",
        "bindingId",
        "bindingVersion",
        "createdAt",
        "policy",
        "updatedAt"
      ],
      "type": "object"
    },
    "OfficeAutomationBindingApprovalMode": {
      "enum": [
        "notRequired",
        "required"
      ],
      "type": "string"
    },
    "OfficeAutomationBindingDispatchMode": {
      "enum": [
        "auto",
        "manual"
      ],
      "type": "string"
    },
    "OfficeAutomationBindingPolicy": {
      "additionalProperties": false,
      "properties": {
        "approvalMode": {
          "$ref": "#/definitions/OfficeAutomationBindingApprovalMode"
        },
        "dispatchMode": {
          "$ref": "#/definitions/OfficeAutomationBindingDispatchMode"
        },
        "riskLevel": {
          "$ref": "#/definitions/OfficeAutomationBindingRiskLevel"
        },
        "status": {
          "$ref": "#/definitions/OfficeAutomationBindingStatus"
        }
      },
      "required": [
        "approvalMode",
        "dispatchMode",
        "riskLevel",
        "status"
      ],
      "type": "object"
    },
    "OfficeAutomationBindingRiskLevel": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "type": "string"
    },
    "OfficeAutomationBindingStatus": {
      "enum": [
        "enabled",
        "disabled"
      ],
      "type": "string"
    }
  },
  "properties": {
    "binding": {
      "$ref": "#/definitions/OfficeAutomationBinding"
    },
    "config": true,
    "filePath": {
      "type": "string"
    }
  },
  "required": [
    "binding",
    "config",
    "filePath"
  ],
  "title": "OfficeAutomationBindingUpsertResponse",
  "type": "object"
}