{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AgentPlatformResourceEvent": {
      "properties": {
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "inputSummary": true,
        "name": {
          "type": "string"
        },
        "outputSummary": true,
        "status": {
          "$ref": "#/definitions/AgentPlatformResourceStatus"
        },
        "type": {
          "$ref": "#/definitions/AgentPlatformResourceType"
        }
      },
      "required": [
        "inputSummary",
        "name",
        "outputSummary",
        "status",
        "type"
      ],
      "type": "object"
    },
    "AgentPlatformResourceStatus": {
      "enum": [
        "started",
        "succeeded",
        "failed"
      ],
      "type": "string"
    },
    "AgentPlatformResourceType": {
      "enum": [
        "skill",
        "mcp",
        "knowledge"
      ],
      "type": "string"
    },
    "AgentPlatformTokenUsage": {
      "properties": {
        "completionTokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "promptTokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "totalTokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "completionTokens",
        "promptTokens",
        "totalTokens"
      ],
      "type": "object"
    }
  },
  "properties": {
    "agentId": {
      "type": "string"
    },
    "durationMs": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "message": {
      "type": "string"
    },
    "resourceEvents": {
      "items": {
        "$ref": "#/definitions/AgentPlatformResourceEvent"
      },
      "type": "array"
    },
    "runId": {
      "type": "string"
    },
    "skillsUsed": {
      "items": true,
      "type": "array"
    },
    "thoughts": {
      "items": true,
      "type": "array"
    },
    "threadId": {
      "type": "string"
    },
    "tokens": {
      "$ref": "#/definitions/AgentPlatformTokenUsage"
    }
  },
  "required": [
    "agentId",
    "durationMs",
    "message",
    "resourceEvents",
    "runId",
    "skillsUsed",
    "thoughts",
    "threadId",
    "tokens"
  ],
  "title": "AgentPlatformChatCompletedNotification",
  "type": "object"
}