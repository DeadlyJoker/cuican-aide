CREWON_CONTROL_DB_PATH=/absolute/path/to/crewon-control.sqlite3
CREWON_ARTIFACT_ROOT=/absolute/path/to/crewon-artifacts
CREWON_ARTIFACT_DB_PATH=/absolute/path/to/crewon-artifacts/metadata.sqlite3
# Raw 32-byte or canonical base64 key file; chmod 600 and keep it outside the repository.
CREWON_ARTIFACT_ENCRYPTION_KEY_PATH=/absolute/path/to/crewon-artifact.key
CREWON_ARTIFACT_ENCRYPTION_KEY_ID=standalone-artifact-key-v1
CREWON_CONTROL_SECURITY_MODE=standalone
CREWON_CONTROL_SESSION_TOKEN=<generate-at-least-32-random-bytes>
CREWON_CONTROL_CSRF_TOKEN=<generate-a-different-32-byte-random-value>
CREWON_CONTROL_ALLOWED_ORIGINS=http://127.0.0.1:5175
CREWON_CONTROL_PORT=3210
CREWON_OUTBOX_SCAN_INTERVAL_MS=1000
CREWON_PRINCIPAL_ID=standalone-principal
CREWON_ACTOR_ID=standalone-actor
CREWON_TENANT_ID=standalone-tenant
CREWON_SPACE_ID=standalone-space
# The default ID must already be activated by the separate release process.
CREWON_AGENT_VERSION_ID=default-agent-v1

# Team/Cloud production mode requires PostgreSQL and replaces every standalone identity variable above.
# CREWON_CONTROL_SECURITY_MODE=production
# CREWON_CONTROL_DATABASE_URL=postgresql://user:password@host/database
# CREWON_CONTROL_DATABASE_SCHEMA=crewon
# CREWON_CONTROL_BFF_TOKEN=<server-only-secret-at-least-32-random-bytes>
# Must equal the BFF's canonical CREWON_WEB_PUBLIC_ORIGIN.
# CREWON_BFF_ALLOWED_ORIGINS=https://crewon.example
# Exact direct socket peers; Control does not trust X-Forwarded-For.
# CREWON_BFF_ALLOWED_REMOTE_ADDRESSES=127.0.0.1,::1
# HTTPS authorities and distinct outbound service credentials.
# CREWON_IDENTITY_VERIFY_URL=https://identity.internal.example/v1/control-token:verify
# CREWON_IDENTITY_SERVICE_TOKEN=<identity-service-secret-at-least-32-random-bytes>
# CREWON_IDENTITY_EXPECTED_ISSUER=https://identity.example
# CREWON_IDENTITY_EXPECTED_AUDIENCE=crewon-control
# CREWON_POLICY_DECISION_URL=https://policy.internal.example/v1/authorize
# CREWON_POLICY_SERVICE_TOKEN=<policy-service-secret-at-least-32-random-bytes>
# CREWON_SECURITY_AUTHORITY_TIMEOUT_MS=2000
# Zero disables token assertion caching; production maximum is 30000ms.
# CREWON_IDENTITY_CACHE_TTL_MS=0
# CREWON_IDENTITY_CACHE_MAX_ENTRIES=1000
