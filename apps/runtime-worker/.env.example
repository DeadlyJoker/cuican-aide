CREWON_CONTROL_DB_PATH=/absolute/path/to/crewon-control.sqlite3
# Configure all four Artifact values together. They must match the Control API process.
CREWON_ARTIFACT_ROOT=/absolute/path/to/crewon-artifacts
CREWON_ARTIFACT_DB_PATH=/absolute/path/to/crewon-artifacts/metadata.sqlite3
CREWON_ARTIFACT_ENCRYPTION_KEY_PATH=/absolute/path/to/crewon-artifact.key
CREWON_ARTIFACT_ENCRYPTION_KEY_ID=standalone-artifact-key-v1
CREWON_RESPONSES_ENDPOINT=https://api.openai.com/v1/responses
CREWON_MODEL_ID=
CREWON_MODEL_API_KEY=
CREWON_RESPONSES_STORE=false
CREWON_RESPONSES_IDLE_TIMEOUT_MS=60000
CREWON_RESPONSES_STREAM_MAX_RETRIES=5
CREWON_RESPONSES_SEQUENCE_POLICY=required
CREWON_RESPONSES_WEBSOCKET_ENABLED=false
CREWON_RESPONSES_WEBSOCKET_CONNECT_TIMEOUT_MS=10000
CREWON_RESPONSES_WEBSOCKET_MAX_RETRIES=2

CREWON_WORKER_OWNER_ID=standalone-worker
CREWON_WORKER_LEASE_DURATION_MS=30000
CREWON_WORKER_RETRY_AFTER_MS=1000
CREWON_TOOL_APPROVAL_RECHECK_MS=1000
CREWON_TOOL_APPROVAL_TTL_MS=86400000
CREWON_WORKER_SCAN_INTERVAL_MS=1000
CREWON_WORKER_CANCELLATION_POLL_INTERVAL_MS=250
CREWON_MCP_STDIO_CONFIG_PATH=
# Optional exact tenant/version/digest to independent Provider/MCP bindings.
CREWON_AGENT_VERSION_RUNTIME_BINDINGS_PATH=

CREWON_TENANT_ID=standalone-tenant
# Used only by the separate `pnpm --filter @crewon/runtime-worker release` authority.
CREWON_RELEASE_PRINCIPAL_ID=standalone-release-principal
CREWON_RELEASE_ACTOR_ID=standalone-release
# Optional idempotency identity. Reuse it only to retry the same release/rollback command.
CREWON_AGENT_VERSION_ACTIVATION_ID=
# Used only by `release:rollback`; must be an existing sha256 release ID.
CREWON_AGENT_VERSION_ROLLBACK_RELEASE_ID=
CREWON_AUTHORITY_ID=standalone-authority
CREWON_RUNTIME_GENERATION=ts-v0
CREWON_AGENT_VERSION_ID=default-agent-v1
# Pin the compiler output from a reviewed deployment manifest; startup fails if any AgentVersion field drifts.
CREWON_AGENT_VERSION_CONTENT_DIGEST=
CREWON_POLICY_SNAPSHOT_ID=standalone-policy-v0
CREWON_WORKSPACE_BINDING_ID=

# Team/Cloud production only. Do not put bearer or Provider credential values in the JSON.
# CREWON_CONTROL_SECURITY_MODE=production
# CREWON_CONTROL_DATABASE_URL=postgresql://crewon@postgres/crewon
# CREWON_RUNTIME_PROVIDER_PROBE_CONFIG_JSON={"schemaVersion":"crewon.runtime-provider-probe.v1","port":3211,"tokenEnvironment":"PROVIDER_PROBE_TOKEN","tenantId":"tenant-1","expectedCatalogRevision":0,"providerId":"openai","runtimeBindingId":"runtime-provider-1","endpoint":"https://api.openai.com/v1","credentialEnvironment":"PROVIDER_API_KEY"}
# PROVIDER_PROBE_TOKEN=<secret-manager-reference>
# PROVIDER_API_KEY=<secret-manager-reference>
