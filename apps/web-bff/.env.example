# The public browser origin. Production requires HTTPS and an origin only.
CREWON_WEB_PUBLIC_ORIGIN=https://crewon.example.com

# Fixed loopback Control target. This is never accepted from a browser request.
CREWON_CONTROL_TARGET=http://127.0.0.1:3210
# Independent BFF-to-Control service credential; never expose it to the browser.
CREWON_CONTROL_BFF_TOKEN=<generate-at-least-32-random-bytes>
CREWON_CONTROL_CSRF_TOKEN=<generate-at-least-32-random-bytes>

# HMAC key used to derive a browser CSRF value from the HttpOnly identity session.
CREWON_WEB_CSRF_SECRET=<generate-at-least-32-random-bytes>

# Formal Identity Center server-to-server session exchange.
CREWON_IDENTITY_SESSION_URL=https://identity.example.com/internal/crewon/session
CREWON_IDENTITY_SERVICE_TOKEN=<generate-at-least-32-random-bytes>

# Optional; defaults shown. The process always binds to loopback.
CREWON_WEB_BFF_PORT=3211
CREWON_IDENTITY_TIMEOUT_MS=5000
