{
  "name": "@crewon/ui",
  "private": true,
  "version": "0.1.0",
  "description": "CrewON multi-agent collaboration workspace",
  "author": "CrewON",
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "pnpm desktop:runtime:stage && pnpm desktop:host:build && node --experimental-strip-types scripts/crewon-electron-dev.ts",
    "desktop:build": "pnpm build && pnpm desktop:runtime:stage && pnpm desktop:host:build && electron-builder",
    "desktop:pack": "pnpm build && pnpm desktop:runtime:stage && pnpm desktop:host:build && electron-builder --dir",
    "desktop:host:build": "node --experimental-strip-types scripts/build-electron.ts",
    "desktop:runtime:stage": "node --experimental-strip-types ../../scripts/stage-desktop-runtime.ts",
    "lint": "tsc -b --noEmit && pnpm desktop:host:lint",
    "desktop:host:lint": "tsc -p electron/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:agent-platform-multiturn": "node scripts/agent-platform-multiturn-eval.mjs"
  },
  "dependencies": {
    "@crewon/contracts": "workspace:*",
    "@crewon/control-client": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "electron-updater": "6.8.9",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@crewon/app-server-protocol": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "43.4.1",
    "electron-builder": "26.15.7",
    "esbuild": "0.27.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "ai.crewon.desktop",
    "productName": "CrewON",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop-resources/runtime",
        "to": "runtime"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DeadlyJoker",
        "repo": "cuican-aide"
      }
    ]
  }
}
