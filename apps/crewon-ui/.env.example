# CrewON Web uses the same-origin /agent-platform-api reverse proxy by default.
VITE_AGENT_PLATFORM_BASE_URL=/agent-platform-api

# Enable only after the Agent Platform `crewon-web` confidential client,
# redirect URI, client secret, and SSO migration 20260725_0011 are ready.
VITE_CREWON_UNIFIED_SSO_ENABLED=false

# Keep the existing post-login runtime identity exchange. OIDC ID Tokens are
# never used directly as app-server runtime credentials.
VITE_CREWON_PRINCIPAL_SESSION_ENABLED=false

# Local development Control runtime. These are read only by Vite's server-side
# BFF and must match the loopback Control API process; never prefix secrets with
# VITE_ or persist them in browser storage.
CREWON_CONTROL_TARGET=http://127.0.0.1:3210
CREWON_CONTROL_SESSION_TOKEN=replace-with-at-least-32-random-characters
CREWON_CONTROL_CSRF_TOKEN=replace-with-at-least-32-random-characters

# WeCom (企业微信) sign-in is configured on the Agent Platform backend, not here:
# the client only reads GET /api/v1/auth/wecom/config and renders the button as
# enabled or disabled. See docs/wecom-sso.md for the backend variables and the
# values to register in the WeCom admin console.
