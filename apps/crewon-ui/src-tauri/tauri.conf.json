{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crewon",
  "version": "0.1.0",
  "identifier": "ai.crewon.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:5175",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Crewon",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 620,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "msi", "nsis"],
    "category": "DeveloperTool",
    "shortDescription": "Crewon desktop client",
    "longDescription": "A desktop and web client for Crewon app-server."
  }
}
