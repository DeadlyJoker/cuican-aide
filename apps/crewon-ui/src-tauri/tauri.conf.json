{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crewon",
  "version": "../package.json",
  "identifier": "ai.crewon.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:5175",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Crewon",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 620,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "backgroundColor": "#00000000"
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/crewon-process-guardian",
      "binaries/crewon-node"
    ],
    "resources": [
      "binaries/runtime/control-api.mjs",
      "binaries/runtime/provider-settings-coordinator.mjs",
      "binaries/runtime/runtime-release.mjs",
      "binaries/runtime/runtime-worker.mjs"
    ],
    "targets": ["dmg", "app", "nsis"],
    "category": "DeveloperTool",
    "shortDescription": "Crewon desktop client",
    "longDescription": "A desktop and web client for Crewon app-server.",
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/DeadlyJoker/cuican-aide/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExOENBNUFFMDU5QzIzMEQKUldRTkk1d0ZycVdNRVM1VHpwT2pKU05YT2hZazFIMzExQlBrZWo5VzY5emREUER0T2NRZTR6STcK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
