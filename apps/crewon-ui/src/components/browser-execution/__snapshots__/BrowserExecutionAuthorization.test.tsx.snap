// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`BrowserExecutionAuthorization > displays every reviewed scope field and sends precisely that scope on click 1`] = `"<section class="browser-execution-authorization" aria-labelledby="_react-id_" aria-busy="false"><header><h3 id="_react-id_">浏览器执行授权</h3><p id="_react-id_" role="status" aria-live="polite">已授权 · 限定范围连续执行</p></header><div class="browser-execution-authorization-scope"><strong>本次授权方式：限定范围连续执行</strong><p>仅授权当前任务的指定技能版本使用以下网站与操作。自动批准模式下此范围仍生效，超出范围会停止，需要重新授权。</p><dl><dt>网站</dt><dd><ul><li>https://reports.example.com</li></ul></dd><dt>操作范围</dt><dd><ol><li><div class="browser-execution-authorization-rule"><strong>打开页面</strong><span>地址：https://reports.example.com/export?date={date}</span></div></li><li><div class="browser-execution-authorization-rule"><strong>点击</strong><span>控件：button · 筛选</span></div></li><li><div class="browser-execution-authorization-rule"><strong>填写</strong><span>控件：textbox · 日期</span><span>参数：date（运行时提供）</span></div></li><li><div class="browser-execution-authorization-rule"><strong>选择</strong><span>控件：combobox · 部门</span><span>固定值：销售</span></div></li><li><div class="browser-execution-authorization-rule"><strong>下载文件</strong><span>控件：link · 导出 CSV</span></div></li></ol></dd></dl></div><div class="browser-execution-authorization-actions"><button type="button" class="browser-execution-authorize" aria-describedby="_react-id_">允许此任务使用浏览器</button><button type="button">接管并撤销授权</button></div></section>"`;

exports[`BrowserExecutionAuthorization > snapshots disconnected SSR 1`] = `"<section class="browser-execution-authorization" aria-labelledby="_R_0_" aria-busy="false"><header><h3 id="_R_0_">浏览器执行授权</h3><p id="_R_0H1_" role="status" aria-live="polite">当前浏览器未连接</p></header><div class="browser-execution-authorization-scope"><strong>本次授权方式：逐次确认</strong><p>浏览器动作仍需逐次确认。此授权仅用于当前任务。</p></div><div class="browser-execution-authorization-actions"><button type="button" class="browser-execution-authorize" disabled="" aria-describedby="_R_0H1_">允许此任务使用浏览器</button></div></section>"`;
