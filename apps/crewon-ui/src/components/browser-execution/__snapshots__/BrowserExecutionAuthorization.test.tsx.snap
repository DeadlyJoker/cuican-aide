// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`BrowserExecutionAuthorization > describes delegated task approval without granting browser access or adding the mode to browser authorization 1`] = `"<div class="browser-authorization-configuration"><div class="browser-execution-authorization"><label class="browser-grant-mode">浏览器授权方式<select><option value="perAction">普通授权（按任务设置审批）</option><option value="scoped">限定范围连续执行</option></select></label></div><section class="browser-execution-authorization" aria-labelledby="_react-id_" aria-busy="false"><header><h3 id="_react-id_">浏览器执行授权</h3><p id="_react-id_" role="status" aria-live="polite">已授权 · 按任务设置审批</p></header><div class="browser-execution-authorization-scope"><strong>本次授权方式：按任务设置审批</strong><p>浏览器动作按本次任务的工具审批设置由 CrewON 代为批准；仍需单独授权当前任务使用浏览器。</p></div><div class="browser-execution-authorization-actions"><button type="button" class="browser-execution-authorize" aria-describedby="_react-id_">允许此任务使用浏览器</button><button type="button">接管并撤销授权</button></div></section></div>"`;

exports[`BrowserExecutionAuthorization > displays every reviewed scope field and sends precisely that scope on click 1`] = `"<div class="browser-authorization-configuration"><section class="browser-execution-authorization" aria-labelledby="_react-id_" aria-busy="false"><header><h3 id="_react-id_">浏览器执行授权</h3><p id="_react-id_" role="status" aria-live="polite">已授权 · 限定范围连续执行</p></header><div class="browser-execution-authorization-scope"><strong>本次授权方式：限定范围连续执行</strong><p>仅授权当前任务的指定技能版本使用以下网站与操作。自动批准模式下此范围仍生效，超出范围会停止，需要重新授权。</p><dl><dt>网站</dt><dd><ul><li>https://reports.example.com</li></ul></dd><dt>操作范围</dt><dd><ol><li><div class="browser-execution-authorization-rule"><strong>打开页面</strong><span>地址：https://reports.example.com/export?date={date}</span></div></li><li><div class="browser-execution-authorization-rule"><strong>点击</strong><span>控件：按钮 · 筛选</span></div></li><li><div class="browser-execution-authorization-rule"><strong>填写</strong><span>控件：输入框 · 日期</span><span>参数：date（运行时提供）</span></div></li><li><div class="browser-execution-authorization-rule"><strong>选择</strong><span>控件：下拉框 · 部门</span><span>固定值：销售</span></div></li><li><div class="browser-execution-authorization-rule"><strong>下载文件</strong><span>控件：链接 · 导出 CSV</span></div></li></ol></dd></dl></div><div class="browser-execution-authorization-actions"><button type="button" class="browser-execution-authorize" aria-describedby="_react-id_">允许此任务使用浏览器</button><button type="button">接管并撤销授权</button></div></section></div>"`;

exports[`BrowserExecutionAuthorization > requires a complete explicitly edited scope and sends only the reviewed fields 1`] = `"<div class="browser-authorization-configuration"><div class="browser-execution-authorization"><label class="browser-grant-mode">浏览器授权方式<select><option value="scoped">限定范围连续执行</option></select></label><p>此技能需要限定范围授权，配置完成后才能开始。</p><div class="browser-grant-editor"><p>填写本次允许使用的网站与操作，再点击下方授权。控件名称须与网页一致；修改配置后需重新授权。</p><fieldset><legend>允许的网站（最多 8 个）</legend><p>填写完整网站来源，例如 https://reports.example.com；不要附带路径或末尾斜杠。</p><div class="browser-grant-editor-row"><label>网站 1<input placeholder="https://reports.example.com" type="url" value="https://reports.example.com"></label><button type="button" aria-label="删除网站 1">删除</button></div><button type="button">添加网站</button></fieldset><fieldset><legend>允许的操作（最多 32 项）</legend><fieldset class="browser-grant-editor-rule"><legend>操作 1</legend><label>操作类型<select><option value="navigate">打开页面</option><option value="click">点击</option><option value="fill">填写</option><option value="select">选择</option><option value="download">下载文件</option></select></label><label>控件类型<select><option value="button">按钮</option><option value="textbox">输入框</option><option value="combobox">下拉框</option><option value="link">链接</option><option value="checkbox">复选框</option><option value="radio">单选框</option><option value="tab">标签页</option><option value="menuitem">菜单项</option><option value="option">选项</option><option value="spinbutton">数字输入框</option><option value="">日期等原生控件（无角色）</option></select></label><label>控件名称<input maxlength="120" placeholder="例如：导出 CSV" value="日期"></label><label>填写内容来源<select><option value="literal">固定值</option><option value="parameter">任务参数</option></select></label><label>参数名称<select><option value="">选择参数</option><option value="date">date</option></select></label><button type="button">删除操作 1</button></fieldset><button type="button">添加操作</button></fieldset></div></div><section class="browser-execution-authorization" aria-labelledby="_react-id_" aria-busy="false"><header><h3 id="_react-id_">浏览器执行授权</h3><p id="_react-id_" role="status" aria-live="polite">已授权 · 限定范围连续执行</p></header><div class="browser-execution-authorization-scope"><strong>本次授权方式：限定范围连续执行</strong><p>仅授权当前任务的指定技能版本使用以下网站与操作。自动批准模式下此范围仍生效，超出范围会停止，需要重新授权。</p><dl><dt>网站</dt><dd><ul><li>https://reports.example.com</li></ul></dd><dt>操作范围</dt><dd><ol><li><div class="browser-execution-authorization-rule"><strong>填写</strong><span>控件：日期等原生控件（无角色） · 日期</span><span>参数：date（运行时提供）</span></div></li></ol></dd></dl></div><div class="browser-execution-authorization-actions"><button type="button" class="browser-execution-authorize" aria-describedby="_react-id_">允许此任务使用浏览器</button><button type="button">接管并撤销授权</button></div></section></div>"`;

exports[`BrowserExecutionAuthorization > snapshots disconnected SSR 1`] = `"<div class="browser-authorization-configuration"><div class="browser-execution-authorization"><label class="browser-grant-mode">浏览器授权方式<select><option value="perAction" selected="">普通授权（按任务设置审批）</option><option value="scoped">限定范围连续执行</option></select></label></div><section class="browser-execution-authorization" aria-labelledby="_R_2_" aria-busy="false"><header><h3 id="_R_2_">浏览器执行授权</h3><p id="_R_2H1_" role="status" aria-live="polite">当前浏览器未连接</p></header><div class="browser-execution-authorization-scope"><strong>本次授权方式：逐次确认</strong><p>浏览器动作仍需逐次确认。此授权仅用于当前任务。</p></div><div class="browser-execution-authorization-actions"><button type="button" class="browser-execution-authorize" disabled="" aria-describedby="_R_2H1_">允许此任务使用浏览器</button></div></section></div>"`;
