// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`keeps browser authorization controls scoped, responsive and keyboard-visible 1`] = `
".browser-execution-authorization {
  display: grid;
  gap: 12px;
  min-width: 0;
  max-width: 100%;
  padding: 14px;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  background: var(--surface);
  color: var(--text);
  font-size: 12px;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.browser-execution-authorization header,
.browser-execution-authorization-scope,
.browser-execution-authorization-rule {
  display: grid;
  gap: 4px;
  min-width: 0;
}

.browser-execution-authorization h3,
.browser-execution-authorization p,
.browser-execution-authorization dl,
.browser-execution-authorization dd {
  margin: 0;
}

.browser-execution-authorization h3 {
  color: var(--text);
  font-size: 13px;
  font-weight: 600;
}

.browser-execution-authorization p,
.browser-execution-authorization-rule span {
  color: var(--text-muted);
}

.browser-execution-authorization dl {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 8px 12px;
  margin-top: 4px;
}

.browser-execution-authorization dt {
  color: var(--text-muted);
}

.browser-execution-authorization ul,
.browser-execution-authorization ol {
  display: grid;
  gap: 6px;
  margin: 0;
  padding-left: 18px;
}

.browser-execution-authorization-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.browser-execution-authorization button {
  min-height: var(--control-h-md);
  max-width: 100%;
  padding: 6px 10px;
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-md);
  background: transparent;
  color: var(--text);
  font: inherit;
  white-space: normal;
  cursor: pointer;
}

.browser-execution-authorization .browser-execution-authorize {
  border-color: var(--accent);
  background: var(--accent);
  color: var(--accent-ink, #fff);
}

.browser-execution-authorization button:hover:not(:disabled) {
  filter: brightness(0.94);
}

.browser-execution-authorization button:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

.browser-execution-authorization button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.browser-execution-authorization .browser-execution-authorization-error {
  color: var(--danger);
}

@media (max-width: 480px) {
  .browser-execution-authorization dl {
    grid-template-columns: minmax(0, 1fr);
    gap: 4px;
  }
}
"
`;
