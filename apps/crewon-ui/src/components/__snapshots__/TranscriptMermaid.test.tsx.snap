exports[`Mermaid transcript presentation > keeps loading, live, rendered, and fallback states visually distinct 1`] = `"<div><figure class="mermaid-block" data-complete="false" data-renderer="mermaid" data-state="loading"><figcaption><span class="mermaid-caption-title">Mermaid</span><em class="mermaid-render-status" role="status"><span aria-hidden="true"></span>Building diagram</em></figcaption><div aria-label="Building Mermaid diagram" class="mermaid-streaming-placeholder" role="status"><span class="mermaid-placeholder-node"></span><span class="mermaid-placeholder-link"></span><span class="mermaid-placeholder-node is-center"></span><span class="mermaid-placeholder-link"></span><span class="mermaid-placeholder-node"></span></div></figure><figure class="mermaid-block" data-complete="false" data-renderer="mermaid" data-state="live"><figcaption><span class="mermaid-caption-title">Mermaid</span><em class="mermaid-render-status" role="status"><span aria-hidden="true"></span>Live preview</em></figcaption><div aria-label="Mermaid live preview" class="mermaid-diagram mermaid-live-diagram" role="img"><svg role="img" viewBox="0 0 240 80"><text>stable diagram</text></svg></div></figure><figure class="mermaid-block" data-complete="true" data-renderer="mermaid" data-state="rendered"><figcaption><span class="mermaid-caption-title">Mermaid</span></figcaption><div aria-label="Mermaid diagram" class="mermaid-diagram" role="img"><svg role="img" viewBox="0 0 240 80"><text>stable diagram</text></svg></div><button aria-label="Expand Mermaid diagram" class="mermaid-zoom-button" title="Expand diagram" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-maximize2"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" x2="14" y1="3" y2="10"></line><line x1="3" x2="10" y1="21" y2="14"></line></svg></button><details class="mermaid-source"><summary>Source</summary><pre><code class="language-mermaid">graph LR\\n  A --&gt; B</code></pre></details></figure><figure class="mermaid-block" data-complete="true" data-renderer="mermaid" data-state="error"><figcaption><span class="mermaid-caption-title">Mermaid</span><em class="mermaid-render-status" role="status"><span aria-hidden="true"></span>Source fallback</em></figcaption><pre><code class="language-mermaid">graph LR\\n  A --&gt;</code></pre><p class="mermaid-error" role="status" title="Parse error">Mermaid diagram could not be rendered.</p></figure></div>"`;
