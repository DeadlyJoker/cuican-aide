exports[`Transcript > snapshots durable Control tool history in the process timeline 1`] = `"<main class="transcript"><div class="message-list" role="log" aria-busy="false" aria-live="polite" aria-relevant="additions text"><section class="turn-group" data-status="completed" aria-label="Processed 1"><article class="message" data-kind="userMessage" data-has-icon="false" data-transcript-variant="message" aria-label="You"><div class="message-body"><div class="message-header"><span class="message-role">You</span><span class="message-type">Input</span></div><div class="markdown-content"><p>Inspect the workspace.</p></div></div></article><section class="turn-process-details" data-state="collapsed" data-status="completed"><button type="button" class="turn-process-summary" aria-controls="turn-process-run-control-tool-history" aria-expanded="false"><span class="turn-process-summary-main"><span class="turn-process-title">Processed</span><em>2s</em></span></button><div class="turn-process-items-shell" hidden="" id="turn-process-run-control-tool-history"><div class="turn-process-items"><article class="message" data-kind="dynamicToolCall" data-has-icon="true" data-status="completed" data-transcript-variant="process" aria-label="Tool"><div class="message-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-code-xml"><path d="m18 16 4-4-4-4"></path><path d="m6 8-4 4 4 4"></path><path d="m14.5 4-5 16"></path></svg></div><div class="message-body"><div class="message-header"><span class="message-role">Tool</span><span class="message-type">Run</span></div><details class="tool-card tool-call-card dynamic-tool-card compact-tool-card" data-status="completed"><summary class="tool-card-header tool-call-header"><span class="tool-action-verb">Tool</span><code>exec_command</code><span class="tool-card-status"><span class="status-dot" aria-hidden="true"></span>Completed</span><em>1s</em></summary><div class="tool-call-body"><section class="tool-call-section"><span>Arguments</span><pre>{}</pre></section><section class="tool-call-section"><span>Output</span><pre>No output</pre></section></div></details></div></article></div></div></section><article class="message" data-kind="agentMessage" data-has-icon="false" data-transcript-variant="message" aria-label="Crewon"><div class="message-body"><div class="message-header"><span class="message-role">Crewon</span><span class="message-type">Reply</span></div><div class="markdown-content"><p>The workspace is ready.</p></div></div></article></section><div aria-hidden="true" class="transcript-follow-anchor" data-testid="transcript-follow-anchor"></div></div></main>"`;

exports[`Transcript > snapshots the processed timeline header and grouped tool batches 1`] = `"<main class="transcript"><div class="message-list" role="log" aria-busy="false" aria-live="polite" aria-relevant="additions text"><section class="turn-group" data-status="completed" aria-label="Processed 1"><article class="message" data-kind="userMessage" data-has-icon="false" data-transcript-variant="message" aria-label="You"><div class="message-body"><div class="message-header"><span class="message-role">You</span><span class="message-type">Input</span></div><div class="markdown-content"><p>Restart the local stack.</p></div></div></article><section class="turn-process-details" data-state="collapsed" data-status="completed"><button type="button" class="turn-process-summary" aria-controls="turn-process-turn-execution-timeline" aria-expanded="false"><span class="turn-process-summary-main"><span class="turn-process-title">Processed</span><em>25m 54s</em></span></button><div class="turn-process-items-shell" hidden="" id="turn-process-turn-execution-timeline"><div class="turn-process-items"><article class="message" data-kind="agentMessage" data-has-icon="false" data-process-note="true" data-transcript-variant="process" aria-label="Progress note"><div class="message-body"><div class="message-header"><span class="message-role">Progress note</span><span class="message-type">Progress</span></div><div class="markdown-content"><p>I will restart the existing local services and verify their health.</p></div></div></article><details class="process-action-group" data-status="completed"><summary><span class="process-action-group-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-terminal"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" x2="20" y1="19" y2="19"></line></svg></span><span>Ran multiple commands</span></summary><div class="process-action-group-items"><article class="message" data-kind="commandExecution" data-has-icon="true" data-status="completed" data-transcript-variant="process" aria-label="Command"><div class="message-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-terminal"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" x2="20" y1="19" y2="19"></line></svg></div><div class="message-body"><div class="message-header"><span class="message-role">Command</span><span class="message-type">Command</span></div><details class="tool-card command-card compact-tool-card" data-status="completed"><summary class="tool-card-header command-card-header"><span class="tool-action-verb">Ran</span><code>launchctl stop com.brilliant.crewon.dev</code><span class="tool-card-status"><span class="status-dot" aria-hidden="true"></span>300ms · exit 0</span></summary></details></div></article><article class="message" data-kind="commandExecution" data-has-icon="true" data-status="completed" data-transcript-variant="process" aria-label="Command"><div class="message-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-terminal"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" x2="20" y1="19" y2="19"></line></svg></div><div class="message-body"><div class="message-header"><span class="message-role">Command</span><span class="message-type">Command</span></div><details class="tool-card command-card compact-tool-card" data-status="completed"><summary class="tool-card-header command-card-header"><span class="tool-action-verb">Ran</span><code>launchctl start com.brilliant.crewon.dev</code><span class="tool-card-status"><span class="status-dot" aria-hidden="true"></span>420ms · exit 0</span></summary></details></div></article></div></details><article class="message" data-kind="agentMessage" data-has-icon="false" data-process-note="true" data-transcript-variant="process" aria-label="Progress note"><div class="message-body"><div class="message-header"><span class="message-role">Progress note</span><span class="message-type">Progress</span></div><div class="markdown-content"><p>The services are starting. I will wait for both health checks.</p></div></div></article><article class="message" data-kind="commandExecution" data-has-icon="true" data-status="completed" data-transcript-variant="process" aria-label="Command"><div class="message-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-terminal"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" x2="20" y1="19" y2="19"></line></svg></div><div class="message-body"><div class="message-header"><span class="message-role">Command</span><span class="message-type">Command</span></div><details class="tool-card command-card compact-tool-card" data-status="completed"><summary class="tool-card-header command-card-header"><span class="tool-action-verb">Ran</span><code>curl -sS http://127.0.0.1:6176/readyz</code><span class="tool-card-status"><span class="status-dot" aria-hidden="true"></span>150ms · exit 0</span></summary><pre class="tool-call-output">ok</pre></details></div></article></div></div></section><article class="message" data-kind="agentMessage" data-has-icon="false" data-transcript-variant="message" aria-label="Crewon"><div class="message-body"><div class="message-header"><span class="message-role">Crewon</span><span class="message-type">Reply</span></div><div class="markdown-content"><p>Both services are healthy.</p></div></div></article></section><div aria-hidden="true" class="transcript-follow-anchor" data-testid="transcript-follow-anchor"></div></div></main>"`;
