// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`TranscriptTeamProgress > shows one user message and actual member states, not a fabricated final answer 1`] = `"<section class="turn-group team-progress-turn" aria-label="团队任务进度"><article class="message" data-kind="userMessage" data-has-icon="false" data-transcript-variant="message" aria-label="你"><div class="message-body"><div class="message-header"><span class="message-role">你</span><span class="message-type">输入</span></div><div class="markdown-content"><p>8位坐席的预算选型</p></div></div></article><div class="team-progress-status" role="status" data-phase="working"><strong>团队正在协作</strong><ul><li data-status="running"><span>业务分析员</span><span>执行中</span></li><li data-status="queued"><span>约束核验员</span><span>排队中</span></li></ul><p>成员完成不代表最终结论已就绪。当前页面负责协调，完成前请勿刷新。</p></div></section>"`;
