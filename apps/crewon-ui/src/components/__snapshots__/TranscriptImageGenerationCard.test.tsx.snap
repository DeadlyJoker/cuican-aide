exports[`generated image delivery > uses authenticated artifact bytes for preview and download, and revokes the URL on unmount 1`] = `"<div class="tool-card action-card transcript-image-generation" data-status="completed"><div class="tool-card-header action-card-header" role="status"><span class="tool-action-verb">图片已生成</span></div><figure class="transcript-generated-image"><img alt="生成的图片" src="blob:crewon-image"><figcaption><a href="blob:crewon-image" download="crewon-image.png"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-download" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"></line></svg>保存图片</a></figcaption></figure></div>"`;
