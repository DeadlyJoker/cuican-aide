// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Team progress handoff from a local user submission > shows the request once while preparation and accepted worker status are visible 1`] = `"<div class="message-list" role="log" aria-busy="true" aria-live="polite" aria-relevant="additions text"><section data-pending-user-message="sending"><article class="message" data-kind="userMessage" data-has-icon="false" data-transcript-variant="message" aria-label="You"><div class="message-body"><div class="message-header"><span class="message-role">You</span><span class="message-type">Input</span></div><div class="markdown-content"><p>Compare the release options as a team</p></div></div></article><p class="message-loading-state" role="status">Sending</p></section><section class="turn-group team-progress-turn" aria-label="Team task progress"><div class="team-progress-status" role="status" data-phase="preparing"><strong>Preparing team task</strong><ul></ul><p>Member completion is not the final answer. This page coordinates the team; avoid reloading until finished.</p></div></section><div aria-hidden="true" class="transcript-follow-anchor" data-testid="transcript-follow-anchor"></div></div>"`;
