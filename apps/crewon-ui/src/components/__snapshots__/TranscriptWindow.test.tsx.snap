exports[`renders partial and unknown history states without paging or file-summary controls > history status 1`] = `"<div class="transcript-window-controls" aria-label="工具过程状态" aria-busy="false"><span class="transcript-history-note">部分工具过程尚未完整加载。<button type="button">重新读取工具过程</button></span></div>"`;

exports[`renders partial and unknown history states without paging or file-summary controls > partial turn 1`] = `"<main class="transcript"><div class="message-list" role="log" aria-busy="false" aria-live="polite" aria-relevant="additions text"><p class="transcript-history-note">本页显示本轮的部分内容</p><section class="turn-group" data-status="completed" aria-label="已处理 1"><article class="message" data-kind="agentMessage" data-message-id="message-2" data-has-icon="false" data-transcript-variant="message" aria-label="CrewON"><div class="message-body"><div class="message-header"><span class="message-role">CrewON</span><span class="message-type">回复</span></div><div class="markdown-content"><p>Answer 2</p></div><div class="message-actions" data-user="false" data-visibility="always" role="group" aria-label="回复操作"><button type="button" aria-label="复制" class="message-action-button" data-state="closed" data-slot="tooltip-trigger"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg></button><span class="message-action-status" role="status"></span></div></div></article></section><div aria-hidden="true" class="transcript-follow-anchor" data-testid="transcript-follow-anchor"></div></div></main>"`;

exports[`renders partial and unknown history states without paging or file-summary controls > unknown history 1`] = `"<main class="transcript"><div class="message-list" role="log" aria-busy="false" aria-live="polite" aria-relevant="additions text"><section><p class="transcript-history-note">历史消息，执行状态未知</p><article class="message" data-kind="agentMessage" data-message-id="message-2" data-has-icon="false" data-transcript-variant="message" aria-label="CrewON"><div class="message-body"><div class="message-header"><span class="message-role">CrewON</span><span class="message-type">回复</span></div><div class="markdown-content"><p>legacy: old answer</p></div><div class="message-actions" data-user="false" data-visibility="always" role="group" aria-label="回复操作"><button type="button" aria-label="复制" class="message-action-button" data-state="closed" data-slot="tooltip-trigger"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg></button><span class="message-action-status" role="status"></span></div></div></article></section><div aria-hidden="true" class="transcript-follow-anchor" data-testid="transcript-follow-anchor"></div></div></main>"`;
