// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`OfficeMembersPanel > hides storage actions and presents deletion as an Office action 1`] = `"<aside class="office-members" aria-label="成员"><div class="office-rail-head"><strong>成员</strong><span>1</span></div><div class="office-member office-manager-member" data-office-manager="true"><span class="office-avatar" data-accent="cyan" aria-hidden="true">组<i class="office-presence" data-online="false"></i></span><span class="office-member-text"><strong>办公室主控</strong><span>Leader Agent · 接收目标、拆解任务与协调员工</span><em>将在首次消息前创建主控线程</em></span><span class="office-manager-badge">Leader</span></div><div class="office-rail-actions"><button type="button" data-tone="danger">删除办公室</button></div></aside>"`;

exports[`OfficeMembersPanel > offers an explicit identity upgrade for a legacy Office member 1`] = `"<aside class="office-members" aria-label="成员"><div class="office-rail-head"><strong>成员</strong><span>2</span></div><div class="office-member office-manager-member" data-office-manager="true"><span class="office-avatar" data-accent="cyan" aria-hidden="true">组<i class="office-presence" data-online="false"></i></span><span class="office-member-text"><strong>办公室主控</strong><span>Leader Agent · 接收目标、拆解任务与协调员工</span><em>将在首次消息前创建主控线程</em></span><span class="office-manager-badge">Leader</span></div><div class="office-member"><span class="office-avatar" data-accent="blue" aria-hidden="true">旧<i class="office-presence" data-online="true"></i></span><span class="office-member-text"><strong>旧成员</strong><span>交付智能体</span><em>等待身份升级</em></span></div><div class="office-recruit"><div class="office-rail-head"><strong>选择智能体</strong><button type="button" title="刷新智能体" aria-label="刷新智能体"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw" aria-hidden="true"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path></svg></button></div><p class="office-recruit-upgrade-note" role="status">旧成员 是旧成员；升级后会获得稳定 memberId 和办公室专属 Runtime，才可安全 @。</p><div class="control-select office-agent-select" data-open="false"><span class="visually-hidden">可招募智能体</span><button aria-controls="_R_14_" aria-expanded="false" aria-haspopup="listbox" aria-label="可招募智能体" class="select-trigger" type="button">旧成员</button><div class="select-menu" hidden="" id="_R_14_" role="listbox"><button aria-selected="true" class="select-option" data-tone="normal" data-value="agent-legacy" role="option" type="button"><span><strong>旧成员</strong><em>交付智能体 · 需升级身份</em></span></button></div></div><button type="button" data-tone="primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-plus" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" x2="19" y1="8" y2="14"></line><line x1="22" x2="16" y1="11" y2="11"></line></svg>升级成员身份</button></div></aside>"`;
