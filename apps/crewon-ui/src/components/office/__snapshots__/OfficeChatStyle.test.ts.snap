// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Office chat style > snapshots the quiet bubble and plain mention contract 1`] = `
{
  "memberBubble": ".office-bubble-body {
  display: grid;
  gap: 5px;
  flex: 1;
  min-width: 0;
  min-height: 58px;
  padding: 14px 16px;
  border: 1px solid color-mix(in srgb, var(--border) 58%, transparent);
  border-radius: var(--radius-xl);
  background: color-mix(in srgb, var(--surface-raised) 72%, transparent);
  box-shadow: none;
}",
  "mention": ".office-mention {
  color: var(--accent);
  font-weight: 500;
  padding: 0;
  border-radius: 0;
  background: transparent;
}",
  "selfBubble": ".office-bubble[data-self="true"] .office-bubble-body {
  border-radius: var(--radius-xl);
  border-color: transparent;
  background: color-mix(in srgb, var(--accent) 5%, var(--surface));
}",
  "selfMention": ".office-bubble[data-self="true"] .office-mention {
  background: transparent;
}",
}
`;
