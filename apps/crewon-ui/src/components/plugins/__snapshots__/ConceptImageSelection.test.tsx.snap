// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`independent exact concept image selection > renders exact image choices and current historical confirmation with a new snapshot > current image from historical requirement 1`] = `"<section class="detail-panel" aria-label="概念图选用" data-selection-revision="1"><div class="panel-heading"><h2>概念图选用</h2><button class="text-button">刷新当前选用</button></div><div class="version-card" data-selected-result-index="2"><strong>当前选用 · 输入 v1 · 结果 3</strong><div class="concept-art"><img loading="lazy" alt="当前选用 · 输入 v1 · 结果 3" src="https://images.example.test/view?filename=image-2.png"></div><p class="detail-note">image-2.png</p><p class="detail-note" role="status">需重新确认：这张图来自旧输入或旧需求，请核对当前需求和画面后再选择。</p></div><p class="detail-note" role="status">原选用请求已确认；当前选用以重新读取的结果为准。</p></section>"`;

exports[`independent exact concept image selection > renders exact image choices and current historical confirmation with a new snapshot > explicit raw image index choice 1`] = `"<div data-result-index="2"><div class="concept-art"><img loading="lazy" alt="雨夜街角 · 输入 v1 · 结果 3" src="https://images.example.test/view?filename=image-2.png"></div><p class="detail-note">结果 3 · image-2.png</p><button class="button secondary">再次选用这张图</button></div>"`;

exports[`independent exact concept image selection > renders unavailable current state after a confirmed write without projecting its old receipt as current > accepted receipt with unavailable current read 1`] = `"<section class="detail-panel" aria-label="概念图选用"><div class="panel-heading"><h2>概念图选用</h2><button class="text-button">刷新当前选用</button></div><p class="detail-note" role="alert">当前选用暂时无法读取，请刷新后再选用。</p><p class="detail-note" role="status">原选用请求已确认；当前选用以重新读取的结果为准。</p></section>"`;

exports[`independent exact concept image selection > shows a retained UNKNOWN request and blocks editing or replacement with a new snapshot > unknown selection retains original request 1`] = `"<section class="detail-panel" aria-label="概念图选用"><div class="panel-heading"><h2>概念图选用</h2><button class="text-button">刷新当前选用</button></div><p class="detail-note" role="status">选用回复丢失或尚未确认，原选用已保留。确认前不能保存、切换或重新选图。</p><button class="button secondary">重试原选用</button></section>"`;
