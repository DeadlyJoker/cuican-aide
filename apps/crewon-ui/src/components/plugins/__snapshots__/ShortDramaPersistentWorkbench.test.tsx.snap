// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`independent short-drama persistent presentation > retains the scoped original layout while waiting, with no account, shell or generation claims 1`] = `"<section class="drama-workbench" aria-label="AI 短剧工作台"><div class="drama-main"><header class="drama-topbar" data-plugin-header-insets="inline"><nav class="breadcrumbs" aria-label="AI 短剧路径"><button>AI 短剧</button><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right"><path d="m9 18 6-6-6-6"></path></svg><span>我的项目</span></nav><div class="topbar-actions"><span class="preview-tag">创作工作台</span></div></header><div class="drama-content "><p class="detail-note" role="status">正在等待模块就绪…</p></div></div><div class="drama-dialog-layer" hidden=""><dialog class="modal" aria-labelledby="drama-persistent-modal-title"><div class="modal-header"><h2 id="drama-persistent-modal-title">需求版本</h2><button class="button icon" aria-label="关闭弹窗"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></div></dialog></div></section>"`;
