// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ProviderResourcePicker > snapshots a compact real-resource list and active binding 1`] = `"<section class="provider-resource-picker" data-phase="bound" aria-label="Provider 资源"><header class="provider-resource-picker__header"><span class="provider-resource-picker__identity"><span class="provider-resource-picker__icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cloud"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path></svg></span><span><strong>云端资源</strong><small>agent-platform · 4 项</small></span></span><label class="provider-resource-picker__workspace"><span class="visually-hidden">Provider 工作空间</span><select aria-label="Provider 工作空间"><option value="workspace-1">cuican-aide</option></select></label><span class="provider-resource-picker__status" data-status="connected"><i aria-hidden="true"></i>已连接</span></header><div class="provider-resource-picker__list" role="listbox"><button class="provider-resource-picker__item" type="button" role="option" aria-selected="false"><span class="provider-resource-picker__item-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bot"><path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path d="M2 14h2"></path><path d="M20 14h2"></path><path d="M15 13v2"></path><path d="M9 13v2"></path></svg></span><span class="provider-resource-picker__item-copy"><strong>review-agent</strong><small>智能体 · revision agent-r1</small></span></button><button class="provider-resource-picker__item" data-bound="true" data-selected="true" type="button" role="option" aria-selected="true"><span class="provider-resource-picker__item-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg></span><span class="provider-resource-picker__item-copy"><strong>code-review</strong><small>Skill · revision skill-r2</small></span><em>已绑定</em></button><button class="provider-resource-picker__item" type="button" role="option" aria-selected="false"><span class="provider-resource-picker__item-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plug"><path d="M12 22v-5"></path><path d="M9 8V2"></path><path d="M15 8V2"></path><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"></path></svg></span><span class="provider-resource-picker__item-copy"><strong>github</strong><small>MCP · revision mcp-r3</small></span></button><button class="provider-resource-picker__item" type="button" role="option" aria-selected="false"><span class="provider-resource-picker__item-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open"><path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg></span><span class="provider-resource-picker__item-copy"><strong>product-docs</strong><small>知识库 · revision kb-r4</small></span></button></div><footer class="provider-resource-picker__footer"><span>已选择 <strong>code-review</strong></span><button type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-unlink" aria-hidden="true"><path d="m18.84 12.25 1.72-1.71h-.02a5.004 5.004 0 0 0-.12-7.07 5.006 5.006 0 0 0-6.95 0l-1.72 1.71"></path><path d="m5.17 11.75-1.71 1.71a5.004 5.004 0 0 0 .12 7.07 5.006 5.006 0 0 0 6.95 0l1.71-1.71"></path><line x1="8" x2="8" y1="2" y2="5"></line><line x1="2" x2="5" y1="8" y2="8"></line><line x1="16" x2="16" y1="19" y2="22"></line><line x1="19" x2="22" y1="16" y2="16"></line></svg>解除绑定</button></footer></section>"`;

exports[`ProviderResourcePicker > snapshots a real resource whose binding capability is unavailable 1`] = `"<section class="provider-resource-picker" data-phase="ready" aria-label="Provider 资源"><header class="provider-resource-picker__header"><span class="provider-resource-picker__identity"><span class="provider-resource-picker__icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cloud"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path></svg></span><span><strong>云端资源</strong><small>agent-platform · 1 项</small></span></span><label class="provider-resource-picker__workspace"><span class="visually-hidden">Provider 工作空间</span><select aria-label="Provider 工作空间"><option value="workspace-1">cuican-aide</option></select></label><span class="provider-resource-picker__status" data-status="connected"><i aria-hidden="true"></i>已连接</span></header><div class="provider-resource-picker__list" role="listbox"><button class="provider-resource-picker__item" data-selected="true" type="button" role="option" aria-selected="true"><span class="provider-resource-picker__item-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open"><path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg></span><span class="provider-resource-picker__item-copy"><strong>product-docs</strong><small>知识库 · revision kb-r4</small></span><em>不可绑定</em></button></div><footer class="provider-resource-picker__footer"><span>已选择 <strong>product-docs</strong></span><button type="button" disabled="">添加到会话</button></footer></section>"`;

exports[`ProviderResourcePicker > snapshots unavailable and recovering states without fake resources 1`] = `
{
  "recovering": "<section class="provider-resource-picker" data-phase="recovering" aria-label="Provider 资源"><header class="provider-resource-picker__header"><span class="provider-resource-picker__identity"><span class="provider-resource-picker__icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cloud"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path></svg></span><span><strong>云端资源</strong><small>由 app-server 安全连接</small></span></span><span class="provider-resource-picker__status" data-status="pending"><i aria-hidden="true"></i>恢复中</span></header><div class="provider-resource-picker__empty" role="status"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw provider-resource-picker__spin" aria-hidden="true"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path></svg><strong>正在恢复连接</strong><span>通过 app-server 校验身份、工作空间与 Provider 能力…</span></div></section>",
  "unavailable": "<section class="provider-resource-picker" data-phase="unavailable" aria-label="Provider 资源"><header class="provider-resource-picker__header"><span class="provider-resource-picker__identity"><span class="provider-resource-picker__icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cloud"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path></svg></span><span><strong>云端资源</strong><small>由 app-server 安全连接</small></span></span><span class="provider-resource-picker__status" data-status="unavailable"><i aria-hidden="true"></i>不可用</span></header><div class="provider-resource-picker__empty" role="status"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cloud" aria-hidden="true"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path></svg><strong>云端资源暂不可用</strong><span>Provider connection is unavailable</span><button type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw" aria-hidden="true"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path></svg>重试</button></div></section>",
}
`;
