exports[`original conversation launch controls > shows explicit creation/execution choices and defaults adoption to manual without writing on render 1`] = `"<div class="project-planning-launch"><details><summary>执行指令</summary><p>先做两集悬疑方案</p></details><label class="form-field"><span>阶段产出处理</span><select aria-label="阶段产出处理"><option value="manual" selected="">每阶段手动采用后继续</option><option value="whenUnchanged">内容未变时自动采用并继续</option></select></label><p role="status">可只创建项目，或按上方范围执行文字计划。</p><div class="project-planning-launch-actions"><button type="button" class="button secondary">创建项目并关联会话</button><button type="button" class="button primary">创建并按计划执行</button><button type="button" class="button secondary">到工作台修改</button></div></div>"`;
