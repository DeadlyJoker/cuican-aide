// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ControlCommandOfficeRoomAdapter > renders the group chat as the primary Office surface 1`] = `"<main aria-label="产品交付办公室" class="office-workspace control-office-chat-room" data-control-office-chat=""><header class="office-top"><button class="office-back" type="button">返回</button><div class="office-top-title" title="产品交付办公室"><h1>产品交付办公室</h1><p>办公室群聊 · 交付组长 · 2 名成员</p></div><div class="office-top-actions"><div aria-label="群聊成员：交付组长、审阅员工" class="control-office-chat-members" role="img" title="群聊 · 交付组长、审阅员工"><span aria-hidden="true">交</span><span aria-hidden="true">审</span></div><button aria-label="成员设置" class="control-office-member-settings-button" title="成员设置" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-settings2" aria-hidden="true"><path d="M20 7h-9"></path><path d="M14 17H5"></path><circle cx="17" cy="17" r="3"></circle><circle cx="7" cy="7" r="3"></circle></svg></button></div></header><div class="office-room-body"><section class="office-chat" aria-label="群聊"><div aria-busy="false" aria-live="polite" aria-relevant="additions text" class="office-chat-stream" role="log"><div class="office-chat-empty" role="status"><strong>正在进入群聊</strong><p>正在加载聊天记录。</p></div></div><input accept=".csv,.docx,.html,.js,.jsx,.json,.md,.py,.rs,.sql,.ts,.tsx,.txt,.xls,.xlsx,.xml,.yaml,.yml" aria-label="选择文件" hidden="" multiple="" type="file"/><input aria-label="选择文件夹" hidden="" multiple="" type="file"/><form class="command-input thread-command-input control-office-chat-composer" data-command-composer="true"><label class="visually-hidden" for="control-office-message-input">群聊输入</label><textarea aria-describedby="control-office-composer-status" aria-label="群聊输入" data-composer="" disabled="" id="control-office-message-input" placeholder="告诉组长目标、背景或下一步…" rows="2"></textarea><div class="input-tools" data-od-id="composer-tools"><div class="composer-controls" data-od-id="composer-control-row"><button aria-label="添加上下文" class="icon-action composer-plus-action" data-palette-trigger="add" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></button><button type="button" role="combobox" aria-expanded="false" aria-autocomplete="none" dir="ltr" data-state="closed" aria-label="权限选择" class="inline-flex min-h-[var(--control-h-md)] cursor-pointer items-center gap-1.5 rounded-[var(--radius-sm)] border border-[var(--border)] bg-[var(--surface)] px-[9px] py-1.5 text-[calc(12px_+_var(--user-ui-font-delta))] font-medium text-[var(--text)] transition-colors duration-[var(--dur-fast)] ease-[var(--ease)] hover:border-[var(--n-alpha-20)] focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-[var(--accent,#2563eb)] disabled:cursor-not-allowed disabled:opacity-50 [&amp;_svg]:shrink-0 [&amp;_svg]:opacity-60 max-w-[180px]" data-selected-tone="normal"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg><span class="min-w-0 flex-1 truncate text-left">本地自动</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevrons-up-down size-3" aria-hidden="true"><path d="m7 15 5 5 5-5"></path><path d="m7 9 5-5 5 5"></path></svg></button><select aria-hidden="true" tabindex="-1" style="position:absolute;border:0;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0, 0, 0, 0);white-space:nowrap;word-wrap:normal"></select></div><div class="composer-actions" data-od-id="composer-action-row"><button type="button" role="combobox" aria-expanded="false" aria-autocomplete="none" dir="ltr" data-state="closed" aria-label="模型与推理档位" class="inline-flex min-h-[var(--control-h-md)] cursor-pointer items-center gap-1.5 rounded-[var(--radius-sm)] border border-[var(--border)] bg-[var(--surface)] px-[9px] py-1.5 text-[calc(12px_+_var(--user-ui-font-delta))] font-medium text-[var(--text)] transition-colors duration-[var(--dur-fast)] ease-[var(--ease)] hover:border-[var(--n-alpha-20)] focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-[var(--accent,#2563eb)] disabled:cursor-not-allowed disabled:opacity-50 [&amp;_svg]:shrink-0 [&amp;_svg]:opacity-60 max-w-[138px]" data-selected-tone="normal"><span class="min-w-0 flex-1 truncate text-left">GPT-5.6 中</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevrons-up-down size-3" aria-hidden="true"><path d="m7 15 5 5 5-5"></path><path d="m7 9 5-5 5 5"></path></svg></button><select aria-hidden="true" tabindex="-1" style="position:absolute;border:0;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0, 0, 0, 0);white-space:nowrap;word-wrap:normal"></select><button aria-busy="true" aria-label="发送" class="send-button" data-action="send" disabled="" title="发送" type="submit"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up" aria-hidden="true"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg></button></div></div><div class="context-palette add-palette" data-od-id="control-office-add-panel" data-composer-palette="" hidden="" id="control-office-add-panel"><label class="visually-hidden" for="control-office-add-search">添加</label><input id="control-office-add-search" placeholder="添加" type="search" value=""/><div class="context-list"><section class="add-palette-group"><div class="add-palette-group-label">执行方式</div><button class="add-palette-item" data-kind="intent" data-label="目标模式" type="button"><span class="add-palette-item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-target" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg></span><span class="add-palette-item-copy"><strong>目标模式</strong><em>围绕一个目标持续推进</em></span></button><button class="add-palette-item" data-kind="intent" data-label="计划模式" type="button"><span class="add-palette-item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-list-checks" aria-hidden="true"><path d="m3 17 2 2 4-4"></path><path d="m3 7 2 2 4-4"></path><path d="M13 6h8"></path><path d="M13 12h8"></path><path d="M13 18h8"></path></svg></span><span class="add-palette-item-copy"><strong>计划模式</strong><em>先给出计划，确认后再执行</em></span></button></section><section class="add-palette-group"><div class="add-palette-group-label">文件</div><button class="add-palette-item" data-kind="file" data-label="选择文件" type="button"><span class="add-palette-item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-paperclip" aria-hidden="true"><path d="M13.234 20.252 21 12.3"></path><path d="m16 6-8.414 8.586a2 2 0 0 0 0 2.828 2 2 0 0 0 2.828 0l8.414-8.586a4 4 0 0 0 0-5.656 4 4 0 0 0-5.656 0l-8.415 8.585a6 6 0 1 0 8.486 8.486"></path></svg></span><span class="add-palette-item-copy"><strong>选择文件</strong><em>从电脑选择一个或多个文件</em></span></button><button class="add-palette-item" data-kind="folder" data-label="选择文件夹" type="button"><span class="add-palette-item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder-open" aria-hidden="true"><path d="m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2"></path></svg></span><span class="add-palette-item-copy"><strong>选择文件夹</strong><em>从电脑选择文件夹</em></span></button></section><section class="add-palette-group"><div class="add-palette-group-label">知识库</div><button class="add-palette-item" data-kind="knowledge" data-label="交付知识库" type="button"><span class="add-palette-item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open" aria-hidden="true"><path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg></span><span class="add-palette-item-copy"><strong>交付知识库</strong><em>产品资料</em></span></button></section><section class="add-palette-group"><div class="add-palette-group-label">Skill</div><button class="add-palette-item" data-kind="skill" data-label="页面审阅" type="button"><span class="add-palette-item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg></span><span class="add-palette-item-copy"><strong>页面审阅</strong><em>检查页面</em></span></button></section><section class="add-palette-group"><div class="add-palette-group-label">MCP</div><button class="add-palette-item" data-kind="mcp" data-label="Filesystem" type="button"><span class="add-palette-item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plug" aria-hidden="true"><path d="M12 22v-5"></path><path d="M9 8V2"></path><path d="M15 8V2"></path><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"></path></svg></span><span class="add-palette-item-copy"><strong>Filesystem</strong><em>读取项目文件</em></span></button></section></div></div><div class="context-palette" data-context-palette="" data-od-id="control-office-context-panel" data-composer-palette="" hidden="" id="control-office-context-panel"><label class="visually-hidden" for="control-office-context-search">搜索知识库或上下文</label><input id="control-office-context-search" placeholder="搜索知识库或上下文" type="search" value=""/><div class="context-list"><button data-context-item="" data-kind="knowledge" data-label="交付知识库" type="button"><span>知识库</span><strong>交付知识库</strong><em>产品资料</em></button></div></div><div class="slash-palette" data-od-id="control-office-slash-panel" data-composer-palette="" data-slash-palette="" hidden="" id="control-office-slash-panel"><label class="visually-hidden" for="control-office-slash-search">搜索 Skill 或 MCP</label><input id="control-office-slash-search" placeholder="搜索 Skill 或 MCP" type="search" value=""/><div class="slash-list"><button data-kind="skill" data-label="页面审阅" data-slash-item="" type="button"><span>Skill</span><strong>页面审阅</strong><em>检查页面</em></button><button data-kind="mcp" data-label="Filesystem" data-slash-item="" type="button"><span>MCP</span><strong>Filesystem</strong><em>读取项目文件</em></button></div></div><div class="composer-state-row" id="control-office-composer-status"></div></form></section></div></main>"`;
