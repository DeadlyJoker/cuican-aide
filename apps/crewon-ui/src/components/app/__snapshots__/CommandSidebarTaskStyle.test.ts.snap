// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`command sidebar task styles > keeps compact signals, hover details, and both theme palettes together 1`] = `
"/* Sidebar task signals keep full titles discoverable without widening the rail. */
.screen-shell.command-screen .sidebar-task-attention {
  justify-self: end;
  width: 5px;
  height: 5px;
  border-radius: var(--radius-pill);
  background: var(--command-task-pending);
  box-shadow:
    0 0 0 3px color-mix(in srgb, var(--command-task-pending) 13%, transparent),
    0 0 6px color-mix(in srgb, var(--command-task-pending) 24%, transparent);
}

.screen-shell.command-screen .linked-conversation-item {
  grid-template-columns: minmax(0, 1fr) auto;
}

.screen-shell.command-screen .command-sidebar-thread-row {
  position: relative;
  min-width: 0;
}

.screen-shell.command-screen .command-sidebar-thread-archive {
  position: absolute;
  top: 50%;
  right: 4px;
  z-index: 1;
  display: grid;
  width: 24px;
  height: 24px;
  padding: 0;
  place-items: center;
  border: 0;
  border-radius: var(--radius-sm);
  background: var(--command-sidebar-active);
  color: var(--n-700);
  cursor: pointer;
  opacity: 0;
  pointer-events: none;
  transform: translateY(-50%);
  transition:
    background 0.14s ease,
    color 0.14s ease,
    opacity 0.14s ease;
}

.screen-shell.command-screen .command-sidebar-thread-archive svg {
  width: 13px;
  height: 13px;
  stroke-width: 1.9;
}

.screen-shell.command-screen
  .command-sidebar-thread-row:hover
  .command-sidebar-thread-archive,
.screen-shell.command-screen
  .command-sidebar-thread-row:has(:focus-visible)
  .command-sidebar-thread-archive {
  opacity: 1;
  pointer-events: auto;
}

.screen-shell.command-screen .command-sidebar-thread-archive:hover,
.screen-shell.command-screen .command-sidebar-thread-archive:focus-visible {
  background: var(--n-100);
  color: var(--n-950);
  outline: 0;
}

.screen-shell.command-screen
  .command-sidebar-thread-row[data-has-archive="true"]:hover
  .command-thread-status,
.screen-shell.command-screen
  .command-sidebar-thread-row[data-has-archive="true"]:hover
  .command-thread-status-time,
.screen-shell.command-screen
  .command-sidebar-thread-row[data-has-archive="true"]:has(:focus-visible)
  .command-thread-status,
.screen-shell.command-screen
  .command-sidebar-thread-row[data-has-archive="true"]:has(:focus-visible)
  .command-thread-status-time {
  opacity: 0;
}

.screen-shell.command-screen .command-sidebar-thread-title {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.screen-shell.command-screen .command-thread-status {
  display: inline-flex;
  flex: 0 0 auto;
  justify-self: end;
  align-items: center;
  justify-content: center;
}

.screen-shell.command-screen
  .command-thread-status:is(
    .is-pending-unread,
    .is-completed-unread,
    .is-failed-unread
  ) {
  width: 6px;
  height: 6px;
  border-radius: var(--radius-pill);
}

.screen-shell.command-screen
  .command-thread-status:is(.is-pending-unread, .is-failed-unread) {
  background: var(--command-task-pending);
  box-shadow:
    0 0 0 3px color-mix(in srgb, var(--command-task-pending) 13%, transparent),
    0 0 6px color-mix(in srgb, var(--command-task-pending) 24%, transparent);
}

.screen-shell.command-screen .command-thread-status.is-completed-unread {
  background: var(--command-task-complete);
  box-shadow:
    0 0 0 3px color-mix(in srgb, var(--command-task-complete) 13%, transparent),
    0 0 6px color-mix(in srgb, var(--command-task-complete) 24%, transparent);
}

.screen-shell.command-screen .command-thread-status-time {
  min-width: 0;
  overflow: hidden;
  color: var(--command-sidebar-muted, var(--n-650));
  font-size: calc(10px + var(--user-ui-font-delta));
  font-style: normal;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

[data-slot="tooltip-content"].command-sidebar-thread-tooltip {
  display: grid;
  gap: 5px;
  width: min(310px, calc(100vw - 24px));
  max-width: 310px;
  padding: 10px 12px;
  border: 1px solid var(--command-task-tooltip-border);
  border-radius: 10px;
  background: var(--command-task-tooltip-bg);
  box-shadow: var(--shadow-overlay);
  color: var(--command-task-tooltip-fg);
  text-align: left;
}

[data-slot="tooltip-content"].command-sidebar-thread-tooltip strong {
  overflow-wrap: anywhere;
  font-size: calc(13px + var(--user-ui-font-delta));
  font-weight: 600;
  line-height: 1.35;
}

[data-slot="tooltip-content"].command-sidebar-thread-tooltip span {
  display: -webkit-box;
  overflow: hidden;
  color: var(--command-task-tooltip-muted);
  font-size: calc(12px + var(--user-ui-font-delta));
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

[data-slot="tooltip-content"].command-sidebar-thread-tooltip small {
  color: var(--command-task-tooltip-muted);
  font-size: calc(11px + var(--user-ui-font-delta));
  font-weight: 500;
  line-height: 1.4;
}

[data-slot="tooltip-content"].command-sidebar-thread-tooltip > svg {
  background: var(--command-task-tooltip-bg);
  fill: var(--command-task-tooltip-bg);
}

:root,
:root[data-theme="light"] {
  --command-task-pending: #d49a18;
  --command-task-complete: #349263;
  --command-task-tooltip-bg: #fffefa;
  --command-task-tooltip-border: #deddd7;
  --command-task-tooltip-fg: #272825;
  --command-task-tooltip-muted: #71736e;
}

:root[data-theme="dark"] {
  --command-task-pending: #f1c24d;
  --command-task-complete: #68cb93;
  --command-task-tooltip-bg: #4b4b4c;
  --command-task-tooltip-border: #5a5a5b;
  --command-task-tooltip-fg: #e2e2e2;
  --command-task-tooltip-muted: #b3b3b3;
}

.screen-shell.command-screen .command-task-page {
  width: min(820px, 100%);
  margin: 0 auto;
  padding: clamp(18px, 4vh, 42px) clamp(10px, 3vw, 30px);
}

.screen-shell.command-screen .command-task-page-header {
  display: grid;
  align-items: flex-start;
}

.screen-shell.command-screen .command-task-page-header p {
  max-width: none;
}

.screen-shell.command-screen .command-task-page-header .button svg {
  width: 14px;
  height: 14px;
}

.screen-shell.command-screen .command-task-page-header .button {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  white-space: nowrap;
}

.screen-shell.command-screen .command-task-page-filters {
  justify-content: flex-start;
  margin-bottom: 0;
}

.screen-shell.command-screen .command-task-page-list {
  padding: 0;
  border: 0;
  background: transparent;
}

.screen-shell.command-screen .command-task-page-list .compact-list {
  gap: 0;
}

.screen-shell.command-screen .command-task-page-row {
  grid-template-columns: 18px minmax(0, 1fr) auto;
  width: 100%;
  min-height: 64px;
  border-width: 0 0 1px;
  border-bottom: 1px solid var(--n-250);
  border-radius: 0;
  background: transparent;
  cursor: pointer;
  text-align: left;
}

.screen-shell.command-screen .command-task-page-row:hover {
  background: var(--n-75);
}

.screen-shell.command-screen .command-task-page-row:focus-visible {
  border-radius: var(--radius-sm);
  outline: 2px solid var(--command-accent);
  outline-offset: 2px;
}

.screen-shell.command-screen .command-task-page-state {
  display: inline-flex;
  min-width: 15px;
  align-items: center;
  justify-content: center;
}

.screen-shell.command-screen .command-task-page-copy {
  display: grid;
  min-width: 0;
  gap: 4px;
}

.screen-shell.command-screen .command-task-page-copy strong {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.screen-shell.command-screen .command-task-page-copy small,
.screen-shell.command-screen .command-task-page-row time {
  color: var(--n-600);
  font-size: calc(11px + var(--user-ui-font-delta));
  font-weight: 500;
}

.screen-shell.command-screen .command-task-page-row time {
  min-width: 68px;
  text-align: right;
  white-space: nowrap;
}

.screen-shell.command-screen .command-task-page-empty {
  padding: 54px 16px;
  text-align: center;
}

.screen-shell.command-screen .command-task-page-empty p {
  margin: 7px 0 0;
  color: var(--n-650);
}

@container command-canvas (max-width: 620px) {
  .screen-shell.command-screen .command-task-page {
    padding: 16px 2px;
  }

  .screen-shell.command-screen .command-task-page-header {
    align-items: stretch;
    flex-direction: column;
    gap: 16px;
  }

  .screen-shell.command-screen .command-task-page-header .button {
    align-self: flex-start;
  }

  .screen-shell.command-screen .command-task-page-row {
    grid-template-columns: 18px minmax(0, 1fr);
  }

  .screen-shell.command-screen .command-task-page-row time {
    display: none;
  }
}

/* End sidebar task signals. */"
`;
