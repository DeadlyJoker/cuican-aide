// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`plugin panels in the formal Agent shell > confines custom project navigation to the left context while preserving the central Agent and withdrawing it on plugin switch 1`] = `"<section class="command-sidebar-workspaces" aria-label="插件 B" data-plugin-sidebar="second"><nav aria-label="插件 B 目录"><button>目录 B</button></nav></section>"`;

exports[`plugin panels in the formal Agent shell > snapshots the quiet plugin header with only a title and a working close action 1`] = `"<header class="command-workbench-tabbar command-plugin-panel-header" data-desktop-drag-region=""><strong>项目产物</strong><button aria-label="关闭插件面板" class="command-workbench-close" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-panel-right" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M15 3v18"></path></svg></button></header>"`;

exports[`snapshots independent plugin page tabs alongside existing tools 1`] = `"<header class="command-workbench-tabbar command-plugin-panel-header" data-desktop-drag-region=""><div class="command-workbench-tabs" role="tablist" aria-label="插件页面"><div class="command-workbench-tab" role="tab" aria-selected="false"><button type="button">我的行程</button><button type="button" class="command-workbench-tab-close" aria-label="关闭 我的行程"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></div><div class="command-workbench-tab" role="tab" aria-selected="true" data-active="true"><button type="button">需求与方案</button><button type="button" class="command-workbench-tab-close" aria-label="关闭 需求与方案"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></div></div><button type="button" class="command-workbench-add" aria-label="新建插件页面"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></button><div class="command-workbench-tabs" role="tablist" aria-label="其他工作台页面"><button type="button" role="tab" aria-selected="false" class="command-workbench-tab">文件</button></div><button aria-label="关闭插件面板" class="command-workbench-close" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-panel-right" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M15 3v18"></path></svg></button></header>"`;
