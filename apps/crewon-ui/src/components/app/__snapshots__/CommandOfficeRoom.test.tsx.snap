exports[`CommandOfficeRoom > snapshots the compact shared empty landing without inventing office data 1`] = `"<div class="office-card-grid" data-office-list="" aria-label="办公室卡片"><div data-office-empty-state="ready"><section aria-labelledby="_R_1_" class="command-team-empty-state" data-team-empty-state="empty"><span class="command-team-empty-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-messages-square"><path d="M14 9a2 2 0 0 1-2 2H6l-4 4V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2z"></path><path d="M18 9h2a2 2 0 0 1 2 2v11l-4-4h-6a2 2 0 0 1-2-2v-1"></path></svg></span><div class="command-team-empty-copy"><span class="command-team-empty-eyebrow">办公室</span><h2 id="_R_1_">创建你的第一个办公室</h2><p>创建办公室并选择成员，就可以开始群聊和协作。</p></div><footer class="command-team-empty-footer"><span class="command-team-empty-status" role="status">当前工作空间还没有办公室</span><button class="button primary" type="button">创建办公室</button></footer></section></div></div><section class="office-room-inline team-office-runtime-room" data-office-room="" hidden="" tabindex="-1"><div class="team-office-room-loading" role="status">正在连接办公室群聊…</div></section>"`;

exports[`CommandOfficeRoom > snapshots the real-office list and mounted shared-composer room 1`] = `"<div class="office-card-grid" data-office-list="" aria-label="办公室卡片" hidden=""><button class="office-card office-card-button" data-office-open="" data-office-record-key="path:/repo/a.json" type="button"><span class="office-card-head"><span class="office-card-glyph" aria-hidden="true">同</span><strong>同名办公室</strong><em class="status success">运行中</em></span><span class="office-card-copy">组长 · 办公室主控 · 1 员工</span><span class="office-card-members" aria-label="1 名成员"><span class="office-card-member-avatars" aria-hidden="true"><i>产</i></span><span>产品组长</span><em>1 人</em></span><span class="office-card-foot"><span title="当前：核对交互">当前：核对交互</span><em>进入群聊</em></span></button><button class="office-card office-card-button is-active" data-office-open="" data-office-record-key="path:/repo/b.json" data-office-selected="true" type="button"><span class="office-card-head"><span class="office-card-glyph" aria-hidden="true">同</span><strong>同名办公室</strong><em class="status success">已完成</em></span><span class="office-card-copy">组长 · 办公室主控 · 1 员工</span><span class="office-card-members" aria-label="1 名成员"><span class="office-card-member-avatars" aria-hidden="true"><i>产</i></span><span>产品组长</span><em>1 人</em></span><span class="office-card-foot"><span title="当前：完成验收">当前：完成验收</span><em>进入群聊</em></span></button></div><section class="office-room-inline team-office-runtime-room" data-office-room="" tabindex="-1"><main class="office-workspace" aria-label="同名办公室"><form class="command-input office-global-composer office-shared-composer"><textarea id="office-message-input"></textarea></form></main></section>"`;
