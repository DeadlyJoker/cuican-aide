exports[`CommandOfficeRoom > snapshots a prominent empty landing without inventing office data 1`] = `"<div class="office-card-grid" data-office-list="" aria-label="办公室卡片"><section aria-labelledby="_R_1_" class="team-office-empty" data-office-empty-state="ready"><header class="team-office-empty-head"><span class="team-office-empty-kicker">OFFICE RUNTIME</span><h3 id="_R_1_">创建你的第一个办公室</h3><p>把组长、员工、任务执行和长期上下文放进同一个可持续协作空间。</p></header><div aria-label="办公室能力" class="team-office-capability-grid"><article class="team-office-capability"><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-square-text"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path><path d="M13 8H7"></path><path d="M17 12H7"></path></svg></span><div><strong>群聊</strong><p>向组长或指定员工发送消息，持续保留同一条协作主线。</p></div></article><article class="team-office-capability"><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-list-checks"><path d="m3 17 2 2 4-4"></path><path d="m3 7 2 2 4-4"></path><path d="M13 6h8"></path><path d="M13 12h8"></path><path d="M13 18h8"></path></svg></span><div><strong>执行台</strong><p>查看排队、执行、确认与完成状态，保持任务进度可追踪。</p></div></article><article class="team-office-capability"><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-brain-circuit"><path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"></path><path d="M9 13a4.5 4.5 0 0 0 3-4"></path><path d="M6.003 5.125A3 3 0 0 0 6.401 6.5"></path><path d="M3.477 10.896a4 4 0 0 1 .585-.396"></path><path d="M6 18a4 4 0 0 1-1.967-.516"></path><path d="M12 13h4"></path><path d="M12 18h6a2 2 0 0 1 2 2v1"></path><path d="M12 8h8"></path><path d="M16 8V5a2 2 0 0 1 2-2"></path><circle cx="16" cy="13" r=".5"></circle><circle cx="18" cy="3" r=".5"></circle><circle cx="20" cy="21" r=".5"></circle><circle cx="20" cy="8" r=".5"></circle></svg></span><div><strong>记忆与上下文</strong><p>沉淀办公室范围内的事实、偏好和决策，并控制可见边界。</p></div></article></div><footer class="team-office-empty-footer"><span class="team-office-connection-state" data-state="ready" role="status">当前工作空间还没有办公室</span><button class="button primary" type="button">创建办公室</button></footer></section></div><section class="office-room-inline team-office-runtime-room" data-office-room="" hidden="" tabindex="-1"><div class="team-office-room-loading" role="status">正在连接办公室运行态…</div></section>"`;

exports[`CommandOfficeRoom > snapshots the real-office list and mounted shared-composer room 1`] = `"<div class="office-card-grid" data-office-list="" aria-label="办公室卡片" hidden=""><button class="office-card office-card-button" data-office-open="" data-office-record-key="path:/repo/a.json" type="button"><span class="office-card-head"><strong>同名办公室</strong><em class="status success">运行中</em></span><span class="office-card-copy">组长 · 办公室主控 · 1 员工</span><span class="office-card-foot"><span title="当前：核对交互">当前：核对交互</span><em>进入群聊</em></span></button><button class="office-card office-card-button is-active" data-office-open="" data-office-record-key="path:/repo/b.json" data-office-selected="true" type="button"><span class="office-card-head"><strong>同名办公室</strong><em class="status success">已完成</em></span><span class="office-card-copy">组长 · 办公室主控 · 1 员工</span><span class="office-card-foot"><span title="当前：完成验收">当前：完成验收</span><em>进入群聊</em></span></button></div><section class="office-room-inline team-office-runtime-room" data-office-room="" tabindex="-1"><main class="office-workspace" aria-label="同名办公室"><form class="command-input office-global-composer office-shared-composer"><textarea id="office-message-input"></textarea></form></main></section>"`;
