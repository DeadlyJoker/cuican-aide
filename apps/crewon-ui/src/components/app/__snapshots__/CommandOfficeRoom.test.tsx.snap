exports[`CommandOfficeRoom > opens a Control Office as a real group chat 1`] = `"<div class="office-card-grid" data-office-list="" aria-label="办公室卡片" hidden=""><button class="office-card office-card-button is-active" data-office-open="" data-office-record-key="record:office-version-1" data-office-selected="true" type="button"><span class="office-card-head"><span class="office-card-glyph" aria-hidden="true">发</span><strong>发布办公室</strong><em class="status">已发布</em></span><span class="office-card-copy">组长 · 办公室组长 · 1 名成员</span><span class="office-card-members" aria-label="1 名成员"><span class="office-card-member-avatars" aria-hidden="true"><i>办</i></span><span>办公室组长</span><em>1 人</em></span><span class="office-card-foot"><span title="可开始群聊">可开始群聊</span><em>进入群聊</em></span></button></div><section class="office-room-inline team-office-runtime-room" data-office-room="" tabindex="-1"><main data-control-office-chat="">办公室群聊</main></section>"`;

