// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CommandOfficeRoom > mounts the unavailable Office landing through the Team view 1`] = `"<section class="shell-view shell-page-view active" data-filter-scope="" data-od-id="shell-view-team" data-shell-view="team"><div class="page-stack" data-filter-scope=""><header class="catalog-market-header function-market-header" data-od-id="team-header-inline"><div class="catalog-mode-tabs" role="group" aria-label="团队视图筛选"><button aria-pressed="true" class="filter-chip mode-tab active" data-filter="office" data-filter-group="team-mode" type="button"><span>办公室</span></button><button aria-pressed="false" class="filter-chip mode-tab" data-filter="workflow" data-filter-group="team-mode" type="button"><span>协作流</span></button><button aria-pressed="false" class="filter-chip mode-tab" data-filter="experts" data-filter-group="team-mode" type="button"><span>专家</span></button></div><div class="catalog-header-actions"><label class="catalog-search" aria-label="搜索办公室"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg><input placeholder="搜索办公室、目标或成员" type="search" value=""/></label><button class="button" type="button">同步真实数据</button><button class="button primary" type="button" data-team-action="office">创建办公室</button></div></header><section class="team-office-shell" data-card-filter="office" data-office-shell="" data-od-id="team-office-shell"><div class="office-card-grid" data-office-list="" aria-label="办公室卡片"><section aria-labelledby="_R_a_" class="team-office-empty" data-office-empty-state="unavailable"><header class="team-office-empty-head"><span class="team-office-empty-kicker">CONTROL OFFICE</span><h3 id="_R_a_">Office 定义暂不可用</h3><p>Control Office 定义暂时无法读取，系统会自动重试；不会使用演示数据替代。</p></header><footer class="team-office-empty-footer"><span class="team-office-connection-state" data-state="unavailable" role="status">等待自动重试</span><button class="button" type="button">立即重试</button></footer></section></div><section class="office-room-inline team-office-runtime-room" data-office-room="" hidden="" tabindex="-1"><div class="team-office-room-loading" role="status">正在读取 Office 定义…</div></section></section><section class="team-workflow-shell" data-card-filter="workflow" data-od-id="team-workflow-shell" data-workflow-shell="" hidden=""><section class="team-office-empty team-capability-live-empty"><h2>协作流服务暂不可用</h2><p>CrewON Control 未提供 Workflow authority。</p></section></section><section class="team-experts-shell" data-card-filter="experts" hidden=""><header class="team-experts-header"><div><span>Agent roster</span><h2>团队专家</h2><p>来自真实 Agent 配置目录，可用于办公室成员和协作流执行。</p></div><strong>0</strong></header><div class="agent-grid team-expert-grid"></div><section class="team-office-empty team-capability-live-empty"><h2>暂无已发布专家</h2><p>先在智能体目录创建并发布 Agent，再把它加入办公室。</p></section></section><div id="team-log" class="sr-log" aria-live="polite"></div></div></section>"`;

exports[`CommandOfficeRoom > presents a Control Office as a published definition without runtime claims 1`] = `"<div class="office-card-grid" data-office-list="" aria-label="办公室卡片"><button class="office-card office-card-button" data-office-open="" data-office-record-key="record:office-version-1" type="button"><span class="office-card-head"><span class="office-card-glyph" aria-hidden="true">发</span><strong>发布办公室</strong><em class="status">已发布</em></span><span class="office-card-copy">Control 定义 · 1 名成员</span><span class="office-card-foot"><span title="通过 Workflow 显式委派">通过 Workflow 显式委派</span><em>查看与委派</em></span></button></div><section class="office-room-inline team-office-runtime-room" data-office-room="" hidden="" tabindex="-1"><div class="team-office-room-loading" role="status">正在读取 Office 定义…</div></section>"`;

exports[`CommandOfficeRoom > shows honest unavailable states instead of fake workflow and expert data 1`] = `"<section class="shell-view shell-page-view active" data-filter-scope="" data-od-id="shell-view-team" data-shell-view="team"><div class="page-stack" data-filter-scope=""><header class="catalog-market-header function-market-header" data-od-id="team-header-inline"><div class="catalog-mode-tabs" role="group" aria-label="团队视图筛选"><button aria-pressed="false" class="filter-chip mode-tab" data-filter="office" data-filter-group="team-mode" type="button"><span>办公室</span></button><button aria-pressed="true" class="filter-chip mode-tab active" data-filter="workflow" data-filter-group="team-mode" type="button"><span>协作流</span></button><button aria-pressed="false" class="filter-chip mode-tab" data-filter="experts" data-filter-group="team-mode" type="button"><span>专家</span></button></div><div class="catalog-header-actions"><button class="button" type="button" disabled="" hidden="">同步真实数据</button><button class="button primary" type="button" data-team-action="office" disabled="" hidden="">创建办公室</button></div></header><section class="team-workflow-shell" data-card-filter="workflow" data-od-id="team-workflow-shell" data-workflow-shell=""><section class="team-office-empty team-capability-live-empty"><h2>协作流服务暂不可用</h2><p>CrewON Control 未提供 Workflow authority。</p></section></section><section class="team-experts-shell" data-card-filter="experts" hidden=""><header class="team-experts-header"><div><span>Agent roster</span><h2>团队专家</h2><p>来自真实 Agent 配置目录，可用于办公室成员和协作流执行。</p></div><strong>0</strong></header><div class="agent-grid team-expert-grid"></div><section class="team-office-empty team-capability-live-empty"><h2>暂无已发布专家</h2><p>先在智能体目录创建并发布 Agent，再把它加入办公室。</p></section></section><div id="team-log" class="sr-log" aria-live="polite"></div></div></section>"`;

exports[`CommandOfficeRoom > snapshots a published-definition landing without inventing runtime capabilities 1`] = `"<div class="office-card-grid" data-office-list="" aria-label="办公室卡片"><section aria-labelledby="_R_1_" class="team-office-empty" data-office-empty-state="ready"><header class="team-office-empty-head"><span class="team-office-empty-kicker">CONTROL OFFICE</span><h3 id="_R_1_">创建第一个 Office 定义</h3><p>发布成员与 AgentVersion 的固定边界，再通过显式 Workflow 委派启动 canonical Run。</p></header><div aria-label="Office 定义边界" class="team-office-capability-grid"><article class="team-office-capability"><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></span><div><strong>成员边界</strong><p>固定成员身份与显示名称，不推断在线或运行状态。</p></div></article><article class="team-office-capability"><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg></span><div><strong>AgentVersion 绑定</strong><p>成员绑定已发布 AgentVersion，Control 保留版本与权限边界。</p></div></article><article class="team-office-capability"><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-git-branch"><line x1="6" x2="6" y1="3" y2="15"></line><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 9a9 9 0 0 1-9 9"></path></svg></span><div><strong>Workflow 委派</strong><p>查看定义后显式选择 WorkflowVersion，启动 canonical Run。</p></div></article></div><footer class="team-office-empty-footer"><span class="team-office-connection-state" data-state="ready" role="status">当前空间还没有 Office 定义</span><button class="button primary" type="button">创建办公室</button></footer></section></div><section class="office-room-inline team-office-runtime-room" data-office-room="" hidden="" tabindex="-1"><div class="team-office-room-loading" role="status">正在读取 Office 定义…</div></section>"`;

exports[`CommandOfficeRoom > snapshots the real-office list and mounted shared-composer room 1`] = `"<div class="office-card-grid" data-office-list="" aria-label="办公室卡片" hidden=""><button class="office-card office-card-button" data-office-open="" data-office-record-key="path:/repo/a.json" type="button"><span class="office-card-head"><span class="office-card-glyph" aria-hidden="true">同</span><strong>同名办公室</strong><em class="status success">运行中</em></span><span class="office-card-copy">组长 · 办公室主控 · 1 员工</span><span class="office-card-foot"><span title="当前：核对交互">当前：核对交互</span><em>进入群聊</em></span></button><button class="office-card office-card-button is-active" data-office-open="" data-office-record-key="path:/repo/b.json" data-office-selected="true" type="button"><span class="office-card-head"><span class="office-card-glyph" aria-hidden="true">同</span><strong>同名办公室</strong><em class="status success">已完成</em></span><span class="office-card-copy">组长 · 办公室主控 · 1 员工</span><span class="office-card-foot"><span title="当前：完成验收">当前：完成验收</span><em>进入群聊</em></span></button></div><section class="office-room-inline team-office-runtime-room" data-office-room="" tabindex="-1"><main class="office-workspace" aria-label="同名办公室"><form class="command-input office-global-composer office-shared-composer"><textarea id="office-message-input"></textarea></form></main></section>"`;
