// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CommandOfficeRoom > keeps Experts as a leader single-chat catalog independent from Office records 1`] = `"<section class="shell-view shell-page-view active" data-filter-scope="" data-od-id="shell-view-team" data-shell-view="team"><div class="page-stack" data-filter-scope=""><header class="catalog-market-header function-market-header" data-od-id="team-header-inline"><div class="catalog-mode-tabs" role="group" aria-label="团队视图筛选"><button aria-pressed="false" class="filter-chip mode-tab" data-filter="office" data-filter-group="team-mode" type="button"><span>办公室</span></button><button aria-pressed="false" class="filter-chip mode-tab" data-filter="workflow" data-filter-group="team-mode" type="button"><span>协作流</span></button><button aria-pressed="true" class="filter-chip mode-tab active" data-filter="experts" data-filter-group="team-mode" type="button"><span>专家团</span></button></div><div class="catalog-header-actions"><button class="button" type="button" disabled="" hidden="">同步真实数据</button><button class="button primary" type="button" data-team-action="office" disabled="" hidden="">创建办公室</button><button class="button primary" type="button" data-team-action="experts" disabled="">创建专家团</button></div></header><section class="team-workflow-shell" data-card-filter="workflow" data-od-id="team-workflow-shell" data-workflow-shell="" hidden=""><section class="team-office-empty team-capability-live-empty"><span class="team-office-empty-kicker">CrewON Workflow</span><h2>当前工作空间还没有协作流</h2><p>协作流由 CrewON 保存和编排，本地 Agent 持久线程负责执行具体节点。</p><button class="button" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-cw" aria-hidden="true"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg>重新同步</button></section></section><section class="team-experts-shell" data-card-filter="experts" data-od-id="team-experts-shell"><section class="expert-team-grid" aria-label="专家团"><article class="expert-team-card"><div class="catalog-card-head"><span>单聊执行目标</span><strong>代码审阅专家团</strong></div><p>由团长汇总审阅结论。</p><div class="expert-member-stack"><span title="分派审阅并汇总结论">团长：审阅团长 · 分派审阅并汇总结论</span><span title="定位风险">探索专家：风险专家 · 定位风险</span></div><button class="button primary compact" type="button">进入团长单聊<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg></button></article></section></section><div id="team-log" class="sr-log" aria-live="polite"></div></div></section>"`;

exports[`CommandOfficeRoom > mounts the unavailable Office landing through the Team view 1`] = `"<section class="shell-view shell-page-view active" data-filter-scope="" data-od-id="shell-view-team" data-shell-view="team"><div class="page-stack" data-filter-scope=""><header class="catalog-market-header function-market-header" data-od-id="team-header-inline"><div class="catalog-mode-tabs" role="group" aria-label="团队视图筛选"><button aria-pressed="true" class="filter-chip mode-tab active" data-filter="office" data-filter-group="team-mode" type="button"><span>办公室</span></button><button aria-pressed="false" class="filter-chip mode-tab" data-filter="workflow" data-filter-group="team-mode" type="button"><span>协作流</span></button><button aria-pressed="false" class="filter-chip mode-tab" data-filter="experts" data-filter-group="team-mode" type="button"><span>专家团</span></button></div><div class="catalog-header-actions"><label class="catalog-search" aria-label="搜索办公室"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg><input placeholder="搜索办公室、目标或成员" type="search" value=""/></label><button class="button" type="button">同步真实数据</button><button class="button primary" type="button" data-team-action="office">创建办公室</button><button class="button primary" type="button" data-team-action="experts" disabled="" hidden="">创建专家团</button></div></header><section class="team-office-shell" data-card-filter="office" data-office-shell="" data-od-id="team-office-shell"><div class="office-card-grid" data-office-list="" aria-label="办公室卡片"><section aria-labelledby="_R_a_" class="team-office-empty" data-office-empty-state="unavailable"><header class="team-office-empty-head"><span class="team-office-empty-kicker">OFFICE RUNTIME</span><h3 id="_R_a_">办公室运行态正在恢复</h3><p>当前工作空间的办公室数据暂时无法读取，系统会自动重试；不会使用演示数据替代。</p></header><div aria-label="办公室能力" class="team-office-capability-grid"><article class="team-office-capability"><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-square-text"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path><path d="M13 8H7"></path><path d="M17 12H7"></path></svg></span><div><strong>群聊</strong><p>向组长或指定员工发送消息，持续保留同一条协作主线。</p></div></article><article class="team-office-capability"><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-list-checks"><path d="m3 17 2 2 4-4"></path><path d="m3 7 2 2 4-4"></path><path d="M13 6h8"></path><path d="M13 12h8"></path><path d="M13 18h8"></path></svg></span><div><strong>任务协作</strong><p>通过群聊 @ 组长或员工派发、跟进和确认任务，保持结果可追踪。</p></div></article><article class="team-office-capability"><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-brain-circuit"><path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"></path><path d="M9 13a4.5 4.5 0 0 0 3-4"></path><path d="M6.003 5.125A3 3 0 0 0 6.401 6.5"></path><path d="M3.477 10.896a4 4 0 0 1 .585-.396"></path><path d="M6 18a4 4 0 0 1-1.967-.516"></path><path d="M12 13h4"></path><path d="M12 18h6a2 2 0 0 1 2 2v1"></path><path d="M12 8h8"></path><path d="M16 8V5a2 2 0 0 1 2-2"></path><circle cx="16" cy="13" r=".5"></circle><circle cx="18" cy="3" r=".5"></circle><circle cx="20" cy="21" r=".5"></circle><circle cx="20" cy="8" r=".5"></circle></svg></span><div><strong>记忆与上下文</strong><p>沉淀办公室范围内的事实、偏好和决策，并控制可见边界。</p></div></article></div><footer class="team-office-empty-footer"><span class="team-office-connection-state" data-state="unavailable" role="status">等待自动重试</span><button class="button" type="button">立即重试</button></footer></section></div><section class="office-room-inline team-office-runtime-room" data-office-room="" hidden="" tabindex="-1"><div class="team-office-room-loading" role="status">正在连接办公室运行态…</div></section></section><section class="team-workflow-shell" data-card-filter="workflow" data-od-id="team-workflow-shell" data-workflow-shell="" hidden=""><section class="team-office-empty team-capability-live-empty"><span class="team-office-empty-kicker">CrewON Workflow</span><h2>当前工作空间还没有协作流</h2><p>协作流由 CrewON 保存和编排，本地 Agent 持久线程负责执行具体节点。</p><button class="button" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-cw" aria-hidden="true"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg>重新同步</button></section></section><section class="team-experts-shell" data-card-filter="experts" data-od-id="team-experts-shell" hidden=""><section class="team-office-empty team-capability-live-empty"><span class="team-office-empty-kicker">团长单聊 · 后台协作</span><h2>还没有专家团</h2><p>创建后由团长承接你的消息，探索与执行专家只在后台向团长汇报。</p></section></section><div id="team-log" class="sr-log" aria-live="polite"></div></div></section>"`;

exports[`CommandOfficeRoom > shows honest unavailable states instead of fake workflow and expert data 1`] = `"<section class="shell-view shell-page-view active" data-filter-scope="" data-od-id="shell-view-team" data-shell-view="team"><div class="page-stack" data-filter-scope=""><header class="catalog-market-header function-market-header" data-od-id="team-header-inline"><div class="catalog-mode-tabs" role="group" aria-label="团队视图筛选"><button aria-pressed="false" class="filter-chip mode-tab" data-filter="office" data-filter-group="team-mode" type="button"><span>办公室</span></button><button aria-pressed="true" class="filter-chip mode-tab active" data-filter="workflow" data-filter-group="team-mode" type="button"><span>协作流</span></button><button aria-pressed="false" class="filter-chip mode-tab" data-filter="experts" data-filter-group="team-mode" type="button"><span>专家团</span></button></div><div class="catalog-header-actions"><button class="button" type="button" disabled="" hidden="">同步真实数据</button><button class="button primary" type="button" data-team-action="workflow">创建协作流</button><button class="button primary" type="button" data-team-action="office" disabled="" hidden="">创建办公室</button><button class="button primary" type="button" data-team-action="experts" disabled="" hidden="">创建专家团</button></div></header><section class="team-workflow-shell" data-card-filter="workflow" data-od-id="team-workflow-shell" data-workflow-shell=""><section class="team-office-empty team-capability-live-empty"><span class="team-office-empty-kicker">CrewON Workflow</span><h2>协作流服务暂不可用</h2><p>当前只读取 CrewON Control 协作流，请检查 Control 连接后重试。</p><button class="button" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-cw" aria-hidden="true"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg>重新同步</button></section></section><section class="team-experts-shell" data-card-filter="experts" data-od-id="team-experts-shell" hidden=""><section class="team-office-empty team-capability-live-empty"><span class="team-office-empty-kicker">团长单聊 · 后台协作</span><h2>还没有专家团</h2><p>创建后由团长承接你的消息，探索与执行专家只在后台向团长汇报。</p></section></section><div id="team-log" class="sr-log" aria-live="polite"></div></div></section>"`;

exports[`CommandOfficeRoom > snapshots a prominent empty landing without inventing office data 1`] = `"<div class="office-card-grid" data-office-list="" aria-label="办公室卡片"><section aria-labelledby="_R_1_" class="team-office-empty" data-office-empty-state="ready"><header class="team-office-empty-head"><span class="team-office-empty-kicker">OFFICE RUNTIME</span><h3 id="_R_1_">创建你的第一个办公室</h3><p>把组长、员工、群聊协作和长期上下文放进同一个可持续协作空间。</p></header><div aria-label="办公室能力" class="team-office-capability-grid"><article class="team-office-capability"><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-square-text"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path><path d="M13 8H7"></path><path d="M17 12H7"></path></svg></span><div><strong>群聊</strong><p>向组长或指定员工发送消息，持续保留同一条协作主线。</p></div></article><article class="team-office-capability"><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-list-checks"><path d="m3 17 2 2 4-4"></path><path d="m3 7 2 2 4-4"></path><path d="M13 6h8"></path><path d="M13 12h8"></path><path d="M13 18h8"></path></svg></span><div><strong>任务协作</strong><p>通过群聊 @ 组长或员工派发、跟进和确认任务，保持结果可追踪。</p></div></article><article class="team-office-capability"><span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-brain-circuit"><path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"></path><path d="M9 13a4.5 4.5 0 0 0 3-4"></path><path d="M6.003 5.125A3 3 0 0 0 6.401 6.5"></path><path d="M3.477 10.896a4 4 0 0 1 .585-.396"></path><path d="M6 18a4 4 0 0 1-1.967-.516"></path><path d="M12 13h4"></path><path d="M12 18h6a2 2 0 0 1 2 2v1"></path><path d="M12 8h8"></path><path d="M16 8V5a2 2 0 0 1 2-2"></path><circle cx="16" cy="13" r=".5"></circle><circle cx="18" cy="3" r=".5"></circle><circle cx="20" cy="21" r=".5"></circle><circle cx="20" cy="8" r=".5"></circle></svg></span><div><strong>记忆与上下文</strong><p>沉淀办公室范围内的事实、偏好和决策，并控制可见边界。</p></div></article></div><footer class="team-office-empty-footer"><span class="team-office-connection-state" data-state="ready" role="status">当前工作空间还没有办公室</span><button class="button primary" type="button">创建办公室</button></footer></section></div><section class="office-room-inline team-office-runtime-room" data-office-room="" hidden="" tabindex="-1"><div class="team-office-room-loading" role="status">正在连接办公室运行态…</div></section>"`;

exports[`CommandOfficeRoom > snapshots the real-office list and mounted shared-composer room 1`] = `"<div class="office-card-grid" data-office-list="" aria-label="办公室卡片" hidden=""><button class="office-card office-card-button" data-office-open="" data-office-record-key="path:/repo/a.json" type="button"><span class="office-card-head"><span class="office-card-glyph" aria-hidden="true">同</span><strong>同名办公室</strong><em class="status success">运行中</em></span><span class="office-card-copy">组长 · 办公室主控 · 1 员工</span><span class="office-card-foot"><span title="当前：核对交互">当前：核对交互</span><em>进入群聊</em></span></button><button class="office-card office-card-button is-active" data-office-open="" data-office-record-key="path:/repo/b.json" data-office-selected="true" type="button"><span class="office-card-head"><span class="office-card-glyph" aria-hidden="true">同</span><strong>同名办公室</strong><em class="status success">已完成</em></span><span class="office-card-copy">组长 · 办公室主控 · 1 员工</span><span class="office-card-foot"><span title="当前：完成验收">当前：完成验收</span><em>进入群聊</em></span></button></div><section class="office-room-inline team-office-runtime-room" data-office-room="" tabindex="-1"><main class="office-workspace" aria-label="同名办公室"><form class="command-input office-global-composer office-shared-composer"><textarea id="office-message-input"></textarea></form></main></section>"`;
