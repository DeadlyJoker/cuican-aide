// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`command workspace conversation style > snapshots resource tags and the command file picker contract 1`] = `
"/* Resource attachments stay compact in the composer, while Skill and MCP remain visible in the sent message. */
.composer-resource-tags {
  display: flex;
  min-width: 0;
  flex-wrap: wrap;
  gap: 7px;
}

.command-input > .composer-resource-tags {
  padding: 14px 14px 0;
}

.command-input:has(> .composer-resource-tags) textarea {
  min-height: 62px;
  padding-top: 9px;
}

.screen-shell.command-screen
  .command-input:has(> .composer-resource-tags)
  textarea {
  height: 62px;
  min-height: 62px;
  max-height: 120px;
  padding-top: 9px;
}

.composer-resource-tag {
  display: inline-flex;
  max-width: min(100%, 320px);
  min-height: 28px;
  align-items: center;
  gap: 6px;
  padding: 4px 8px;
  border: 1px solid var(--n-300);
  border-radius: var(--radius-md);
  background: var(--n-50);
  color: var(--n-850);
  font-size: calc(12px + var(--user-ui-font-delta));
  line-height: 1;
}

.composer-resource-tag > svg {
  width: 14px;
  height: 14px;
  flex: 0 0 auto;
}

.composer-resource-tag > small {
  color: var(--n-700);
  font-size: calc(10px + var(--user-ui-font-delta));
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.composer-resource-tag > strong {
  min-width: 0;
  overflow: hidden;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.composer-resource-tag > button {
  display: inline-grid;
  width: 18px;
  height: 18px;
  flex: 0 0 auto;
  place-items: center;
  padding: 0;
  border: 0;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--n-700);
  cursor: pointer;
}

.composer-resource-tag > button:hover {
  background: var(--n-200);
  color: var(--n-900);
}

.composer-resource-tag > button svg {
  width: 12px;
  height: 12px;
}

.composer-resource-tag[data-resource-kind="file"] {
  border-color: oklch(86% 0.04 245);
  background: var(--n-75);
  color: oklch(39% 0.07 245);
}

.composer-resource-tag[data-resource-kind="folder"] {
  border-color: oklch(86% 0.045 85);
  background: var(--n-75);
  color: oklch(40% 0.07 75);
}

.composer-resource-tag[data-resource-kind="image"] {
  border-color: oklch(87% 0.045 315);
  background: var(--n-75);
  color: oklch(42% 0.075 315);
}

.composer-resource-tag[data-resource-kind="knowledge"] {
  border-color: oklch(86% 0.04 205);
  background: var(--n-75);
  color: oklch(39% 0.07 205);
}

.composer-resource-tag[data-resource-kind="skill"] {
  border-color: oklch(86% 0.045 275);
  background: var(--n-75);
  color: oklch(40% 0.08 275);
}

.composer-resource-tag[data-resource-kind="mcp"] {
  border-color: oklch(85% 0.045 155);
  background: var(--n-75);
  color: oklch(38% 0.07 155);
}

.message-body > .composer-resource-tags {
  margin-top: 8px;
}

/* Command workspace keeps the CrewON conversation beside a Codex-style workbench. */
.command-shell-route {
  /* Anchors the collapsed capability trigger, which floats rather than
   * occupying a grid column. */
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  width: 100vw;
  height: 100vh;
  height: 100dvh;
  overflow: hidden;
  background: var(--n-25);
  transition: grid-template-columns 180ms ease;
}

.command-shell-route[data-capability-sidebar-open="true"] {
  grid-template-columns: minmax(0, 1fr) auto;
}

.command-shell-route > .screen-shell.command-screen {
  width: auto;
  max-width: 100%;
  min-width: 0;
}

.command-shell-route > .screen-shell.command-screen .command-window {
  width: 100%;
  min-width: 0;
}

.command-capability-sidebar {
  position: relative;
  z-index: 30;
  display: grid;
  min-width: 0;
  height: 100vh;
  height: 100dvh;
  grid-template-rows: 44px minmax(0, 1fr);
  overflow: hidden;
  border-left: 1px solid var(--n-300);
  background: var(--n-25);
  box-shadow: none;
}

.command-capability-sidebar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 0 8px 0 13px;
  border-bottom: 1px solid var(--n-250);
}

.command-capability-sidebar-header strong {
  min-width: 0;
  overflow: hidden;
  color: var(--n-950);
  font-size: calc(13px + var(--user-ui-font-delta));
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.command-capability-sidebar-close {
  flex: 0 0 auto;
  width: 30px;
  height: 30px;
  border: 0;
  background: transparent;
}

.command-capability-sidebar-close svg {
  transform: scaleX(-1);
}

/*
 * Collapsed means gone, not narrow. Reserving a 44px column left a permanent
 * strip beside the canvas that read as an unfinished panel rather than a
 * closed one, so the column collapses and the trigger floats over the canvas
 * instead of occupying layout.
 */
.command-shell-route[data-capability-sidebar-open="false"] {
  grid-template-columns: minmax(0, 1fr) 46px;
}

.command-workbench-activity {
  z-index: 30;
  display: flex;
  width: 46px;
  height: 100%;
  flex-direction: column;
  align-items: center;
  gap: 5px;
  padding: 12px 5px;
  border-left: 1px solid var(--n-250);
  background: var(--n-50);
}

.command-workbench-activity button {
  display: grid;
  width: 34px;
  height: 34px;
  place-items: center;
  border: 0;
  border-radius: 9px;
  background: transparent;
  color: var(--n-650);
  cursor: pointer;
}

.command-workbench-activity button:hover,
.command-workbench-activity button:focus-visible {
  background: var(--n-150);
  color: var(--n-950);
  outline: 0;
}

.command-workbench-activity svg {
  width: 18px;
  height: 18px;
  stroke-width: 1.75;
}

.command-capability-sidebar .capability-dock {
  position: static;
  display: grid;
  grid-template-rows: auto minmax(0, 1fr);
  width: 100%;
  min-height: 0;
  gap: 0;
  overflow: hidden;
  padding: 0;
}

.command-capability-sidebar .capability-tool-tabs {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 2px;
  min-height: 38px;
  padding: 4px 8px;
  border-bottom: 1px solid var(--n-250);
}

.command-capability-sidebar .capability-tool-tabs > button {
  display: inline-grid;
  width: 28px;
  min-width: 28px;
  height: 28px;
  place-items: center;
  padding: 0;
  border: 1px solid transparent;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--n-750);
}

.command-capability-sidebar .capability-tool-tabs > button:hover,
.command-capability-sidebar .capability-tool-tabs > button:focus-visible,
.command-capability-sidebar .capability-tool-tabs > button[data-active="true"] {
  border-color: var(--n-300);
  background: var(--n-150);
  color: var(--n-950);
  outline: 0;
}

.command-capability-sidebar .capability-tool-tabs .capability-label {
  display: inline-grid;
  width: 100%;
  height: 100%;
  place-items: center;
  overflow: hidden;
  font-size: 0;
}

.command-capability-sidebar .capability-tool-tabs svg {
  width: 16px;
  height: 16px;
  stroke-width: 1.75;
}

.command-capability-sidebar .capability-tool-tabs kbd {
  display: none;
}

.command-capability-sidebar .capability-dock-content {
  min-height: 0;
  overflow: auto;
  overscroll-behavior: contain;
}

.command-capability-sidebar .capability-result {
  display: grid;
  max-height: none;
  gap: 11px;
  margin: 0;
  padding: 10px 12px 20px;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--n-900);
  font-size: calc(12px + var(--user-ui-font-delta));
}

.command-capability-sidebar .capability-result-header {
  display: grid;
  align-items: start;
  justify-content: stretch;
  gap: 0;
  padding: 0 2px 8px;
  border-bottom: 0;
}

.command-capability-sidebar .capability-result-header strong {
  display: none;
}

.command-capability-sidebar .capability-result-header span {
  color: var(--n-700);
  font-size: calc(11px + var(--user-ui-font-delta));
  line-height: 1.35;
}

.command-capability-sidebar .capability-result-summary {
  margin: -2px 2px 0;
  color: var(--n-750);
  font-size: calc(12px + var(--user-ui-font-delta));
  line-height: 1.5;
  white-space: pre-wrap;
}

.command-capability-sidebar .capability-command-form input,
.command-capability-sidebar .capability-field-list input,
.command-capability-sidebar .capability-field-list select {
  height: 32px;
  border: 1px solid var(--n-300);
  border-radius: var(--radius-sm);
  background: var(--n-25);
  color: var(--n-900);
}

.command-capability-sidebar .capability-field-list {
  gap: 9px;
}

.command-capability-sidebar .capability-field-list label {
  gap: 5px;
}

.command-capability-sidebar .capability-field-list span {
  color: var(--n-700);
  font-size: calc(11px + var(--user-ui-font-delta));
}

.command-capability-sidebar .capability-result-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 6px;
}

.command-capability-sidebar .capability-command-form button,
.command-capability-sidebar .capability-result-actions button {
  flex: 0 0 auto;
  height: 30px;
  padding: 0 10px;
  border: 1px solid var(--n-300);
  border-radius: var(--radius-sm);
  background: var(--n-100);
  color: var(--n-900);
  font-size: calc(12px + var(--user-ui-font-delta));
  white-space: nowrap;
}

.command-capability-sidebar .capability-result-actions button:hover,
.command-capability-sidebar .capability-result-actions button:focus-visible,
.command-capability-sidebar .capability-command-form button:hover,
.command-capability-sidebar .capability-command-form button:focus-visible {
  border-color: var(--n-400);
  background: var(--n-200);
  outline: 0;
}

.command-capability-sidebar .capability-result-output {
  max-height: none;
  padding: 10px 11px;
  border: 1px solid var(--n-250);
  border-radius: var(--radius-sm);
  background: var(--n-75);
  color: var(--n-900);
}

.command-capability-sidebar
  .capability-result:is(
    [data-panel-kind="terminal"],
    [data-panel-kind="review"]
  )
  .capability-result-output {
  max-height: calc(100dvh - 248px);
  overflow: auto;
  border-color: var(--n-250);
  background: var(--n-75);
  color: var(--n-900);
  overscroll-behavior: contain;
}

.command-capability-sidebar .capability-result-list {
  gap: 0;
  margin: 0;
  padding: 3px;
  border: 1px solid var(--n-250);
  border-radius: var(--radius-md);
  background: var(--n-25);
}

.command-capability-sidebar .capability-result-item {
  display: grid;
  grid-template-columns: 18px minmax(0, 1fr);
  width: 100%;
  min-height: 32px;
  align-items: center;
  gap: 6px;
  padding: 3px 7px;
  border: 0;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--n-900);
  font-family: inherit;
  font-size: calc(12px + var(--user-ui-font-delta));
  text-decoration: none;
}

.command-capability-sidebar .capability-result-item:hover,
.command-capability-sidebar .capability-result-item:focus-visible {
  background: var(--n-150);
  color: var(--n-1000);
  outline: 0;
  text-decoration: none;
}

.command-capability-sidebar .capability-result-item.is-static {
  grid-template-columns: 18px minmax(0, 1fr);
}

.command-capability-sidebar
  .capability-result-item:not([data-has-icon="true"]) {
  grid-template-columns: minmax(0, 1fr);
}

.command-capability-sidebar
  .capability-result-item.is-static:not([data-has-icon="true"]) {
  grid-template-columns: minmax(0, 1fr);
}

.command-capability-sidebar .capability-result-item-icon {
  display: grid;
  color: var(--n-700);
  place-items: center;
}

.command-capability-sidebar .capability-result-item-icon svg {
  width: 14px;
  height: 14px;
  stroke-width: 1.6;
}

.command-capability-sidebar
  .capability-result[data-panel-kind="files"]
  .capability-result-item-icon {
  color: var(--n-700);
}

.command-capability-sidebar .capability-result-item-label {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

:root[data-theme="light"] .command-capability-sidebar .capability-result-item {
  background: transparent;
  color: oklch(31% 0 0);
}

:root[data-theme="light"]
  .command-capability-sidebar
  .capability-result-item:hover,
:root[data-theme="light"]
  .command-capability-sidebar
  .capability-result-item:focus-visible {
  background: oklch(94.8% 0 0);
  color: oklch(20% 0.022 235);
}

.command-capability-sidebar-empty {
  position: static;
  display: grid;
  align-content: center;
  gap: 5px;
  min-height: 220px;
  padding: 24px 28px;
  color: var(--n-700);
  text-align: center;
}

.command-capability-sidebar-empty strong {
  color: var(--n-850);
  font-size: calc(13px + var(--user-ui-font-delta));
}

.command-capability-sidebar-empty p {
  margin: 0;
  font-size: calc(12px + var(--user-ui-font-delta));
  line-height: 1.55;
}

@media (max-width: 1080px) {
  .command-shell-route[data-capability-sidebar-open="true"] {
    grid-template-columns: minmax(0, 1fr) 340px;
  }
}

@media (max-width: 880px) {
  .command-shell-route[data-capability-sidebar-open="true"] {
    grid-template-columns: minmax(0, 1fr);
  }

  .command-capability-sidebar {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(380px, calc(100vw - 32px));
    box-shadow: var(--shadow-drawer-left);
  }

  .command-shell-route[data-capability-sidebar-open="true"]
    .command-capability-sidebar::before {
    position: fixed;
    z-index: -1;
    inset: 0;
    background: rgb(21 30 42 / 0.16);
    content: "";
    pointer-events: none;
    backdrop-filter: blur(1.5px);
  }
}

@media (max-width: 520px) {
  .command-capability-sidebar {
    width: 100vw;
  }
}"
`;

exports[`command workspace conversation style > snapshots the assistant and home conversation alignment contract 1`] = `
"/* Assistant uses the same real thread transcript and composer as the home chat. */
.shell-page-view.assistant-only-view {
  background: var(--n-25);
}
.assistant-single-conversation {
  position: relative;
  display: grid;
  grid-template-rows: minmax(0, 1fr) auto;
  width: min(1180px, calc(100% - 88px));
  height: calc(100% - 38px);
  min-height: 0;
  margin: 19px auto;
  padding: 0;
  gap: 12px;
}
.assistant-conversation-actions {
  position: absolute;
  top: 2px;
  left: 50%;
  z-index: 4;
  display: flex;
  width: min(780px, 100%);
  justify-content: flex-end;
  pointer-events: none;
  transform: translateX(-50%);
}
.assistant-clear-conversation {
  display: inline-flex;
  min-height: 30px;
  align-items: center;
  gap: 6px;
  padding: 0 9px;
  border: 1px solid transparent;
  border-radius: var(--radius-md);
  background: var(--n-25);
  color: var(--n-750);
  cursor: pointer;
  font-size: calc(12px + var(--user-ui-font-delta));
  font-weight: 500;
  pointer-events: auto;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}
.assistant-clear-conversation svg {
  width: 14px;
  height: 14px;
}
.assistant-clear-conversation:hover:not(:disabled),
.assistant-clear-conversation:focus-visible:not(:disabled) {
  border-color: var(--n-300);
  background: var(--n-75);
  color: oklch(48% 0.12 25);
  outline: 0;
}
.assistant-clear-conversation:focus-visible {
  box-shadow: 0 0 0 3px oklch(72% 0.08 25 / 0.16);
}
.assistant-clear-conversation:disabled {
  cursor: not-allowed;
  opacity: 0.42;
}
.assistant-empty-state {
  display: grid;
  align-content: center;
  justify-items: center;
  width: min(620px, 100%);
  margin: 0 auto;
  color: var(--n-750);
  text-align: center;
  gap: 10px;
}
.assistant-empty-state > span {
  display: grid;
  width: 48px;
  height: 48px;
  place-items: center;
  border: 1px solid var(--n-300);
  border-radius: var(--radius-xl);
  background: var(--n-0);
  color: oklch(40% 0.06 225);
  box-shadow: var(--shadow-overlay);
}
.assistant-empty-state svg {
  width: 22px;
  height: 22px;
}
.assistant-empty-state strong {
  color: var(--n-950);
  font-size: calc(17px + var(--user-ui-font-delta));
  font-weight: 600;
}
.assistant-empty-state p {
  max-width: 520px;
  margin: 0;
  font-size: calc(13px + var(--user-ui-font-delta));
  line-height: 1.7;
}
.assistant-single-conversation .command-thread-room {
  min-height: 0;
}
.assistant-thread-room .message[data-kind="userMessage"] {
  display: grid;
  justify-content: stretch;
}
.assistant-thread-room .message[data-kind="userMessage"] .message-body {
  width: fit-content;
  max-width: min(620px, 82%);
  justify-self: end;
}
.assistant-thread-room .message[data-kind="agentMessage"] .markdown-content {
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.assistant-thread-room .message[data-kind="userMessage"] .markdown-content {
  border-radius: var(--radius-xl);
  box-shadow: none;
}
/* 720px, matching the thread composer and transcript column. */
.assistant-composer-zone {
  display: grid;
  justify-self: center;
  width: min(720px, 100%);
  gap: 0;
}

/*
 * The home composer is the same control as the thread composer, so it carries
 * the same edge treatment: hairline border, soft outer shadow, and a radius
 * past the shared \`xl\` container token.
 */
.assistant-home-composer {
  width: 100%;
  margin: 0;
  border-width: 0.5px;
  border-color: var(--n-300);
  border-radius: 18px;
  background: var(--n-0);
  box-shadow: var(--shadow-composer);
}
.assistant-home-composer textarea {
  height: 80px;
  min-height: 80px;
  max-height: 160px;
  padding: 15px 15px 7px;
  color: inherit;
  font-family:
    -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC",
    "Hiragino Sans GB", "Segoe UI", system-ui, sans-serif;
  font-size: calc(13px + var(--user-ui-font-delta));
  line-height: 1.45;
  letter-spacing: 0;
  -webkit-font-smoothing: antialiased;
}
.assistant-home-composer .input-tools {
  min-height: 56px;
  height: auto;
  padding: 0 12px 0 16px;
}
.assistant-home-composer .composer-state-row {
  min-height: 34px;
  padding: 7px 12px;
}
@media (max-width: 860px) {
  .assistant-single-conversation {
    width: calc(100% - 28px);
    height: calc(100% - 28px);
    min-height: 0;
    margin: 14px auto;
    padding: 0;
  }
  .assistant-home-composer .input-tools {
    padding: 8px 10px;
  }
}
@media (max-width: 560px) {
  .assistant-clear-conversation {
    width: 30px;
    justify-content: center;
    padding: 0;
  }
  .assistant-clear-conversation span {
    display: none;
  }
}"
`;

exports[`command workspace conversation style > snapshots the compact Codex-inspired transcript contract 1`] = `
"/* Keep active conversations close to Codex's quiet transcript hierarchy. */
/* Home chat + Assist share one top-aligned column — never vertically float mid-page. */
.screen-shell.command-screen .hero-center.has-command-thread,
.assistant-single-conversation {
  top: 0;
  left: 50%;
  display: grid;
  grid-template-rows: minmax(0, 1fr) auto;
  align-content: stretch;
  justify-items: stretch;
  width: min(1180px, calc(100% - 88px));
  height: calc(100% - 14px);
  margin: 0;
  transform: translateX(-50%);
  gap: 12px;
}

/*
 * The task bar occupies the first 40px of the canvas, so the conversation column
 * starts below it instead of underneath it.
 */
.screen-shell.command-screen
  .command-home-view.has-command-thread
  .hero-center.has-command-thread {
  top: 40px;
  height: calc(100% - 54px);
}

/*
 * Below 860px the shell drops the hero out of absolute positioning, so the
 * translateX(-50%) that centres it against \`left: 50%\` no longer has a matching
 * offset to cancel and instead shoves the composer off the left edge. app.css
 * clears the transform at this breakpoint, but this file loads after it, so the
 * reset has to be repeated here.
 */
@media (max-width: 860px) {
  .screen-shell.command-screen .hero-center.has-command-thread {
    left: auto;
    width: calc(100% - 28px);
    justify-self: center;
    transform: none;
  }
}

.assistant-single-conversation {
  position: relative;
  left: auto;
  margin: 19px auto;
  transform: none;
}

.screen-shell.command-screen .command-thread-room .message-list,
.assistant-thread-room .message-list {
  gap: 16px;
  padding: 22px 12px 22px;
  scrollbar-gutter: stable both-edges;
}

.screen-shell.command-screen .command-input.thread-command-input,
.assistant-single-conversation .command-input {
  width: min(720px, 100%);
}

/*
 * The top bar spans the full canvas and holds only the task name, flush left.
 * It is deliberately not part of the centered 780px transcript column: when it
 * was, the bar started mid-canvas and its trailing content sat on top of the
 * message flow.
 */
.screen-shell.command-screen .command-thread-toolbar {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 28px;
  padding: 4px 0 7px;
  color: var(--n-650);
}

.screen-shell.command-screen .command-thread-identity {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 0;
}

.screen-shell.command-screen .command-thread-identity > strong {
  min-width: 0;
  overflow: hidden;
  color: var(--n-850);
  font-size: calc(12px + var(--user-ui-font-delta));
  font-weight: 500;
  line-height: 1.3;
  letter-spacing: 0;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.screen-shell.command-screen .command-thread-cwd {
  max-width: min(160px, 20vw);
  min-height: auto;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: var(--n-600);
  font-size: calc(11px + var(--user-ui-font-delta));
  font-style: normal;
  font-weight: 500;
}

.screen-shell.command-screen .command-thread-cwd::before {
  content: "·";
  margin: 0 8px;
  color: var(--n-400);
}

.screen-shell.command-screen .command-thread-runtime {
  gap: 6px;
  color: var(--n-600);
}

.screen-shell.command-screen .command-thread-runtime strong {
  gap: 6px;
  color: var(--n-650);
  font-size: calc(12px + var(--user-ui-font-delta));
  font-weight: 500;
}

.screen-shell.command-screen .command-thread-runtime strong::before {
  width: 6px;
  height: 6px;
  background: var(--n-400);
}

.screen-shell.command-screen .command-thread-runtime em {
  min-height: auto;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: var(--n-600);
  font-size: calc(12px + var(--user-ui-font-delta));
  font-weight: 500;
}

.screen-shell.command-screen .command-thread-runtime em::before {
  content: "·";
  margin-right: 6px;
  color: var(--n-400);
}

:root[data-theme="dark"] .screen-shell.command-screen .command-thread-toolbar {
  color: #a1a1aa;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-identity
  > strong {
  color: #d4d4d8;
}

:root[data-theme="dark"] .screen-shell.command-screen .command-thread-cwd,
:root[data-theme="dark"] .screen-shell.command-screen .command-thread-runtime,
:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-runtime
  em {
  color: #a1a1aa;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-runtime
  strong {
  color: #a1a1aa;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-cwd::before,
:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-runtime
  em::before {
  color: #52525b;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-runtime
  strong::before {
  background: #52525b;
}

.screen-shell.command-screen .command-thread-room .turn-group,
.screen-shell.command-screen .command-thread-room .message-list > .message,
.assistant-thread-room .turn-group,
.assistant-thread-room .message-list > .message {
  width: min(720px, 100%);
  max-width: 720px;
}

.screen-shell.command-screen .command-thread-room .turn-group,
.assistant-thread-room .turn-group {
  gap: 12px;
}

.screen-shell.command-screen .command-thread-room .message {
  grid-template-columns: minmax(0, 1fr);
  column-gap: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.screen-shell.command-screen .command-thread-room .message::before {
  display: none;
}

.screen-shell.command-screen .command-thread-room .message-body {
  grid-column: 1;
}

.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .message-header {
  display: none;
}

/* Cursor agent chat: dense body, tight lists, quiet inline code. */
.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content,
.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="plan"]
  .markdown-content,
.assistant-thread-room .message[data-kind="agentMessage"] .markdown-content,
.assistant-thread-room .message[data-kind="plan"] .markdown-content {
  /* Kept under the 720px column so body text is not flush with its edges. */
  max-width: 680px;
  gap: 0;
  /* Theme colors are set by data-theme rules below. */
  color: inherit;
  font-family:
    -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC",
    "Hiragino Sans GB", "Segoe UI", system-ui, sans-serif;
  font-size: calc(13px + var(--user-ui-font-delta));
  font-weight: 400;
  line-height: 1.45;
  letter-spacing: 0;
  text-wrap: pretty;
  -webkit-font-smoothing: antialiased;
}

.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  :is(p, li),
.assistant-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  :is(p, li) {
  color: inherit;
  line-height: 1.45;
}

.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  > :is(p, ul, ol, blockquote, pre, figure, table),
.assistant-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  > :is(p, ul, ol, blockquote, pre, figure, table) {
  margin: 0 0 9px;
}

.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  > :last-child,
.assistant-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  > :last-child {
  margin-bottom: 0;
}

.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  :is(h1, h2, h3, h4),
.assistant-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  :is(h1, h2, h3, h4) {
  margin: 14px 0 5px;
  color: inherit;
  font-weight: 700;
  letter-spacing: 0;
  line-height: 1.35;
}

.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  > :is(h1, h2, h3, h4):first-child,
.assistant-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  > :is(h1, h2, h3, h4):first-child {
  margin-top: 0;
}

.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  h1,
.assistant-thread-room .message[data-kind="agentMessage"] .markdown-content h1 {
  font-size: calc(14px + var(--user-ui-font-delta));
}

.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  h2,
.assistant-thread-room .message[data-kind="agentMessage"] .markdown-content h2 {
  font-size: calc(13px + var(--user-ui-font-delta));
}

.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  :is(h3, h4),
.assistant-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  :is(h3, h4) {
  font-size: calc(13px + var(--user-ui-font-delta));
}

.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  :is(ul, ol),
.assistant-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  :is(ul, ol) {
  gap: 3px;
  padding-left: 18px;
}

.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  li,
.assistant-thread-room .message[data-kind="agentMessage"] .markdown-content li {
  padding-left: 1px;
}

.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  li
  > :is(ul, ol),
.assistant-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  li
  > :is(ul, ol) {
  margin: 2px 0 0;
  gap: 2px;
}

.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  li
  > p,
.assistant-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  li
  > p {
  margin: 0;
}

.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  li::marker,
.assistant-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  li::marker {
  color: var(--n-600);
}

.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  :not(pre)
  > code,
.assistant-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  :not(pre)
  > code {
  padding: 0 3.5px;
  border: 0;
  border-radius: 3px;
  background: rgba(24, 24, 27, 0.06);
  color: inherit;
  font-family: var(--font-mono);
  font-size: 0.92em;
  line-height: 1.35;
}

.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  strong,
.assistant-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  strong {
  font-weight: 500;
  color: inherit;
}

.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  blockquote,
.assistant-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  blockquote {
  padding: 0 0 0 12px;
  border-left: 2px solid var(--n-350);
  color: var(--n-800);
}

.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  table,
.assistant-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  table {
  border: 1px solid var(--n-alpha-08);
  border-radius: var(--radius-md);
  font-size: calc(12px + var(--user-ui-font-delta));
  line-height: 1.4;
}

.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  :is(th, td),
.assistant-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  :is(th, td) {
  min-width: 56px;
  padding: 5px 9px;
}

.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  th,
.assistant-thread-room .message[data-kind="agentMessage"] .markdown-content th {
  font-size: calc(12px + var(--user-ui-font-delta));
  font-weight: 500;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  table {
  border-color: rgba(255, 255, 255, 0.1);
}

:root:not([data-theme="light"])
  .screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content,
:root:not([data-theme="light"])
  .assistant-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content {
  color: var(--n-750);
}

:root:not([data-theme="light"])
  .screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  :is(h1, h2, h3, h4, strong),
:root:not([data-theme="light"])
  .assistant-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  :is(h1, h2, h3, h4, strong) {
  color: var(--n-800);
}

:root:not([data-theme="light"])
  .screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  blockquote,
:root:not([data-theme="light"])
  .assistant-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  blockquote {
  border-left-color: var(--n-800);
  color: var(--n-550);
}

:root:not([data-theme="light"])
  .screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  :not(pre)
  > code,
:root:not([data-theme="light"])
  .assistant-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  :not(pre)
  > code {
  border: 0;
  background: var(--n-0);
  color: var(--n-850);
}

:root:not([data-theme="light"])
  .screen-shell.command-screen
  .command-thread-room
  .message[data-kind="userMessage"]
  .markdown-content,
:root:not([data-theme="light"])
  .assistant-thread-room
  .message[data-kind="userMessage"]
  .markdown-content {
  border: 1px solid var(--border);
  background: var(--surface-raised);
  color: var(--text);
}

:root:not([data-theme="light"])
  .screen-shell.command-screen
  .command-input
  textarea,
:root:not([data-theme="light"]) .assistant-home-composer textarea,
:root:not([data-theme="light"])
  .assistant-single-conversation
  .command-input
  textarea {
  color: var(--n-800);
}

:root:not([data-theme="light"])
  .screen-shell.command-screen
  .command-input
  textarea::placeholder,
:root:not([data-theme="light"]) .assistant-home-composer textarea::placeholder {
  color: var(--n-650);
}

:root[data-theme="light"]
  .screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content,
:root[data-theme="light"]
  .assistant-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content {
  color: var(--n-950);
}

:root[data-theme="light"]
  .screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  :is(h1, h2, h3, h4, strong),
:root[data-theme="light"]
  .assistant-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  :is(h1, h2, h3, h4, strong) {
  color: var(--n-1000);
}

:root[data-theme="light"]
  .screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  :not(pre)
  > code,
:root[data-theme="light"]
  .assistant-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  :not(pre)
  > code {
  background: rgba(24, 24, 27, 0.06);
  color: var(--n-950);
}

:root[data-theme="light"]
  .screen-shell.command-screen
  .command-thread-room
  .message[data-kind="userMessage"]
  .markdown-content,
:root[data-theme="light"]
  .assistant-thread-room
  .message[data-kind="userMessage"]
  .markdown-content {
  background: #f0f0f0;
  color: var(--n-950);
}

:root[data-theme="light"] .screen-shell.command-screen .command-input textarea,
:root[data-theme="light"] .assistant-home-composer textarea,
:root[data-theme="light"]
  .assistant-single-conversation
  .command-input
  textarea {
  color: var(--n-950);
}

.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="userMessage"]
  .message-body {
  max-width: min(560px, 76%);
}

.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="userMessage"]
  .markdown-content,
.assistant-thread-room .message[data-kind="userMessage"] .markdown-content {
  padding: 8px 13px;
  border: 0;
  border-radius: var(--radius-xl);
  box-shadow: none;
  /* Theme bubble fill/text set by data-theme rules above. */
  font-family:
    -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC",
    "Hiragino Sans GB", "Segoe UI", system-ui, sans-serif;
  font-size: calc(13px + var(--user-ui-font-delta));
  font-weight: 400;
  line-height: 1.45;
  letter-spacing: 0;
  text-wrap: pretty;
  -webkit-font-smoothing: antialiased;
}

.screen-shell.command-screen .command-input textarea,
.assistant-home-composer textarea,
.assistant-single-conversation .command-input textarea {
  font-size: calc(13px + var(--user-ui-font-delta));
  font-weight: 400;
  line-height: 1.45;
  letter-spacing: 0;
}

.screen-shell.command-screen .command-input textarea::placeholder,
.assistant-home-composer textarea::placeholder,
.assistant-single-conversation .command-input textarea::placeholder {
  color: var(--n-600);
  opacity: 1;
}

.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="userMessage"]
  .markdown-content
  > :first-child {
  margin-top: 0;
}

.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="userMessage"]
  .markdown-content
  > :last-child {
  margin-bottom: 0;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .message[data-transcript-variant="process"] {
  grid-template-columns: minmax(0, 1fr);
  column-gap: 0;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .message[data-transcript-variant="process"]::before {
  display: none;
}

/* Tool cards self-describe; the duplicated role header only adds noise. */
.screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .message[data-transcript-variant="process"]
  .message-header {
  display: none;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .message[data-transcript-variant="process"]
  .message-body {
  grid-column: 1;
  padding-left: 0;
}

/* The turn status owns the execution disclosure; tool batches stay inside it. */
.screen-shell.command-screen .command-thread-room .turn-process-details {
  justify-items: stretch;
}

.screen-shell.command-screen .command-thread-room .turn-process-summary {
  width: 100%;
  max-width: none;
  min-height: 38px;
  justify-self: stretch;
  justify-content: flex-start;
  gap: 7px;
  margin: 0;
  padding: 0 0 12px;
  border: 0;
  border-bottom: 1px solid var(--n-200);
  border-radius: 0;
  background: transparent;
  color: var(--n-650);
  transform: none;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-summary::before {
  order: 3;
  width: 7px;
  height: 7px;
  margin-left: 2px;
}

.screen-shell.command-screen .command-thread-room .turn-process-summary-main {
  display: inline-flex;
  align-items: baseline;
  gap: 6px;
}

.screen-shell.command-screen .command-thread-room .turn-process-title,
.screen-shell.command-screen .command-thread-room .turn-process-summary em {
  color: inherit;
  font-size: calc(14px + var(--user-ui-font-delta));
  font-weight: 500;
  line-height: 1.4;
}

.screen-shell.command-screen .command-thread-room .turn-process-summary:hover,
.screen-shell.command-screen
  .command-thread-room
  .turn-process-summary:focus-visible {
  border-color: var(--n-300);
  background: transparent;
  color: var(--n-750);
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-details[data-state="expanded"]
  .turn-process-summary,
.screen-shell.command-screen
  .command-thread-room
  .turn-process-details[data-state="collapsing"]
  .turn-process-summary {
  margin-bottom: 18px;
}

.screen-shell.command-screen .command-thread-room .turn-process-items {
  gap: 18px;
  padding: 2px 0 4px;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .message[data-process-note="true"] {
  margin: 0;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .message[data-process-note="true"]
  .markdown-content {
  max-width: 100%;
  color: var(--n-950);
  font-size: calc(14px + var(--user-ui-font-delta));
  font-weight: 400;
  line-height: 1.65;
  letter-spacing: -0.009em;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .message[data-has-icon="true"] {
  grid-template-columns: 22px minmax(0, 1fr);
  column-gap: 8px;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .message[data-has-icon="true"]
  .message-icon {
  display: grid;
  width: 20px;
  height: 26px;
  place-items: center;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--n-600);
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .message[data-has-icon="true"]
  .message-body {
  grid-column: 2;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .tool-card-header,
.screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .process-card
  summary {
  min-height: 26px;
  padding: 0;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  :is(.tool-action-verb, .reasoning-card-headline),
.screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  :is(
    .command-card-header,
    .file-read-header,
    .file-change-header,
    .tool-call-header,
    .action-card-header
  )
  code {
  color: var(--n-650);
  font-size: calc(13px + var(--user-ui-font-delta));
  font-weight: 500;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .tool-action-verb {
  font-weight: 500;
}

.process-action-group {
  display: block;
  width: 100%;
  color: var(--n-650);
}

.process-action-group > summary {
  display: grid;
  grid-template-columns: 22px minmax(0, 1fr) auto;
  min-height: 28px;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  list-style: none;
  font-size: calc(13px + var(--user-ui-font-delta));
  font-weight: 500;
}

.process-action-group > summary::-webkit-details-marker {
  display: none;
}

.process-action-group > summary::after {
  width: 7px;
  height: 7px;
  margin-right: 3px;
  border-right: 1.5px solid currentColor;
  border-bottom: 1.5px solid currentColor;
  opacity: 0.72;
  content: "";
  transform: rotate(45deg);
  transition: transform 160ms ease;
}

.process-action-group[open] > summary::after {
  transform: translateY(2px) rotate(225deg);
}

.process-action-group-icon {
  display: grid;
  width: 20px;
  height: 24px;
  place-items: center;
  color: var(--n-600);
}

.process-action-group-items {
  display: grid;
  gap: 4px;
  margin: 4px 0 0 10px;
  padding: 2px 0 2px 20px;
  border-left: 1px solid var(--n-250);
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-details
  + .message[data-kind="agentMessage"] {
  margin-top: 6px;
}

@media (max-width: 860px) {
  .screen-shell.command-screen .command-thread-room .message-list {
    padding: 16px 14px 18px;
  }

  .screen-shell.command-screen
    .command-thread-room
    .message[data-kind="agentMessage"]
    .markdown-content,
  .screen-shell.command-screen
    .command-thread-room
    .message[data-kind="plan"]
    .markdown-content,
  .assistant-thread-room .message[data-kind="agentMessage"] .markdown-content {
    font-size: calc(13px + var(--user-ui-font-delta));
    line-height: 1.42;
  }

  .screen-shell.command-screen .command-input textarea,
  .assistant-home-composer textarea {
    font-size: calc(13px + var(--user-ui-font-delta));
    line-height: 1.42;
  }
}

/* Keep the whole command shell on the same appearance preference. */
:root[data-theme="dark"] .screen-shell.command-screen {
  --command-sidebar-bg: #202020;
  --command-sidebar-border: #303030;
  --command-sidebar-hover: #292929;
  --command-sidebar-active: #343434;
  --command-control-bg: #242424;
  --command-control-border: #3a3a3a;
  background: #171717;
  color: #ededed;
}

:root[data-theme="dark"] .command-shell-route,
:root[data-theme="dark"] .screen-shell.command-screen .command-window,
:root[data-theme="dark"] .screen-shell.command-screen .command-canvas,
:root[data-theme="dark"] .screen-shell.command-screen .shell-page-view {
  background: #171717;
  color: #ededed;
}

:root[data-theme="dark"] .screen-shell.command-screen .command-sidebar {
  border-color: var(--command-sidebar-border);
  background: var(--command-sidebar-bg);
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  :is(
    .sidebar-brand,
    .sidebar-brand small,
    .space-tree,
    .sidebar-nav em,
    .sidebar-empty-hint,
    .conversation-item em
  ) {
  color: #9b9b9b;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  :is(
    .sidebar-nav a,
    .sidebar-nav button,
    .sidebar-tool,
    .tree-head button,
    .space-title button,
    .conversation-item,
    .sidebar-account summary
  ) {
  color: #d6d6d6;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  .sidebar-nav
  :is(a, button) {
  background: transparent;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  :is(
    .sidebar-nav a,
    .sidebar-nav button,
    .sidebar-tool,
    .space-title button,
    .conversation-item,
    .sidebar-account summary
  ):hover {
  background: var(--command-sidebar-hover);
  color: #f5f5f5;
}

/* Selection is a step brighter than hover; see the light counterpart. */
:root[data-theme="dark"]
  .screen-shell.command-screen
  .sidebar-nav
  button.active,
:root[data-theme="dark"]
  .screen-shell.command-screen
  .conversation-item.active {
  background: var(--command-sidebar-active);
  color: #f5f5f5;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  :is(
    .sidebar-search-panel,
    .sidebar-workspace-form,
    .sidebar-account-popover
  ) {
  border-color: #393939;
  background: #242424;
  color: #ededed;
  box-shadow: var(--shadow-modal);
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  :is(.sidebar-search-field, .sidebar-workspace-form input) {
  border-color: #3c3c3c;
  background: #1d1d1d;
  color: #ededed;
}

:root:not([data-theme="light"]) .workspace-remove-dialog {
  border-color: #393939;
  background: #242424;
}

:root:not([data-theme="light"]) .workspace-remove-dialog strong {
  color: #f1f1f1;
}

:root:not([data-theme="light"]) .workspace-remove-dialog code {
  background: #1d1d1d;
  color: #d6d6d6;
}

:root:not([data-theme="light"]) .workspace-remove-dialog p {
  color: #a1a1aa;
}

:root:not([data-theme="light"]) .workspace-remove-dialog footer button {
  border-color: #3c3c3c;
  color: #ededed;
}

:root:not([data-theme="light"]) .workspace-remove-dialog footer button:hover {
  background: #303030;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  :is(
    .home-title h1,
    .home-title h1 span:first-child,
    .command-thread-room .message-role,
    .command-input textarea
  ) {
  color: #f1f1f1;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  :is(
    .scene-subtitle,
    .capability-summary,
    .command-thread-identity > span,
    .command-thread-cwd,
    .command-thread-room .message-type,
    .composer-state-row
  ) {
  color: #a3a3a3;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  :is(
    .scene-pills,
    .scene-pills button,
    .quick-row button,
    .input-tools button:not(.send-button),
    .workspace-pill,
    .command-input,
    .control-select .select-trigger,
    .workspace-picker .select-trigger
  ) {
  border-color: #393939;
  background: #242424;
  color: #dcdcdc;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  :is(
    .scene-pills button,
    .quick-row button,
    .input-tools button:not(.send-button),
    .control-select .select-trigger,
    .workspace-picker .select-trigger
  ):hover {
  border-color: #505050;
  background: #303030;
  color: #fff;
}

:root[data-theme="dark"] .screen-shell.command-screen .command-thread-cwd {
  background: transparent;
  color: #a1a1aa;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-room
  :is(.message[data-kind="agentMessage"], .message[data-kind="plan"])
  .markdown-content,
:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-room
  .message[data-kind="userMessage"]
  .markdown-content,
:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-room
  .turn-process-details {
  color: #dedede;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-room
  .turn-process-summary {
  border-bottom-color: #303030;
  color: #a0a0a0;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-room
  .turn-process-summary:hover,
:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-room
  .turn-process-summary:focus-visible {
  border-bottom-color: #3a3a3a;
  background: transparent;
  color: #b8b8b8;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .message[data-process-note="true"]
  .markdown-content,
:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .message[data-process-note="true"]
  .markdown-content
  :is(p, li, strong, em, code) {
  color: #f0f0f0;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .message[data-process-note="true"]
  .markdown-content
  :not(pre)
  > code {
  border-color: #363636;
  background: #2a2a2a;
  color: #ededed;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .message-icon,
:root[data-theme="dark"] .process-action-group-icon {
  color: #a0a0a0;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  :is(.tool-action-verb, .reasoning-card-headline),
:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  :is(
    .command-card-header,
    .file-read-header,
    .file-change-header,
    .tool-call-header,
    .action-card-header
  )
  code,
:root[data-theme="dark"] .process-action-group {
  color: #a8a8a8;
}

:root[data-theme="dark"] .process-action-group-items {
  border-left-color: #343434;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-room
  .message[data-kind="userMessage"]
  .markdown-content {
  border-color: #3b3b3b;
  background: #242424;
}

:root[data-theme="dark"] .command-capability-sidebar {
  border-color: #303030;
  background: #1e1e1e;
  color: #ededed;
  box-shadow: none;
}

:root[data-theme="dark"] .command-capability-sidebar-header,
:root[data-theme="dark"] .command-capability-sidebar .capability-tool-tabs,
:root[data-theme="dark"] .command-capability-sidebar .capability-result-header,
:root[data-theme="dark"] .command-capability-sidebar .capability-result-list,
:root[data-theme="dark"]
  .command-capability-sidebar
  .capability-result-list
  li {
  border-color: #303030;
}

:root[data-theme="dark"] .command-capability-sidebar-header span,
:root[data-theme="dark"]
  .command-capability-sidebar
  .capability-result-header
  span,
:root[data-theme="dark"] .command-capability-sidebar-empty {
  color: #9b9b9b;
}

:root[data-theme="dark"] .command-capability-sidebar-header strong,
:root[data-theme="dark"] .command-capability-sidebar-empty strong,
:root[data-theme="dark"]
  .command-capability-sidebar
  .capability-result-header
  strong,
:root[data-theme="dark"]
  .command-capability-sidebar
  .capability-tool-tabs
  > button,
:root[data-theme="dark"] .command-capability-sidebar .capability-result-item {
  color: #dedede;
}

:root[data-theme="dark"]
  .command-capability-sidebar
  .capability-tool-tabs
  > button:hover,
:root[data-theme="dark"]
  .command-capability-sidebar
  .capability-tool-tabs
  > button:focus-visible,
:root[data-theme="dark"]
  .command-capability-sidebar
  .capability-tool-tabs
  > button[data-active="true"],
:root[data-theme="dark"]
  .command-capability-sidebar
  .capability-result-item:hover,
:root[data-theme="dark"]
  .command-capability-sidebar
  .capability-result-item:focus-visible {
  border-color: #3f3f3f;
  background: #2b2b2b;
  color: #fff;
}

:root[data-theme="dark"]
  .command-capability-sidebar
  :is(
    .capability-result,
    .capability-result pre,
    .capability-command-form input,
    .capability-field-list input,
    .capability-field-list select,
    .capability-command-form button,
    .capability-result-actions button,
    .capability-dock kbd,
    .capability-result-output
  ) {
  border-color: #3b3b3b;
  background: #242424;
  color: #dedede;
}

:root[data-theme="dark"]
  .command-capability-sidebar
  .capability-result:is(
    [data-panel-kind="terminal"],
    [data-panel-kind="review"]
  )
  .capability-result-output {
  border-color: #383838;
  background: #242424;
  color: #dedede;
}

:root[data-theme="dark"] .command-capability-sidebar .capability-result-list {
  border-color: #303030;
  background: #202020;
}

:root[data-theme="dark"] .command-capability-sidebar .capability-result-summary,
:root[data-theme="dark"]
  .command-capability-sidebar
  .capability-result-item-icon,
:root[data-theme="dark"]
  .command-capability-sidebar
  .capability-result-item-chevron {
  color: #9b9b9b;
}

:root[data-theme="dark"] .command-capability-sidebar-empty {
  border-color: #404040;
}

/* Codex-parity tool workbench: real browser, terminal, file and review surfaces. */
.command-workbench {
  --workbench-bg: #171717;
  --workbench-surface: #1d1d1d;
  --workbench-raised: #242424;
  --workbench-hover: #303030;
  --workbench-active: #383838;
  --workbench-border: #303030;
  --workbench-text: #ededed;
  --workbench-muted: #9b9b9b;
  --workbench-faint: #707070;
  --workbench-page: #111;
  --workbench-syntax-blue: #61afef;
  --workbench-syntax-cyan: #56b6c2;
  --workbench-syntax-green: #98c379;
  --workbench-syntax-orange: #d19a66;
  --workbench-syntax-purple: #c678dd;
  --workbench-syntax-red: #e06c75;
  position: relative;
  z-index: 30;
  display: grid;
  width: clamp(420px, 36vw, 520px);
  min-width: 0;
  height: 100%;
  grid-template-rows: 42px minmax(0, 1fr);
  overflow: hidden;
  border-left: 1px solid var(--workbench-border);
  background: var(--workbench-bg);
  color: var(--workbench-text);
  container-name: command-workbench;
  container-type: inline-size;
}

.command-task-board {
  display: grid;
  height: 100%;
  min-height: 0;
  grid-template-rows: auto minmax(0, 1fr);
  overflow: hidden;
  background: var(--workbench-bg);
}

.command-task-board-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  padding: 18px 18px 14px;
  border-bottom: 1px solid var(--workbench-border);
}

.command-task-board-header strong {
  color: var(--workbench-text);
  font-size: calc(15px + var(--user-ui-font-delta));
  font-weight: 600;
}

.command-task-board-header p {
  margin: 4px 0 0;
  color: var(--workbench-muted);
  font-size: calc(11px + var(--user-ui-font-delta));
  line-height: 1.5;
}

.command-task-board-header > span {
  min-width: 26px;
  padding: 3px 8px;
  border-radius: 999px;
  background: var(--workbench-hover);
  color: var(--workbench-muted);
  font-size: 11px;
  text-align: center;
}

.command-task-board-columns {
  display: grid;
  min-width: 0;
  min-height: 0;
  grid-template-columns: repeat(3, minmax(132px, 1fr));
  gap: 10px;
  overflow: auto;
  padding: 12px;
}

.command-task-column {
  display: grid;
  min-width: 0;
  min-height: 0;
  grid-template-rows: auto minmax(0, 1fr);
  overflow: hidden;
  border: 1px solid var(--workbench-border);
  border-radius: 12px;
  background: var(--workbench-surface);
}

.command-task-column > header {
  display: flex;
  min-height: 42px;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 0 10px;
  border-bottom: 1px solid var(--workbench-border);
}

.command-task-column > header span {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 7px;
}

.command-task-column > header svg {
  width: 15px;
  height: 15px;
  color: var(--workbench-muted);
}

.command-task-column > header strong {
  overflow: hidden;
  color: var(--workbench-text);
  font-size: 12px;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.command-task-column > header em {
  color: var(--workbench-faint);
  font-size: 11px;
  font-style: normal;
}

.command-task-column-list {
  display: flex;
  min-height: 0;
  flex-direction: column;
  gap: 8px;
  overflow: auto;
  padding: 8px;
}

.command-task-card {
  display: grid;
  width: 100%;
  gap: 5px;
  padding: 10px;
  border: 1px solid var(--workbench-border);
  border-radius: 9px;
  background: var(--workbench-raised);
  color: var(--workbench-text);
  cursor: pointer;
  font: inherit;
  text-align: left;
}

.command-task-card:hover,
.command-task-card:focus-visible,
.command-task-card[aria-current="true"] {
  border-color: color-mix(in oklch, var(--accent), var(--workbench-border) 55%);
  background: var(--workbench-hover);
  outline: 0;
}

.command-task-card strong,
.command-task-card span {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.command-task-card strong {
  font-size: 12px;
  font-weight: 600;
}

.command-task-card span,
.command-task-card small,
.command-task-column-empty {
  color: var(--workbench-muted);
  font-size: 10px;
}

.command-task-column-empty {
  margin: auto;
  text-align: center;
}

.command-project-board-page {
  display: grid;
  height: 100%;
  min-height: 0;
  grid-template-rows: auto auto minmax(0, 1fr);
  gap: 18px;
  padding: 28px 32px 32px;
}

.command-project-board-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.command-project-board-controls .segmented-tabs {
  display: inline-flex;
  gap: 3px;
  padding: 3px;
  border: 1px solid var(--n-250);
  border-radius: 9px;
  background: var(--n-100);
}

.command-project-board-controls .segmented-tabs button {
  height: 28px;
  padding: 0 10px;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: var(--n-650);
  cursor: pointer;
  font-size: calc(12px + var(--user-ui-font-delta));
}

.command-project-board-controls .segmented-tabs button.active {
  background: var(--n-25);
  color: var(--n-950);
  box-shadow: var(--shadow-raised);
}

.command-project-board-controls .catalog-search {
  width: min(320px, 42%);
}

.command-library-shell-view {
  min-width: 0;
  overflow: hidden;
  background: var(--n-25);
}

.command-library-shell-view > .library-page {
  height: 100%;
  padding: 30px clamp(24px, 5vw, 72px) 64px;
}

.command-library-mode-switch {
  display: flex;
  flex: 0 0 auto;
  gap: 4px;
  padding: 12px 24px 0;
  background: var(--n-25);
}

.command-library-mode-switch button {
  height: 30px;
  padding: 0 12px;
  border: 1px solid transparent;
  border-radius: 8px;
  background: transparent;
  color: var(--n-650);
  cursor: pointer;
}

.command-library-mode-switch button.active {
  border-color: var(--n-250);
  background: var(--n-100);
  color: var(--n-950);
}

.command-control-schedule-page {
  height: 100%;
  min-height: 0;
  overflow: auto;
  padding: 24px 30px 36px;
}

.command-control-schedule-page .catalog-market-header {
  position: static;
}

.command-control-schedule-page .schedule-calendar-shell {
  min-height: 560px;
}

.schedule-section-tabs {
  display: flex;
  gap: 26px;
  border-bottom: 1px solid var(--n-200);
}

.schedule-section-tabs button {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 12px 2px 10px;
  border: 0;
  border-bottom: 2px solid transparent;
  background: transparent;
  color: var(--n-550);
  cursor: pointer;
}

.schedule-section-tabs button.active {
  border-bottom-color: var(--n-950);
  color: var(--n-950);
  font-weight: 600;
}

.schedule-section-tabs svg,
.schedule-scope-row svg,
.schedule-summary-grid svg,
.schedule-history-state svg,
.schedule-history-item svg,
.schedule-team-empty svg {
  width: 16px;
  height: 16px;
}

.schedule-scope-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.schedule-view-switch {
  display: inline-flex;
  gap: 2px;
  padding: 3px;
  border: 1px solid var(--n-200);
  border-radius: 9px;
  background: var(--n-50);
}

.schedule-view-switch button {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 6px 9px;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: var(--n-550);
  cursor: pointer;
}

.schedule-view-switch button[aria-pressed="true"] {
  background: var(--surface);
  color: var(--n-950);
  box-shadow: var(--shadow-xs);
}

.schedule-team-empty,
.schedule-history-state {
  display: flex;
  min-height: 220px;
  align-items: center;
  justify-content: center;
  gap: 12px;
  border: 1px dashed var(--n-250);
  border-radius: 14px;
  color: var(--n-550);
  text-align: left;
}

.schedule-team-empty strong,
.schedule-team-empty p {
  display: block;
  margin: 0;
}

.schedule-team-empty p {
  max-width: 560px;
  margin-top: 5px;
  font-size: 13px;
}

.schedule-history-shell {
  display: grid;
  align-content: start;
  gap: 16px;
}

.schedule-summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.schedule-summary-grid article {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 9px;
  padding: 14px 16px;
  border: 1px solid var(--n-200);
  border-radius: 12px;
  background: var(--surface);
}

.schedule-summary-grid span,
.schedule-history-item p,
.schedule-history-item small {
  color: var(--n-550);
}

.schedule-summary-grid strong {
  font-size: 22px;
}

.schedule-history-list {
  display: grid;
  gap: 8px;
}

.schedule-history-item {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 12px;
  padding: 13px 15px;
  border: 1px solid var(--n-200);
  border-radius: 10px;
  background: var(--surface);
}

.schedule-history-item p,
.schedule-history-item small,
.schedule-history-item em {
  display: block;
  margin: 3px 0 0;
  font-size: 12px;
  font-style: normal;
}

.schedule-run-status {
  display: grid;
  width: 30px;
  height: 30px;
  place-items: center;
  border-radius: 50%;
  background: var(--n-100);
}

.schedule-run-status.is-completed {
  color: var(--success);
}

.schedule-run-status.is-failed {
  color: var(--danger);
}

.schedule-history-state.is-error {
  color: var(--danger);
}

@media (max-width: 820px) {
  .schedule-summary-grid {
    grid-template-columns: 1fr;
  }

  .schedule-scope-row {
    align-items: flex-start;
    flex-direction: column;
  }
}

.command-schedule-list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 12px;
}

.command-schedule-list .library-item {
  max-width: none;
  text-align: left;
}

.team-experts-shell {
  display: grid;
  align-content: start;
  gap: 18px;
  padding: 20px 4px 36px;
}

.team-experts-shell[hidden] {
  display: none;
}

.team-experts-header {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 20px;
}

.team-experts-header h2,
.team-experts-header p {
  margin: 4px 0 0;
}

.team-experts-header > strong {
  min-width: 32px;
  padding: 5px 10px;
  border-radius: 999px;
  background: var(--n-100);
  text-align: center;
}

.team-expert-grid {
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
}

.command-workbench .library-page {
  height: 100%;
  padding: 20px;
}

.command-workbench .library-heading,
.command-workbench .library-item,
.command-workbench .library-empty,
.command-workbench .library-error {
  max-width: none;
}

.sidebar-runtime-account > button {
  display: flex;
  width: 100%;
  align-items: center;
  gap: 10px;
  padding: 8px 10px;
  border: 0;
  background: transparent;
  color: inherit;
  cursor: pointer;
  text-align: left;
}

.command-project-board-toolbar {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
}

.command-project-board-toolbar span {
  color: var(--n-600);
  font-size: calc(11px + var(--user-ui-font-delta));
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.command-project-board-toolbar h2 {
  margin: 5px 0 3px;
  color: var(--n-950);
  font-size: calc(28px + var(--user-ui-font-delta));
  line-height: 1.1;
}

.command-project-board-toolbar p {
  margin: 0;
  color: var(--n-650);
  font-size: calc(12px + var(--user-ui-font-delta));
}

.command-project-board-page > .command-task-board {
  border: 1px solid var(--n-250);
  border-radius: 14px;
  background: var(--n-25);
}

.command-project-board-page .command-task-board-columns {
  grid-template-columns: repeat(3, minmax(120px, 1fr));
}

:root[data-theme="light"] .command-project-board-page > .command-task-board {
  --workbench-bg: #fff;
  --workbench-surface: #fff;
  --workbench-raised: #f6f6f6;
  --workbench-hover: #eee;
  --workbench-border: #e5e5e5;
  --workbench-text: #202020;
  --workbench-muted: #737373;
  --workbench-faint: #a4a4a4;
}

@media (max-width: 760px) {
  .command-project-board-page {
    gap: 12px;
    padding: 18px;
  }

  .command-project-board-toolbar {
    align-items: flex-start;
  }
}

.command-workbench[hidden] {
  display: none !important;
}

:root[data-theme="light"] .command-workbench {
  --workbench-bg: #fff;
  --workbench-surface: #fff;
  --workbench-raised: #f6f6f6;
  --workbench-hover: #eeeeee;
  --workbench-active: #e9e9e9;
  --workbench-border: #e5e5e5;
  --workbench-text: #202020;
  --workbench-muted: #737373;
  --workbench-faint: #a4a4a4;
  --workbench-page: #fff;
  --workbench-syntax-blue: #2563c8;
  --workbench-syntax-cyan: #137a85;
  --workbench-syntax-green: #4d7c0f;
  --workbench-syntax-orange: #a64b00;
  --workbench-syntax-purple: #7c3aed;
  --workbench-syntax-red: #c2414b;
}

.command-workbench[data-empty="true"] {
  grid-template-rows: minmax(0, 1fr);
}

.command-workbench[data-maximized="true"] {
  position: fixed;
  z-index: 90;
  inset: 0;
  width: 100vw;
  border-left: 0;
  box-shadow: none;
}

/*
 * Straddles the workbench edge instead of sitting inside it. A 9px strip that
 * lived entirely on top of the page iframe was both hard to hit and easy for the
 * child document to claim; 14px centred on the border keeps the grab target
 * comfortable while the visible rule below stays 1px.
 */
.command-workbench-resize-handle {
  position: absolute;
  z-index: 8;
  inset: 0 auto 0 -7px;
  width: 14px;
  border: 0;
  outline: 0;
  background: transparent;
  cursor: col-resize;
  touch-action: none;
}

/* Stays on the workbench edge itself now that the hit area extends past it. */
.command-workbench-resize-handle::before {
  position: absolute;
  inset: 0 auto 0 7px;
  width: 1px;
  background: var(--workbench-border);
  content: "";
  transition:
    width 120ms ease,
    background 120ms ease;
}

.command-workbench-resize-handle:hover::before,
.command-workbench-resize-handle:focus-visible::before,
.command-workbench[data-resizing="true"]
  .command-workbench-resize-handle::before {
  width: 3px;
  background: color-mix(in oklch, var(--accent), var(--workbench-border) 35%);
}

.command-workbench-tabbar {
  position: relative;
  z-index: 4;
  display: flex;
  min-height: 42px;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 4px 8px 4px 10px;
  border-bottom: 1px solid var(--workbench-border);
  background: var(--workbench-surface);
  /*
   * Flex defaults to \`min-width: auto\`, so this bar refused to shrink below the
   * combined width of its tabs. Four tabs at their 128px floor overflowed the
   * workbench and pushed the collapse control past the viewport edge, where it
   * could not be clicked at all. The tab strip scrolls instead.
   */
  min-width: 0;
}

.command-workbench-tabs,
.command-workbench-window-actions {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 4px;
}

/*
 * The tab strip absorbs all the shrinking; the window actions never do. Letting
 * them compress hid the fullscreen and collapse controls once several tabs were
 * open, which left no way to put the workbench away.
 */
.command-workbench-tabs {
  flex: 1 1 auto;
  overflow-x: auto;
  scrollbar-width: none;
}

.command-workbench-window-actions {
  flex: 0 0 auto;
}

.command-workbench-tab {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  /*
   * Shrinks under pressure rather than forcing the strip wider than the
   * workbench. The label ellipsizes while the library action remains visible.
   */
  flex: 0 1 auto;
  min-width: 92px;
  max-width: 220px;
  height: 32px;
  align-items: center;
  overflow: hidden;
  border: 1px solid transparent;
  border-radius: 10px;
  background: transparent;
  color: var(--workbench-muted);
}

.command-workbench-tab[data-active="true"] {
  border-color: transparent;
  background: var(--workbench-hover);
  color: var(--workbench-text);
}

.command-workbench-tab > button:first-child {
  display: flex;
  min-width: 0;
  height: 100%;
  align-items: center;
  gap: 8px;
  padding: 0 4px 0 10px;
  border: 0;
  background: transparent;
  color: inherit;
  cursor: pointer;
}

.command-workbench-tab > button:first-child span {
  min-width: 0;
  overflow: hidden;
  font-size: calc(12px + var(--user-ui-font-delta));
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/*
 * One glyph size across the top row: the workbench controls match the sidebar
 * tools at 15px so no icon on that line reads as larger than its neighbours.
 */
.command-workbench-tab svg,
.command-workbench-library-button svg,
.command-workbench-add svg,
.command-workbench-close svg,
.command-workbench-maximize svg {
  width: 15px;
  height: 15px;
  flex: 0 0 auto;
  stroke-width: 1.7;
}

.command-workbench-tab-close,
.command-workbench-library-button,
.command-workbench-add,
.command-workbench-close,
.command-workbench-maximize {
  display: grid;
  place-items: center;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: var(--workbench-muted);
  cursor: pointer;
  /* The rest of the shell settles its hover; these snapped. */
  transition:
    background 0.14s ease,
    color 0.14s ease;
}

/*
 * 24px was below a comfortable pointer target and made closing a tab a
 * precision exercise. The tab's own grid column widened to match.
 */
.command-workbench-tab-close {
  width: 28px;
  height: 28px;
}

.command-workbench-tab-close:hover,
.command-workbench-library-button:hover,
.command-workbench-library-button:focus-visible,
.command-workbench-add:hover,
.command-workbench-close:hover,
.command-workbench-maximize:hover {
  background: var(--workbench-hover);
  color: var(--workbench-text);
}

.command-workbench-library-button {
  width: 32px;
  height: 32px;
  flex: 0 0 auto;
}

.command-workbench-launcher-anchor {
  position: relative;
  flex: 0 0 auto;
}

.command-workbench-add {
  width: 32px;
  height: 32px;
}

/*
 * Matches the \`+\` button on the same row. At 26px these two sat below a
 * comfortable target and read as visually lighter than their neighbour.
 */
.command-workbench-close,
.command-workbench-maximize {
  width: 32px;
  height: 32px;
  flex: 0 0 auto;
}

/*
 * The workbench collapse control mirrors the sidebar collapse control, so it
 * carries the same box as the tab strip's \`+\` rather than a wider one of its own.
 * Its glyph stays on the 15px top-row size set above: an 18px override made this
 * one icon read as larger than every neighbour on the same line.
 */
.command-workbench .command-workbench-close {
  width: 32px;
  height: 32px;
}

.command-workbench .command-workbench-close svg {
  transform: scaleX(-1);
}

/* Shares the top row's centre line (y=27) with the sidebar tools. */
.command-workbench-close.is-floating {
  position: absolute;
  z-index: 5;
  top: 11px;
  right: 10px;
}

.command-workbench-launcher-menu {
  position: absolute;
  z-index: 10;
  top: calc(100% + 6px);
  left: 0;
  width: 284px;
  padding: 5px;
  border: 1px solid var(--workbench-border);
  border-radius: 12px;
  background: var(--workbench-raised);
  box-shadow: var(--shadow-modal);
}

.command-workbench-content {
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  background: var(--workbench-bg);
}

.command-workbench-panel {
  width: 100%;
  height: 100%;
  min-height: 0;
}

.command-workbench-panel[hidden] {
  display: none;
}

.command-workbench[data-empty="true"] .command-workbench-content {
  display: grid;
  place-items: center;
}

.command-workbench-launcher {
  display: grid;
  width: min(320px, calc(100% - 48px));
  gap: 5px;
}

.command-workbench-launcher-menu .command-workbench-launcher {
  width: 100%;
}

.command-workbench-launcher > button {
  display: flex;
  width: 100%;
  min-height: 38px;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 0 10px;
  border: 0;
  border-radius: 8px;
  background: var(--workbench-raised);
  color: var(--workbench-text);
  cursor: pointer;
  font: inherit;
  text-align: left;
  /* The rest of the shell settles its hover; these snapped. */
  transition:
    background 0.14s ease,
    color 0.14s ease;
}

.command-workbench-launcher-menu .command-workbench-launcher > button {
  background: transparent;
}

.command-workbench-launcher > button:hover,
.command-workbench-launcher > button:focus-visible {
  background: var(--workbench-hover);
  color: var(--workbench-text);
  outline: 0;
}

.command-workbench-launcher > button:disabled {
  cursor: default;
  opacity: 0.52;
}

.command-workbench-launcher > button span {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 9px;
  font-size: calc(12px + var(--user-ui-font-delta));
  font-weight: 500;
}

.command-workbench-launcher > button svg {
  width: 16px;
  height: 16px;
  flex: 0 0 auto;
  color: var(--workbench-muted);
  stroke-width: 1.65;
}

.command-workbench-launcher > button kbd {
  color: var(--workbench-muted);
  font-family: inherit;
  font-size: calc(11px + var(--user-ui-font-delta));
}

.command-workbench-error {
  margin: 16px;
  color: #c44747;
  font-size: calc(12px + var(--user-ui-font-delta));
}

/* Generic panel surface */
.command-workbench-generic-surface {
  width: 100%;
  height: 100%;
  min-height: 0;
  overflow: auto;
  padding: 14px;
  background: var(--workbench-bg);
}

.command-workbench-generic-surface .capability-result {
  max-height: none;
  border-color: var(--workbench-border);
  background: var(--workbench-raised);
  color: var(--workbench-text);
}

/* Browser */
.command-browser {
  display: grid;
  width: 100%;
  height: 100%;
  min-height: 0;
  grid-template-rows: 54px minmax(0, 1fr);
  background: var(--workbench-surface);
}

.command-browser-toolbar {
  display: grid;
  grid-template-columns: auto minmax(180px, 880px) 32px;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 8px 10px;
  border-bottom: 1px solid var(--workbench-border);
}

.command-browser-nav {
  display: flex;
  gap: 2px;
}

.command-browser-menu-anchor {
  position: relative;
}

.command-browser-nav button,
.command-browser-more,
.command-browser-address button {
  display: grid;
  width: 30px;
  height: 30px;
  place-items: center;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: var(--workbench-muted);
  cursor: pointer;
}

.command-browser-nav button:hover:not(:disabled),
.command-browser-more:hover,
.command-browser-address button:hover {
  background: var(--workbench-hover);
  color: var(--workbench-text);
}

.command-browser-nav button:disabled {
  cursor: default;
  opacity: 0.34;
}

.command-browser-nav svg,
.command-browser-more svg,
.command-browser-address svg {
  width: 17px;
  height: 17px;
  stroke-width: 1.65;
}

.command-browser-address {
  position: relative;
  display: grid;
  width: min(880px, 100%);
  grid-template-columns: minmax(0, 1fr) 32px;
  justify-self: center;
  border: 1px solid var(--workbench-border);
  border-radius: 10px;
  background: var(--workbench-surface);
}

.command-browser-address:focus-within {
  border-color: color-mix(in oklch, var(--accent), var(--workbench-border) 48%);
  box-shadow: 0 0 0 2px color-mix(in oklch, var(--accent) 14%, transparent);
}

.command-browser-address input {
  width: 100%;
  min-width: 0;
  height: 34px;
  padding: 0 10px;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--workbench-text);
  font: inherit;
  font-size: calc(12px + var(--user-ui-font-delta));
}

.command-browser-address > span {
  position: absolute;
  top: calc(100% + 5px);
  left: 8px;
  z-index: 2;
  padding: 4px 7px;
  border-radius: 6px;
  background: #8f2f2f;
  color: #fff;
  font-size: calc(11px + var(--user-ui-font-delta));
}

.command-browser-menu {
  position: absolute;
  z-index: 8;
  top: calc(100% + 5px);
  right: 0;
  display: grid;
  width: 180px;
  gap: 2px;
  padding: 5px;
  border: 1px solid var(--workbench-border);
  border-radius: 10px;
  background: var(--workbench-raised);
  box-shadow: var(--shadow-modal);
}

.command-browser-menu button {
  min-height: 30px;
  padding: 0 8px;
  border: 0;
  border-radius: 7px;
  background: transparent;
  color: var(--workbench-text);
  cursor: pointer;
  font: inherit;
  font-size: calc(12px + var(--user-ui-font-delta));
  text-align: left;
}

.command-browser-menu button:hover:not(:disabled) {
  background: var(--workbench-hover);
}

.command-browser-menu button:disabled {
  cursor: default;
  opacity: 0.42;
}

.command-browser-empty,
.command-browser-error,
.command-browser-loading {
  display: grid;
  align-content: center;
  justify-items: center;
  gap: 8px;
  padding: 24px;
  color: var(--workbench-muted);
  text-align: center;
}

.command-browser-empty svg,
.command-browser-error svg {
  width: 30px;
  height: 30px;
  margin-bottom: 4px;
  stroke-width: 1.45;
}

.command-browser-empty strong,
.command-browser-error strong {
  color: var(--workbench-text);
  font-size: calc(14px + var(--user-ui-font-delta));
  font-weight: 500;
}

.command-browser-empty span,
.command-browser-error span,
.command-browser-loading {
  font-size: calc(12px + var(--user-ui-font-delta));
}

.command-browser-viewport {
  position: relative;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  background: var(--workbench-page);
}

.command-browser-viewport iframe {
  width: 100%;
  height: 100%;
  border: 0;
  background: var(--workbench-page);
}

/*
 * A page iframe is its own event target, so during a width drag it captures the
 * pointer the moment it crosses the 9px handle and the resize dies halfway.
 * Pointer capture on the handle is the primary fix; this makes the child
 * document inert for the duration so no engine quirk can steal the drag back.
 */
.command-workbench[data-resizing="true"] .command-browser-viewport iframe {
  pointer-events: none;
}

/* Files */
.command-file-workbench {
  display: grid;
  width: 100%;
  height: 100%;
  min-height: 0;
  grid-template-rows: 44px minmax(0, 1fr);
}

.command-file-toolbar {
  display: flex;
  min-width: 0;
  align-items: center;
  padding: 0 12px;
  border-bottom: 1px solid var(--workbench-border);
}

.command-file-breadcrumbs {
  display: flex;
  flex: 1 1 auto;
  min-width: 0;
  align-items: center;
  overflow: hidden;
  color: var(--workbench-muted);
}

.command-file-toolbar-actions {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 4px;
  margin-left: 10px;
}

.command-file-toolbar-actions button {
  display: flex;
  min-width: 30px;
  height: 30px;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 0 8px;
  border: 0;
  border-radius: 8px;
  background: var(--workbench-raised);
  color: var(--workbench-text);
  cursor: pointer;
  font: inherit;
  font-size: calc(11px + var(--user-ui-font-delta));
}

.command-file-toolbar-actions button:hover:not(:disabled) {
  background: var(--workbench-active);
}

.command-file-toolbar-actions button:disabled {
  cursor: default;
  opacity: 0.42;
}

.command-file-toolbar-actions svg {
  width: 14px;
  height: 14px;
}

.command-file-breadcrumbs > span {
  display: flex;
  min-width: 0;
  align-items: center;
}

.command-file-breadcrumbs svg {
  width: 14px;
  height: 14px;
  flex: 0 0 auto;
}

.command-file-breadcrumbs button {
  min-width: 0;
  overflow: hidden;
  padding: 3px 5px;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: inherit;
  cursor: pointer;
  font: inherit;
  font-size: calc(12px + var(--user-ui-font-delta));
  text-overflow: ellipsis;
  white-space: nowrap;
}

.command-file-breadcrumbs button:hover:not(:disabled) {
  background: var(--workbench-hover);
  color: var(--workbench-text);
}

.command-file-breadcrumbs button:disabled {
  color: var(--workbench-text);
  cursor: default;
}

.command-file-layout {
  display: grid;
  min-height: 0;
  grid-template-columns: minmax(0, 1fr) 280px;
}

.command-file-preview {
  min-width: 0;
  min-height: 0;
  overflow: auto;
  background: var(--workbench-bg);
}

.command-file-empty {
  display: grid;
  min-height: 100%;
  align-content: center;
  justify-items: center;
  gap: 7px;
  color: var(--workbench-muted);
  text-align: center;
}

.command-file-empty svg {
  width: 28px;
  height: 28px;
  margin-bottom: 3px;
  stroke-width: 1.45;
}

.command-file-empty strong {
  color: var(--workbench-text);
  font-size: calc(13px + var(--user-ui-font-delta));
  font-weight: 500;
}

.command-file-empty span {
  font-size: calc(11px + var(--user-ui-font-delta));
}

.command-file-code {
  display: grid;
  min-width: max-content;
  grid-template-columns: 48px minmax(max-content, 1fr);
  padding: 8px 0 36px;
  font-family: var(--font-mono);
  font-size: calc(12px + var(--user-ui-font-delta));
  line-height: 1.55;
  tab-size: 2;
}

.command-file-line-numbers,
.command-file-highlighted-code {
  margin: 0;
  font: inherit;
  line-height: inherit;
}

.command-file-line-numbers {
  display: grid;
  align-content: start;
  padding-right: 12px;
  color: var(--workbench-faint);
  text-align: right;
  user-select: none;
}

.command-file-line-numbers span {
  min-height: 20px;
}

.command-file-highlighted-code {
  padding-right: 24px;
  color: var(--workbench-text);
  white-space: pre;
}

.command-file-highlighted-code code {
  font: inherit;
}

.command-file-highlighted-code .hljs-comment,
.command-file-highlighted-code .hljs-quote {
  color: var(--workbench-faint);
  font-style: italic;
}

.command-file-highlighted-code .hljs-keyword,
.command-file-highlighted-code .hljs-selector-tag,
.command-file-highlighted-code .hljs-literal,
.command-file-highlighted-code .hljs-section,
.command-file-highlighted-code .hljs-link {
  color: var(--workbench-syntax-purple);
}

.command-file-highlighted-code .hljs-string,
.command-file-highlighted-code .hljs-regexp,
.command-file-highlighted-code .hljs-addition,
.command-file-highlighted-code .hljs-attribute {
  color: var(--workbench-syntax-green);
}

.command-file-highlighted-code .hljs-title,
.command-file-highlighted-code .hljs-title.class_,
.command-file-highlighted-code .hljs-title.function_,
.command-file-highlighted-code .hljs-function,
.command-file-highlighted-code .hljs-built_in {
  color: var(--workbench-syntax-blue);
}

.command-file-highlighted-code .hljs-number,
.command-file-highlighted-code .hljs-symbol,
.command-file-highlighted-code .hljs-bullet,
.command-file-highlighted-code .hljs-meta {
  color: var(--workbench-syntax-orange);
}

.command-file-highlighted-code .hljs-type,
.command-file-highlighted-code .hljs-variable,
.command-file-highlighted-code .hljs-template-variable,
.command-file-highlighted-code .hljs-params {
  color: var(--workbench-syntax-cyan);
}

.command-file-highlighted-code .hljs-deletion,
.command-file-highlighted-code .hljs-tag,
.command-file-highlighted-code .hljs-name {
  color: var(--workbench-syntax-red);
}

.command-file-explorer {
  display: grid;
  min-width: 0;
  min-height: 0;
  grid-template-rows: auto auto minmax(0, 1fr);
  overflow: hidden;
  border-left: 1px solid var(--workbench-border);
  background: var(--workbench-surface);
}

.command-file-filter {
  display: grid;
  height: 34px;
  grid-template-columns: 18px minmax(0, 1fr);
  align-items: center;
  gap: 6px;
  margin: 8px 8px 5px;
  padding: 0 8px;
  border: 1px solid var(--workbench-border);
  border-radius: 9px;
  background: var(--workbench-surface);
  color: var(--workbench-muted);
}

.command-file-filter:focus-within {
  border-color: color-mix(in oklch, var(--accent), var(--workbench-border) 48%);
}

.command-file-filter svg {
  width: 15px;
  height: 15px;
}

.command-file-filter input {
  width: 100%;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--workbench-text);
  font: inherit;
  font-size: calc(12px + var(--user-ui-font-delta));
}

.command-file-root {
  display: grid;
  min-height: 30px;
  grid-template-columns: 16px minmax(0, 1fr);
  align-items: center;
  gap: 4px;
  padding: 0 10px;
  border: 0;
  background: transparent;
  color: var(--workbench-text);
  cursor: pointer;
  font: inherit;
  text-align: left;
}

.command-file-root svg {
  width: 14px;
  height: 14px;
}

.command-file-root strong {
  overflow: hidden;
  font-size: calc(12px + var(--user-ui-font-delta));
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.command-file-tree {
  min-height: 0;
  overflow: auto;
  padding: 0 5px 12px;
  scrollbar-width: thin;
}

.command-file-row {
  display: grid;
  width: 100%;
  min-height: 27px;
  grid-template-columns: 14px 16px minmax(0, 1fr);
  align-items: center;
  gap: 5px;
  padding: 2px 6px;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: var(--workbench-text);
  cursor: pointer;
  font: inherit;
  font-size: calc(12px + var(--user-ui-font-delta));
  text-align: left;
}

.command-file-row:hover,
.command-file-row:focus-visible {
  background: var(--workbench-hover);
  outline: 0;
}

.command-file-row.is-active {
  background: var(--workbench-active);
}

.command-file-row:disabled {
  cursor: default;
  opacity: 0.5;
}

.command-file-row svg {
  width: 14px;
  height: 14px;
  color: var(--workbench-muted);
  stroke-width: 1.55;
}

.command-file-row-spacer {
  width: 14px;
}

.command-file-row span {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Terminal */
.command-terminal-workbench {
  display: flex;
  width: 100%;
  height: 100%;
  min-height: 0;
  flex-direction: column;
  background: #151515;
  color: #e8e8e8;
}

.command-terminal-header {
  display: grid;
  min-height: 40px;
  grid-template-columns: auto minmax(0, 1fr) auto 28px;
  align-items: center;
  gap: 12px;
  padding: 0 12px;
  border-bottom: 1px solid #303030;
  background: #1b1b1b;
}

.command-terminal-header > span,
.command-terminal-status {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 6px;
}

.command-terminal-header svg {
  width: 15px;
  height: 15px;
}

.command-terminal-header strong,
.command-terminal-cwd,
.command-terminal-status {
  font-size: calc(11px + var(--user-ui-font-delta));
}

.command-terminal-header strong {
  font-weight: 500;
}

.command-terminal-cwd {
  overflow: hidden;
  color: #8e8e8e;
  font-family: var(--font-mono);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.command-terminal-status {
  color: #8e8e8e;
}

.command-terminal-status svg {
  width: 7px;
  height: 7px;
  fill: #737373;
  color: #737373;
}

.command-terminal-status[data-running="true"] svg {
  fill: #62a66c;
  color: #62a66c;
}

.command-terminal-header > button {
  display: grid;
  width: 26px;
  height: 26px;
  place-items: center;
  padding: 0;
  border: 0;
  border-radius: 7px;
  background: transparent;
  color: #a7a7a7;
  cursor: pointer;
}

.command-terminal-header > button:hover:not(:disabled) {
  background: #303030;
  color: #ededed;
}

.command-terminal-header > button:disabled {
  cursor: default;
  opacity: 0.45;
}

.command-terminal-xterm {
  min-height: 0;
  flex: 1 1 auto;
  overflow: hidden;
  padding: 10px 12px 12px;
  background: #111;
}

.command-terminal-xterm .xterm,
.command-terminal-xterm .xterm-screen,
.command-terminal-xterm .xterm-viewport {
  height: 100%;
}

.command-terminal-xterm .xterm-viewport {
  scrollbar-width: thin;
}

/* Review */
.command-review-workbench {
  display: grid;
  width: 100%;
  height: 100%;
  min-height: 0;
  grid-template-rows: 44px minmax(0, 1fr);
}

.command-review-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 0 10px 0 13px;
  border-bottom: 1px solid var(--workbench-border);
}

.command-review-header > span {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 7px;
}

.command-review-header svg,
.command-review-files svg {
  width: 15px;
  height: 15px;
  flex: 0 0 auto;
}

.command-review-header strong {
  font-size: calc(12px + var(--user-ui-font-delta));
  font-weight: 500;
}

.command-review-header em {
  min-width: 0;
  overflow: hidden;
  color: var(--workbench-muted);
  font-size: calc(11px + var(--user-ui-font-delta));
  font-style: normal;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.command-review-header button {
  display: flex;
  min-height: 30px;
  align-items: center;
  gap: 6px;
  padding: 0 8px;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: var(--workbench-muted);
  cursor: pointer;
  font: inherit;
  font-size: calc(11px + var(--user-ui-font-delta));
}

.command-review-header button:hover:not(:disabled) {
  background: var(--workbench-hover);
  color: var(--workbench-text);
}

.command-review-layout {
  display: grid;
  min-height: 0;
  grid-template-columns: 240px minmax(0, 1fr);
}

.command-review-files {
  min-width: 0;
  min-height: 0;
  overflow: auto;
  padding: 8px 5px 16px;
  border-right: 1px solid var(--workbench-border);
  background: var(--workbench-surface);
}

.command-review-files > strong {
  display: block;
  padding: 4px 8px 7px;
  color: var(--workbench-muted);
  font-size: calc(11px + var(--user-ui-font-delta));
  font-weight: 500;
  text-transform: uppercase;
}

.command-review-files button {
  display: grid;
  width: 100%;
  min-height: 29px;
  grid-template-columns: 16px minmax(0, 1fr);
  align-items: center;
  gap: 6px;
  padding: 3px 7px;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: var(--workbench-text);
  cursor: pointer;
  font: inherit;
  font-size: calc(12px + var(--user-ui-font-delta));
  text-align: left;
}

.command-review-files button:hover,
.command-review-files button[data-active="true"] {
  background: var(--workbench-hover);
}

.command-review-files button span {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.command-review-diff {
  min-width: 0;
  min-height: 0;
  overflow: auto;
  background: var(--workbench-bg);
}

.command-review-diff > p {
  margin: 16px;
  color: #c44747;
}

.command-review-code {
  min-width: max-content;
  padding: 8px 0 32px;
  font-family: var(--font-mono);
  font-size: calc(12px + var(--user-ui-font-delta));
  line-height: 1.55;
}

.command-review-code > div {
  display: grid;
  min-height: 20px;
  grid-template-columns: 48px minmax(max-content, 1fr);
}

.command-review-code > div > span {
  padding-right: 12px;
  color: var(--workbench-faint);
  text-align: right;
  user-select: none;
}

.command-review-code code {
  padding-right: 20px;
  color: var(--workbench-text);
  font: inherit;
  white-space: pre;
}

.command-review-code [data-kind="added"] {
  background: color-mix(in srgb, #2f9d50 16%, transparent);
}

.command-review-code [data-kind="removed"] {
  background: color-mix(in srgb, #d14d4d 14%, transparent);
}

.command-review-code [data-kind="hunk"] {
  background: color-mix(in srgb, #5a7fc0 13%, transparent);
  color: #6d8ec7;
}

.command-review-code [data-kind="meta"] code {
  color: var(--workbench-muted);
}

.command-review-empty {
  display: grid;
  min-height: 100%;
  align-content: center;
  justify-items: center;
  gap: 7px;
  padding: 24px;
  color: var(--workbench-muted);
  text-align: center;
  white-space: pre-wrap;
}

.command-review-empty svg {
  width: 28px;
  height: 28px;
  margin-bottom: 3px;
  stroke-width: 1.45;
}

.command-review-empty strong {
  color: var(--workbench-text);
  font-size: calc(13px + var(--user-ui-font-delta));
  font-weight: 500;
}

.command-review-empty span {
  max-width: 640px;
  font-size: calc(11px + var(--user-ui-font-delta));
}

/*
 * Floats over the canvas rather than sitting in a reserved column: a closed
 * workbench should leave no strip behind.
 *
 * Sizing is stated outright rather than inherited from \`.sidebar-tool\`. This
 * button lives under \`.command-shell-route\`, outside \`.screen-shell\`, so the
 * command-screen sizing never applied to it and the box ended up smaller than
 * the glyph it contains -- clicks beside the icon missed the button entirely.
 * \`display: grid\` + \`place-items: center\` makes the whole box the target.
 */
.command-shell-route .command-workbench-trigger {
  position: absolute;
  top: 10px;
  right: 10px;
  z-index: 45;
  display: grid;
  width: 34px;
  height: 32px;
  place-items: center;
  padding: 0;
  border: 1px solid transparent;
  border-radius: var(--radius-md);
  background: transparent;
  color: var(--n-700);
  box-shadow: none;
  cursor: pointer;
}

.command-shell-route .command-workbench-trigger:hover,
.command-shell-route .command-workbench-trigger:focus-visible {
  background: var(--n-150);
  color: var(--n-950);
  outline: 0;
}

/* Matches the sidebar collapse glyph, so the two rails read as a pair. */
.command-shell-route .command-workbench-trigger svg {
  width: 18px;
  height: 18px;
  stroke-width: 1.75;
}

@media (max-width: 1379px) {
  .command-shell-route[data-capability-sidebar-open="true"] {
    grid-template-columns: minmax(0, 1fr) auto;
  }
}

@container command-workbench (max-width: 560px) {
  .command-file-layout {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) minmax(170px, 38%);
  }

  .command-file-explorer {
    border-top: 1px solid var(--workbench-border);
    border-left: 0;
  }

  .command-review-layout {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(128px, 30%) minmax(0, 1fr);
  }

  .command-review-files {
    border-right: 0;
    border-bottom: 1px solid var(--workbench-border);
  }
}

@media (max-width: 760px) {
  .command-browser-toolbar {
    gap: 5px;
  }
}

/*
 * Scene switch and recommended-task cards.
 *
 * Theme-scoped \`:is(...)\` rules earlier in this file group \`.scene-pills button\`
 * and \`.quick-row button\` with the generic pill controls and pin their color per
 * theme. That outranks the base rules above, which left the selected tab dark
 * text on the dark sliding thumb. These rules restate the intent at higher
 * specificity, and because they resolve through --accent-ink and the neutral
 * scale they stay correct in both themes.
 */
:root[data-theme="light"]
  .command-shell-route
  .screen-shell.command-screen
  .scene-tabs.scene-pills
  button.active {
  border-color: transparent;
  background: transparent;
  color: var(--accent-ink);
}

/*
 * Dark mode paints the thumb from the grey ladder rather than --accent, so the
 * label needs light ink; --accent-ink is near-black to suit the near-white
 * accent and would vanish on the grey thumb.
 */
:root:not([data-theme="light"])
  .command-shell-route
  .screen-shell.command-screen
  .scene-tabs.scene-pills
  button.active {
  border-color: transparent;
  background: transparent;
  color: var(--n-950);
}

/*
 * Theme-scoped \`:is(...)\` rules above match \`.quick-row button\` and flatten its
 * border to transparent. Those use an attribute selector inside \`:is()\`, so they
 * outrank ordinary class selectors; matching that weight with \`:where()\` at zero
 * cost is not enough either. The cards therefore assert their own box at a
 * deliberately higher weight, scoped by the shell so nothing else is affected.
 */
:root[data-theme="light"]
  .command-shell-route
  .screen-shell.command-screen
  .quick-row
  button.quick-card {
  border: 1px solid var(--n-200);
  background: transparent;
  color: var(--text);
}

:root[data-theme="light"]
  .command-shell-route
  .screen-shell.command-screen
  .quick-row
  button.quick-card:hover {
  border: 1px solid var(--n-300);
  background: var(--n-0);
}

/*
 * Dark mode gives the cards a raised fill instead of an outline: a border over a
 * transparent card reads as an empty frame against the near-black canvas.
 */
:root:not([data-theme="light"])
  .command-shell-route
  .screen-shell.command-screen
  .quick-row
  button.quick-card {
  border: 1px solid transparent;
  background: #202020;
  color: var(--text);
}

:root:not([data-theme="light"])
  .command-shell-route
  .screen-shell.command-screen
  .quick-row
  button.quick-card:hover {
  border: 1px solid transparent;
  background: #2a2a2a;
}

/*
 * Scene tabs are painted by the sliding thumb behind them, so each tab must stay
 * transparent. Earlier \`:is(...)\` groups list \`.scene-pills button\` alongside
 * its own container and win on specificity, which gave every tab a fill and a
 * hairline and split the group into three separate boxes. Matching the element
 * as well as the class settles it in both themes.
 */
:root[data-theme]
  .command-shell-route
  .screen-shell.command-screen
  .scene-tabs.scene-pills
  button {
  border-color: transparent;
  background: transparent;
  box-shadow: none;
}
.command-shell .composer-inline-error {
  color: var(--text-danger, #b42318);
  font-size: 12px;
  margin: 6px 16px 0;
}

/*
 * Composer status stack: the progress pill and goal bar sit above the input
 * card, centered on it, so the card keeps one visual weight and the two rows
 * read as reporting on the run rather than as controls inside the composer.
 */
.screen-shell.command-screen .composer-progress-pill {
  display: inline-flex;
  align-items: center;
  justify-self: center;
  gap: 6px;
  min-height: 26px;
  margin: 0 auto 10px;
  padding: 0 12px;
  border: 1px solid var(--n-300);
  border-radius: var(--radius-pill);
  background: var(--n-0);
  color: var(--n-700);
  font-size: calc(12px + var(--user-ui-font-delta));
  white-space: nowrap;
}

.screen-shell.command-screen .composer-progress-spinner {
  width: 13px;
  height: 13px;
  color: var(--n-550);
}

.screen-shell.command-screen .composer-progress-step {
  color: var(--n-850);
  font-weight: 500;
}

.screen-shell.command-screen .composer-progress-separator,
.screen-shell.command-screen .composer-goal-separator {
  color: var(--n-450);
}

.screen-shell.command-screen .composer-progress-diff {
  display: inline-flex;
  gap: 5px;
  font-weight: 500;
}

.screen-shell.command-screen .composer-progress-diff [data-tone="added"] {
  color: var(--ok, #067647);
}

.screen-shell.command-screen .composer-progress-diff [data-tone="removed"] {
  color: var(--text-danger, #b42318);
}

/*
 * The goal bar is a full-width row directly above the input card, one line
 * high, with the objective allowed to truncate so the timer and the three
 * controls stay on the same baseline at every width.
 */
.screen-shell.command-screen .composer-goal-bar {
  display: grid;
  grid-template-columns: 15px auto minmax(0, 1fr) auto auto auto;
  align-items: center;
  gap: 6px;
  min-height: 32px;
  margin: 0 0 4px;
  padding: 0 6px 0 12px;
  border: 0;
  border-radius: var(--radius-lg);
  background: transparent;
  font-size: calc(13px + var(--user-ui-font-delta));
}

.screen-shell.command-screen .composer-goal-icon {
  width: 15px;
  height: 15px;
  color: var(--n-550);
  stroke-width: 1.7;
}

.screen-shell.command-screen .composer-goal-status {
  color: var(--n-950);
  font-weight: 600;
  white-space: nowrap;
}

.screen-shell.command-screen .composer-goal-objective {
  overflow: hidden;
  color: var(--n-750);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.screen-shell.command-screen .composer-goal-input {
  min-width: 0;
  height: 24px;
  border: 1px solid var(--n-400);
  border-radius: var(--radius-sm);
  background: var(--n-0);
  padding: 0 6px;
  color: var(--n-950);
  font: inherit;
}

.screen-shell.command-screen .composer-goal-elapsed {
  color: var(--n-600);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.screen-shell.command-screen .composer-goal-actions {
  display: inline-flex;
  align-items: center;
  gap: 2px;
}

.screen-shell.command-screen .composer-goal-action {
  width: 26px;
  height: 26px;
  min-height: 26px;
  color: var(--n-600);
}

.screen-shell.command-screen .composer-goal-action svg {
  width: 14px;
  height: 14px;
}

.screen-shell.command-screen
  .permission-dropdown
  .select-option[data-tone="warning"] {
  color: var(--warning);
}

/*
 * The canvas, not the viewport, is what the composer has to fit into: the
 * workbench claims up to 840px of a window that stays wide, so viewport
 * breakpoints never fired and the control row was clipped at its right edge.
 * The query lives here because this file loads last; in app.css the later
 * single-line \`.input-tools\` rule won on order.
 */
@container command-canvas (max-width: 520px) {
  .screen-shell.command-screen .input-tools {
    height: auto;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 4px;
    padding-bottom: 8px;
  }

  .screen-shell.command-screen .composer-actions {
    justify-self: end;
  }
}"
`;

exports[`command workspace conversation style > snapshots the compact add-resource palette contract 1`] = `""`;

exports[`command workspace conversation style > snapshots the markdown table sizing contract 1`] = `
{
  "baseContract": ".markdown-content table {
  display: block;
  width: fit-content;
  max-width: 100%;
  overflow: auto;
  border-spacing: 0;
  border-collapse: separate;
  color: inherit;
  font-size: calc(12px + var(--user-ui-font-delta));
}",
  "commandContract": ".message[data-kind="agentMessage"]
  .markdown-content
  table {
  overflow: auto;
  border-radius: var(--radius-lg);
  box-shadow: inset 0 0 0 1px var(--n-250);
}",
}
`;

exports[`command workspace conversation style > snapshots the resizable workbench right-pane contract 1`] = `
".command-shell-route {
  /* Anchors the collapsed capability trigger, which floats rather than
   * occupying a grid column. */
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  width: 100vw;
  height: 100vh;
  height: 100dvh;
  overflow: hidden;
  background: var(--n-25);
  transition: grid-template-columns 180ms ease;
}

.command-shell-route[data-capability-sidebar-open="true"] {
  grid-template-columns: minmax(0, 1fr) auto;
}


.command-workbench {
  --workbench-bg: #171717;
  --workbench-surface: #1d1d1d;
  --workbench-raised: #242424;
  --workbench-hover: #303030;
  --workbench-active: #383838;
  --workbench-border: #303030;
  --workbench-text: #ededed;
  --workbench-muted: #9b9b9b;
  --workbench-faint: #707070;
  --workbench-page: #111;
  --workbench-syntax-blue: #61afef;
  --workbench-syntax-cyan: #56b6c2;
  --workbench-syntax-green: #98c379;
  --workbench-syntax-orange: #d19a66;
  --workbench-syntax-purple: #c678dd;
  --workbench-syntax-red: #e06c75;
  position: relative;
  z-index: 30;
  display: grid;
  width: clamp(420px, 36vw, 520px);
  min-width: 0;
  height: 100%;
  grid-template-rows: 42px minmax(0, 1fr);
  overflow: hidden;
  border-left: 1px solid var(--workbench-border);
  background: var(--workbench-bg);
  color: var(--workbench-text);
  container-name: command-workbench;
  container-type: inline-size;
}

.command-task-board {
  display: grid;
  height: 100%;
  min-height: 0;
  grid-template-rows: auto minmax(0, 1fr);
  overflow: hidden;
  background: var(--workbench-bg);
}

.command-task-board-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  padding: 18px 18px 14px;
  border-bottom: 1px solid var(--workbench-border);
}

.command-task-board-header strong {
  color: var(--workbench-text);
  font-size: calc(15px + var(--user-ui-font-delta));
  font-weight: 600;
}

.command-task-board-header p {
  margin: 4px 0 0;
  color: var(--workbench-muted);
  font-size: calc(11px + var(--user-ui-font-delta));
  line-height: 1.5;
}

.command-task-board-header > span {
  min-width: 26px;
  padding: 3px 8px;
  border-radius: 999px;
  background: var(--workbench-hover);
  color: var(--workbench-muted);
  font-size: 11px;
  text-align: center;
}

.command-task-board-columns {
  display: grid;
  min-width: 0;
  min-height: 0;
  grid-template-columns: repeat(3, minmax(132px, 1fr));
  gap: 10px;
  overflow: auto;
  padding: 12px;
}

.command-task-column {
  display: grid;
  min-width: 0;
  min-height: 0;
  grid-template-rows: auto minmax(0, 1fr);
  overflow: hidden;
  border: 1px solid var(--workbench-border);
  border-radius: 12px;
  background: var(--workbench-surface);
}

.command-task-column > header {
  display: flex;
  min-height: 42px;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 0 10px;
  border-bottom: 1px solid var(--workbench-border);
}

.command-task-column > header span {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 7px;
}

.command-task-column > header svg {
  width: 15px;
  height: 15px;
  color: var(--workbench-muted);
}

.command-task-column > header strong {
  overflow: hidden;
  color: var(--workbench-text);
  font-size: 12px;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.command-task-column > header em {
  color: var(--workbench-faint);
  font-size: 11px;
  font-style: normal;
}

.command-task-column-list {
  display: flex;
  min-height: 0;
  flex-direction: column;
  gap: 8px;
  overflow: auto;
  padding: 8px;
}

.command-task-card {
  display: grid;
  width: 100%;
  gap: 5px;
  padding: 10px;
  border: 1px solid var(--workbench-border);
  border-radius: 9px;
  background: var(--workbench-raised);
  color: var(--workbench-text);
  cursor: pointer;
  font: inherit;
  text-align: left;
}

.command-task-card:hover,
.command-task-card:focus-visible,
.command-task-card[aria-current="true"] {
  border-color: color-mix(in oklch, var(--accent), var(--workbench-border) 55%);
  background: var(--workbench-hover);
  outline: 0;
}

.command-task-card strong,
.command-task-card span {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.command-task-card strong {
  font-size: 12px;
  font-weight: 600;
}

.command-task-card span,
.command-task-card small,
.command-task-column-empty {
  color: var(--workbench-muted);
  font-size: 10px;
}

.command-task-column-empty {
  margin: auto;
  text-align: center;
}

.command-project-board-page {
  display: grid;
  height: 100%;
  min-height: 0;
  grid-template-rows: auto auto minmax(0, 1fr);
  gap: 18px;
  padding: 28px 32px 32px;
}

.command-project-board-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.command-project-board-controls .segmented-tabs {
  display: inline-flex;
  gap: 3px;
  padding: 3px;
  border: 1px solid var(--n-250);
  border-radius: 9px;
  background: var(--n-100);
}

.command-project-board-controls .segmented-tabs button {
  height: 28px;
  padding: 0 10px;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: var(--n-650);
  cursor: pointer;
  font-size: calc(12px + var(--user-ui-font-delta));
}

.command-project-board-controls .segmented-tabs button.active {
  background: var(--n-25);
  color: var(--n-950);
  box-shadow: var(--shadow-raised);
}

.command-project-board-controls .catalog-search {
  width: min(320px, 42%);
}

.command-library-shell-view {
  min-width: 0;
  overflow: hidden;
  background: var(--n-25);
}

.command-library-shell-view > .library-page {
  height: 100%;
  padding: 30px clamp(24px, 5vw, 72px) 64px;
}

.command-library-mode-switch {
  display: flex;
  flex: 0 0 auto;
  gap: 4px;
  padding: 12px 24px 0;
  background: var(--n-25);
}

.command-library-mode-switch button {
  height: 30px;
  padding: 0 12px;
  border: 1px solid transparent;
  border-radius: 8px;
  background: transparent;
  color: var(--n-650);
  cursor: pointer;
}

.command-library-mode-switch button.active {
  border-color: var(--n-250);
  background: var(--n-100);
  color: var(--n-950);
}

.command-control-schedule-page {
  height: 100%;
  min-height: 0;
  overflow: auto;
  padding: 24px 30px 36px;
}

.command-control-schedule-page .catalog-market-header {
  position: static;
}

.command-control-schedule-page .schedule-calendar-shell {
  min-height: 560px;
}

.schedule-section-tabs {
  display: flex;
  gap: 26px;
  border-bottom: 1px solid var(--n-200);
}

.schedule-section-tabs button {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 12px 2px 10px;
  border: 0;
  border-bottom: 2px solid transparent;
  background: transparent;
  color: var(--n-550);
  cursor: pointer;
}

.schedule-section-tabs button.active {
  border-bottom-color: var(--n-950);
  color: var(--n-950);
  font-weight: 600;
}

.schedule-section-tabs svg,
.schedule-scope-row svg,
.schedule-summary-grid svg,
.schedule-history-state svg,
.schedule-history-item svg,
.schedule-team-empty svg {
  width: 16px;
  height: 16px;
}

.schedule-scope-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.schedule-view-switch {
  display: inline-flex;
  gap: 2px;
  padding: 3px;
  border: 1px solid var(--n-200);
  border-radius: 9px;
  background: var(--n-50);
}

.schedule-view-switch button {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 6px 9px;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: var(--n-550);
  cursor: pointer;
}

.schedule-view-switch button[aria-pressed="true"] {
  background: var(--surface);
  color: var(--n-950);
  box-shadow: var(--shadow-xs);
}

.schedule-team-empty,
.schedule-history-state {
  display: flex;
  min-height: 220px;
  align-items: center;
  justify-content: center;
  gap: 12px;
  border: 1px dashed var(--n-250);
  border-radius: 14px;
  color: var(--n-550);
  text-align: left;
}

.schedule-team-empty strong,
.schedule-team-empty p {
  display: block;
  margin: 0;
}

.schedule-team-empty p {
  max-width: 560px;
  margin-top: 5px;
  font-size: 13px;
}

.schedule-history-shell {
  display: grid;
  align-content: start;
  gap: 16px;
}

.schedule-summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.schedule-summary-grid article {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 9px;
  padding: 14px 16px;
  border: 1px solid var(--n-200);
  border-radius: 12px;
  background: var(--surface);
}

.schedule-summary-grid span,
.schedule-history-item p,
.schedule-history-item small {
  color: var(--n-550);
}

.schedule-summary-grid strong {
  font-size: 22px;
}

.schedule-history-list {
  display: grid;
  gap: 8px;
}

.schedule-history-item {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 12px;
  padding: 13px 15px;
  border: 1px solid var(--n-200);
  border-radius: 10px;
  background: var(--surface);
}

.schedule-history-item p,
.schedule-history-item small,
.schedule-history-item em {
  display: block;
  margin: 3px 0 0;
  font-size: 12px;
  font-style: normal;
}

.schedule-run-status {
  display: grid;
  width: 30px;
  height: 30px;
  place-items: center;
  border-radius: 50%;
  background: var(--n-100);
}

.schedule-run-status.is-completed {
  color: var(--success);
}

.schedule-run-status.is-failed {
  color: var(--danger);
}

.schedule-history-state.is-error {
  color: var(--danger);
}

@media (max-width: 820px) {
  .schedule-summary-grid {
    grid-template-columns: 1fr;
  }

  .schedule-scope-row {
    align-items: flex-start;
    flex-direction: column;
  }
}

.command-schedule-list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 12px;
}

.command-schedule-list .library-item {
  max-width: none;
  text-align: left;
}

.team-experts-shell {
  display: grid;
  align-content: start;
  gap: 18px;
  padding: 20px 4px 36px;
}

.team-experts-shell[hidden] {
  display: none;
}

.team-experts-header {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 20px;
}

.team-experts-header h2,
.team-experts-header p {
  margin: 4px 0 0;
}

.team-experts-header > strong {
  min-width: 32px;
  padding: 5px 10px;
  border-radius: 999px;
  background: var(--n-100);
  text-align: center;
}

.team-expert-grid {
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
}

.command-workbench .library-page {
  height: 100%;
  padding: 20px;
}

.command-workbench .library-heading,
.command-workbench .library-item,
.command-workbench .library-empty,
.command-workbench .library-error {
  max-width: none;
}

.sidebar-runtime-account > button {
  display: flex;
  width: 100%;
  align-items: center;
  gap: 10px;
  padding: 8px 10px;
  border: 0;
  background: transparent;
  color: inherit;
  cursor: pointer;
  text-align: left;
}

.command-project-board-toolbar {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
}

.command-project-board-toolbar span {
  color: var(--n-600);
  font-size: calc(11px + var(--user-ui-font-delta));
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.command-project-board-toolbar h2 {
  margin: 5px 0 3px;
  color: var(--n-950);
  font-size: calc(28px + var(--user-ui-font-delta));
  line-height: 1.1;
}

.command-project-board-toolbar p {
  margin: 0;
  color: var(--n-650);
  font-size: calc(12px + var(--user-ui-font-delta));
}

.command-project-board-page > .command-task-board {
  border: 1px solid var(--n-250);
  border-radius: 14px;
  background: var(--n-25);
}

.command-project-board-page .command-task-board-columns {
  grid-template-columns: repeat(3, minmax(120px, 1fr));
}

:root[data-theme="light"] .command-project-board-page > .command-task-board {
  --workbench-bg: #fff;
  --workbench-surface: #fff;
  --workbench-raised: #f6f6f6;
  --workbench-hover: #eee;
  --workbench-border: #e5e5e5;
  --workbench-text: #202020;
  --workbench-muted: #737373;
  --workbench-faint: #a4a4a4;
}

@media (max-width: 760px) {
  .command-project-board-page {
    gap: 12px;
    padding: 18px;
  }

  .command-project-board-toolbar {
    align-items: flex-start;
  }
}


.command-workbench-resize-handle {
  position: absolute;
  z-index: 8;
  inset: 0 auto 0 -7px;
  width: 14px;
  border: 0;
  outline: 0;
  background: transparent;
  cursor: col-resize;
  touch-action: none;
}

/* Stays on the workbench edge itself now that the hit area extends past it. */
.command-workbench-resize-handle::before {
  position: absolute;
  inset: 0 auto 0 7px;
  width: 1px;
  background: var(--workbench-border);
  content: "";
  transition:
    width 120ms ease,
    background 120ms ease;
}

.command-workbench-resize-handle:hover::before,
.command-workbench-resize-handle:focus-visible::before,
.command-workbench[data-resizing="true"]
  .command-workbench-resize-handle::before {
  width: 3px;
  background: color-mix(in oklch, var(--accent), var(--workbench-border) 35%);
}


@media (max-width: 1379px) {
  .command-shell-route[data-capability-sidebar-open="true"] {
    grid-template-columns: minmax(0, 1fr) auto;
  }
}

@container command-workbench (max-width: 560px) {
  .command-file-layout {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) minmax(170px, 38%);
  }

  .command-file-explorer {
    border-top: 1px solid var(--workbench-border);
    border-left: 0;
  }

  .command-review-layout {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(128px, 30%) minmax(0, 1fr);
  }

  .command-review-files {
    border-right: 0;
    border-bottom: 1px solid var(--workbench-border);
  }
}"
`;
