// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`command workspace conversation style > snapshots resource tags and the command file picker contract 1`] = `
"/* Resource attachments stay compact in the composer, while Skill and MCP remain visible in the sent message. */
.composer-resource-tags {
  display: flex;
  min-width: 0;
  flex-wrap: wrap;
  gap: 7px;
}

.command-input > .composer-resource-tags {
  padding: 14px 14px 0;
}

.command-input:has(> .composer-resource-tags) textarea {
  min-height: 62px;
  padding-top: 9px;
}

.screen-shell.command-screen
  .command-input:has(> .composer-resource-tags)
  textarea {
  height: 62px;
  min-height: 62px;
  max-height: 120px;
  padding-top: 9px;
}

.composer-resource-tag {
  display: inline-flex;
  max-width: min(100%, 320px);
  min-height: 28px;
  align-items: center;
  gap: 6px;
  padding: 4px 8px;
  border: 1px solid oklch(88% 0.012 235);
  border-radius: 8px;
  background: oklch(98% 0.006 235);
  color: oklch(36% 0.018 235);
  font-size: 12px;
  line-height: 1;
}

.composer-resource-tag > svg {
  width: 14px;
  height: 14px;
  flex: 0 0 auto;
}

.composer-resource-tag > small {
  color: oklch(51% 0.024 235);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.composer-resource-tag > strong {
  min-width: 0;
  overflow: hidden;
  font-weight: 560;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.composer-resource-tag > button {
  display: inline-grid;
  width: 18px;
  height: 18px;
  flex: 0 0 auto;
  place-items: center;
  padding: 0;
  border: 0;
  border-radius: 5px;
  background: transparent;
  color: oklch(54% 0.02 235);
  cursor: pointer;
}

.composer-resource-tag > button:hover {
  background: oklch(92% 0.012 235);
  color: oklch(28% 0.018 235);
}

.composer-resource-tag > button svg {
  width: 12px;
  height: 12px;
}

.composer-resource-tag[data-resource-kind="file"] {
  border-color: oklch(86% 0.04 245);
  background: oklch(97% 0.018 245);
  color: oklch(39% 0.07 245);
}

.composer-resource-tag[data-resource-kind="folder"] {
  border-color: oklch(86% 0.045 85);
  background: oklch(97% 0.022 85);
  color: oklch(40% 0.07 75);
}

.composer-resource-tag[data-resource-kind="image"] {
  border-color: oklch(87% 0.045 315);
  background: oklch(97% 0.018 315);
  color: oklch(42% 0.075 315);
}

.composer-resource-tag[data-resource-kind="knowledge"] {
  border-color: oklch(86% 0.04 205);
  background: oklch(97% 0.018 205);
  color: oklch(39% 0.07 205);
}

.composer-resource-tag[data-resource-kind="skill"] {
  border-color: oklch(86% 0.045 275);
  background: oklch(97% 0.018 275);
  color: oklch(40% 0.08 275);
}

.composer-resource-tag[data-resource-kind="mcp"] {
  border-color: oklch(85% 0.045 155);
  background: oklch(97% 0.018 155);
  color: oklch(38% 0.07 155);
}

.message-body > .composer-resource-tags {
  margin-top: 8px;
}

/* Command workspace keeps the CrewON conversation beside a Codex-style workbench. */
.command-shell-route {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  width: 100vw;
  height: 100vh;
  height: 100dvh;
  overflow: hidden;
  background: oklch(98.5% 0.006 235);
  transition: grid-template-columns 180ms ease;
}

.command-shell-route[data-capability-sidebar-open="true"] {
  grid-template-columns: minmax(820px, 0.86fr) minmax(560px, 1fr);
}

.command-shell-route > .screen-shell.command-screen {
  width: auto;
  max-width: 100%;
  min-width: 0;
}

.command-shell-route > .screen-shell.command-screen .command-window {
  width: 100%;
  min-width: 0;
}

.command-capability-sidebar {
  position: relative;
  z-index: 30;
  display: grid;
  min-width: 0;
  height: 100vh;
  height: 100dvh;
  grid-template-rows: 44px minmax(0, 1fr);
  overflow: hidden;
  border-left: 1px solid oklch(89% 0.009 235);
  background: oklch(98.8% 0.002 235);
  box-shadow: none;
}

.command-capability-sidebar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 0 8px 0 13px;
  border-bottom: 1px solid oklch(90% 0.008 235);
}

.command-capability-sidebar-header strong {
  min-width: 0;
  overflow: hidden;
  color: oklch(24% 0.016 235);
  font-size: 13px;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.command-capability-sidebar-close {
  flex: 0 0 auto;
  width: 30px;
  height: 30px;
  border: 0;
  background: transparent;
}

.command-capability-sidebar-close svg {
  transform: scaleX(-1);
}

.command-shell-route[data-capability-sidebar-open="false"] {
  grid-template-columns: minmax(0, 1fr) 44px;
}

.command-capability-sidebar-trigger {
  position: relative;
  z-index: 45;
  align-self: start;
  justify-self: center;
  margin-top: 10px;
  width: 34px;
  height: 32px;
  border-color: transparent;
  background: transparent;
  box-shadow: none;
  backdrop-filter: none;
}

.command-capability-sidebar-trigger svg {
  width: 18px;
  height: 18px;
  transform: scaleX(-1) rotate(180deg);
}

.command-capability-sidebar .capability-dock {
  position: static;
  display: grid;
  grid-template-rows: auto minmax(0, 1fr);
  width: 100%;
  min-height: 0;
  gap: 0;
  overflow: hidden;
  padding: 0;
}

.command-capability-sidebar .capability-tool-tabs {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 2px;
  min-height: 38px;
  padding: 4px 8px;
  border-bottom: 1px solid oklch(91% 0.007 235);
}

.command-capability-sidebar .capability-tool-tabs > button {
  display: inline-grid;
  width: 28px;
  min-width: 28px;
  height: 28px;
  place-items: center;
  padding: 0;
  border: 1px solid transparent;
  border-radius: 6px;
  background: transparent;
  color: oklch(46% 0.014 235);
}

.command-capability-sidebar .capability-tool-tabs > button:hover,
.command-capability-sidebar .capability-tool-tabs > button:focus-visible,
.command-capability-sidebar .capability-tool-tabs > button[data-active="true"] {
  border-color: oklch(89% 0.009 235);
  background: oklch(94.8% 0.007 235);
  color: oklch(24% 0.02 235);
  outline: 0;
}

.command-capability-sidebar .capability-tool-tabs .capability-label {
  display: inline-grid;
  width: 100%;
  height: 100%;
  place-items: center;
  overflow: hidden;
  font-size: 0;
}

.command-capability-sidebar .capability-tool-tabs svg {
  width: 16px;
  height: 16px;
  stroke-width: 1.75;
}

.command-capability-sidebar .capability-tool-tabs kbd {
  display: none;
}

.command-capability-sidebar .capability-dock-content {
  min-height: 0;
  overflow: auto;
  overscroll-behavior: contain;
}

.command-capability-sidebar .capability-result {
  display: grid;
  max-height: none;
  gap: 11px;
  margin: 0;
  padding: 10px 12px 20px;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: oklch(31% 0.016 235);
  font-size: 12px;
}

.command-capability-sidebar .capability-result-header {
  display: grid;
  align-items: start;
  justify-content: stretch;
  gap: 0;
  padding: 0 2px 8px;
  border-bottom: 0;
}

.command-capability-sidebar .capability-result-header strong {
  display: none;
}

.command-capability-sidebar .capability-result-header span {
  color: oklch(54% 0.016 235);
  font-size: 10.5px;
  line-height: 1.35;
}

.command-capability-sidebar .capability-result-summary {
  margin: -2px 2px 0;
  color: oklch(48% 0.014 235);
  font-size: 11.5px;
  line-height: 1.5;
  white-space: pre-wrap;
}

.command-capability-sidebar .capability-command-form input,
.command-capability-sidebar .capability-field-list input,
.command-capability-sidebar .capability-field-list select {
  height: 32px;
  border: 1px solid oklch(88.5% 0.009 235);
  border-radius: 7px;
  background: oklch(99% 0.003 235);
  color: oklch(31% 0.016 235);
}

.command-capability-sidebar .capability-field-list {
  gap: 9px;
}

.command-capability-sidebar .capability-field-list label {
  gap: 5px;
}

.command-capability-sidebar .capability-field-list span {
  color: oklch(51% 0.014 235);
  font-size: 11px;
}

.command-capability-sidebar .capability-result-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 6px;
}

.command-capability-sidebar .capability-command-form button,
.command-capability-sidebar .capability-result-actions button {
  flex: 0 0 auto;
  height: 30px;
  padding: 0 10px;
  border: 1px solid oklch(88% 0.01 235);
  border-radius: 7px;
  background: oklch(96% 0.007 235);
  color: oklch(32% 0.018 235);
  font-size: 11.5px;
  white-space: nowrap;
}

.command-capability-sidebar .capability-result-actions button:hover,
.command-capability-sidebar .capability-result-actions button:focus-visible,
.command-capability-sidebar .capability-command-form button:hover,
.command-capability-sidebar .capability-command-form button:focus-visible {
  border-color: oklch(82% 0.014 235);
  background: oklch(92.5% 0.009 235);
  outline: 0;
}

.command-capability-sidebar .capability-result-output {
  max-height: none;
  padding: 10px 11px;
  border: 1px solid oklch(90% 0.007 235);
  border-radius: 7px;
  background: oklch(97.2% 0.004 235);
  color: oklch(31% 0.018 235);
}

.command-capability-sidebar
  .capability-result:is(
    [data-panel-kind="terminal"],
    [data-panel-kind="review"]
  )
  .capability-result-output {
  max-height: calc(100dvh - 248px);
  overflow: auto;
  border-color: oklch(90% 0.007 235);
  background: oklch(97.2% 0.004 235);
  color: oklch(31% 0.018 235);
  overscroll-behavior: contain;
}

.command-capability-sidebar .capability-result-list {
  gap: 0;
  margin: 0;
  padding: 3px;
  border: 1px solid oklch(91% 0.007 235);
  border-radius: 8px;
  background: oklch(99.2% 0.002 235);
}

.command-capability-sidebar .capability-result-item {
  display: grid;
  grid-template-columns: 18px minmax(0, 1fr);
  width: 100%;
  min-height: 32px;
  align-items: center;
  gap: 6px;
  padding: 3px 7px;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: oklch(31% 0.018 235);
  font-family: inherit;
  font-size: 12px;
  text-decoration: none;
}

.command-capability-sidebar .capability-result-item:hover,
.command-capability-sidebar .capability-result-item:focus-visible {
  background: oklch(94.8% 0.007 235);
  color: oklch(20% 0.022 235);
  outline: 0;
  text-decoration: none;
}

.command-capability-sidebar .capability-result-item.is-static {
  grid-template-columns: 18px minmax(0, 1fr);
}

.command-capability-sidebar
  .capability-result-item:not([data-has-icon="true"]) {
  grid-template-columns: minmax(0, 1fr);
}

.command-capability-sidebar
  .capability-result-item.is-static:not([data-has-icon="true"]) {
  grid-template-columns: minmax(0, 1fr);
}

.command-capability-sidebar .capability-result-item-icon {
  display: grid;
  color: oklch(54% 0.012 235);
  place-items: center;
}

.command-capability-sidebar .capability-result-item-icon svg {
  width: 14px;
  height: 14px;
  stroke-width: 1.6;
}

.command-capability-sidebar
  .capability-result[data-panel-kind="files"]
  .capability-result-item-icon {
  color: oklch(54% 0.012 235);
}

.command-capability-sidebar .capability-result-item-label {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

:root[data-theme="light"]
  .command-capability-sidebar
  .capability-result-item {
  background: transparent;
  color: oklch(31% 0.018 235);
}

:root[data-theme="light"]
  .command-capability-sidebar
  .capability-result-item:hover,
:root[data-theme="light"]
  .command-capability-sidebar
  .capability-result-item:focus-visible {
  background: oklch(94.8% 0.007 235);
  color: oklch(20% 0.022 235);
}

.command-capability-sidebar-empty {
  position: static;
  display: grid;
  align-content: center;
  gap: 5px;
  min-height: 220px;
  padding: 24px 28px;
  color: oklch(52% 0.016 235);
  text-align: center;
}

.command-capability-sidebar-empty strong {
  color: oklch(36% 0.018 235);
  font-size: 13px;
}

.command-capability-sidebar-empty p {
  margin: 0;
  font-size: 12px;
  line-height: 1.55;
}

@media (max-width: 1080px) {
  .command-shell-route[data-capability-sidebar-open="true"] {
    grid-template-columns: minmax(0, 1fr) 340px;
  }
}

@media (max-width: 880px) {
  .command-shell-route[data-capability-sidebar-open="true"] {
    grid-template-columns: minmax(0, 1fr);
  }

  .command-capability-sidebar {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(380px, calc(100vw - 32px));
    box-shadow: -24px 0 70px rgb(22 31 43 / 0.2);
  }

  .command-shell-route[data-capability-sidebar-open="true"]
    .command-capability-sidebar::before {
    position: fixed;
    z-index: -1;
    inset: 0;
    background: rgb(21 30 42 / 0.16);
    content: "";
    pointer-events: none;
    backdrop-filter: blur(1.5px);
  }
}

@media (max-width: 520px) {
  .command-capability-sidebar {
    width: 100vw;
  }
}"
`;

exports[`command workspace conversation style > snapshots the assistant and home conversation alignment contract 1`] = `
"/* Assistant uses the same real thread transcript and composer as the home chat. */
.shell-page-view.assistant-only-view {
  background: oklch(99% 0.002 235);
}
.assistant-single-conversation {
  position: relative;
  display: grid;
  grid-template-rows: minmax(0, 1fr) auto;
  width: min(1180px, calc(100% - 88px));
  height: calc(100% - 38px);
  min-height: 0;
  margin: 19px auto;
  padding: 0;
  gap: 12px;
}
.assistant-conversation-actions {
  position: absolute;
  top: 2px;
  left: 50%;
  z-index: 4;
  display: flex;
  width: min(780px, 100%);
  justify-content: flex-end;
  pointer-events: none;
  transform: translateX(-50%);
}
.assistant-clear-conversation {
  display: inline-flex;
  min-height: 30px;
  align-items: center;
  gap: 6px;
  padding: 0 9px;
  border: 1px solid transparent;
  border-radius: 9px;
  background: rgb(255 255 255 / 0.76);
  color: oklch(48% 0.018 235);
  cursor: pointer;
  font-size: 12px;
  font-weight: 620;
  pointer-events: auto;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}
.assistant-clear-conversation svg {
  width: 14px;
  height: 14px;
}
.assistant-clear-conversation:hover:not(:disabled),
.assistant-clear-conversation:focus-visible:not(:disabled) {
  border-color: oklch(88% 0.018 25);
  background: oklch(97% 0.012 25);
  color: oklch(48% 0.12 25);
  outline: 0;
}
.assistant-clear-conversation:focus-visible {
  box-shadow: 0 0 0 3px oklch(72% 0.08 25 / 0.16);
}
.assistant-clear-conversation:disabled {
  cursor: not-allowed;
  opacity: 0.42;
}
.assistant-empty-state {
  display: grid;
  align-content: center;
  justify-items: center;
  width: min(620px, 100%);
  margin: 0 auto;
  color: oklch(49% 0.014 235);
  text-align: center;
  gap: 10px;
}
.assistant-empty-state > span {
  display: grid;
  width: 48px;
  height: 48px;
  place-items: center;
  border: 1px solid oklch(88% 0.012 235);
  border-radius: 16px;
  background: oklch(100% 0 0);
  color: oklch(40% 0.06 225);
  box-shadow: 0 12px 30px rgb(18 26 38 / 0.05);
}
.assistant-empty-state svg {
  width: 22px;
  height: 22px;
}
.assistant-empty-state strong {
  color: oklch(24% 0.018 235);
  font-size: 17px;
  font-weight: 720;
}
.assistant-empty-state p {
  max-width: 520px;
  margin: 0;
  font-size: 13px;
  line-height: 1.7;
}
.assistant-single-conversation .command-thread-room {
  min-height: 0;
}
.assistant-thread-room .message[data-kind="userMessage"] {
  display: grid;
  justify-content: stretch;
}
.assistant-thread-room .message[data-kind="userMessage"] .message-body {
  width: fit-content;
  max-width: min(620px, 82%);
  justify-self: end;
}
.assistant-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content {
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.assistant-thread-room
  .message[data-kind="userMessage"]
  .markdown-content {
  border-radius: 20px;
  box-shadow: none;
}
.assistant-composer-zone {
  display: grid;
  justify-self: center;
  width: min(780px, 100%);
  gap: 0;
}
.assistant-home-composer {
  width: 100%;
  margin: 0;
  border-color: oklch(88.5% 0.01 235);
  border-radius: 20px;
  background: oklch(100% 0 0);
  box-shadow: 0 14px 34px rgb(18 26 38 / 0.06);
}
.assistant-home-composer textarea {
  height: 80px;
  min-height: 80px;
  max-height: 160px;
  padding: 15px 15px 7px;
  color: inherit;
  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "SF Pro Text",
    "PingFang SC",
    "Hiragino Sans GB",
    "Segoe UI",
    system-ui,
    sans-serif;
  font-size: 13.5px;
  line-height: 1.45;
  letter-spacing: 0;
  -webkit-font-smoothing: antialiased;
}
.assistant-home-composer .input-tools {
  min-height: 56px;
  height: auto;
  padding: 0 12px 0 16px;
}
.assistant-home-composer .composer-state-row {
  min-height: 34px;
  padding: 7px 12px;
}
@media (max-width: 860px) {
  .assistant-single-conversation {
    width: calc(100% - 28px);
    height: calc(100% - 28px);
    min-height: 0;
    margin: 14px auto;
    padding: 0;
  }
  .assistant-home-composer .input-tools {
    padding: 8px 10px;
  }
}
@media (max-width: 560px) {
  .assistant-clear-conversation {
    width: 30px;
    justify-content: center;
    padding: 0;
  }
  .assistant-clear-conversation span {
    display: none;
  }
}"
`;

exports[`command workspace conversation style > snapshots the compact Codex-inspired transcript contract 1`] = `
"/* Keep active conversations close to Codex's quiet transcript hierarchy. */
/* Home chat + Assist share one top-aligned column — never vertically float mid-page. */
.screen-shell.command-screen .hero-center.has-command-thread,
.assistant-single-conversation {
  top: 0;
  left: 50%;
  display: grid;
  grid-template-rows: minmax(0, 1fr) auto;
  align-content: stretch;
  justify-items: stretch;
  width: min(1180px, calc(100% - 88px));
  height: calc(100% - 38px);
  margin: 0;
  transform: translateX(-50%);
  gap: 12px;
}

.assistant-single-conversation {
  position: relative;
  left: auto;
  margin: 19px auto;
  transform: none;
}

.screen-shell.command-screen .command-thread-room .message-list,
.assistant-thread-room .message-list {
  gap: 16px;
  padding: 22px 12px 22px;
  scrollbar-gutter: stable both-edges;
}

.screen-shell.command-screen .command-input.thread-command-input,
.assistant-single-conversation .command-input {
  width: min(780px, 100%);
}

.screen-shell.command-screen .command-thread-toolbar {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 16px;
  width: min(780px, 100%);
  min-height: 36px;
  padding: 8px 2px 11px;
  border-bottom: 1px solid rgba(24, 24, 27, 0.08);
  color: #71717a;
}

.screen-shell.command-screen .command-thread-identity {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 0;
}

.screen-shell.command-screen .command-thread-identity > strong {
  min-width: 0;
  overflow: hidden;
  color: #3f3f46;
  font-size: 13px;
  font-weight: 550;
  line-height: 1.3;
  letter-spacing: 0;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.screen-shell.command-screen .command-thread-cwd {
  max-width: min(160px, 20vw);
  min-height: auto;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: #8a8f98;
  font-size: 12px;
  font-style: normal;
  font-weight: 500;
}

.screen-shell.command-screen .command-thread-cwd::before {
  content: "·";
  margin: 0 8px;
  color: #c4c4c8;
}

.screen-shell.command-screen .command-thread-runtime {
  gap: 6px;
  color: #8a8f98;
}

.screen-shell.command-screen .command-thread-runtime strong {
  gap: 6px;
  color: #71717a;
  font-size: 12px;
  font-weight: 500;
}

.screen-shell.command-screen .command-thread-runtime strong::before {
  width: 6px;
  height: 6px;
  background: #c4c4c8;
}

