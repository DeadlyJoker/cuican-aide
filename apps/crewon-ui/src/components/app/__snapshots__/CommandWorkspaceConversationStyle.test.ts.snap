}

:root:not([data-theme="light"])
  .screen-shell.command-screen
  .command-input
  textarea::placeholder,
:root:not([data-theme="light"]) .assistant-home-composer textarea::placeholder {
  color: #7a7a7e;
}

:root[data-theme="light"]
  .screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content,
:root[data-theme="light"]
  .assistant-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content {
  color: #1a1a1a;
}

:root[data-theme="light"]
  .screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  :is(h1, h2, h3, h4, strong),
:root[data-theme="light"]
  .assistant-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  :is(h1, h2, h3, h4, strong) {
  color: #111111;
}

:root[data-theme="light"]
  .screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  :not(pre)
  > code,
:root[data-theme="light"]
  .assistant-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  :not(pre)
  > code {
  background: rgba(24, 24, 27, 0.06);
  color: #1a1a1a;
}

:root[data-theme="light"]
  .screen-shell.command-screen
  .command-thread-room
  .message[data-kind="userMessage"]
  .markdown-content,
:root[data-theme="light"]
  .assistant-thread-room
  .message[data-kind="userMessage"]
  .markdown-content {
  background: #f0f0f0;
  color: #1a1a1a;
}

:root[data-theme="light"]
  .screen-shell.command-screen
  .command-input
  textarea,
:root[data-theme="light"] .assistant-home-composer textarea,
:root[data-theme="light"]
  .assistant-single-conversation
  .command-input
  textarea {
  color: #1a1a1a;
}

.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="userMessage"]
  .message-body {
  max-width: min(560px, 76%);
}

.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="userMessage"]
  .markdown-content,
.assistant-thread-room .message[data-kind="userMessage"] .markdown-content {
  padding: 8px 13px;
  border: 0;
  border-radius: 14px;
  box-shadow: none;
  /* Theme bubble fill/text set by data-theme rules above. */
  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "SF Pro Text",
    "PingFang SC",
    "Hiragino Sans GB",
    "Segoe UI",
    system-ui,
    sans-serif;
  font-size: 13.5px;
  font-weight: 400;
  line-height: 1.45;
  letter-spacing: 0;
  text-wrap: pretty;
  -webkit-font-smoothing: antialiased;
}

.screen-shell.command-screen .command-input textarea,
.assistant-home-composer textarea,
.assistant-single-conversation .command-input textarea {
  font-size: 13.5px;
  font-weight: 400;
  line-height: 1.45;
  letter-spacing: 0;
}

.screen-shell.command-screen .command-input textarea::placeholder,
.assistant-home-composer textarea::placeholder,
.assistant-single-conversation .command-input textarea::placeholder {
  color: #8a8f98;
  opacity: 1;
}

.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="userMessage"]
  .markdown-content
  > :first-child {
  margin-top: 0;
}

.screen-shell.command-screen
  .command-thread-room
  .message[data-kind="userMessage"]
  .markdown-content
  > :last-child {
  margin-bottom: 0;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .message[data-transcript-variant="process"] {
  grid-template-columns: minmax(0, 1fr);
  column-gap: 0;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .message[data-transcript-variant="process"]::before {
  display: none;
}

/* Tool cards self-describe; the duplicated role header only adds noise. */
.screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .message[data-transcript-variant="process"]
  .message-header {
  display: none;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .message[data-transcript-variant="process"]
  .message-body {
  grid-column: 1;
  padding-left: 0;
}

/* The turn status owns the execution disclosure; tool batches stay inside it. */
.screen-shell.command-screen
  .command-thread-room
  .turn-process-details {
  justify-items: stretch;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-summary {
  width: 100%;
  max-width: none;
  min-height: 38px;
  justify-self: stretch;
  justify-content: flex-start;
  gap: 7px;
  margin: 0;
  padding: 0 0 12px;
  border: 0;
  border-bottom: 1px solid #e4e6e9;
  border-radius: 0;
  background: transparent;
  color: #7b818a;
  transform: none;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-summary::before {
  order: 3;
  width: 7px;
  height: 7px;
  margin-left: 2px;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-summary-main {
  display: inline-flex;
  align-items: baseline;
  gap: 6px;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-title,
.screen-shell.command-screen
  .command-thread-room
  .turn-process-summary
  em {
  color: inherit;
  font-size: 14px;
  font-weight: 570;
  line-height: 1.4;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-summary:hover,
.screen-shell.command-screen
  .command-thread-room
  .turn-process-summary:focus-visible {
  border-color: #d9dce1;
  background: transparent;
  color: #555b64;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-details[data-state="expanded"]
  .turn-process-summary,
.screen-shell.command-screen
  .command-thread-room
  .turn-process-details[data-state="collapsing"]
  .turn-process-summary {
  margin-bottom: 18px;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-items {
  gap: 18px;
  padding: 2px 0 4px;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .message[data-process-note="true"] {
  margin: 0;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .message[data-process-note="true"]
  .markdown-content {
  max-width: 100%;
  color: #22252a;
  font-size: 14.5px;
  font-weight: 430;
  line-height: 1.65;
  letter-spacing: -0.009em;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .message[data-has-icon="true"] {
  grid-template-columns: 22px minmax(0, 1fr);
  column-gap: 8px;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .message[data-has-icon="true"]
  .message-icon {
  display: grid;
  width: 20px;
  height: 26px;
  place-items: center;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #8a9098;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .message[data-has-icon="true"]
  .message-body {
  grid-column: 2;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .tool-card-header,
.screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .process-card
  summary {
  min-height: 26px;
  padding: 0;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  :is(.tool-action-verb, .reasoning-card-headline),
.screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  :is(.command-card-header, .file-read-header, .file-change-header, .tool-call-header, .action-card-header)
  code {
  color: #777d85;
  font-size: 13px;
  font-weight: 480;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .tool-action-verb {
  font-weight: 570;
}

.process-action-group {
  display: block;
  width: 100%;
  color: #777d85;
}

.process-action-group > summary {
  display: grid;
  grid-template-columns: 22px minmax(0, 1fr) auto;
  min-height: 28px;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  list-style: none;
  font-size: 13px;
  font-weight: 560;
}

.process-action-group > summary::-webkit-details-marker {
  display: none;
}

.process-action-group > summary::after {
  width: 7px;
  height: 7px;
  margin-right: 3px;
  border-right: 1.5px solid currentColor;
  border-bottom: 1.5px solid currentColor;
  opacity: 0.72;
  content: "";
  transform: rotate(45deg);
  transition: transform 160ms ease;
}

.process-action-group[open] > summary::after {
  transform: translateY(2px) rotate(225deg);
}

.process-action-group-icon {
  display: grid;
  width: 20px;
  height: 24px;
  place-items: center;
  color: #8a9098;
}

.process-action-group-items {
  display: grid;
  gap: 4px;
  margin: 4px 0 0 10px;
  padding: 2px 0 2px 20px;
  border-left: 1px solid #e1e3e6;
}

.screen-shell.command-screen
  .command-thread-room
  .turn-process-details
  + .message[data-kind="agentMessage"] {
  margin-top: 6px;
}

@media (max-width: 860px) {
  .screen-shell.command-screen .command-thread-room .message-list {
    padding: 16px 14px 18px;
  }

  .screen-shell.command-screen
    .command-thread-room
    .message[data-kind="agentMessage"]
    .markdown-content,
  .screen-shell.command-screen
    .command-thread-room
    .message[data-kind="plan"]
    .markdown-content,
  .assistant-thread-room
    .message[data-kind="agentMessage"]
    .markdown-content {
    font-size: 13px;
    line-height: 1.42;
  }

  .screen-shell.command-screen .command-input textarea,
  .assistant-home-composer textarea {
    font-size: 13px;
    line-height: 1.42;
  }
}

/* Keep the whole command shell on the same appearance preference. */
:root[data-theme="dark"] .screen-shell.command-screen {
  --command-sidebar-bg: #202020;
  --command-sidebar-border: #303030;
  --command-sidebar-hover: #292929;
  --command-sidebar-active: #343434;
  --command-control-bg: #242424;
  --command-control-border: #3a3a3a;
  background: #171717;
  color: #ededed;
}

:root[data-theme="dark"] .command-shell-route,
:root[data-theme="dark"] .screen-shell.command-screen .command-window,
:root[data-theme="dark"] .screen-shell.command-screen .command-canvas,
:root[data-theme="dark"] .screen-shell.command-screen .shell-page-view {
  background: #171717;
  color: #ededed;
}

:root[data-theme="dark"] .screen-shell.command-screen .command-sidebar {
  border-color: var(--command-sidebar-border);
  background: var(--command-sidebar-bg);
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  :is(
    .sidebar-brand,
    .sidebar-brand small,
    .space-tree,
    .sidebar-nav em,
    .sidebar-empty-hint,
    .conversation-item em
  ) {
  color: #9b9b9b;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  :is(
    .sidebar-nav a,
    .sidebar-nav button,
    .sidebar-tool,
    .tree-head button,
    .space-title button,
    .conversation-item,
    .sidebar-account summary
  ) {
  color: #d6d6d6;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  .sidebar-nav
  :is(a, button) {
  background: transparent;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  :is(
    .sidebar-nav a,
    .sidebar-nav button,
    .sidebar-tool,
    .space-title button,
    .conversation-item,
    .sidebar-account summary
  ):hover,
:root[data-theme="dark"]
  .screen-shell.command-screen
  .sidebar-nav
  button.active,
:root[data-theme="dark"]
  .screen-shell.command-screen
  .conversation-item.active {
  background: var(--command-sidebar-hover);
  color: #f5f5f5;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  :is(
    .sidebar-search-panel,
    .sidebar-workspace-form,
    .sidebar-account-popover
  ) {
  border-color: #393939;
  background: #242424;
  color: #ededed;
  box-shadow: 0 16px 44px rgb(0 0 0 / 0.34);
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  :is(.sidebar-search-field, .sidebar-workspace-form input) {
  border-color: #3c3c3c;
  background: #1d1d1d;
  color: #ededed;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  :is(
    .home-title h1,
    .home-title h1 span:first-child,
    .command-thread-room .message-role,
    .command-input textarea
  ) {
  color: #f1f1f1;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  :is(
    .scene-subtitle,
    .capability-summary,
    .command-thread-identity > span,
    .command-thread-cwd,
    .command-thread-room .message-type,
    .composer-state-row
  ) {
  color: #a3a3a3;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  :is(
    .scene-pills,
    .scene-pills button,
    .quick-row button,
    .input-tools button:not(.send-button),
    .workspace-pill,
    .command-input,
    .control-select .select-trigger,
    .workspace-picker .select-trigger
  ) {
  border-color: #393939;
  background: #242424;
  color: #dcdcdc;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  :is(
    .scene-pills button,
    .quick-row button,
    .input-tools button:not(.send-button),
    .control-select .select-trigger,
    .workspace-picker .select-trigger
  ):hover {
  border-color: #505050;
  background: #303030;
  color: #fff;
}

:root[data-theme="dark"] .screen-shell.command-screen .command-thread-toolbar {
  border-color: rgba(255, 255, 255, 0.08);
}

:root[data-theme="dark"] .screen-shell.command-screen .command-thread-cwd {
  background: transparent;
  color: #a1a1aa;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-room
  :is(.message[data-kind="agentMessage"], .message[data-kind="plan"])
  .markdown-content,
:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-room
  .message[data-kind="userMessage"]
  .markdown-content,
:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-room
  .turn-process-details {
  color: #dedede;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-room
  .turn-process-summary {
  border-bottom-color: #303030;
  color: #a0a0a0;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-room
  .turn-process-summary:hover,
:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-room
  .turn-process-summary:focus-visible {
  border-bottom-color: #3a3a3a;
  background: transparent;
  color: #b8b8b8;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .message[data-process-note="true"]
  .markdown-content,
:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .message[data-process-note="true"]
  .markdown-content
  :is(p, li, strong, em, code) {
  color: #f0f0f0;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .message[data-process-note="true"]
  .markdown-content
  :not(pre)
  > code {
  border-color: #363636;
  background: #2a2a2a;
  color: #ededed;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  .message-icon,
:root[data-theme="dark"] .process-action-group-icon {
  color: #a0a0a0;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  :is(.tool-action-verb, .reasoning-card-headline),
:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-room
  .turn-process-items
  :is(.command-card-header, .file-read-header, .file-change-header, .tool-call-header, .action-card-header)
  code,
:root[data-theme="dark"] .process-action-group {
  color: #a8a8a8;
}

:root[data-theme="dark"] .process-action-group-items {
  border-left-color: #343434;
}

:root[data-theme="dark"]
  .screen-shell.command-screen
  .command-thread-room
  .message[data-kind="userMessage"]
  .markdown-content {
  border-color: #3b3b3b;
  background: #242424;
}

:root[data-theme="dark"] .command-capability-sidebar {
  border-color: #303030;
  background: #1e1e1e;
  color: #ededed;
  box-shadow: none;
}

:root[data-theme="dark"] .command-capability-sidebar-header,
:root[data-theme="dark"] .command-capability-sidebar .capability-tool-tabs,
:root[data-theme="dark"] .command-capability-sidebar .capability-result-header,
:root[data-theme="dark"] .command-capability-sidebar .capability-result-list,
:root[data-theme="dark"]
  .command-capability-sidebar
  .capability-result-list
  li {
  border-color: #303030;
}

:root[data-theme="dark"] .command-capability-sidebar-header span,
:root[data-theme="dark"]
  .command-capability-sidebar
  .capability-result-header
  span,
:root[data-theme="dark"] .command-capability-sidebar-empty {
  color: #9b9b9b;
}

:root[data-theme="dark"] .command-capability-sidebar-header strong,
:root[data-theme="dark"] .command-capability-sidebar-empty strong,
:root[data-theme="dark"]
  .command-capability-sidebar
  .capability-result-header
  strong,
:root[data-theme="dark"]
  .command-capability-sidebar
  .capability-tool-tabs
  > button,
:root[data-theme="dark"] .command-capability-sidebar .capability-result-item {
  color: #dedede;
}

:root[data-theme="dark"]
  .command-capability-sidebar
  .capability-tool-tabs
  > button:hover,
:root[data-theme="dark"]
  .command-capability-sidebar
  .capability-tool-tabs
  > button:focus-visible,
:root[data-theme="dark"]
  .command-capability-sidebar
  .capability-tool-tabs
  > button[data-active="true"],
:root[data-theme="dark"]
  .command-capability-sidebar
  .capability-result-item:hover,
:root[data-theme="dark"]
  .command-capability-sidebar
  .capability-result-item:focus-visible {
  border-color: #3f3f3f;
  background: #2b2b2b;
  color: #fff;
}

:root[data-theme="dark"]
  .command-capability-sidebar
  :is(
    .capability-result,
    .capability-result pre,
    .capability-command-form input,
    .capability-field-list input,
    .capability-field-list select,
    .capability-command-form button,
    .capability-result-actions button,
    .capability-dock kbd,
    .capability-result-output
  ) {
  border-color: #3b3b3b;
  background: #242424;
  color: #dedede;
}

:root[data-theme="dark"]
  .command-capability-sidebar
  .capability-result:is(
    [data-panel-kind="terminal"],
    [data-panel-kind="review"]
  )
  .capability-result-output {
  border-color: #383838;
  background: #242424;
  color: #dedede;
}

:root[data-theme="dark"] .command-capability-sidebar .capability-result-list {
  border-color: #303030;
  background: #202020;
}

:root[data-theme="dark"] .command-capability-sidebar .capability-result-summary,
:root[data-theme="dark"]
  .command-capability-sidebar
  .capability-result-item-icon,
:root[data-theme="dark"]
  .command-capability-sidebar
  .capability-result-item-chevron {
  color: #9b9b9b;
}

:root[data-theme="dark"] .command-capability-sidebar-empty {
  border-color: #404040;
}

/* The command tools are a peer workbench, not a narrow inspector sidebar. */
.command-workbench {
  position: relative;
  z-index: 30;
  display: grid;
  min-width: 0;
  height: 100vh;
  height: 100dvh;
  grid-template-rows: auto auto minmax(0, 1fr);
  overflow: hidden;
  border-left: 1px solid #2d2d2d;
  background: #171717;
  color: #ededed;
}

.command-workbench[data-empty="true"] {
  grid-template-rows: minmax(0, 1fr);
}

.command-workbench-tabbar {
  position: relative;
  z-index: 4;
  display: flex;
  min-height: 42px;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 4px 8px 4px 10px;
  border-bottom: 1px solid #2b2b2b;
  background: #181818;
}

.command-workbench-tabs {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 4px;
  overflow-x: auto;
  scrollbar-width: none;
}

.command-workbench-tab {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 26px;
  min-width: 112px;
  max-width: 210px;
  height: 32px;
  align-items: center;
  overflow: hidden;
  border: 1px solid transparent;
  border-radius: 9px;
  background: #202020;
  color: #b7b7b7;
}

.command-workbench-tab[data-active="true"] {
  border-color: #353535;
  background: #292929;
  color: #f4f4f4;
}

.command-workbench-tab > button:first-child {
  display: flex;
  min-width: 0;
  height: 100%;
  align-items: center;
  gap: 8px;
  padding: 0 4px 0 10px;
  border: 0;
  background: transparent;
  color: inherit;
  cursor: pointer;
}

.command-workbench-tab > button:first-child span {
  min-width: 0;
  overflow: hidden;
  font-size: 12px;
  font-weight: 570;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.command-workbench-tab svg,
.command-workbench-add svg,
.command-workbench-close svg {
  width: 16px;
  height: 16px;
  flex: 0 0 auto;
  stroke-width: 1.7;
}

.command-workbench-tab-close,
.command-workbench-add,
.command-workbench-close {
  display: grid;
  place-items: center;
  border: 0;
  background: transparent;
  color: #999;
  cursor: pointer;
}

.command-workbench-tab-close {
  width: 24px;
  height: 24px;
  border-radius: 6px;
}

.command-workbench-tab-close:hover,
.command-workbench-add:hover,
.command-workbench-close:hover {
  background: #343434;
  color: #fff;
}

.command-workbench-launcher-anchor {
  position: relative;
  flex: 0 0 auto;
}

.command-workbench-add {
  width: 32px;
  height: 32px;
  border-radius: 9px;
  color: #dedede;
}

.command-workbench-close {
  width: 30px;
  height: 30px;
  flex: 0 0 auto;
  border-radius: 8px;
}

.command-workbench-close.is-floating {
  position: absolute;
  z-index: 5;
  top: 8px;
  right: 8px;
}

.command-workbench-launcher-menu {
  position: absolute;
  z-index: 10;
  top: calc(100% + 6px);
  left: 0;
  width: 284px;
  padding: 5px;
  border: 1px solid #414141;
  border-radius: 13px;
  background: #2a2a2a;
  box-shadow: 0 18px 46px rgb(0 0 0 / 0.38);
}

.command-workbench-content {
  min-width: 0;
  min-height: 0;
  overflow: hidden;
}

.command-workbench[data-empty="true"] .command-workbench-content {
  display: grid;
  place-items: center;
}

.command-workbench-launcher {
  display: grid;
  width: min(320px, calc(100% - 48px));
  gap: 5px;
}

.command-workbench-launcher-menu .command-workbench-launcher {
  width: 100%;
}

.command-workbench-launcher > button {
  display: flex;
  width: 100%;
  min-height: 38px;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 0 10px;
  border: 0;
  border-radius: 8px;
  background: #202020;
  color: #e5e5e5;
  cursor: pointer;
  font: inherit;
  text-align: left;
}

.command-workbench-launcher-menu .command-workbench-launcher > button {
  background: transparent;
}

.command-workbench-launcher > button:hover,
.command-workbench-launcher > button:focus-visible {
  background: #414141;
  color: #fff;
  outline: 0;
}

.command-workbench-launcher > button:disabled {
  cursor: default;
  opacity: 0.52;
}

.command-workbench-launcher > button span {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 9px;
  font-size: 12.5px;
  font-weight: 560;
}

.command-workbench-launcher > button svg {
  width: 16px;
  height: 16px;
  flex: 0 0 auto;
  color: #bdbdbd;
  stroke-width: 1.65;
}

.command-workbench-launcher > button kbd {
  color: #999;
  font-family: inherit;
  font-size: 11px;
}

.command-workbench-context-bar {
  min-width: 0;
  min-height: 34px;
  overflow: hidden;
  padding: 9px 14px 7px;
  border-bottom: 1px solid #292929;
  color: #bcbcbc;
  font-family: var(--font-mono);
  font-size: 11px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.command-workbench-files {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 250px;
  width: 100%;
  height: 100%;
  min-height: 0;
}

.command-workbench-file-preview {
  display: grid;
  min-width: 0;
  min-height: 0;
  overflow: auto;
  background: #181818;
}

.command-workbench-file-preview > section {
  min-width: 0;
  min-height: 100%;
}

.command-workbench-file-preview pre {
  min-height: 100%;
  margin: 0;
  padding: 18px 20px 40px;
  overflow: auto;
  color: #d8d8d8;
  font-family: var(--font-mono);
  font-size: 12px;
  line-height: 1.55;
  tab-size: 2;
  white-space: pre-wrap;
}

.command-workbench-file-empty,
.command-workbench-tool-empty {
  display: grid;
  align-content: center;
  justify-items: center;
  gap: 6px;
  color: #8c8c8c;
  text-align: center;
}

.command-workbench-file-empty svg,
.command-workbench-tool-empty svg {
  width: 26px;
  height: 26px;
  margin-bottom: 4px;
  stroke-width: 1.5;
}

.command-workbench-file-empty strong,
.command-workbench-tool-empty strong {
  color: #dedede;
  font-size: 13px;
  font-weight: 590;
}

.command-workbench-file-empty span {
  font-size: 11px;
}

.command-workbench-file-explorer {
  display: flex;
  min-width: 0;
  min-height: 0;
  flex-direction: column;
  overflow: hidden;
  border-left: 1px solid #2c2c2c;
  background: #1b1b1b;
}

.command-workbench-file-search {
  display: grid;
  gap: 7px;
  padding: 8px 8px 5px;
}

.command-workbench-file-search label {
  display: grid;
  gap: 4px;
}

.command-workbench-file-search label > span {
  display: none;
}

.command-workbench-file-search input,
.command-workbench-file-search select {
  width: 100%;
  height: 27px;
  min-width: 0;
  padding: 0 8px;
  border: 1px solid #353535;
  border-radius: 8px;
  outline: 0;
  background: #222;
  color: #ddd;
  font: inherit;
  font-size: 11px;
}

.command-workbench-file-search input:focus,
.command-workbench-file-search select:focus {
  border-color: #555;
}

.command-workbench-file-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  padding: 0 8px 6px;
}

.command-workbench-file-actions button {
  height: 25px;
  padding: 0 7px;
  border: 1px solid #343434;
  border-radius: 7px;
  background: #232323;
  color: #bdbdbd;
  cursor: pointer;
  font: inherit;
  font-size: 10.5px;
}

.command-workbench-file-actions button:hover {
  background: #303030;
  color: #fff;
}

.command-workbench-file-tree {
  min-height: 0;
  flex: 1 1 auto;
  overflow: auto;
  padding: 2px 5px 12px;
  scrollbar-width: thin;
}

.command-workbench-file-row {
  display: grid;
  grid-template-columns: 16px minmax(0, 1fr);
  width: 100%;
  min-height: 27px;
  align-items: center;
  gap: 5px;
  padding: 2px 5px;
  border: 0;
  border-radius: 5px;
  background: transparent;
  color: #c5c5c5;
  cursor: pointer;
  font: inherit;
  font-size: 11.5px;
  text-align: left;
}

.command-workbench-file-row:hover,
.command-workbench-file-row:focus-visible {
  background: #2c2c2c;
  color: #fff;
  outline: 0;
}

.command-workbench-file-row:disabled {
  cursor: default;
  opacity: 0.55;
}

.command-workbench-file-row svg {
  width: 14px;
  height: 14px;
  color: #aaa;
  stroke-width: 1.55;
}

.command-workbench-file-row span {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.command-workbench-error {
  margin: 16px;
  color: #ef9b9b;
  font-size: 12px;
}

.command-workbench-generic-surface {
  width: 100%;
  height: 100%;
  min-height: 0;
  overflow: auto;
  background: #181818;
}

.command-workbench-generic-surface .capability-result {
  display: grid;
  min-height: 100%;
  align-content: start;
  gap: 12px;
  margin: 0;
  padding: 14px 16px 32px;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #dcdcdc;
}

.command-workbench-generic-surface .capability-result-header {
  display: none;
}

.command-workbench-generic-surface .capability-command-form {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 6px;
}

.command-workbench-generic-surface
  :is(
    .capability-command-form input,
    .capability-field-list input,
    .capability-field-list select
  ) {
  border-color: #393939;
  background: #222;
  color: #e4e4e4;
}

.command-workbench-generic-surface
  :is(.capability-command-form button, .capability-result-actions button) {
  border-color: #3c3c3c;
  background: #292929;
  color: #ddd;
}

.command-workbench-generic-surface .capability-result-output {
  max-height: calc(100dvh - 150px);
  margin: 0;
  padding: 0;
  overflow: auto;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #d7d7d7;
  font-size: 12px;
  line-height: 1.55;
}

.command-workbench-generic-surface[data-tool-id="terminal"]
  .capability-result-output {
  color: #d8d8d8;
}

.command-workbench-trigger {
  position: relative;
  z-index: 45;
  align-self: start;
  justify-self: center;
  width: 34px;
  height: 32px;
  margin-top: 8px;
  border: 0;
  background: transparent;
  color: #aaa;
  box-shadow: none;
}

.command-workbench-trigger:hover {
  background: #2b2b2b;
  color: #fff;
}

.command-workbench-trigger svg {
  width: 18px;
  height: 18px;
}

@media (max-width: 1379px) {
  .command-shell-route[data-capability-sidebar-open="true"] {
    grid-template-columns: minmax(0, 1fr);
  }

  .command-workbench {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(760px, calc(100vw - 80px));
    box-shadow: -28px 0 70px rgb(0 0 0 / 0.38);
  }
}

@media (max-width: 760px) {
  .command-workbench {
    width: 100vw;
  }

  .command-workbench-files {
    grid-template-columns: minmax(0, 1fr) minmax(210px, 38%);
  }
}"
`;

exports[`command workspace conversation style > snapshots the compact add-resource palette contract 1`] = `""`;

exports[`command workspace conversation style > snapshots the markdown table sizing contract 1`] = `
{
  "baseContract": ".markdown-content table {
  display: block;
  width: fit-content;
  max-width: 100%;
  overflow: auto;
  border-spacing: 0;
  border-collapse: separate;
  color: inherit;
  font-size: 12px;
}",
  "commandContract": ".message[data-kind="agentMessage"]
  .markdown-content
  table {
  overflow: auto;
  border-radius: 12px;
  box-shadow: inset 0 0 0 1px oklch(90% 0.008 235);
}",
}
`;
