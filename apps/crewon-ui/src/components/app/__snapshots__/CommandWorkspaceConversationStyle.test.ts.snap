}

:root:not([data-theme="light"])
  .screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  blockquote,
:root:not([data-theme="light"])
  .assistant-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  blockquote {
  border-left-color: #3d3d3d;
  color: #a8a8a8;
}

:root:not([data-theme="light"])
  .screen-shell.command-screen
  .command-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  :not(pre)
  > code,
:root:not([data-theme="light"])
  .assistant-thread-room
  .message[data-kind="agentMessage"]
  .markdown-content
  :not(pre)
  > code {
  border: 0;
  background: rgba(255, 255, 255, 0.08);
  color: #f4f4f5;
}

:root:not([data-theme="light"])
  .screen-shell.command-screen
  .command-thread-room
  .message[data-kind="userMessage"]
  .markdown-content,
