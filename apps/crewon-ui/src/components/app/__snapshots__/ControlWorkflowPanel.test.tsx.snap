// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ControlWorkflowPanel > snapshots immutable version detail, invalid JSON, and no-thread states 1`] = `
{
  "detail": "<section class="workflow-room-inline workflow-runtime-room" aria-labelledby="control-workflow-title"><header class="workflow-room-top"><button class="button compact" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg> 返回</button><div class="workflow-room-title-block"><span>Control Workflow</span><h3 id="control-workflow-title">交付检查协作流</h3><p>读取风险并保留人工确认边界。</p><small>不可变版本 workflow-version-1</small></div></header><main class="workflow-room-stage"><section class="workflow-execution-strip" aria-label="静态节点定义"><article class="workflow-step-node"><span>01</span><div><strong>风险审阅</strong><p>读取输入并形成风险清单。</p><small>review</small></div><em class="status">Agent</em></article><article class="workflow-step-node"><span>02</span><div><strong>人工验收</strong><p>确认风险清单满足交付口径。</p><small>gate</small></div><em class="status">Human Gate · 当前不可用</em></article></section><section class="workflow-chat-panel"><div class="workflow-room-thread" role="log" aria-label="Control Workflow Run"><article class="office-room-message"><span class="team-avatar">流</span><div><strong>静态定义已载入</strong><p>节点进度不在客户端推断；运行状态只读取 canonical Run。</p></div></article></div><form class="command-input workflow-global-composer workflow-control-composer" data-command-composer="true"><label class="visually-hidden" for="workflow-json-input">Workflow JSON 输入</label><textarea id="workflow-json-input" aria-label="Workflow JSON 输入" rows="3" spellCheck="false">{}</textarea><div class="input-tools" data-od-id="composer-tools"><div class="composer-controls"><span class="workflow-composer-capabilities">严格 JSON 输入 <i aria-hidden="true">·</i> 绑定当前 Control 会话</span></div><div class="composer-actions"><button class="send-button" type="submit" aria-label="启动协作流" aria-busy="false" title="启动协作流"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up" aria-hidden="true"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg></button></div></div><div class="composer-state-row"><span class="composer-state" role="status">协作流 · 已就绪</span></div></form></section></main></section>",
  "invalidJson": "<section class="workflow-room-inline workflow-runtime-room" aria-labelledby="control-workflow-title"><header class="workflow-room-top"><button class="button compact" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg> 返回</button><div class="workflow-room-title-block"><span>Control Workflow</span><h3 id="control-workflow-title">交付检查协作流</h3><p>读取风险并保留人工确认边界。</p><small>不可变版本 workflow-version-1</small></div></header><main class="workflow-room-stage"><section class="workflow-execution-strip" aria-label="静态节点定义"><article class="workflow-step-node"><span>01</span><div><strong>风险审阅</strong><p>读取输入并形成风险清单。</p><small>review</small></div><em class="status">Agent</em></article><article class="workflow-step-node"><span>02</span><div><strong>人工验收</strong><p>确认风险清单满足交付口径。</p><small>gate</small></div><em class="status">Human Gate · 当前不可用</em></article></section><section class="workflow-chat-panel"><div class="workflow-room-thread" role="log" aria-label="Control Workflow Run"><article class="office-room-message"><span class="team-avatar">流</span><div><strong>静态定义已载入</strong><p>节点进度不在客户端推断；运行状态只读取 canonical Run。</p></div></article><p class="workflow-control-error" role="alert">输入必须是有效的严格 JSON。</p></div><form class="command-input workflow-global-composer workflow-control-composer" data-command-composer="true"><label class="visually-hidden" for="workflow-json-input">Workflow JSON 输入</label><textarea id="workflow-json-input" aria-label="Workflow JSON 输入" rows="3" spellCheck="false">{}</textarea><div class="input-tools" data-od-id="composer-tools"><div class="composer-controls"><span class="workflow-composer-capabilities">严格 JSON 输入 <i aria-hidden="true">·</i> 绑定当前 Control 会话</span></div><div class="composer-actions"><button class="send-button" type="submit" aria-label="启动协作流" aria-busy="false" title="启动协作流"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up" aria-hidden="true"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg></button></div></div><div class="composer-state-row"><span class="composer-state" role="status">协作流 · 已就绪</span></div></form></section></main></section>",
  "noThread": "<section class="workflow-room-inline workflow-runtime-room" aria-labelledby="control-workflow-title"><header class="workflow-room-top"><button class="button compact" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg> 返回</button><div class="workflow-room-title-block"><span>Control Workflow</span><h3 id="control-workflow-title">交付检查协作流</h3><p>读取风险并保留人工确认边界。</p><small>不可变版本 workflow-version-1</small></div></header><main class="workflow-room-stage"><section class="workflow-execution-strip" aria-label="静态节点定义"><article class="workflow-step-node"><span>01</span><div><strong>风险审阅</strong><p>读取输入并形成风险清单。</p><small>review</small></div><em class="status">Agent</em></article><article class="workflow-step-node"><span>02</span><div><strong>人工验收</strong><p>确认风险清单满足交付口径。</p><small>gate</small></div><em class="status">Human Gate · 当前不可用</em></article></section><section class="workflow-chat-panel"><div class="workflow-room-thread" role="log" aria-label="Control Workflow Run"><article class="office-room-message"><span class="team-avatar">流</span><div><strong>静态定义已载入</strong><p>节点进度不在客户端推断；运行状态只读取 canonical Run。</p></div></article></div><form class="command-input workflow-global-composer workflow-control-composer" data-command-composer="true"><label class="visually-hidden" for="workflow-json-input">Workflow JSON 输入</label><textarea id="workflow-json-input" aria-label="Workflow JSON 输入" rows="3" spellCheck="false">{}</textarea><div class="input-tools" data-od-id="composer-tools"><div class="composer-controls"><span class="workflow-composer-capabilities">严格 JSON 输入 <i aria-hidden="true">·</i> 绑定当前 Control 会话</span></div><div class="composer-actions"><button class="send-button" type="submit" aria-label="启动协作流" aria-busy="false" disabled="" title="启动协作流"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up" aria-hidden="true"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg></button></div></div><div class="composer-state-row"><span class="composer-state" role="status">请先打开一个 Control 会话</span></div></form></section></main></section>",
}
`;

exports[`ControlWorkflowPanel > snapshots loading, empty, and truthful Control errors 1`] = `
{
  "empty": "<section class="team-office-empty team-capability-live-empty"><span class="team-office-empty-kicker">CrewON Workflow</span><h2>还没有已发布的协作流</h2><p>发布 WorkflowVersion 后即可在这里启动。</p><button class="button" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-cw" aria-hidden="true"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg> 重新同步</button></section>",
  "error": "<section class="team-office-empty team-capability-live-empty"><span class="team-office-empty-kicker">CrewON Workflow</span><h2>协作流服务暂不可用</h2><p>control_workflow_catalog_unavailable</p><button class="button" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-cw" aria-hidden="true"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg> 重新同步</button></section>",
  "loading": "<section class="team-office-empty team-capability-live-empty"><span class="team-office-empty-kicker">CrewON Workflow</span><h2>正在读取协作流</h2><p>正在从 CrewON Control 读取不可变版本目录。</p><button class="button" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-cw" aria-hidden="true"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg> 重新同步</button></section>",
}
`;

