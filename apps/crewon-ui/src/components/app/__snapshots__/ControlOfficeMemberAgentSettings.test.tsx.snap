exports[`ControlOfficeMemberAgentSettings > shows the member prompt and selectable capabilities 1`] = `"<section class="control-office-agent-settings"><div class="control-office-agent-settings-title"><strong>工作方式</strong><p>只影响当前办公室里的这个成员</p></div><label class="control-office-agent-prompt"><span>系统提示词</span><textarea maxLength="2000" placeholder="例如：你负责质量验收，优先检查遗漏、风险和证据…" rows="5" spellCheck="false">优先检查遗漏、风险和证据。</textarea><small>说明它该怎么判断、表达，以及哪些事不要做</small></label><div class="control-office-agent-capabilities"><details class="control-office-agent-capability"><summary><span class="control-office-agent-capability-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg></span><strong>Skill</strong><em>1 已选</em></summary><div class="control-office-agent-capability-list"><button aria-pressed="true" title="检查交付内容是否完整" type="button"><span data-accent="violet" aria-hidden="true">审</span><span><strong>交付审查</strong><small>检查交付内容是否完整</small></span><i aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"></path></svg></i></button></div></details><details class="control-office-agent-capability"><summary><span class="control-office-agent-capability-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plug"><path d="M12 22v-5"></path><path d="M9 8V2"></path><path d="M15 8V2"></path><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"></path></svg></span><strong>MCP 服务</strong><em>0 已选</em></summary><div class="control-office-agent-capability-list"><button aria-pressed="false" title="读取和更新团队任务" type="button"><span data-accent="blue" aria-hidden="true">任</span><span><strong>任务服务</strong><small>读取和更新团队任务</small></span><i aria-hidden="true"></i></button></div></details><details class="control-office-agent-capability"><summary><span class="control-office-agent-capability-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open"><path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg></span><strong>知识库</strong><em>1 已选</em></summary><div class="control-office-agent-capability-list"><button aria-pressed="true" title="团队统一的交付要求" type="button"><span data-accent="green" aria-hidden="true">规</span><span><strong>交付规范</strong><small>团队统一的交付要求</small></span><i aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"></path></svg></i></button></div></details></div></section>"`;
