// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CommandTeamCapabilityCreateDialog > snapshots the experts creation boundary 1`] = `"<div class="modal-backdrop open" role="dialog" aria-modal="true"><form class="office-modal-card team-capability-create-card"><header class="arrangement-modal-header"><div><span class="modal-kicker">专家团创建</span><h2>创建专家团</h2></div><button class="icon-action compact" type="button" aria-label="关闭"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></header><label class="form-field"><span>专家团名称</span><input required="" maxLength="120" value=""/></label><label class="form-field"><span>前台团长</span><input required="" maxLength="120" placeholder="例如：代码审查组长" value=""/></label><label class="form-field"><span>目标与交付边界</span><textarea required="" maxLength="2000"></textarea></label><div class="team-capability-scope-preview"><strong>团长单聊工作空间</strong><span title="/repo/single-chat">/repo/single-chat</span><em>后台专家不直接进入用户会话</em></div><footer class="arrangement-modal-actions"><button class="button" type="button">取消</button><button class="button primary" type="submit">创建并进入团长单聊</button></footer></form></div>"`;

exports[`CommandTeamCapabilityCreateDialog > snapshots the workflow creation boundary 1`] = `"<div class="modal-backdrop open" role="dialog" aria-modal="true"><form class="office-modal-card team-capability-create-card"><header class="arrangement-modal-header"><div><span class="modal-kicker">协作流创建</span><h2>创建协作流</h2></div><button class="icon-action compact" type="button" aria-label="关闭"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></header><label class="form-field"><span>协作流名称</span><input required="" maxLength="120" value=""/></label><label class="form-field"><span>组长与首个节点负责人</span><input required="" maxLength="120" placeholder="例如：交付组长智能体" value=""/></label><label class="form-field"><span>目标与交付边界</span><textarea required="" maxLength="2000"></textarea></label><div class="team-capability-scope-preview"><strong>群聊运行工作空间</strong><span title="/repo/team">/repo/team</span><em>节点成员在同一协作流群聊中推进</em></div><footer class="arrangement-modal-actions"><button class="button" type="button">取消</button><button class="button primary" type="submit">创建并进入协作流</button></footer></form></div>"`;
