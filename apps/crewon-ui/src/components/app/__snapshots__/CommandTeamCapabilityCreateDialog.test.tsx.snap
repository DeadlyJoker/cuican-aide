// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CommandTeamCapabilityCreateDialog > snapshots the experts creation boundary 1`] = `"<div class="modal-backdrop open" role="dialog" aria-modal="true"><form class="office-modal-card team-capability-create-card"><header class="arrangement-modal-header"><div><span class="modal-kicker">专家团创建</span><h2>创建专家团</h2></div><button class="icon-action compact" type="button" aria-label="关闭"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></header><label class="form-field"><span>专家团名称</span><input required="" maxLength="120" value=""/></label><label class="form-field"><span>目标与交付边界</span><textarea required="" maxLength="2000"></textarea></label><section class="team-capability-scope-preview" aria-labelledby="expert-leader-title"><strong id="expert-leader-title">团长 · 用户唯一对话入口</strong><div class="modal-form-grid"><label class="form-field"><span>团长名称</span><input required="" maxLength="120" placeholder="例如：代码审查组长" value=""/></label><label class="form-field"><span>团长职责</span><input required="" maxLength="160" placeholder="例如：澄清目标、分派与汇总" value=""/></label></div><em>用户只和团长保持一个连续会话，后台专家不会直接插入消息。</em></section><section class="team-capability-scope-preview" aria-labelledby="expert-member-0-title"><strong id="expert-member-0-title">后台专家 1</strong><div class="modal-form-grid"><label class="form-field"><span>专家名称</span><input required="" maxLength="120" placeholder="例如：仓库探索专家" value=""/></label><label class="form-field"><span>专家职责</span><input required="" maxLength="160" placeholder="例如：定位代码与风险" value=""/></label><label class="form-field"><span>协作类型</span><select><option value="explorer" selected="">Explorer · 探索与调研</option><option value="worker">Worker · 实现与交付</option></select></label></div></section><section class="team-capability-scope-preview" aria-labelledby="expert-member-1-title"><strong id="expert-member-1-title">后台专家 2</strong><div class="modal-form-grid"><label class="form-field"><span>专家名称</span><input required="" maxLength="120" placeholder="例如：实现交付专家" value=""/></label><label class="form-field"><span>专家职责</span><input required="" maxLength="160" placeholder="例如：实现与验证" value=""/></label><label class="form-field"><span>协作类型</span><select><option value="explorer">Explorer · 探索与调研</option><option value="worker" selected="">Worker · 实现与交付</option></select></label></div></section><div class="team-capability-scope-preview"><strong>团长单聊工作空间</strong><span title="/repo/single-chat">/repo/single-chat</span><em>后台专家不直接进入用户会话</em></div><footer class="arrangement-modal-actions"><button class="button" type="button">取消</button><button class="button primary" type="submit">创建并进入团长单聊</button></footer></form></div>"`;

exports[`CommandTeamCapabilityCreateDialog > snapshots the workflow creation boundary 1`] = `"<div class="modal-backdrop open" role="dialog" aria-modal="true"><form class="office-modal-card team-capability-create-card"><header class="arrangement-modal-header"><div><span class="modal-kicker">协作流创建</span><h2>创建协作流</h2></div><button class="icon-action compact" type="button" aria-label="关闭"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></header><label class="form-field"><span>协作流名称</span><input required="" maxLength="120" value=""/></label><label class="form-field"><span>目标与交付边界</span><textarea required="" maxLength="2000"></textarea></label><section class="workflow-node-builder" aria-labelledby="workflow-node-builder-title"><div class="workflow-node-builder-head"><div><strong id="workflow-node-builder-title">执行节点</strong><p>节点按当前顺序串行执行，前一个 Agent 的输出会交给下一个。</p></div><button class="button compact" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>添加节点</button></div><div class="workflow-node-list"><article class="workflow-node-editor"><header><span>1</span><strong>Agent 节点</strong><div><button class="icon-action compact" type="button" aria-label="上移节点" disabled=""><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up" aria-hidden="true"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg></button><button class="icon-action compact" type="button" aria-label="下移节点" disabled=""><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-down" aria-hidden="true"><path d="M12 5v14"></path><path d="m19 12-7 7-7-7"></path></svg></button><button class="icon-action compact" type="button" aria-label="删除节点" disabled=""><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2" aria-hidden="true"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path><line x1="10" x2="10" y1="11" y2="17"></line><line x1="14" x2="14" y1="11" y2="17"></line></svg></button></div></header><div class="modal-form-grid"><label class="form-field"><span>云智能体</span><select required=""><option value="" selected="">选择智能体</option><option value="101">产品审阅智能体</option><option disabled="" value="102">交付智能体 · API 未启用</option></select></label><label class="form-field"><span>节点名称</span><input required="" maxLength="120" placeholder="例如：需求审阅" value=""/></label></div><label class="form-field"><span>本节点任务</span><textarea required="" maxLength="2000" placeholder="说明这个节点要完成的任务、输出格式和验收要求。"></textarea></label></article></div></section><div class="team-capability-scope-preview"><strong>云端执行边界</strong><span>Agent Platform 云端</span><em>创建真实 Workflow 定义，不上传本机路径或工作空间内容</em></div><footer class="arrangement-modal-actions"><button class="button" type="button">取消</button><button class="button primary" type="submit">创建协作流</button></footer></form></div>"`;
