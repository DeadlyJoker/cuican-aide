// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`shared tool and plugin tab strip > renders one accessible strip with independent close controls and a common launcher 1`] = `"<header class="command-workbench-tabbar" data-desktop-drag-region=""><div class="command-workbench-tabs" role="tablist" aria-label="工作台页面"><div role="tab" aria-selected="true" class="command-workbench-tab" data-active="true"><button type="button"><span>分集剧本</span></button><button type="button" class="command-workbench-tab-close" aria-label="关闭 分集剧本"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></div><div role="tab" aria-selected="false" class="command-workbench-tab"><button type="button"><span>网页</span></button><button type="button" class="command-workbench-tab-close" aria-label="关闭 网页"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></div><div class="command-workbench-launcher-anchor"><button type="button" class="command-workbench-add" aria-label="打开工具" aria-haspopup="menu" aria-expanded="true" aria-controls="command-workbench-launcher-menu"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></button></div></div><div role="menu"><button role="menuitem">短剧页面</button><button role="menuitem">网页</button></div><button type="button" class="command-workbench-close" aria-label="收起工作台"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-panel-right" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M15 3v18"></path></svg></button></header>"`;
