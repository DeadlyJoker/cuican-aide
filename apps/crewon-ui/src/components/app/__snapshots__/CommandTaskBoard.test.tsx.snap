// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CommandTaskBoard > renders the migration-era project destination with live tasks 1`] = `"<section class="shell-view shell-page-view active" data-od-id="shell-view-projects" data-shell-view="projects"><div class="page-stack command-project-board-page"><header class="command-project-board-toolbar"><div><span>项目与执行</span><h2>任务</h2><p>按真实会话和运行状态组织；打开任务即可继续工作。</p></div><button class="button primary" type="button">发起任务</button></header><section class="command-task-board" aria-label="任务看板"><header class="command-task-board-header"><div><strong>任务看板</strong><p>来自真实会话状态；打开卡片继续处理</p></div><span>1</span></header><div class="command-task-board-columns"><section class="command-task-column" data-task-stage="active"><header><span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-loader-circle" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg><strong>进行中</strong></span><em>1</em></header><div class="command-task-column-list"><button aria-current="true" class="command-task-card" data-thread-id="active" type="button"><strong>active title</strong><span>active preview</span><small>20685 天前</small></button></div></section><section class="command-task-column" data-task-stage="attention"><header><span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-alert" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg><strong>需处理</strong></span><em>0</em></header><div class="command-task-column-list"><p class="command-task-column-empty">暂无任务</p></div></section><section class="command-task-column" data-task-stage="ready"><header><span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><strong>可继续</strong></span><em>0</em></header><div class="command-task-column-list"><p class="command-task-column-empty">暂无任务</p></div></section></div></section></div></section>"`;

exports[`CommandTaskBoard > snapshots a user-visible task board backed by real conversations 1`] = `"<section class="command-task-board" aria-label="任务看板"><header class="command-task-board-header"><div><strong>任务看板</strong><p>来自真实会话状态；打开卡片继续处理</p></div><span>3</span></header><div class="command-task-board-columns"><section class="command-task-column" data-task-stage="active"><header><span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-loader-circle" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg><strong>进行中</strong></span><em>1</em></header><div class="command-task-column-list"><button aria-current="true" class="command-task-card" data-thread-id="active" type="button"><strong>active title</strong><span>active preview</span><small>20685 天前</small></button></div></section><section class="command-task-column" data-task-stage="attention"><header><span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-alert" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg><strong>需处理</strong></span><em>1</em></header><div class="command-task-column-list"><button class="command-task-card" data-thread-id="failed" type="button"><strong>failed title</strong><span>failed preview</span><small>20685 天前</small></button></div></section><section class="command-task-column" data-task-stage="ready"><header><span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><strong>可继续</strong></span><em>1</em></header><div class="command-task-column-list"><button class="command-task-card" data-thread-id="ready" type="button"><strong>ready title</strong><span>ready preview</span><small>20685 天前</small></button></div></section></div></section>"`;
