// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CommandOfficeCreateDialog > snapshots the Control contract boundary without a fake goal field 1`] = `"<div class="modal-backdrop open" id="team-office-create-modal" role="dialog" aria-modal="true" aria-labelledby="team-office-create-title"><form class="office-modal-card office-create-card" data-od-id="team-office-create-modal"><header class="arrangement-modal-header"><div><span class="modal-kicker">办公室创建</span><h2 id="team-office-create-title">创建办公室</h2></div><button class="icon-action compact" type="button" aria-label="关闭"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></header><div class="office-create-layout"><div class="office-create-main"><label class="form-field"><span>办公室名称</span><input type="text" required="" maxLength="120" placeholder="例如：设计交付办公室" value=""/></label><p class="office-manager-note">Control Office contract 当前只保存名称、成员和执行目标，不支持长期目标字段。</p></div><aside class="agent-picker-panel" aria-label="选择智能体"><strong>从智能体页选择</strong><p class="team-office-create-empty">当前没有已发布 AgentVersion，Control Office 创建暂不可用。</p></aside></div><footer class="arrangement-modal-actions"><button class="button" type="button">取消</button><button class="button primary" type="submit" disabled="">创建办公室</button></footer></form></div>"`;

exports[`CommandOfficeCreateDialog > snapshots the new in-place Office builder with real recruitable agents 1`] = `"<div class="modal-backdrop open" id="team-office-create-modal" role="dialog" aria-modal="true" aria-labelledby="team-office-create-title"><form class="office-modal-card office-create-card" data-od-id="team-office-create-modal"><header class="arrangement-modal-header"><div><span class="modal-kicker">办公室创建</span><h2 id="team-office-create-title">创建办公室</h2></div><button class="icon-action compact" type="button" aria-label="关闭"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></header><div class="office-create-layout"><div class="office-create-main"><label class="form-field"><span>办公室名称</span><input type="text" required="" maxLength="120" placeholder="例如：设计交付办公室" value=""/></label><label class="form-field"><span>负责的工作任务</span><textarea required="" maxLength="2000" placeholder="说明这个办公室长期负责的目标、边界和交付结果。"></textarea><small class="office-manager-note">创建后自动生成独立的办公室主控（Leader Agent）；所选智能体作为员工加入。</small></label></div><aside class="agent-picker-panel" aria-label="选择智能体"><strong>从智能体页选择</strong><label class="agent-pick-card"><input type="checkbox"/><span><b>产品审阅智能体</b><em>PRD 风险与验收口径</em></span></label></aside></div><footer class="arrangement-modal-actions"><button class="button" type="button">取消</button><button class="button primary" type="submit">创建办公室</button></footer></form></div>"`;
