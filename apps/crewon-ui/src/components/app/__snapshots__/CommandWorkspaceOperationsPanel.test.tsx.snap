// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CommandWorkspaceOperationsPanel > snapshots Team read-only and unavailable boundaries 1`] = `
{
  "readOnly": "<section class="page-panel workspace-operations-panel" aria-labelledby="workspace-operations-title" data-workspace-operations="control" data-mutation-authority="readOnly" data-locale="en"><header class="panel-head"><div><h3 id="workspace-operations-title">Workspace operations</h3><p>Current thread · Workspace selected</p></div><span class="status success">Live</span></header><div class="slim-controls"><span class="catalog-context-note">Safe top-level entries only</span><button class="button compact primary" type="button" data-workspace-action="create" disabled=""><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>Read top level</button></div><div class="filter-empty-state" data-workspace-authority-notice="readOnly" role="status">Team environments are currently read-only. Results remain visible, but Workspace operations cannot be started, checked again, or canceled.</div><div class="compact-list" role="list" aria-label="Workspace operation records"><article class="capability-row is-priority" role="listitem" data-workspace-operation="pending"><div><strong>Top-level read · workspace:pending</strong><p>The Device is reading safe top-level entries from the authorized Workspace.</p></div><div class="catalog-header-actions"><span class="status warn">Running</span><button class="button compact" type="button" data-workspace-action="cancel" data-execution-id="workspace:pending" disabled=""><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect></svg>Cancel</button></div></article></div><div class="sr-log" role="status" aria-live="polite" data-workspace-live-state="live">Workspace operations are synchronized.</div></section>",
  "unavailable": "<section class="page-panel workspace-operations-panel" aria-labelledby="workspace-operations-title" data-workspace-operations="control" data-mutation-authority="unavailable" data-locale="en"><header class="panel-head"><div><h3 id="workspace-operations-title">Workspace operations</h3><p>No thread selected</p></div><span class="status danger">Unavailable</span></header><div class="slim-controls"><span class="catalog-context-note">Safe top-level entries only</span><button class="button compact primary" type="button" data-workspace-action="create" disabled=""><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>Read top level</button></div><div class="filter-empty-state" data-workspace-authority-notice="unavailable" role="status">Workspace Control is unavailable. CrewON will not fall back to the legacy file API.</div><div class="filter-empty-state" data-workspace-empty="true">Workspace operations are unavailable.</div><div class="sr-log" role="status" aria-live="polite" data-workspace-live-state="unavailable">Workspace Control is unavailable.</div></section>",
}
`;

exports[`CommandWorkspaceOperationsPanel > snapshots the compact desktop live panel with all durable statuses 1`] = `"<section class="page-panel workspace-operations-panel" aria-labelledby="workspace-operations-title" data-workspace-operations="control" data-mutation-authority="desktop" data-locale="zh"><header class="panel-head"><div><h3 id="workspace-operations-title">工作空间操作</h3><p>当前线程 · 已选择工作空间</p></div><span class="status success">实时</span></header><div class="slim-controls"><span class="catalog-context-note">仅显示顶层安全条目</span><button class="button compact primary" type="button" data-workspace-action="create"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>读取顶层目录</button></div><div class="compact-list" role="list" aria-label="工作空间操作记录"><article class="capability-row is-priority" role="listitem" data-workspace-operation="pending"><div><strong>顶层目录读取 · workspace:pending</strong><p>设备正在读取已授权工作空间的顶层条目。</p></div><div class="catalog-header-actions"><span class="status warn">执行中</span><button class="button compact" type="button" data-workspace-action="cancel" data-execution-id="workspace:pending"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect></svg>取消</button></div></article><article class="capability-row" role="listitem" data-workspace-operation="completed"><div><strong>顶层目录读取 · workspace:completed</strong><p>已返回 14 个安全顶层条目。</p><div class="compact-list" role="list" aria-label="顶层条目"><div class="run-row" role="listitem"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path></svg><strong>entry-00</strong><span class="status">文件</span></div><div class="run-row" role="listitem"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder" aria-hidden="true"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg><strong>中文</strong><span class="status">文件夹</span></div><div class="run-row" role="listitem"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path></svg><strong>entry-02</strong><span class="status">文件</span></div><div class="run-row" role="listitem"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder" aria-hidden="true"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg><strong>entry-03</strong><span class="status">文件夹</span></div><div class="run-row" role="listitem"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path></svg><strong>entry-04</strong><span class="status">文件</span></div><p data-workspace-result-truncated="true">另有 9 项未在紧凑视图中展开；结果列表已截断。</p></div></div><div class="catalog-header-actions"><span class="status success">已完成</span></div></article><article class="capability-row" role="listitem" data-workspace-operation="failed"><div><strong>顶层目录读取 · workspace:failed</strong><p>操作失败，可以重新发起。</p></div><div class="catalog-header-actions"><span class="status danger">失败</span></div></article><article class="capability-row" role="listitem" data-workspace-operation="canceled"><div><strong>顶层目录读取 · workspace:canceled</strong><p>操作已取消，没有继续读取工作空间。</p></div><div class="catalog-header-actions"><span class="status">已取消</span></div></article></div><div class="sr-log" role="status" aria-live="polite" data-workspace-live-state="live">工作空间操作已同步。</div></section>"`;

exports[`CommandWorkspaceOperationsPanel > snapshots the redacted native Workspace selector without exposing a path 1`] = `"<section class="page-panel workspace-operations-panel" aria-labelledby="workspace-operations-title" data-workspace-operations="control" data-mutation-authority="desktop" data-locale="zh"><header class="panel-head"><div><h3 id="workspace-operations-title">工作空间操作</h3><p>cuican-aide</p></div><span class="status success">实时</span></header><div class="capability-row workspace-native-selector" data-native-workspace-selector="available"><div><span class="catalog-context-note">本机工作空间</span><strong>cuican-aide</strong></div><div class="catalog-header-actions"><button class="button compact" type="button" data-workspace-action="select-native">更换</button><button class="button compact" type="button" data-workspace-action="clear-native">清除</button></div></div><div class="slim-controls"><span class="catalog-context-note">仅显示顶层安全条目</span><button class="button compact primary" type="button" data-workspace-action="create"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>读取顶层目录</button></div><div class="filter-empty-state" data-workspace-empty="true">当前线程还没有工作空间操作。</div><div class="sr-log" role="status" aria-live="polite" data-workspace-live-state="live">工作空间操作已同步。</div></section>"`;

exports[`CommandWorkspaceOperationsPanel > snapshots unknownOutcome with explicit recovery controls 1`] = `"<section class="page-panel workspace-operations-panel" aria-labelledby="workspace-operations-title" data-workspace-operations="control" data-mutation-authority="desktop" data-locale="zh"><header class="panel-head"><div><h3 id="workspace-operations-title">工作空间操作</h3><p>当前线程 · 已选择工作空间</p></div><span class="status success">实时</span></header><div class="slim-controls"><span class="catalog-context-note">仅显示顶层安全条目</span><button class="button compact primary" type="button" data-workspace-action="create"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>读取顶层目录</button></div><div class="compact-list" role="list" aria-label="工作空间操作记录"><article class="capability-row" role="listitem" data-workspace-operation="unknownOutcome"><div><strong>顶层目录读取 · workspace:unknown</strong><p>发送结果尚未确认，可以使用相同操作记录重新确认。</p></div><div class="catalog-header-actions"><span class="status warn">结果待确认</span><button class="button compact" type="button" data-workspace-action="reconcile" data-execution-id="workspace:unknown"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw" aria-hidden="true"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path></svg>重新确认</button><button class="button compact" type="button" data-workspace-action="cancel" data-execution-id="workspace:unknown"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect></svg>取消</button></div></article></div><div class="sr-log" role="status" aria-live="polite" data-workspace-live-state="live">工作空间操作已同步。</div></section>"`;
