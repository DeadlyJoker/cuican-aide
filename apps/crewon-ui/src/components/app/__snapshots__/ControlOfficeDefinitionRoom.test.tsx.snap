exports[`ControlOfficeDefinitionRoom > presents member settings in product language 1`] = `"<section class="control-office-definition-room" data-control-office-definition=""><header class="control-office-definition-header"><button class="button compact" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>返回</button><div class="control-office-definition-title"><span>成员设置</span><h2 title="产品交付办公室">产品交付办公室</h2><p>2 名成员</p></div><div class="control-office-definition-actions"><span class="control-office-save-status" data-state="ready" role="status">正在读取</span><button class="button primary compact" disabled="" type="button">保存</button></div></header><main class="control-office-definition-body"><div class="control-office-settings-layout"><section class="control-office-definition-members"><header><h3>办公室成员</h3><em>2</em></header><div aria-label="办公室成员" class="control-office-member-list"><button aria-current="true" class="control-office-member-row" type="button"><span class="control-office-member-avatar" aria-hidden="true">交</span><span class="control-office-member-copy"><span class="control-office-member-name-line"><strong title="交付组长">交付组长</strong><em>组长</em></span><small>负责协调和回复</small></span></button><button class="control-office-member-row" type="button"><span class="control-office-member-avatar" aria-hidden="true">审</span><span class="control-office-member-copy"><span class="control-office-member-name-line"><strong title="审阅成员">审阅成员</strong></span><small>参与任务协作</small></span></button></div></section><section class="control-office-member-settings" aria-label="成员详情"><header><span class="control-office-member-avatar control-office-member-avatar-large" aria-hidden="true">交</span><h3>交付组长</h3><em>组长</em></header><div class="control-office-member-form"><label for="control-office-member-name"><span>成员名称</span><input aria-invalid="false" id="control-office-member-name" maxLength="160" type="text" value="交付组长"/><small>群聊和任务中会显示这个名称</small></label><div class="control-office-role-setting"><div><strong>办公室组长</strong><p>负责分工、跟进进展并统一回复你</p></div></div><section class="control-office-agent-settings is-error" role="alert"><div><strong>成员配置暂时不可用</strong><p>请检查连接后再试。</p></div><button type="button">重试</button></section><div class="control-office-member-remove"><div><strong>移出办公室</strong><p>保存后，该成员将不再参与新的任务</p></div><button aria-label="移出办公室" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2" aria-hidden="true"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path><line x1="10" x2="10" y1="11" y2="17"></line><line x1="14" x2="14" y1="11" y2="17"></line></svg>移出</button></div></div></section></div></main></section>"`;
