// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`command workspace catalog style > snapshots the compact knowledge card density 1`] = `
"/* Knowledge ownership badges share the pill shape with local/cloud badges. */
.screen-shell.command-screen .catalog-location-badge.is-mine {
  background: var(--n-150);
  color: oklch(40% 0.12 155);
}

.screen-shell.command-screen .catalog-location-badge.is-market {
  background: var(--n-150);
  color: oklch(43% 0.13 248);
}

/* Wider tracks and clamped copy keep every knowledge card on one density rung. */
.screen-shell.command-screen
  .capability-catalog.knowledge-catalog[data-catalog-filter] {
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 10px;
  margin-top: 12px;
}

.screen-shell.command-screen
  .capability-catalog.knowledge-catalog[data-catalog-filter]
  .catalog-card {
  grid-template-columns: 38px minmax(0, 1fr) 28px;
  min-height: 146px;
  gap: 10px;
  padding: 14px;
}

.screen-shell.command-screen
  .capability-catalog.knowledge-catalog[data-catalog-filter]
  .catalog-card-head
  span {
  display: none;
}

.screen-shell.command-screen
  .capability-catalog.knowledge-catalog[data-catalog-filter]
  .catalog-card-head
  strong {
  display: -webkit-box;
  overflow: hidden;
  line-height: 1.4;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.screen-shell.command-screen
  .capability-catalog.knowledge-catalog[data-catalog-filter]
  .catalog-card-body
  > p {
  min-height: 35px;
}

.screen-shell.command-screen
  .capability-catalog.knowledge-catalog[data-catalog-filter]
  .catalog-card-action {
  width: var(--control-h-sm);
  height: var(--control-h-sm);
  min-height: var(--control-h-sm);
}

.screen-shell.command-screen
  .capability-catalog.knowledge-catalog[data-catalog-filter]
  .catalog-card-actions {
  min-width: var(--control-h-sm);
}"
`;

exports[`command workspace catalog style > snapshots the shared auto-fill capability catalog 1`] = `
"/* Agents, skills, services, and knowledge share one auto-fill catalog grid. */
.screen-shell.command-screen .capability-catalog[data-catalog-filter] {
  /* auto-fill tracks the available width: in narrow page-view columns a fixed
   * 4-up grid squeezed cards to ~99px and crushed the card body to zero width
   * (the capability-page container query only applies where that container is
   * registered, so it never fired here). */
  grid-template-columns: repeat(auto-fill, minmax(248px, 1fr));
  gap: 14px;
}

.screen-shell.command-screen
  .capability-catalog[data-catalog-filter]
  .catalog-card {
  grid-template-columns: 38px minmax(0, 1fr) auto;
  grid-template-rows: auto auto auto;
  align-content: start;
  min-height: 136px;
  gap: 12px;
  padding: 16px;
}

.screen-shell.command-screen
  .capability-catalog[data-catalog-filter]
  .catalog-card-body {
  display: contents;
}

.screen-shell.command-screen
  .capability-catalog[data-catalog-filter]
  .catalog-icon {
  grid-row: 1;
  grid-column: 1;
}

.screen-shell.command-screen
  .capability-catalog[data-catalog-filter]
  .catalog-card-head {
  grid-row: 1;
  grid-column: 2;
  align-self: center;
  margin-bottom: 0;
}

.screen-shell.command-screen
  .capability-catalog[data-catalog-filter]
  .catalog-card
  > .button,
.screen-shell.command-screen
  .capability-catalog[data-catalog-filter]
  .catalog-card
  > .catalog-card-action,
.screen-shell.command-screen
  .capability-catalog[data-catalog-filter]
  .catalog-card
  > .status,
.screen-shell.command-screen
  .capability-catalog[data-catalog-filter]
  .catalog-card-actions {
  grid-row: 1;
  grid-column: 3;
  align-self: start;
}

.screen-shell.command-screen
  .capability-catalog[data-catalog-filter]
  .catalog-card-action {
  width: 30px;
  height: 30px;
  min-height: 30px;
  padding: 0;
}

.screen-shell.command-screen
  .capability-catalog[data-catalog-filter]
  .catalog-card-action
  svg {
  width: 15px;
  height: 15px;
}

.screen-shell.command-screen
  .capability-catalog[data-catalog-filter]
  .catalog-card-actions {
  min-width: 30px;
  align-items: flex-end;
}

.screen-shell.command-screen
  .capability-catalog[data-catalog-filter]
  .catalog-card
  > p,
.screen-shell.command-screen
  .capability-catalog[data-catalog-filter]
  .catalog-card-body
  > p {
  grid-row: 2;
  grid-column: 1 / -1;
  min-height: 38px;
}

.screen-shell.command-screen
  .capability-catalog[data-catalog-filter]
  .catalog-meta,
.screen-shell.command-screen
  .capability-catalog[data-catalog-filter]
  .catalog-resource-meta {
  grid-row: 3;
  grid-column: 1 / -1;
  margin-top: 0;
}

@container capability-page (max-width: 760px) {
  .screen-shell.command-screen .capability-catalog[data-catalog-filter] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@container capability-page (max-width: 520px) {
  .screen-shell.command-screen .capability-catalog[data-catalog-filter] {
    grid-template-columns: minmax(0, 1fr);
  }
}"
`;
