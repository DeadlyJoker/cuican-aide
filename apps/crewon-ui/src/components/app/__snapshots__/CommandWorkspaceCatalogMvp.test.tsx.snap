-label="运行位置筛选"><span>运行位置</span><button aria-pressed="true" class="catalog-location-filter-button active" type="button">全部</button><button aria-pressed="false" class="catalog-location-filter-button" type="button">本地</button><button aria-pressed="false" class="catalog-location-filter-button" type="button">云端</button><span class="catalog-location-summary">本地 0 · 云端 0</span></div><div class="catalog-category-states"><div class="catalog-category-state is-loading" data-resource-category="knowledge" role="status"><div><strong>正在读取当前账号的知识库…</strong></div></div></div><section class="capability-catalog knowledge-catalog" data-catalog-filter="knowledge"></section></div></section><section class="shell-view shell-page-view active" data-shell-view="knowledge"><div class="page-stack"><header class="catalog-market-header"><div class="catalog-mode-tabs" aria-label="知识库分类"><span class="filter-chip mode-tab active"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open" aria-hidden="true"><path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg><span>知识库</span></span></div><div class="catalog-header-actions"><label class="catalog-search" aria-label="搜索知识库"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg><input placeholder="搜索知识库名称或描述" type="search" value=""/></label><button class="button compact" type="button">刷新资源</button></div></header><div class="catalog-location-filter" role="group" aria-label="运行位置筛选"><span>运行位置</span><button aria-pressed="true" clas