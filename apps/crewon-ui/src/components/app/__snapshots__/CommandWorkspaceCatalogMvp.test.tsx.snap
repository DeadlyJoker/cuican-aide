ab" data-filter-group="category" data-filter="service" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layers" aria-hidden="true"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"></path><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"></path><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"></path></svg><span>服务</span></button></div><div class="catalog-header-actions"><label class="catalog-search" aria-label="搜索能力"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg><input placeholder="搜索员工、技能或服务" type="search" value=""/></label><button class="button compact" type="button">刷新资源</button></div></header><div class="catalog-category-states"><div class="catalog-category-state is-error" data-resource-category="agents" role="alert"><div><strong>Agent 暂时无法加载，请重试。</strong><span class="catalog-category-error-detail">agent-platform unavailable</span></div><button class="button compact" type="button">重试 Agent</button></div><div class="catalog-category-state is-error" data-resource-category="skills" role="alert"><div><strong>Skill 暂时无法加载，请重试。</strong><span class="catalog-category-error-detail">agent-platform unavailable</span></div><button class="button compact" type="button">重试 Skill</button></div><div class="catalog-category-state is-error" data-resource-category="mcp" role="alert"><div><strong>MCP 暂时无法加载，请重试。</strong><span class="catalog-category-error-detail">agent-platform unavailable</span></div><button class="button compact" type="button">重试 MCP</button></div></div><section class="capability-catalog" data-od-id="agent-capability-catalog"></section></div></section><section class="shell-view shell-page-view active" data-shell-view="knowledge"><div class="page-stack"><header class="catalog-market-header"><div><h2>知识库</h2></div><div class="catalog-header-actions"><label class="catalog-search" aria-label="搜索知识库"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg><input placeholder="搜索知识库名称或描述" type="search" value=""/></label><button class="button compact" type="button">刷新资源</button></div></header><div class="catalog-category-states"><div class="catalog-category-state is-loading" data-resource-category="knowledge" role="status"><div><strong>正在读取当前账号的知识库…</strong></div></div></div><section class="capability-catalog knowledge-catalog"></section></div></section><section class="shell-view shell-page-view active" data-shell-view="knowledge"><div class="page-stack"><header class="catalog-market-header"><div><h2>知识库</h2></div><div class="catalog-header-actions"><label class="catalog-search" aria-label="搜索知识库"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg><input placeholder="搜索知识库名称或描述" type="search" value=""/></label><button class="button compact" type="button">刷新资源</button></div></header><div class="catalog-category-states"><div class="catalog-category-state is-ready" data-resource-category="knowledge" role="status"><div><strong>当前账号暂无知识库。</strong></div></div></div><section class="capabili