exports[`CrewON resource catalog MVP > snapshots registration and first password setup states 1`] = `"<main class="crewon-auth-shell"><section class="crewon-auth-story" aria-label="CrewON 产品介绍"><a class="crewon-auth-brand" href="#"><span class="crewon-auth-brand-mark">C</span><span><strong>CrewON</strong><small>Agent 协作工作台</small></span></a><div class="crewon-auth-story-copy"><h1>CrewON 智能协作工作台</h1><p>统一组织 Agent、Skill、MCP 与企业知识，协同推进任务交付。</p></div></section><section class="crewon-auth-panel" aria-label="账号登录注册"><div class="crewon-auth-card"><header><span class="crewon-auth-mobile-brand">CrewON</span><h2>创建企业账号</h2><p>注册信息将写入 agent-platform user 表</p></header><button class="crewon-auth-sso" disabled="" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-building2" aria-hidden="true"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"></path><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"></path><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"></path><path d="M10 6h4"></path><path d="M10 10h4"></path><path d="M10 14h4"></path><path d="M10 18h4"></path></svg>企业微信（配置后启用）</button><div class="crewon-auth-divider"><span>或使用账号密码</span></div><div class="crewon-auth-tabs" role="tablist" aria-label="登录或注册"><button aria-selected="false" role="tab" type="button">登录</button><button aria-selected="true" class="active" role="tab" type="button">注册</button></div><form class="crewon-auth-form"><label><span>用户名</span><input autoComplete="username" minLength="3" required="" name="username"/></label><label><span>企业邮箱</span><input autoComplete="email" type="email" required="" name="email"/></label><label><span>密码</span><div class="crewon-auth-password-input"><input autoComplete="new-password" minLength="8" required="" type="password" name="password"/><button aria-label="显示密码" title="显示密码" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye-off" aria-hidden="true"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"></path><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path><path d="m2 2 20 20"></path></svg></button></div><small>至少 8 位，包含大小写字母和数字</small></label><label><span>确认密码</span><div class="crewon-auth-password-input"><input autoComplete="new-password" required="" type="password" name="confirmPassword"/><button aria-label="显示密码" title="显示密码" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye-off" aria-hidden="true"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"></path><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path><path d="m2 2 20 20"></path></svg></button></div></label><button class="crewon-auth-submit" type="submit"><span>创建账号</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></button></form><footer>登录即表示同意企业账号与资源访问策略</footer></div></section></main><div class="crewon-password-backdrop" role="presentation"><section aria-labelledby="crewon-password-title" aria-modal="true" class="crewon-password-dialog" role="dialog"><header><span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock-keyhole" aria-hidden="true"><circle cx="12" cy="16" r="1"></circle><rect x="3" y="10" width="18" height="12" rx="2"></rect><path d="M7 10V7a5 5 0 0 1 10 0v3"></path></svg></span><div><h2 id="crewon-password-title">设置登录密码</h2><p>设置后可使用用户名或企业邮箱登录</p></div><button aria-label="关闭" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></header><form><label><span>新密码</span><div class="crewon-auth-password-input"><input minLength="8" required="" type="password" name="newPassword"/><button aria-label="显示密码" title="显示密码" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye-off" aria-hidden="true"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"></path><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path><path d="m2 2 20 20"></path></svg></button></div></label><label><span>确认密码</span><div class="crewon-auth-password-input"><input minLength="8" required="" type="password" name="confirmPassword"/><button aria-label="显示密码" title="显示密码" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye-off" aria-hidden="true"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"></path><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path><path d="m2 2 20 20"></path></svg></button></div></label><small>至少 8 位，包含大小写字母和数字</small><button class="crewon-auth-submit" type="submit">保存密码</button></form></section></div>"`;

exports[`CrewON resource catalog MVP > snapshots the agent-platform login and registration entry 1`] = `"<main class="crewon-auth-shell"><section class="crewon-auth-story" aria-label="CrewON 产品介绍"><a class="crewon-auth-brand" href="#"><span class="crewon-auth-brand-mark">C</span><span><strong>CrewON</strong><small>Agent 协作工作台</small></span></a><div class="crewon-auth-story-copy"><h1>CrewON 智能协作工作台</h1><p>统一组织 Agent、Skill、MCP 与企业知识，协同推进任务交付。</p></div></section><section class="crewon-auth-panel" aria-label="账号登录注册"><div class="crewon-auth-card"><header><span class="crewon-auth-mobile-brand">CrewON</span><h2>进入 CrewON</h2><p>登录后继续进入智能体工作台</p></header><button class="crewon-auth-sso" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-building2" aria-hidden="true"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"></path><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"></path><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"></path><path d="M10 6h4"></path><path d="M10 10h4"></path><path d="M10 14h4"></path><path d="M10 18h4"></path></svg>使用企业微信登录</button><div class="crewon-auth-divider"><span>或使用账号密码</span></div><div class="crewon-auth-tabs" role="tablist" aria-label="登录或注册"><button aria-selected="true" class="active" role="tab" type="button">登录</button><button aria-selected="false" role="tab" type="button">注册</button></div><form class="crewon-auth-form"><label><span>用户名或邮箱</span><input autoComplete="username" minLength="3" required="" name="username"/></label><label><span>密码</span><div class="crewon-auth-password-input"><input autoComplete="current-password" minLength="8" required="" type="password" name="password"/><button aria-label="显示密码" title="显示密码" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye-off" aria-hidden="true"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"></path><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path><path d="m2 2 20 20"></path></svg></button></div></label><button class="crewon-auth-submit" type="submit"><span>进入 CrewON</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></button></form><footer>登录即表示同意企业账号与资源访问策略</footer></div></section></main>"`;
