exports[`CrewON resource catalog MVP > snapshots friendly online read-only resource details 1`] = `
"<div class="catalog-detail-document"><section><h3>能力说明</h3><p>回答企业授信业务问题</p></section><section><h3>配置状态</h3><dl class="catalog-contract-list"><div><dt>模式</dt><dd>可用</dd></div><div><dt>运行</dt><dd>Open API 已启用</dd></div></dl></section></div><div class="catalog-skill-reader"><aside class="catalog-file-browser"><header><strong>文件</strong></header><div></div></aside><article class="catalog-reader-content"><div class="markdown-content"><h1>风险校验</h1>
<p>校验输入并输出风险提示。</p></div></article></div><div class="catalog-detail-document"><section><h3>服务说明</h3><p>查询风险信号</p></section><section><h3>服务地址</h3><dl class="catalog-contract-list"><div><dt>Endpoint</dt><dd><code>https://mcp.example.com/risk</code></dd></div><div><dt>上游地址</dt><dd><code>https://upstream.example.com/risk</code></dd></div></dl></section><section><h3>工具</h3><div class="catalog-tool-list"><details open=""><summary><span><strong>lookup_risk</strong><small>按企业名称查询风险</small></span><span>查看参数</span></summary><div><h4>输入参数</h4><div class="catalog-schema-table" role="table"><div class="catalog-schema-row catalog-schema-head" role="row"><span>字段</span><span>类型</span><span>要求</span><span>说明</span></div><div class="catalog-schema-row" role="row"><code>company</code><span>string</span><span>必填</span><span>企业名称</span></div></div><h4>调用响应</h4><div class="catalog-schema-table" role="table"><div class="catalog-schema-row catalog-schema-head" role="row"><span>字段</span><span>类型</span><span>要求</span><span>说明</span></div><div class="catalog-schema-row" role="row"><code>tool_id</code><span>integer</span><span>必填</span><span>平台 Tool ID</span></div><div class="catalog-schema-row" role="row"><code>tool_name</code><span>string</span><span>必填</span><span>MCP Tool 名称</span></div><div class="catalog-schema-row" role="row"><code>result</code><span>object</span><span>必填</span><span>MCP ToolResult</span></div><div class="catalog-schema-row" role="row"><code>session_id</code><span>string</span><span>必填</span><span>本次调用会话 ID</span></div></div><h4>Tool 结果</h4><p class="catalog-schema-note">该工具未声明 outputSchema，按 MCP 标准 ToolResult 展示。</p><div class="catalog-schema-table" role="table"><div class="catalog-schema-row catalog-schema-head" role="row"><span>字段</span><span>类型</span><span>要求</span><span>说明</span></div><div class="catalog-schema-row" role="row"><code>content</code><span>array</span><span>可选</span><span>文本、图片、音频或资源内容</span></div><div class="catalog-schema-row" role="row"><code>structuredContent</code><span>object</span><span>可选</span><span>工具返回的结构化数据</span></div><div class="catalog-schema-row" role="row"><code>isError</code><span>boolean</span><span>可选</span><span>工具是否返回执行错误</span></div></div></div></details><details><summary><span><strong>score_risk</strong><small>输出结构化风险等级</small></span><span>查看参数</span></summary><div><h4>输入参数</h4><div class="catalog-schema-table" role="table"><div class="catalog-schema-row catalog-schema-head" role="row"><span>字段</span><span>类型</span><span>要求</span><span>说明</span></div><div class="catalog-schema-row" role="row"><code>company</code><span>string</span><span>可选</span><span>-</span></div></div><h4>调用响应</h4><div class="catalog-schema-table" role="table"><div class="catalog-schema-row catalog-schema-head" role="row"><span>字段</span><span>类型</span><span>要求</span><span>说明</span></div><div class="catalog-schema-row" role="row"><code>tool_id</code><span>integer</span><span>必填</span><span>平台 Tool ID</span></div><div class="catalog-schema-row" role="row"><code>tool_name</code><span>string</span><span>必填</span><span>MCP Tool 名称</span></div><div class="catalog-schema-row" role="row"><code>result</code><span>object</span><span>必填</span><span>MCP ToolResult</span></div><div class="catalog-schema-row" role="row"><code>session_id</code><span>string</span><span>必填</span><span>本次调用会话 ID</span></div></div><h4>Tool 结果</h4><div class="catalog-schema-table" role="table"><div class="catalog-schema-row catalog-schema-head" role="row"><span>字段</span><span>类型</span><span>要求</span><span>说明</span></div><div class="catalog-schema-row" role="row"><code>risk_level</code><span>string</span><span>必填</span><span>风险等级</span></div></div></div></details></div></section></div><div class="catalog-knowledge-reader"><aside><strong>文档</strong><div><button class="active" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-text" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg><span>授信规则</span></button></div></aside><article class="catalog-reader-content"><h3>授信规则</h3><div class="markdown-content"><h1>授信规则</h1>
<p>申请材料必须完整。</p></div></article></div>"
`;

