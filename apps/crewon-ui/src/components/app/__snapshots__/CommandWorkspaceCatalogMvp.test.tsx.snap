exports[`CrewON resource catalog MVP > snapshots loading, empty-account, and unavailable catalog states 1`] = `"<section class="shell-view shell-page-view active" data-filter-scope="" data-od-id="shell-view-agents" data-shell-view="agents"><div class="page-stack" data-filter-scope=""><header class="catalog-market-header" data-od-id="agents-header-inline"><div class="catalog-mode-tabs" role="group" aria-label="能力分类筛选"><button aria-pressed="false" class="filter-chip mode-tab" data-filter-group="category" data-filter="employee" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bot" aria-hidden="true"><path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path d="M2 14h2"></path><path d="M20 14h2"></path><path d="M15 13v2"></path><path d="M9 13v2"></path></svg><span>智能体</span></button><button aria-pressed="false" class="filter-chip mode-tab" data-filter-group="category" data-filter="skill" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-wrench" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg><span>技能</span></button><button aria-pressed="false" class="filter-chip mode-tab" data-filter-group="category" data-filter="service" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layers" aria-hidden="true"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-