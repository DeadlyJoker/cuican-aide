// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`keeps every conversation under its persisted owner when adding and activating workspaces 1`] = `"<section class="space-tree" data-od-id="desktop-workspace-tree" aria-label="工作空间和对话"><div class="tree-head"><strong class="tree-head-label">工作空间</strong><button aria-label="新增空间" class="tree-head-action" title="新增空间" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></button></div><div class="space-node real-workspace-node" data-workspace-id="workspace-a"><div class="space-title real-workspace-title"><button aria-label="切换到工作空间 Project A" class="workspace-title-toggle" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder" aria-hidden="true"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg><strong>Project A</strong></button><span class="workspace-row-actions"><button aria-label="在工作空间 Project A 中新建会话" title="在工作空间 Project A 中新建会话" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-pen" aria-hidden="true"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"></path></svg></button></span></div><div class="conversation-list recent-thread-list"><div class="command-sidebar-thread-row" data-selected="false"><button class="conversation-item linked-conversation-item recent-thread-item" data-linked-thread-id="thread-a" data-thread-state="completedViewed" type="button" data-state="closed" data-slot="tooltip-trigger"><span class="command-sidebar-thread-title">Task A</span><em class="command-thread-status-time">Today</em></button></div></div></div><div class="space-node real-workspace-node current" data-workspace-id="workspace-b"><div class="space-title real-workspace-title"><button aria-label="切换到工作空间 Project B" class="workspace-title-toggle" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder-open" aria-hidden="true"><path d="m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2"></path></svg><strong>Project B</strong></button><span class="workspace-row-actions"><button aria-label="在工作空间 Project B 中新建会话" title="在工作空间 Project B 中新建会话" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-pen" aria-hidden="true"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"></path></svg></button></span></div><div class="conversation-list recent-thread-list"><div class="command-sidebar-thread-row" data-selected="false"><button class="conversation-item linked-conversation-item recent-thread-item" data-linked-thread-id="thread-b" data-thread-state="completedViewed" type="button" data-state="closed" data-slot="tooltip-trigger"><span class="command-sidebar-thread-title">Task B</span><em class="command-thread-status-time">Today</em></button></div></div></div><div class="space-node real-workspace-node" data-workspace-id="workspace-empty"><div class="space-title real-workspace-title"><button aria-label="切换到工作空间 Empty project" class="workspace-title-toggle" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder" aria-hidden="true"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg><strong>Empty project</strong></button><span class="workspace-row-actions"><button aria-label="在工作空间 Empty project 中新建会话" title="在工作空间 Empty project 中新建会话" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-pen" aria-hidden="true"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"></path></svg></button></span></div><div class="conversation-list recent-thread-list"><p class="sidebar-empty-hint">开始一次任务后，会话会出现在这个工作空间下。</p></div></div><div class="space-node standalone-workspace-node"><div class="space-title standalone-workspace-title"><button aria-controls="standalone-workspace-thread-list" aria-expanded="true" class="workspace-title-toggle standalone-workspace-toggle" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg><strong>无工作空间</strong></button><span class="workspace-row-actions"><button aria-label="新建无工作空间会话" title="新建无工作空间会话" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-pen" aria-hidden="true"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"></path></svg></button></span></div><div class="conversation-list recent-thread-list standalone-thread-list" id="standalone-workspace-thread-list"><div class="command-sidebar-thread-row" data-selected="false"><button class="conversation-item linked-conversation-item recent-thread-item" data-linked-thread-id="thread-old" data-thread-state="completedViewed" type="button" data-state="closed" data-slot="tooltip-trigger"><span class="command-sidebar-thread-title">Old unbound task</span><em class="command-thread-status-time">Today</em></button></div></div></div></section>"`;
