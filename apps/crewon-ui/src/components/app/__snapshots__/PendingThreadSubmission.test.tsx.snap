exports[`Immediate user message submission > matches the new-conversation user bubble snapshot before a task exists 1`] = `"<header class="home-title thread-home-title" data-od-id="desktop-command-header"><p>Agent conversation</p><h1><span>New conversation</span></h1></header><section class="command-thread-room" data-od-id="command-thread-room"><main class="transcript"><div class="message-list" role="log" aria-busy="false" aria-live="polite" aria-relevant="additions text"><section data-pending-user-message="sending"><article class="message" data-kind="userMessage" data-has-icon="false" data-transcript-variant="message" aria-label="You"><div class="message-body"><div class="message-header"><span class="message-role">You</span><span class="message-type">Input</span></div><div class="markdown-content"><p>An idea</p></div></div></article><p class="message-loading-state" role="status">Sending</p></section><div aria-hidden="true" class="transcript-follow-anchor" data-testid="transcript-follow-anchor"></div></div></main></section>"`;
