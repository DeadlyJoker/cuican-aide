// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CommandWorkflowPanel > does not turn catalog-only definitions into runnable workflows 1`] = `"<section class="team-office-empty team-capability-live-empty"><span class="team-office-empty-kicker">真实 Workflow</span><h2>当前账号没有可运行的协作流</h2><p>这里只展示 agent-platform 返回的有效 Workflow，不生成本地演示节点。</p><button class="button" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-cw" aria-hidden="true"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg>重新同步</button></section>"`;

exports[`CommandWorkflowPanel > snapshots the design-aligned Workflow room with real execution 1`] = `"<section class="workflow-room-inline workflow-runtime-room" data-workflow-room="" aria-labelledby="team-workflow-room-title"><header class="workflow-room-top"><button class="button compact" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>返回</button><div class="workflow-room-title-block"><span>协作流群聊</span><h3 id="team-workflow-room-title">需求风险分析</h3><p title="当前阶段：需求审阅 · 产品审阅智能体">当前阶段：需求审阅 · 产品审阅智能体</p></div><div class="workflow-room-actions"><span class="status">待启动</span><button aria-label="同步协作流" class="button compact" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-cw" aria-hidden="true"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg>同步</button></div></header><main class="workflow-room-stage"><section class="workflow-execution-strip" aria-label="执行节点"><article class="workflow-step-node"><span>01</span><div><strong>需求审阅</strong><p>产品审阅智能体</p></div><em class="status">排队</em></article><article class="workflow-step-node"><span>02</span><div><strong>交付检查</strong><p>开发交付智能体</p></div><em class="status">排队</em></article></section><section class="workflow-chat-panel"><div class="workflow-room-thread" role="log" aria-label="协作流群聊"><div class="workflow-thread-empty"><strong>从一个明确目标开始</strong><p>输入目标后，协作流会按云端定义推进并返回结果。</p></div></div><form class="command-input workflow-global-composer" data-command-composer="true"><label class="visually-hidden" for="workflow-message-input">协作流消息输入</label><textarea aria-label="协作流消息输入" data-composer="" id="workflow-message-input" placeholder="继续推进这个协作流…" rows="2"></textarea><div class="input-tools" data-od-id="composer-tools"><div class="composer-controls" data-od-id="composer-control-row"><span class="workflow-composer-capabilities"><b>@</b> 指定阶段 Agent<i aria-hidden="true">·</i><b>/</b> 调用 Skill 或 MCP</span></div><div class="composer-actions" data-od-id="composer-action-row"><button aria-label="运行协作流" class="send-button" data-action="send" disabled="" title="运行协作流" type="submit"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up" aria-hidden="true"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg></button></div></div><div class="composer-state-row"><span class="composer-state" role="status">协作流 · 已就绪</span></div></form></section></main></section>"`;

exports[`CommandWorkflowPanel > snapshots the design-aligned real Workflow list 1`] = `"<div class="workflow-list" data-workflow-list="" aria-label="协作流列表"><button class="workflow-list-item" data-workflow-open="" type="button"><span class="workflow-list-main"><strong>需求风险分析</strong><em class="status">待启动</em></span><span class="workflow-list-meta"><span class="workflow-list-copy" title="当前阶段：需求审阅 · 产品审阅智能体">当前阶段：需求审阅 · 产品审阅智能体</span><span class="workflow-member-strip" aria-label="协作流来源"><small>产</small><small>开</small><em>2 成员</em></span></span><span class="workflow-list-foot"><span class="workflow-list-progress" aria-hidden="true"><i class=""></i><i class=""></i></span><b>进入群聊</b></span></button><button class="workflow-list-item" data-workflow-open="" type="button"><span class="workflow-list-main"><strong>交付验收协作流</strong><em class="status">已启用</em></span><span class="workflow-list-meta"><span class="workflow-list-copy" title="串联需求审阅、实现检查和人工验收。">串联需求审阅、实现检查和人工验收。</span><span class="workflow-member-strip" aria-label="协作流来源"><small>云</small><em>Agent Platform</em></span></span><span class="workflow-list-foot"><b>进入群聊</b></span></button></div>"`;
