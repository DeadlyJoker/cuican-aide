// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CommandWorkflowPanel > does not retain Gate actions or a waiting stage after cancellation 1`] = `"<section class="workflow-room-inline workflow-runtime-room" data-workflow-room="" aria-labelledby="team-workflow-room-title"><header class="workflow-room-top"><button class="button compact" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>返回</button><div class="workflow-room-title-block"><span>团队协作</span><h3 id="team-workflow-room-title">已取消的人工验收流</h3><p title="当前阶段：人工验收 · 人工确认">当前阶段：人工验收 · 人工确认</p></div><div class="workflow-room-actions"><span class="status danger">已取消</span><button aria-label="同步协作流" class="button compact" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-cw" aria-hidden="true"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg>同步</button></div></header><main class="workflow-room-stage"><section class="workflow-execution-strip" aria-label="执行步骤"><article class="workflow-step-node is-done"><span>01</span><div><strong>需求审阅</strong><p>产品审阅成员</p></div><em class="status success">完成</em></article><article class="workflow-step-node is-error"><span>02</span><div><strong>人工验收</strong><p>由你确认</p></div><em class="status danger">已取消</em></article></section><section class="workflow-chat-panel"><div class="workflow-room-thread" role="log" aria-label="协作流群聊"><article class="office-room-message is-user"><span class="team-avatar">你</span><div><strong>你</strong><p>检查后取消</p></div></article><article class="office-room-message workflow-result-message"><span class="team-avatar">流</span><div><strong>协作结果</strong><div class="markdown-content"><p>协作已取消，后续步骤不会继续。</p></div><div class="message-actions" data-user="false" data-visibility="always" role="group" aria-label="回复操作"><button type="button" aria-label="复制" class="message-action-button" data-state="closed" data-slot="tooltip-trigger"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg></button><span class="message-action-status" role="status"></span></div><section class="workflow-node-outputs" aria-label="节点产出"><p>节点产出保留在下方，供你核对；执行完成不代表已经对外发送或发布。</p><details><summary>需求审阅 · 查看产出</summary><div class="workflow-node-output-body"><div class="markdown-content"><p>已完成审阅</p></div><div class="message-actions" data-user="false" data-visibility="always" role="group" aria-label="回复操作"><button type="button" aria-label="复制" class="message-action-button" data-state="closed" data-slot="tooltip-trigger"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg></button><span class="message-action-status" role="status"></span></div></div></details></section><small>本次协作 · 已取消</small></div></article></div><form class="command-input workflow-global-composer" data-command-composer="true"><label class="visually-hidden" for="workflow-message-input">协作流消息输入</label><textarea aria-label="协作流消息输入" data-composer="" id="workflow-message-input" placeholder="继续推进这个协作流…" rows="2"></textarea><div class="input-tools" data-od-id="composer-tools"><div class="composer-controls" data-od-id="composer-control-row"><span class="workflow-composer-capabilities"><b>@</b> 选择负责成员<i aria-hidden="true">·</i><b>/</b> 添加能力</span></div><div class="composer-actions" data-od-id="composer-action-row"><button aria-label="运行协作流" class="send-button" data-action="send" disabled="" title="运行协作流" type="submit"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up" aria-hidden="true"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg></button></div></div><div class="composer-state-row"><span class="composer-state" role="status">可以继续沟通</span></div></form></section></main></section>"`;

exports[`CommandWorkflowPanel > renders a completed result as readable Markdown without exposing run ids 1`] = `
"<section class="workflow-room-inline workflow-runtime-room" data-workflow-room="" aria-labelledby="team-workflow-room-title"><header class="workflow-room-top"><button class="button compact" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>返回</button><div class="workflow-room-title-block"><span>团队协作</span><h3 id="team-workflow-room-title">上线验收</h3><p title="全部步骤已完成">全部步骤已完成</p></div><div class="workflow-room-actions"><span class="status success">已完成</span><button aria-label="同步协作流" class="button compact" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-cw" aria-hidden="true"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg>同步</button></div></header><main class="workflow-room-stage"><section class="workflow-execution-strip" aria-label="执行步骤"><article class="workflow-step-node is-done"><span>01</span><div><strong>需求审阅</strong><p>产品审阅成员</p></div><em class="status success">完成</em></article><article class="workflow-step-node is-done"><span>02</span><div><strong>交付检查</strong><p>开发交付成员</p></div><em class="status success">完成</em></article></section><section class="workflow-chat-panel"><div class="workflow-room-thread" role="log" aria-label="协作流群聊"><article class="office-room-message is-user"><span class="team-avatar">你</span><div><strong>你</strong><p>给我最终验收结论</p></div></article><article class="office-room-message workflow-result-message"><span class="team-avatar">流</span><div><strong>协作结果</strong><div class="markdown-content"><h3>验收结论</h3>
<p>已完成全部检查。</p>
<ul>
<li>登录正常</li>
<li>核心流程正常</li>
</ul></div><div class="message-actions" data-user="false" data-visibility="always" role="group" aria-label="回复操作"><button type="button" aria-label="复制" class="message-action-button" data-state="closed" data-slot="tooltip-trigger"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg></button><span class="message-action-status" role="status"></span></div><section class="workflow-node-outputs" aria-label="节点产出"><p>节点产出保留在下方，供你核对；执行完成不代表已经对外发送或发布。</p><details><summary>需求审阅 · 查看产出</summary><div class="workflow-node-output-body"><div class="markdown-content"><p>检查完成</p></div><div class="message-actions" data-user="false" data-visibility="always" role="group" aria-label="回复操作"><button type="button" aria-label="复制" class="message-action-button" data-state="closed" data-slot="tooltip-trigger"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg></button><span class="message-action-status" role="status"></span></div></div></details><details><summary>交付检查 · 查看产出</summary><div class="workflow-node-output-body"><div class="markdown-content"><p>检查完成</p></div><div class="message-actions" data-user="false" data-visibility="always" role="group" aria-label="回复操作"><button type="button" aria-label="复制" class="message-action-button" data-state="closed" data-slot="tooltip-trigger"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg></button><span class="message-action-status" role="status"></span></div></div></details></section><small>本次协作 · 已完成</small></div></article></div><form class="command-input workflow-global-composer" data-command-composer="true"><label class="visually-hidden" for="workflow-message-input">协作流消息输入</label><textarea aria-label="协作流消息输入" data-composer="" id="workflow-message-input" placeholder="继续推进这个协作流…" rows="2"></textarea><div class="input-tools" data-od-id="composer-tools"><div class="composer-controls" data-od-id="composer-control-row"><span class="workflow-composer-capabilities"><b>@</b> 选择负责成员<i aria-hidden="true">·</i><b>/</b> 添加能力</span></div><div class="composer-actions" data-od-id="composer-action-row"><button aria-label="运行协作流" class="send-button" data-action="send" disabled="" title="运行协作流" type="submit"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up" aria-hidden="true"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg></button></div></div><div class="composer-state-row"><span class="composer-state" role="status">可以继续沟通</span></div></form></section></main></section>"
`;

exports[`CommandWorkflowPanel > shows a readable verification failure while preserving its detailed output 1`] = `
"<section class="workflow-room-inline workflow-runtime-room" data-workflow-room="" aria-labelledby="team-workflow-room-title"><header class="workflow-room-top"><button class="button compact" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>返回</button><div class="workflow-room-title-block"><span>团队协作</span><h3 id="team-workflow-room-title">独立验收流</h3><p title="当前阶段：独立验证 · 独立验证成员">当前阶段：独立验证 · 独立验证成员</p></div><div class="workflow-room-actions"><span class="status danger">失败</span><button aria-label="同步协作流" class="button compact" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-cw" aria-hidden="true"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg>同步</button></div></header><main class="workflow-room-stage"><section class="workflow-execution-strip" aria-label="执行步骤"><article class="workflow-step-node is-done"><span>01</span><div><strong>需求审阅</strong><p>产品审阅成员</p></div><em class="status success">完成</em></article><article class="workflow-step-node is-error"><span>02</span><div><strong>独立验证</strong><p>独立验证成员</p></div><em class="status danger">失败</em></article></section><section class="workflow-chat-panel"><div class="workflow-room-thread" role="log" aria-label="协作流群聊"><article class="office-room-message is-user"><span class="team-avatar">你</span><div><strong>你</strong><p>验证本次发布</p></div></article><article class="office-room-message workflow-result-message"><span class="team-avatar">流</span><div><strong>协作结果</strong><div class="markdown-content"><p><strong>独立验证未通过，协作流已停止。请根据验证详情修复后重试。</strong></p>
<h3>验证详情</h3>
<p>VERDICT: FAIL</p>
<ul>
<li>缺少回滚证据</li>
<li>不允许发布</li>
</ul></div><div class="message-actions" data-user="false" data-visibility="always" role="group" aria-label="回复操作"><button type="button" aria-label="复制" class="message-action-button" data-state="closed" data-slot="tooltip-trigger"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg></button><span class="message-action-status" role="status"></span></div><section class="workflow-node-outputs" aria-label="节点产出"><p>节点产出保留在下方，供你核对；执行完成不代表已经对外发送或发布。</p><details><summary>需求审阅 · 查看产出</summary><div class="workflow-node-output-body"><div class="markdown-content"><p>已完成审阅</p></div><div class="message-actions" data-user="false" data-visibility="always" role="group" aria-label="回复操作"><button type="button" aria-label="复制" class="message-action-button" data-state="closed" data-slot="tooltip-trigger"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg></button><span class="message-action-status" role="status"></span></div></div></details></section><small>本次协作 · 失败</small></div></article></div><form class="command-input workflow-global-composer" data-command-composer="true"><label class="visually-hidden" for="workflow-message-input">协作流消息输入</label><textarea aria-label="协作流消息输入" data-composer="" id="workflow-message-input" placeholder="继续推进这个协作流…" rows="2"></textarea><div class="input-tools" data-od-id="composer-tools"><div class="composer-controls" data-od-id="composer-control-row"><span class="workflow-composer-capabilities"><b>@</b> 选择负责成员<i aria-hidden="true">·</i><b>/</b> 添加能力</span></div><div class="composer-actions" data-od-id="composer-action-row"><button aria-label="运行协作流" class="send-button" data-action="send" disabled="" title="运行协作流" type="submit"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up" aria-hidden="true"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg></button></div></div><div class="composer-state-row"><span class="composer-state" role="status">可以继续沟通</span></div></form></section></main></section>"
`;

exports[`CommandWorkflowPanel > shows the unavailable local service state without catalog fallbacks 1`] = `"<section aria-labelledby="_R_0_" class="command-team-empty-state" data-team-empty-state="unavailable"><span class="command-team-empty-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-workflow"><rect width="8" height="8" x="3" y="3" rx="2"></rect><path d="M7 11v4a2 2 0 0 0 2 2h4"></path><rect width="8" height="8" x="13" y="13" rx="2"></rect></svg></span><div class="command-team-empty-copy"><span class="command-team-empty-eyebrow">协作流</span><h2 id="_R_0_">暂时无法打开协作流</h2><p>暂时无法读取协作流，稍后可以重新同步。</p></div><footer class="command-team-empty-footer"><span class="command-team-empty-status" role="status">连接暂时中断</span><button class="button" type="button">重新同步</button></footer></section>"`;

exports[`CommandWorkflowPanel > snapshots a persisted Human Gate with approve, reject, and cancel controls 1`] = `"<section class="workflow-room-inline workflow-runtime-room" data-workflow-room="" aria-labelledby="team-workflow-room-title"><header class="workflow-room-top"><button class="button compact" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>返回</button><div class="workflow-room-title-block"><span>团队协作</span><h3 id="team-workflow-room-title">带人工验收的交付流</h3><p title="当前阶段：人工验收 · 人工确认">当前阶段：人工验收 · 人工确认</p></div><div class="workflow-room-actions"><span class="status warn">等待你确认</span><button aria-label="同步协作流" class="button compact" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-cw" aria-hidden="true"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg>同步</button><button aria-label="取消当前协作流运行" class="button compact workflow-cancel-button" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect></svg>取消运行</button></div></header><main class="workflow-room-stage"><section class="workflow-execution-strip" aria-label="执行步骤"><article class="workflow-step-node is-done"><span>01</span><div><strong>需求审阅</strong><p>产品审阅成员</p></div><em class="status success">完成</em></article><article class="workflow-step-node is-done"><span>02</span><div><strong>交付检查</strong><p>开发交付成员</p></div><em class="status success">完成</em></article><article class="workflow-step-node is-waiting" aria-current="step"><span>03</span><div><strong>人工验收</strong><p>由你确认</p></div><em class="status warn">等你确认</em></article></section><section class="workflow-chat-panel"><div class="workflow-room-thread" role="log" aria-label="协作流群聊"><article class="office-room-message is-user"><span class="team-avatar">你</span><div><strong>你</strong><p>检查交付风险</p></div></article><article class="office-room-message workflow-result-message"><span class="team-avatar">流</span><div><strong>协作结果</strong><div class="markdown-content"><p>已到达确认环节，等待你批准或驳回。</p></div><div class="message-actions" data-user="false" data-visibility="always" role="group" aria-label="回复操作"><button type="button" aria-label="复制" class="message-action-button" data-state="closed" data-slot="tooltip-trigger"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg></button><span class="message-action-status" role="status"></span></div><section class="workflow-node-outputs" aria-label="节点产出"><p>节点产出保留在下方，供你核对；执行完成不代表已经对外发送或发布。</p><details><summary>需求审阅 · 查看产出</summary><div class="workflow-node-output-body"><div class="markdown-content"><p>风险清单</p></div><div class="message-actions" data-user="false" data-visibility="always" role="group" aria-label="回复操作"><button type="button" aria-label="复制" class="message-action-button" data-state="closed" data-slot="tooltip-trigger"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg></button><span class="message-action-status" role="status"></span></div></div></details><details><summary>交付检查 · 查看产出</summary><div class="workflow-node-output-body"><div class="markdown-content"><p>交付检查通过</p></div><div class="message-actions" data-user="false" data-visibility="always" role="group" aria-label="回复操作"><button type="button" aria-label="复制" class="message-action-button" data-state="closed" data-slot="tooltip-trigger"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg></button><span class="message-action-status" role="status"></span></div></div></details></section><small>本次协作 · 等待你确认</small></div></article><section class="workflow-gate-card" aria-label="确认环节"><div class="workflow-gate-card-copy"><span>等待你确认</span><strong>人工验收</strong><p>确认风险清单是否满足交付口径。</p></div><label class="form-field"><span>审批说明（可选）</span><textarea maxLength="2000" placeholder="补充批准依据或驳回原因"></textarea></label><div class="workflow-gate-actions"><button class="approval-deny" type="button">驳回并结束</button><button class="approval-approve" type="button">批准并继续</button></div></section></div><form class="command-input workflow-global-composer" data-command-composer="true"><label class="visually-hidden" for="workflow-message-input">协作流消息输入</label><textarea aria-label="协作流消息输入" data-composer="" disabled="" id="workflow-message-input" placeholder="继续推进这个协作流…" rows="2"></textarea><div class="input-tools" data-od-id="composer-tools"><div class="composer-controls" data-od-id="composer-control-row"><span class="workflow-composer-capabilities"><b>@</b> 选择负责成员<i aria-hidden="true">·</i><b>/</b> 添加能力</span></div><div class="composer-actions" data-od-id="composer-action-row"><button aria-busy="true" aria-label="运行协作流" class="send-button" data-action="send" disabled="" title="运行协作流" type="submit"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up" aria-hidden="true"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg></button></div></div><div class="composer-state-row"><span class="composer-state" role="status">等待你确认</span></div></form></section></main></section>"`;

exports[`CommandWorkflowPanel > snapshots the design-aligned local Workflow list 1`] = `"<div class="workflow-list" data-workflow-list="" aria-label="协作流列表"><button class="workflow-list-item" data-workflow-open="" type="button"><span class="workflow-list-index" aria-hidden="true"><b>2</b><small>步骤</small></span><span class="workflow-list-main"><span class="workflow-list-title"><strong>需求风险分析</strong><small title="分析输入并返回交付风险清单">分析输入并返回交付风险清单</small></span><em class="status">待启动</em></span><span class="workflow-list-meta"><span class="workflow-list-copy" title="当前阶段：需求审阅 · 产品审阅智能体">当前阶段：需求审阅 · 产品审阅智能体</span><span class="workflow-member-strip" aria-label="协作流来源"><small>产</small><small>开</small><em>2 成员</em></span></span><span class="workflow-list-foot"><span class="workflow-list-progress" aria-hidden="true"><i class=""></i><i class=""></i></span><b>进入群聊</b></span></button><button class="workflow-list-item" data-workflow-open="" type="button"><span class="workflow-list-index" aria-hidden="true"><b>1</b><small>步骤</small></span><span class="workflow-list-main"><span class="workflow-list-title"><strong>交付验收协作流</strong><small title="串联需求审阅、实现检查和人工验收。">串联需求审阅、实现检查和人工验收。</small></span><em class="status">待启动</em></span><span class="workflow-list-meta"><span class="workflow-list-copy" title="当前阶段：需求审阅 · 产品审阅智能体">当前阶段：需求审阅 · 产品审阅智能体</span><span class="workflow-member-strip" aria-label="协作流来源"><small>产</small><em>1 成员</em></span></span><span class="workflow-list-foot"><span class="workflow-list-progress" aria-hidden="true"><i class=""></i></span><b>进入群聊</b></span></button></div>"`;

exports[`CommandWorkflowPanel > snapshots the local Workflow room 1`] = `"<section class="workflow-room-inline workflow-runtime-room" data-workflow-room="" aria-labelledby="team-workflow-room-title"><header class="workflow-room-top"><button class="button compact" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>返回</button><div class="workflow-room-title-block"><span>团队协作</span><h3 id="team-workflow-room-title">需求风险分析</h3><p title="当前阶段：需求审阅 · 产品审阅智能体">当前阶段：需求审阅 · 产品审阅智能体</p></div><div class="workflow-room-actions"><span class="status">待启动</span><button aria-label="同步协作流" class="button compact" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-cw" aria-hidden="true"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg>同步</button></div></header><main class="workflow-room-stage"><section class="workflow-execution-strip" aria-label="执行步骤"><article class="workflow-step-node"><span>01</span><div><strong>需求审阅</strong><p>产品审阅成员</p></div><em class="status">未开始</em></article><article class="workflow-step-node"><span>02</span><div><strong>交付检查</strong><p>开发交付成员</p></div><em class="status">未开始</em></article></section><section class="workflow-chat-panel"><div class="workflow-room-thread" role="log" aria-label="协作流群聊"><div class="workflow-thread-empty"><strong>从一个明确目标开始</strong><p>输入目标后，团队会按既定步骤接力完成。</p></div></div><form class="command-input workflow-global-composer" data-command-composer="true"><label class="visually-hidden" for="workflow-message-input">协作流消息输入</label><textarea aria-label="协作流消息输入" data-composer="" id="workflow-message-input" placeholder="继续推进这个协作流…" rows="2"></textarea><div class="input-tools" data-od-id="composer-tools"><div class="composer-controls" data-od-id="composer-control-row"><span class="workflow-composer-capabilities"><b>@</b> 选择负责成员<i aria-hidden="true">·</i><b>/</b> 添加能力</span></div><div class="composer-actions" data-od-id="composer-action-row"><button aria-label="运行协作流" class="send-button" data-action="send" disabled="" title="运行协作流" type="submit"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up" aria-hidden="true"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg></button></div></div><div class="composer-state-row"><span class="composer-state" role="status">可以继续沟通</span></div></form></section></main></section>"`;
