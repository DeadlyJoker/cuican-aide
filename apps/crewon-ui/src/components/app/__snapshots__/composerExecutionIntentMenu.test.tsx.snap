exports[`composer intent menu > offers explicit, mutually exclusive en selections without inserting prompt tokens 1`] = `"<div class="context-palette add-palette" data-od-id="add" data-composer-palette="" id="add"><label class="visually-hidden" for="search">Add</label><input id="search" placeholder="Add" type="search" value=""/><div class="context-list"><section class="add-palette-group"><div class="add-palette-group-label">Execution intent</div><button class="add-palette-item" data-active="true" data-kind="intent" data-label="Goal" aria-pressed="true" type="button"><span class="add-palette-item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-target" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg></span><span class="add-palette-item-copy"><strong>Goal</strong><em>Create or update a goal when you send, then keep working toward it</em></span><span class="add-palette-item-check"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span></button><button class="add-palette-item" data-kind="intent" data-label="Plan" aria-pressed="false" type="button"><span class="add-palette-item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-list-checks" aria-hidden="true"><path d="m3 17 2 2 4-4"></path><path d="m3 7 2 2 4-4"></path><path d="M13 6h8"></path><path d="M13 12h8"></path><path d="M13 18h8"></path></svg></span><span class="add-palette-item-copy"><strong>Plan</strong><em>Plan only this turn, without making changes</em></span></button></section></div></div>"`;

exports[`composer intent menu > offers explicit, mutually exclusive zh selections without inserting prompt tokens 1`] = `"<div class="context-palette add-palette" data-od-id="add" data-composer-palette="" id="add"><label class="visually-hidden" for="search">Add</label><input id="search" placeholder="Add" type="search" value=""/><div class="context-list"><section class="add-palette-group"><div class="add-palette-group-label">执行方式</div><button class="add-palette-item" data-active="true" data-kind="intent" data-label="目标" aria-pressed="true" type="button"><span class="add-palette-item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-target" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg></span><span class="add-palette-item-copy"><strong>目标</strong><em>发送后创建或更新目标，持续推进</em></span><span class="add-palette-item-check"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span></button><button class="add-palette-item" data-kind="intent" data-label="计划" aria-pressed="false" type="button"><span class="add-palette-item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-list-checks" aria-hidden="true"><path d="m3 17 2 2 4-4"></path><path d="m3 7 2 2 4-4"></path><path d="M13 6h8"></path><path d="M13 12h8"></path><path d="M13 18h8"></path></svg></span><span class="add-palette-item-copy"><strong>计划</strong><em>本次先制定计划，不执行写操作</em></span></button></section></div></div>"`;
