// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`command workspace schedule style > snapshots the spacious desktop calendar contract 1`] = `
".screen-shell.command-screen .shell-page-view[data-shell-view="schedule"] {
  padding: 10px 18px 36px;
}
.screen-shell.command-screen
  .shell-page-view[data-shell-view="schedule"]
  .page-stack.schedule-page {
  gap: 0;
  /*
   * A column that fills the page so the calendar panel can take the leftover
   * height; as a plain grid it stopped at the panel's 620px minimum and left a
   * ~220px dead band underneath.
   */
  display: flex;
  flex-direction: column;
  min-height: 100%;
  container-name: schedule-page;
  container-type: inline-size;
}
.screen-shell.command-screen
  .shell-page-view[data-shell-view="schedule"]
  .schedule-calendar-shell {
  flex: 1 1 auto;
}
.schedule-header,
.schedule-header-actions,
.schedule-subnav,
.schedule-task-title,
.schedule-task-meta,
.schedule-task-actions,
.schedule-history-filters,
.schedule-delivery {
  display: flex;
  align-items: center;
}
/*
 * Tabs left, actions right -- matching .catalog-market-header. The 12px below
 * the row is padding, not margin, for the same reason: the catalog headers count
 * it inside their 44px box, so carrying it as margin here put the schedule's
 * first content row 10px lower than every other page.
 */
.schedule-header {
  gap: 16px;
  justify-content: space-between;
  min-height: 42px;
  padding-bottom: 12px;
}
.schedule-header-actions {
  flex: 1 1 auto;
  justify-content: flex-end;
  gap: 8px;
}
.schedule-header-actions .button,
.schedule-run-row .button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}
/*
 * Page-level actions match the button scale used on every other page. The old
 * 42px/8px pairing only survived as a radius, since a later rule already pulled
 * the height back to 32px -- exactly the kind of half-applied override that made
 * the pages look unrelated.
 */
.schedule-header-actions .button {
  min-height: var(--control-h-md);
  padding-inline: 16px;
  border-radius: var(--radius-md);
  white-space: nowrap;
}
.schedule-header-actions svg,
.schedule-subnav svg,
.schedule-task-card svg,
.schedule-run-row svg,
.schedule-alert svg,
.schedule-delivery svg {
  width: 15px;
  height: 15px;
}
/* Same search field as the catalog pages, rather than a wider, taller variant. */
.shell-page-view .schedule-search {
  flex: 1 1 280px;
  min-width: 200px;
  max-width: 460px;
  min-height: var(--control-h-md);
  border-radius: var(--radius-md);
}
.schedule-refresh {
  display: inline-grid;
  width: 42px;
  min-width: 42px;
  height: 42px;
  padding: 0;
  place-items: center;
  border: 1px solid var(--n-350);
  border-radius: var(--radius-lg);
  color: var(--n-850);
  background: var(--n-0);
}
.schedule-refresh:hover:not(:disabled) {
  border-color: var(--n-450);
  background: var(--n-75);
}
/*
 * Now a group inside the header, so it carries no bar of its own. It wraps rather
 * than overflowing: tabs plus the action cluster need ~700px, and the pane is
 * often narrower than that.
 */
.schedule-subnav {
  flex: 0 1 auto;
  flex-wrap: wrap;
  gap: 12px;
  min-width: 0;
}
/* The stack has no gap, so each block carries its own trailing space. */
.schedule-summary,
.schedule-alert {
  margin-bottom: 14px;
}
/*
 * The schedule's two tab strips render SegmentedTabs like every other page, so
 * their appearance comes from .mode-tab. Only the divider between them is local.
 */
.schedule-nav-divider {
  /* flex-shrink would collapse a bare span to zero width. */
  flex: 0 0 auto;
  width: 1px;
  height: 18px;
  background: var(--n-300);
}
.schedule-summary {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
}
.schedule-summary article {
  display: grid;
  gap: 7px;
  min-height: 112px;
  padding: 17px 20px;
  border: 1px solid var(--n-300);
  border-radius: var(--radius-xl);
  background: var(--n-0);
}
.schedule-summary span,
.schedule-summary small {
  color: var(--n-700);
  font-size: calc(13px + var(--user-ui-font-delta));
}
.schedule-summary strong {
  color: var(--n-950);
  font-size: calc(28px + var(--user-ui-font-delta));
  line-height: 1.1;
}
.schedule-summary .schedule-next-run {
  font-size: calc(20px + var(--user-ui-font-delta));
}
/* Spacious calendar layout for wide desktop workspaces. */
.schedule-calendar-shell {
  display: grid;
  grid-template-columns: minmax(480px, 1.02fr) minmax(420px, 0.98fr);
  min-height: 620px;
  overflow: hidden;
  border: 1px solid var(--n-300);
  border-radius: var(--radius-xl);
  background: var(--n-0);
  /* A resting page panel, not a popover: a hairline rather than a drop. */
  box-shadow: var(--shadow-raised);
}
.schedule-calendar-pane,
.schedule-agenda-pane {
  /* Columns that can shrink, so the agenda list scrolls instead of overflowing. */
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
  padding: clamp(24px, 2vw, 30px);
}
.schedule-calendar-pane {
  border-right: 1px solid var(--n-250);
  background: linear-gradient(180deg, var(--n-25), var(--n-0) 38%), var(--n-0);
}
.schedule-calendar-toolbar,
.schedule-calendar-controls,
.schedule-agenda-header,
.schedule-agenda-title,
.schedule-agenda-actions,
.schedule-calendar-legend {
  display: flex;
  align-items: center;
}
.schedule-calendar-toolbar,
.schedule-agenda-header {
  justify-content: space-between;
  gap: 20px;
}
.schedule-calendar-toolbar > div:first-child,
.schedule-agenda-header > div {
  display: grid;
  gap: 5px;
}
.schedule-calendar-toolbar span,
.schedule-agenda-header span {
  color: var(--n-700);
  font-size: calc(12px + var(--user-ui-font-delta));
  font-weight: 500;
}
.schedule-calendar-toolbar strong,
.schedule-agenda-header strong {
  color: var(--n-950);
  font-size: calc(20px + var(--user-ui-font-delta));
}
.schedule-calendar-controls {
  gap: 8px;
}
.schedule-calendar-controls .button,
.schedule-calendar-controls .icon-action,
.schedule-agenda-actions .button,
.schedule-agenda-actions .icon-action {
  min-height: var(--control-h-lg);
  border-radius: var(--radius-lg);
}
.schedule-calendar-controls .icon-action,
.schedule-agenda-actions .icon-action {
  width: 38px;
  height: 38px;
}
.schedule-calendar-controls svg,
.schedule-agenda-actions svg,
.schedule-agenda-time svg,
.schedule-agenda-empty svg {
  width: 14px;
  height: 14px;
}
.schedule-calendar-weekdays,
.schedule-calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
}
.schedule-calendar-weekdays {
  gap: 8px;
  margin-top: 28px;
  padding-bottom: 12px;
}
.schedule-calendar-weekdays span {
  color: var(--n-650);
  font-size: calc(11px + var(--user-ui-font-delta));
  font-weight: 500;
  text-align: center;
}
.schedule-calendar-grid {
  gap: 8px;
}
.schedule-calendar-day {
  position: relative;
  display: grid;
  min-height: clamp(62px, 5.2vw, 76px);
  place-items: center;
  align-content: center;
  gap: 7px;
  padding: 8px 5px;
  border: 1px solid transparent;
  border-radius: var(--radius-lg);
  color: var(--n-850);
  background: transparent;
  font: inherit;
  cursor: pointer;
  transition:
    border-color 0.14s ease,
    background 0.14s ease,
    color 0.14s ease,
    transform 0.14s ease;
}
.schedule-calendar-day:hover {
  border-color: var(--n-300);
  background: var(--n-75);
  transform: translateY(-1px);
}
.schedule-calendar-day > span {
  font-size: calc(14px + var(--user-ui-font-delta));
  font-weight: 500;
  line-height: 1;
}
.schedule-calendar-day.outside {
  color: var(--n-550);
}
.schedule-calendar-day.has-events {
  background: var(--n-50);
}
.schedule-calendar-day[aria-current="date"]:not(.selected) {
  border-color: oklch(73% 0.08 245);
  color: var(--accent);
}
.schedule-calendar-day.selected {
  border-color: oklch(32% 0.035 238);
  background: var(--n-900);
  color: var(--n-0);
  /* A selected cell stays in the grid; the dark fill already marks it. */
  box-shadow: var(--shadow-raised);
}
.schedule-calendar-day > i {
  display: flex;
  min-height: 4px;
  align-items: center;
  gap: 3px;
  font-style: normal;
}
.schedule-calendar-day > i b {
  width: 5px;
  height: 5px;
  border-radius: var(--radius-pill);
  background: var(--accent);
}
.schedule-calendar-day.selected > i b {
  background: oklch(92% 0.055 225);
}
.schedule-calendar-legend {
  justify-content: space-between;
  gap: 16px;
  margin-top: 20px;
  color: var(--n-650);
  font-size: calc(11px + var(--user-ui-font-delta));
}
.schedule-calendar-legend span:first-child {
  display: inline-flex;
  align-items: center;
  gap: 5px;
}
.schedule-calendar-legend i {
  width: 5px;
  height: 5px;
  border-radius: var(--radius-pill);
  background: var(--accent);
}
.schedule-agenda-pane {
  display: grid;
  grid-template-rows: auto minmax(0, 1fr);
  align-content: start;
  gap: 22px;
  background: var(--n-25);
}
.schedule-agenda-count {
  padding: 6px 11px;
  border-radius: var(--radius-pill);
  background: var(--n-150);
  color: var(--n-800) !important;
}
.schedule-agenda-list {
  display: grid;
  align-content: start;
  gap: 14px;
  /* Scrolls within whatever height the pane gets, rather than a fixed 520px. */
  flex: 1 1 auto;
  min-height: 0;
  overflow: auto;
  padding-right: 3px;
}
.schedule-agenda-item {
  display: grid;
  grid-template-areas: "time main actions";
  grid-template-columns: 68px minmax(0, 1fr) auto;
  align-items: center;
  gap: 16px;
  min-height: 104px;
  padding: 16px 18px;
  border: 1px solid var(--n-300);
  border-radius: var(--radius-xl);
  background: var(--n-0);
  box-shadow: var(--shadow-hairline);
}
.schedule-agenda-item:hover {
  border-color: oklch(78% 0.045 242);
}
.schedule-agenda-time {
  grid-area: time;
  display: grid;
  justify-items: start;
  gap: 8px;
  color: oklch(50% 0.035 242);
}
.schedule-agenda-time strong {
  color: var(--n-900);
  font-family: var(--font-mono);
  font-size: calc(12px + var(--user-ui-font-delta));
}
.schedule-agenda-main {
  grid-area: main;
  min-width: 0;
}
.schedule-agenda-title {
  gap: 9px;
}
.schedule-agenda-title > strong {
  min-width: 0;
  overflow: hidden;
  color: var(--n-950);
  font-size: calc(15px + var(--user-ui-font-delta));
  text-overflow: ellipsis;
  white-space: nowrap;
}
.schedule-agenda-title > span {
  flex: 0 0 auto;
  padding: 3px 8px;
  border-radius: var(--radius-pill);
  color: var(--n-750);
  background: var(--n-100);
  font-size: calc(10px + var(--user-ui-font-delta));
  font-weight: 500;
}
.schedule-agenda-title > span.enabled {
  color: oklch(41% 0.11 155);
  background: var(--n-100);
}
.schedule-agenda-main p {
  display: -webkit-box;
  overflow: hidden;
  margin: 7px 0 8px;
  color: var(--n-700);
  font-size: calc(12px + var(--user-ui-font-delta));
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.schedule-agenda-main small {
  color: var(--n-650);
  font-size: calc(11px + var(--user-ui-font-delta));
}
.schedule-agenda-actions {
  grid-area: actions;
  gap: 8px;
}
.schedule-agenda-actions .button {
  gap: 5px;
  padding-inline: 12px;
  font-size: calc(11px + var(--user-ui-font-delta));
}
.schedule-agenda-empty {
  display: grid;
  min-height: 430px;
  place-items: center;
  align-content: center;
  gap: 11px;
  padding: 42px;
  color: var(--n-700);
  text-align: center;
}
.schedule-agenda-empty > svg {
  width: 30px;
  height: 30px;
  margin-bottom: 3px;
  color: var(--accent);
}
.schedule-agenda-empty strong {
  color: var(--n-950);
  font-size: calc(16px + var(--user-ui-font-delta));
}
.schedule-agenda-empty p {
  max-width: 290px;
  margin: 0 0 7px;
  font-size: calc(12px + var(--user-ui-font-delta));
}"
`;
