// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`AppCommandOfficeRoomAdapter > renders the Command Office surface directly 1`] = `"<main class="office-workspace" aria-label="前端交付办公室"><header class="office-top"><button type="button" class="office-back">返回</button><div class="office-top-title" title="稳定交付 Team Office"><span>办公室群聊</span><h1>前端交付办公室</h1><p>组长 · 办公室主控 · 1 员工</p></div><div class="office-tabs" role="tablist" aria-label="办公室视图"><button type="button" role="tab" aria-selected="true" data-active="true">群聊</button></div><div class="office-top-actions"><button type="button" aria-expanded="false">成员</button><span class="office-runtime-status" data-runtime-status="connected">已就绪</span></div></header><div class="office-room-body"><section class="office-chat" aria-label="群聊"><div aria-live="polite" aria-relevant="additions text" class="office-chat-stream" role="log"></div><div class="office-shared-composer-shell" data-runtime-mode="idle"><form class="command-input office-global-composer office-shared-composer" data-command-composer="true"><label class="visually-hidden" for="office-message-input">群聊输入</label><textarea aria-describedby="office-composer-status office-composer-budget" aria-label="群聊输入" data-composer="" id="office-message-input" placeholder="告诉组长目标、背景或下一步…" rows="2"></textarea><div class="input-tools" data-od-id="composer-tools"><div class="composer-controls" data-od-id="composer-control-row"><button aria-label="添加附件" class="icon-action composer-plus-action office-composer-attach-action" disabled="" title="添加工作空间附件" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></button></div><div class="composer-actions" data-od-id="composer-action-row"><button aria-label="发送" class="send-button" data-action="send" disabled="" title="发送" type="submit"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up" aria-hidden="true"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg></button></div></div><div class="context-palette office-member-palette" data-composer-palette="" hidden=""><div class="context-list" role="listbox"><button role="option" title="@办公室组长" type="button"><span>组</span><strong>办公室组长</strong><em>组长</em></button></div></div><div class="slash-palette office-slash-palette" data-composer-palette="" hidden=""><div class="slash-list" role="listbox"><p class="office-composer-palette-empty">当前没有可用的 Skill 或 MCP。</p></div></div><div class="composer-state-row"><span aria-live="polite" class="composer-state" id="office-composer-status" role="status">未 @ 时由办公室主控接收 · 输入 @ 选择员工，/ 使用 Skill 或 MCP</span><span class="composer-input-budget" id="office-composer-budget">0/900 字节</span></div></form></div></section><button type="button" class="office-members-backdrop" aria-label="关闭成员面板" hidden=""></button><div class="office-members-drawer" hidden=""><aside class="office-members" aria-label="成员"><div class="office-rail-head"><strong>成员</strong><div class="office-rail-head-actions"><span>2</span><button type="button" aria-label="关闭成员面板" title="关闭"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></div></div><div class="office-member office-manager-member" data-office-manager="true"><span class="office-avatar" data-accent="cyan" aria-hidden="true">组<i class="office-presence" data-online="true"></i></span><span class="office-member-text"><strong>办公室主控</strong><span>Leader Agent · 接收目标、拆解任务与协调员工</span><em>独立主控线程已就绪</em></span><span class="office-manager-badge">Leader</span></div><div class="office-member"><span class="office-avatar" data-accent="blue" aria-hidden="true">组<i class="office-presence" data-online="true"></i></span><span class="office-member-text"><strong>办公室组长</strong><span>组长</span><em>待命</em></span></div><div class="office-recruit"><div class="office-rail-head"><strong>选择智能体</strong><button type="button" title="刷新智能体" aria-label="刷新智能体"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw" aria-hidden="true"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path></svg></button></div><p class="office-recruit-empty">暂无可招募智能体。请先在智能体页把云智能体加入当前工作区。</p><button type="button" data-tone="primary" disabled=""><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-plus" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" x2="19" y1="8" y2="14"></line><line x1="22" x2="16" y1="11" y2="11"></line></svg>加入成员</button></div><div class="office-rail-actions"><button type="button" data-tone="danger">删除办公室</button></div></aside></div></div></main>"`;
