exports[`CommandSidebar > cuts local storage, folder picker, and cwd markup out of Control authority 1`] = `"<aside class="command-sidebar" data-od-id="desktop-sidebar" data-sidebar-current="command" data-sidebar-log="command-log" data-sidebar-prefix="desktop" data-sidebar-shell=""><div class="sidebar-topbar" data-od-id="desktop-sidebar-topbar"><div class="sidebar-tools" aria-label="Sidebar tools"><button aria-label="Collapse sidebar" aria-pressed="false" class="sidebar-tool" data-od-id="sidebar-collapse-button" data-sidebar-collapse="" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-panel-left" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M9 3v18"></path></svg></button><button aria-controls="sidebar-search-panel" aria-expanded="true" aria-label="Search" class="sidebar-tool" data-od-id="sidebar-search-button" data-sidebar-search-open="" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg></button></div></div><section class="sidebar-search-panel" data-od-id="sidebar-search-panel" data-sidebar-search="" id="sidebar-search-panel"><div class="sidebar-search-field"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg><input aria-label="Search conversations and capabilities" data-sidebar-search-input="" placeholder="Search conversations and capabilities" type="search" value=""/><kbd>⌘K</kbd></div><div class="sidebar-search-results" role="listbox" aria-label="Search results"><button class="sidebar-search-result" data-search-action="view" data-search-result="" type="button"><span><strong>Agent</strong><small>Agent configuration</small></span><em>Feature</em></button><button class="sidebar-search-result" data-search-action="thread" data-search-result="" data-thread-id="thread-control" type="button"><span><strong>Control task</strong><small>Safe preview</small></span><em>Conversation</em></button><p class="sidebar-search-empty" data-search-empty="" hidden="">No matches</p></div></section><a class="sidebar-brand" data-od-id="desktop-brand" href="#view-command"><span>Crewon</span><small>v0.2</small></a><nav class="sidebar-nav" data-od-id="desktop-nav"><button aria-current="page" class="active" data-nav-key="command" data-shell-view-target="command" type="button"><span class="nav-glyph" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></span><strong>New task</strong></button><button class="" data-nav-key="assist" data-shell-view-target="assist" type="button"><span class="nav-glyph" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5