exports[`CommandSidebar > keeps an explicit draft workspace visible beside conversation workspaces 1`] = `"<aside class="command-sidebar" data-od-id="desktop-sidebar" data-sidebar-current="command" data-sidebar-log="command-log" data-sidebar-prefix="desktop" data-sidebar-shell=""><div class="sidebar-topbar" data-od-id="desktop-sidebar-topbar"><div class="sidebar-tools" aria-label="侧栏工具"><button aria-label="折叠侧栏" aria-pressed="false" class="sidebar-tool" data-od-id="sidebar-collapse-button" data-sidebar-collapse="" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-panel-left" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M9 3v18"></path></svg></button><button aria-controls="sidebar-search-panel" aria-expanded="false" aria-label="搜索" class="sidebar-tool" data-od-id="sidebar-search-button" data-sidebar-search-open="" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg></button></div></div><section class="sidebar-search-panel" data-od-id="sidebar-search-panel" data-sidebar-search="" hidden="" id="sidebar-search-panel"><div class="sidebar-search-field"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg><input aria-label="搜索对话和能力" data-sidebar-search-input="" placeholder="搜索对话和能力" type="search" value=""/><kbd>⌘K</kbd></div><div class="sidebar-search-results" r