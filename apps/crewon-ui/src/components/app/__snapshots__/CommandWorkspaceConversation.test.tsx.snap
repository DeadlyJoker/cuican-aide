exports[`CommandThreadRoom > retains an unsynchronized terminal reply when the next Run owns the live stream 1`] = `"<header class="home-title thread-home-title" data-od-id="desktop-command-header"><p>Agent 正在执行</p><h1><span>连续对话</span></h1></header><section class="command-thread-room" data-od-id="command-thread-room"><main class="transcript"><div class="message-list" role="log" aria-busy="true" aria-live="polite" aria-relevant="additions text"><section class="turn-group" data-status="completed" aria-label="已处理 1"><article class="message" data-kind="userMessage" data-has-icon="false" data-transcript-variant="message" aria-label="你"><div class="message-body"><div class="message-header"><span class="message-role">你</span><span class="message-type">输入</span></div><div class="markdown-content"><p>第一轮</p></div><div class="message-actions" data-user="true" data-visibility="on-hover" role="group" aria-label="用户消息操作"><button type="button" aria-label="复制" class="message-action-button" data-state="closed" data-slot="tooltip-trigger"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg></button><button id="message-edit-demo-user-1000" disabled="" type="button" aria-label="编辑消息" class="message-action-button" data-state="closed" data-slot="tooltip-trigger"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pencil-line" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"></path><path d="m15 5