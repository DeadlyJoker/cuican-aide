0 0 1 .506-.854z"></path><path d="m15 5 3 3"></path></svg></button><span class="message-action-status" role="status"></span></div></div></article></section><section data-pending-reply-run="demo-turn-1791590400000" data-local-preview="pending-reply:original-run"><article class="message" data-kind="agentMessage" data-has-icon="false" aria-atomic="false" aria-label="Crewon"><div class="message-body"><div class="message-header"><span class="message-role">Crewon</span><span class="message-type">流式</span></div><div class="markdown-content"><p>已收到的真实输出</p></div></div></article></section><div aria-hidden="true" class="transcript-follow-anchor" data-testid="transcript-follow-anchor"></div></div></main></section>"`;
