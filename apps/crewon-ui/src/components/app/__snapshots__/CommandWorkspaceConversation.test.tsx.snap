exports[`CommandThreadRoom > snapshots a durable Cloud Agent result as a standard conversation 1`] = `
"<header class="home-title thread-home-title" data-od-id="desktop-command-header"><p>Agent conversation</p><h1><span>Cloud delivery review</span></h1></header><section class="command-thread-room" data-od-id="command-thread-room"><main class="transcript"><div class="message-list" role="log" aria-busy="false" aria-live="polite" aria-relevant="additions text"><section class="turn-group" data-status="completed" aria-label="Processed 1"><article class="message" data-kind="userMessage" data-has-icon="false" data-transcript-variant="message" aria-label="You"><div class="message-body"><div class="message-header"><span class="message-role">You</span><span class="message-type">Input</span></div><div class="markdown-content"><p>Review the delivery boundary and return the result.</p></div><div class="message-actions" data-user="true" data-visibility="on-hover" role="group" aria-label="User message actions"><button type="button" aria-label="Copy" class="message-action-button" data-state="closed" data-slot="tooltip-trigger"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg></button><span class="message-action-status" role="status"></span></div></div></article><article class="message" data-kind="agentMessage" data-message-id="cloud-agent-message-1" data-has-icon="false" data-transcript-variant="message" aria-label="Crewon"><div class="message-body"><div class="message-header"><span class="message-role">Crewon</span><span class="message-type">Reply</span></div><div class="markdown-content"><h2>Review complete</h2>
<p>The boundary is stable and ready for verification.</p></div><div class="message-actions" data-user="false" data-visibility="always" role="group" aria-label="Response actions"><button type="button" aria-label="Copy" class="message-action-button" data-state="closed" data-slot="tooltip-trigger"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg></button><span class="message-action-status" role="status"></span></div></div></article></section><div aria-hidden="true" class="transcript-follow-anchor" data-testid="transcript-follow-anchor"></div></div></main></section>"
`;

