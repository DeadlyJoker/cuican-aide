// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CommandThreadRoom > renders a bursty control reply as partial streaming text before the final frame 1`] = `"<header class="home-title thread-home-title" data-od-id="desktop-command-header"><p>Agent 正在执行</p><h1><span>未命名会话</span></h1></header><section class="command-thread-room" data-od-id="command-thread-room"><main class="transcript"><div class="message-list" role="log" aria-busy="true" aria-live="polite" aria-relevant="additions text"><section class="turn-group" data-status="inProgress" aria-label="正在处理 1"><div class="turn-divider" data-status="inProgress"><span>正在处理</span></div></section><article class="message" data-kind="agentMessage" data-has-icon="false" aria-atomic="false" aria-label="Crewon"><div class="message-body"><div class="message-header"><span class="message-role">Crewon</span><span class="message-type">流式</span></div><div class="markdown-content"><p>答答答答答答答答答答答答</p></div></div></article><div aria-hidden="true" class="transcript-follow-anchor" data-testid="transcript-follow-anchor"></div></div></main></section>"`;

exports[`CommandThreadRoom > snapshots a durable Cloud Agent result as a standard conversation 1`] = `
"<header class="home-title thread-home-title" data-od-id="desktop-command-header"><p>Agent conversation</p><h1><span>Cloud delivery review</span></h1></header><section class="command-thread-room" data-od-id="command-thread-room"><main class="transcript"><div class="message-list" role="log" aria-busy="false" aria-live="polite" aria-relevant="additions text"><section class="turn-group" data-status="completed" aria-label="Processed 1"><article class="message" data-kind="userMessage" data-has-icon="false" data-transcript-variant="message" aria-label="You"><div class="message-body"><div class="message-header"><span class="message-role">You</span><span class="message-type">Input</span></div><div class="markdown-content"><p>Review the delivery boundary and return the result.</p></div></div></article><article class="message" data-kind="agentMessage" data-has-icon="false" data-transcript-variant="message" aria-label="Crewon"><div class="message-body"><div class="message-header"><span class="message-role">Crewon</span><span class="message-type">Reply</span></div><div class="markdown-content"><h2>Review complete</h2>
<p>The boundary is stable and ready for verification.</p></div></div></article></section><div aria-hidden="true" class="transcript-follow-anchor" data-testid="transcript-follow-anchor"></div></div></main></section>"
`;
