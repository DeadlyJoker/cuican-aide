exports[`CommandExpertsPanel > snapshots a real Experts record as one leader chat with background specialists 1`] = `"<section class="expert-team-grid" aria-label="专家团"><article class="expert-team-card"><div class="catalog-card-head"><span>单聊执行目标</span><strong>代码交付专家团</strong></div><p>审查当前改动，修复必要问题并给出可验证结果。</p><div class="expert-member-stack"><span title="澄清目标、分派任务并汇总结果">团长：交付组长 · 澄清目标、分派任务并汇总结果</span><span title="定位代码、依赖与风险">探索专家：仓库探索专家 · 定位代码、依赖与风险</span><span title="完成实现并运行验证">执行专家：实现验证专家 · 完成实现并运行验证</span></div><button class="button primary compact" type="button">进入团长单聊<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg></button></article></section>"`;

exports[`CommandExpertsPanel > snapshots the honest empty Experts state 1`] = `"<section class="team-office-empty team-capability-live-empty"><span class="team-office-empty-kicker">团长单聊 · 后台协作</span><h2>还没有专家团</h2><p>创建后由团长承接你的消息，探索与执行专家只在后台向团长汇报。</p></section>"`;
