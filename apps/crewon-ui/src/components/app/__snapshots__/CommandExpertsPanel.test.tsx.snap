// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CommandExpertsPanel > snapshots a real Experts record as one leader chat with background specialists 1`] = `"<section class="expert-team-grid" aria-label="专家团"><article class="expert-team-card"><div class="expert-team-card-head"><span class="expert-team-card-glyph" aria-hidden="true">代</span><div class="catalog-card-head"><span>团长单聊 · 后台协作</span><strong>代码交付专家团</strong></div></div><p class="expert-team-goal">审查当前改动，修复必要问题并给出可验证结果。</p><div class="expert-member-stack"><span class="is-leader" title="澄清目标、分派任务并汇总结果"><i aria-hidden="true">团</i><span><b>团长：交付组长</b><small>澄清目标、分派任务并汇总结果</small></span></span><span title="定位代码、依赖与风险"><i aria-hidden="true">探</i><span><b>探索专家：仓库探索专家</b><small>定位代码、依赖与风险</small></span></span><span title="完成实现并运行验证"><i aria-hidden="true">执</i><span><b>执行专家：实现验证专家</b><small>完成实现并运行验证</small></span></span></div><footer class="expert-team-card-foot"><span>3 名成员 · 1 个对话入口</span><button class="button primary compact" type="button">进入团长单聊<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg></button></footer></article></section>"`;

exports[`CommandExpertsPanel > snapshots the honest empty Experts state 1`] = `"<section aria-labelledby="_R_0_" class="command-team-empty-state" data-team-empty-state="empty"><span class="command-team-empty-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg></span><div class="command-team-empty-copy"><span class="command-team-empty-eyebrow">专家团</span><h2 id="_R_0_">还没有专家团</h2><p>创建后由团长承接你的消息，其他专家在后台协作。</p></div><footer class="command-team-empty-footer"><button class="button primary" type="button">创建专家团</button></footer></section>"`;

exports[`CommandExpertsPanel > snapshots the shared unavailable Experts state 1`] = `"<section aria-labelledby="_R_0_" class="command-team-empty-state" data-team-empty-state="unavailable"><span class="command-team-empty-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg></span><div class="command-team-empty-copy"><span class="command-team-empty-eyebrow">专家团</span><h2 id="_R_0_">暂时无法打开专家团</h2><p>暂时无法读取专家团，稍后可以重新同步。</p></div><footer class="command-team-empty-footer"><span class="command-team-empty-status" role="status">连接暂时中断</span><button class="button" type="button">重新同步</button></footer></section>"`;
