// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CommandSceneHeader > snapshots the en command-home copy 1`] = `"<header class="home-title" data-od-id="desktop-command-header"><h1>Put CrewON to work</h1><p class="scene-subtitle" data-scene-subtitle="">Organize, write, and move your work forward</p></header><div class="scene-tabs scene-pills" data-od-id="scene-tabs" role="tablist" aria-label="Scene" style="--scene-count:3;--scene-index:0"><span aria-hidden="true" class="scene-pill-thumb"></span><button aria-selected="true" class="active" data-scene-target="office" role="tab" tabindex="0" title="Organize, write, and move your work forward" type="button">Office</button><button aria-selected="false" class="" data-scene-target="code" role="tab" tabindex="-1" title="Ask, plan, implement, and review in your repository" type="button">Code</button><button aria-selected="false" class="" data-scene-target="design" role="tab" tabindex="-1" title="Explore, produce, and inspect from a brief" type="button">Design</button></div>"`;

exports[`CommandSceneHeader > snapshots the zh command-home copy 1`] = `"<header class="home-title" data-od-id="desktop-command-header"><h1>让 CrewON 完成你的工作</h1><p class="scene-subtitle" data-scene-subtitle="">整理、撰写和推进你的工作</p></header><div class="scene-tabs scene-pills" data-od-id="scene-tabs" role="tablist" aria-label="场景" style="--scene-count:3;--scene-index:0"><span aria-hidden="true" class="scene-pill-thumb"></span><button aria-selected="true" class="active" data-scene-target="office" role="tab" tabindex="0" title="整理、撰写和推进你的工作" type="button">日常办公</button><button aria-selected="false" class="" data-scene-target="code" role="tab" tabindex="-1" title="围绕仓库完成询问、计划、实现与审阅" type="button">生码</button><button aria-selected="false" class="" data-scene-target="design" role="tab" tabindex="-1" title="从 Brief 完成探索、制作与走查" type="button">设计创意</button></div>"`;

exports[`CommandSceneQuickRow > snapshots the en cards 1`] = `"<div class="quick-row" data-od-id="quick-scenarios"><button class="quick-card" data-scene="office" type="button"><span class="quick-card-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-list" aria-hidden="true"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><path d="M12 11h4"></path><path d="M12 16h4"></path><path d="M8 11h.01"></path><path d="M8 16h.01"></path></svg></span><span class="quick-card-label">Organize today&#x27;s work</span><span class="quick-card-hint">Tasks, meetings, and blockers</span></button><button class="quick-card" data-scene="office" type="button"><span class="quick-card-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-presentation" aria-hidden="true"><path d="M2 3h20"></path><path d="M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3"></path><path d="m7 21 5-5 5 5"></path></svg></span><span class="quick-card-label">Prepare meeting materials</span><span class="quick-card-hint">Agenda, context, and decisions</span></button><button class="quick-card" data-scene="office" type="button"><span class="quick-card-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-text" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg></span><span class="quick-card-label">Write a project update</span><span class="quick-card-hint">Progress, risks, and next steps</span></button><button class="quick-card" data-scene="office" type="button"><span class="quick-card-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-marked" aria-hidden="true"><path d="M10 2v8l3-3 3 3V2"></path><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"></path></svg></span><span class="quick-card-label">Save to the knowledge base</span><span class="quick-card-hint">Conclusions, sources, and owner</span></button></div>"`;

