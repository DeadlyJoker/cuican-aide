// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CommandSceneHeader > snapshots the en command-home copy 1`] = `"<header class="home-title" data-od-id="desktop-command-header"><h1>Put CrewON to work</h1><p class="scene-subtitle" data-scene-subtitle="">Organize, write, and move your work forward</p></header><div class="scene-tabs scene-pills" data-od-id="scene-tabs"><button aria-pressed="true" class="active" data-scene-target="office" title="Organize, write, and move your work forward" type="button">Office</button><button aria-pressed="false" class="" data-scene-target="code" title="Ask, plan, implement, and review in your repository" type="button">Code</button><button aria-pressed="false" class="" data-scene-target="design" title="Explore, produce, and inspect from a brief" type="button">Design</button></div><div class="capability-summary" data-scene-capabilities="">Recommended: Documents · Calendar · Knowledge</div><div class="quick-row" data-od-id="quick-scenarios"><button data-scene="office" type="button">Organize today&#x27;s work</button><button data-scene="office" type="button">Prepare meeting materials</button><button data-scene="office" type="button">Write a project update</button><button data-scene="office" type="button">Save to the knowledge base</button></div>"`;

exports[`CommandSceneHeader > snapshots the zh command-home copy 1`] = `"<header class="home-title" data-od-id="desktop-command-header"><h1>让 CrewON 完成你的工作</h1><p class="scene-subtitle" data-scene-subtitle="">整理、撰写和推进你的工作</p></header><div class="scene-tabs scene-pills" data-od-id="scene-tabs"><button aria-pressed="true" class="active" data-scene-target="office" title="整理、撰写和推进你的工作" type="button">日常办公</button><button aria-pressed="false" class="" data-scene-target="code" title="围绕仓库完成询问、计划、实现与审阅" type="button">生码</button><button aria-pressed="false" class="" data-scene-target="design" title="从 Brief 完成探索、制作与走查" type="button">设计创意</button></div><div class="capability-summary" data-scene-capabilities="">推荐能力：文档整理 · Calendar · Knowledge</div><div class="quick-row" data-od-id="quick-scenarios"><button data-scene="office" type="button">整理今日工作</button><button data-scene="office" type="button">生成会议材料</button><button data-scene="office" type="button">撰写项目汇报</button><button data-scene="office" type="button">沉淀知识库</button></div>"`;
