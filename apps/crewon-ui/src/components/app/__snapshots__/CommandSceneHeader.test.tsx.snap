exports[`CommandSceneQuickRow > snapshots the en cards 1`] = `"<div class="quick-scenarios grid gap-2.5" data-od-id="quick-scenarios"><button class="flex flex-col items-start gap-1.5 rounded-xl border bg-card px-4 py-3.5 text-left transition-colors focus-visible:outline-2 focus-visible:outline-ring" data-scene="office" type="button"><span class="[&amp;_svg]:size-[18px]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-list" aria-hidden="true"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><path d="M12 11h4"></path><path d="M12 16h4"></path><path d="M8 11h.01"></path><path d="M8 16h.01"></path></svg></span><span class="text-sm font-medium text-foreground">Organize today&#x27;s work</span><span class="text-xs text-muted-foreground">Tasks, meetings, and blockers</span></button><button class="flex flex-col items-start gap-1.5 rounded-xl border bg-card px-4 py-3.5 text-left transition-colors focus-visible:outline-2 focus-visible:outline-ring" data-scene="office" type="button"><span class="[&amp;_svg]:size-[18px]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-presentation" aria-hidden="true"><path d="M2 3h20"></path><path d="M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3"></path><path d="m7 21 5-5 5 5"></path></svg></span><span class="text-sm font-medium text-foreground">Prepare meeting materials</span><span class="text-xs text-muted-foreground">Agenda, context, and decisions</span></button><button class="flex flex-col items-start gap-1.5 rounded-xl border bg-card px-4 py-3.5 text-left transition-colors focus-visible:outline-2 focus-visible:outline-ring" data-scen