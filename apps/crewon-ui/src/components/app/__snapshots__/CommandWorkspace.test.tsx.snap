type="button" role="option" aria-selected="false"><span class="provider-resource-picker__item-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plug"><path d="M12 22v-5"></path><path d="M9 8V2"></path><path d="M15 8V2"></path><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"></path></svg></span><span class="provider-resource-picker__item-copy"><strong>provider-mcp-tool</strong><small>MCP Tool · revision revision-1</small></span></button></div></section></div><div class="composer-state-row"><span class="composer-state" id="assistant-composer-status">单一会话 · 默认执行环境 · 上下文自动压缩</span><span aria-label="对话服务已连接" class="connection-indicator" data-state="connected" role="status" title="对话服务已连接"></span></div></form></div></div></section><section class="shell-view shell-page-view" data-od-id="shell-view-projects" data-shell-view="projects" hidden=""><div class="page-stack command-task-page"><header class="page-header command-task-page-header"><div><h1>任务</h1><p>需要处理的任务优先显示，其他任务按最近活动排列</p></div><button class="button primary" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>新建任务</button></header><div class="catalog-source-bar command-task-page-filters"><div class="catalog-mode-tabs" role="group" aria-label="任务范围"><button aria-pressed="true" class="filter-chip mode-tab active" data-filter="all" data-filter-group="task-scope" type="button"><span>全部</span></button><button aria-pressed="false" class="filter-chip mode-tab" data-filter="personal" data-filter-group="task-scope" type="button"><span>个人</span></button><button aria-pressed="false" class="filter-chip mod