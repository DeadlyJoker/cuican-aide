exports[`CommandWorkspace > groups add-menu resource types with visible separators 1`] = `"<div class="context-palette add-palette" data-od-id="add-menu" data-composer-palette="" id="add-menu"><label class="visually-hidden" for="add-menu-search">添加资源</label><input id="add-menu-search" placeholder="添加资源" type="search" value=""/><div class="context-list"><section class="add-palette-group"><div class="add-palette-group-label">文件</div><button class="add-palette-item" data-kind="file" data-label="选择文件" type="button"><span class="add-palette-item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg></span><span class="add-palette-item-copy"><strong>选择文件</strong><em>选择本地内容</em></span></button><button class="add-palette-item" data-kind="folder" data-label="选择文件夹" type="button"><span class="add-palette-item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg></span><span class="add-palette-item-copy"><strong>选择文件夹</strong><em>选择本地目录</em></span></button></section><section class="add-palette-group"><div class="add-palette-group-label">知识库</div><button class="add-palette-item" data-kind="knowledge" data-label="产品知识" type="button"><span class="add-palette-item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open" aria-hidden="true"><path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg></span><span class="add-palette-item-copy"><strong>产品知识</strong><em>引用知识</em></span></button></section><section class="add-palette-group"><div class="add-palette-group-label">Skill</div><button class="add-palette-item" data-kind="skill" data-label="页面审阅" type="button"><span class="add-palette-item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg></span><span class="add-palette-item-copy"><strong>页面审阅</strong><em>检查页面</em></span></button></section><section class="add-palette-group"><div class="add-palette-group-label">MCP</div><button class="add-palette-item" data-kind="mcp" data-label="Filesystem" type="button"><span class="add-palette-item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plug" aria-hidden="true"><path d="M12 22v-5"></path><path d="M9 8V2"></path><path d="M15 8V2"></path><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"></path></svg></span><span class="add-palette-item-copy"><strong>Filesystem</strong><em>访问文件</em></span></button></section></div></div>"`;

exports[`CommandWorkspace > renders the schedule calendar on the Control runtime without technical jargon 1`] = `"<button type="button" role="combobox" aria-expanded="false" aria-autocomplete="none" dir="ltr" data-state="closed" aria-label="模型与推理档位" class="inline-flex min-h-[var(--control-h-md)] cursor-pointer items-center gap-1.5 rounded-[var(--radius-sm)] border border-[var(--border)] bg-[var(--surface)] px-[9px] py-1.5 text-[calc(12px_+_var(--user-ui-font-delta))] font-medium text-[var(--text)] transition-colors duration-[var(--dur-fast)] ease-[var(--ease)] hover:border-[var(--n-alpha-20)] focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-[var(--accent,#2563eb)] disabled:cursor-not-allowed disabled:opacity-50 [&amp;_svg]:shrink-0 [&amp;_svg]:opacity-60 max-w-[138px]" data-selected-tone="normal""`;

exports[`CommandWorkspace > snapshots a Provider Agent in the execution target selector, not the add palette 1`] = `"<section class="screen-shell command-screen desktop-command-screen" data-od-id="desktop-command-screen" data-force-new-task="false" data-locale="zh"><input aria-label="从本地电脑选择文件" hidden="" multiple="" type="file"/><input aria-label="从本地电脑选择文件夹" hidden="" multiple="" type="file"/><section class="desktop-window command-window" data-od-id="desktop-window"><aside class="command-sidebar" data-od-id="desktop-sidebar" data-sidebar-current="command" data-sidebar-log="command-log" data-sidebar-prefix="desktop" data-sidebar-shell=""><div class="sidebar-topbar" data-od-id="desktop-sidebar-topbar"><div class="sidebar-tools" aria-label="侧栏工具"><button aria-label="折叠侧栏" aria-pressed="false" class="sidebar-tool" data-od-id="sidebar-collapse-button" data-sidebar-collapse="" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-panel-left" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M9 3v18"></path></svg></button><button aria-controls="sidebar-search-panel" aria-expanded="false" aria-label="搜索" class="sidebar-tool" data-od-id="sidebar-search-button" data-sidebar-search-open="" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg></button></div></div><section class="sidebar-search-panel" data-od-id="sidebar-search-panel" data-sidebar-search="" hidden="" id="sidebar-search-panel"><div class="sidebar-search-field"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg><input aria-label="搜索对话和能力" data-sidebar-search-input="" placeholder="搜索对话和能力" type="search" value=""/><kbd>⌘K</kbd></div><div class="sidebar-search-results" role="listbox" aria-label="搜索结果"><button class="sidebar-search-result" data-search-action="view" data-search-result="" type="button"><span><strong>产品审阅智能体</strong><small>智能体配置</small></span><em>功能</em></button><p class="sidebar-search-empty" data-search-empty="" hidden="">没有匹配</p></div></section><a class="sidebar-brand" data-od-id="desktop-brand" href="#view-command"><span>Crewon</span><small>v0.2</small></a><nav class="sidebar-nav" data-od-id="desktop-nav"><button aria-current="page" class="active" data-nav-key="command" data-shell-view-target="command" type="button"><span class="nav-glyph" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></span><strong>新建任务</strong></button><button class="" data-nav-key="projects" data-shell-view-target="projects" type="button"><span class="nav-glyph" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-list-checks" aria-hidden="true"><path d="m3 17 2 2 4-4"></path><path d="m3 7 2 2 4-4"></path><path d="M13 6h8"></path><path d="M13 12h8"></path><path d="M13 18h8"></path></svg></span><strong>任务</strong></button><button class="" data-nav-key="assist" data-shell-view-target="assist" type="button"><span class="nav-glyph" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg></span><strong>助理</strong></button><button class="" data-nav-key="agents" data-shell-view-target="agents" type="button"><span class="nav-glyph" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bot" aria-hidden="true"><path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path d="M2 14h2"></path><path d="M20 14h2"></path><path d="M15 13v2"></path><path d="M9 13v2"></path></svg></span><strong>智能体</strong></button><button class="" data-nav-key="schedule" data-shell-view-target="schedule" type="button"><span class="nav-glyph" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar-days" aria-hidden="true"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path><path d="M8 14h.01"></path><path d="M12 14h.01"></path><path d="M16 14h.01"></path><path d="M8 18h.01"></path><path d="M12 18h.01"></path><path d="M16 18h.01"></path></svg></span><strong>日程安排</strong></button><button class="" data-nav-key="team" data-shell-view-target="team" type="button"><span class="nav-glyph" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></span><strong>团队</strong></button><button class="" data-run-title-zh="知识库" data-run-title-en="Knowledge base" type="button"><span class="nav-glyph" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open" aria-hidden="true"><path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg></span><strong>知识库</strong></button></nav><section class="space-tree" data-od-id="desktop-workspace-tree" aria-label="工作空间和对话"><div class="tree-head"><strong class="tree-head-label">工作空间</strong><button aria-expanded="false" aria-label="新增空间" class="tree-head-action" title="新增空间" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></button><form class="sidebar-workspace-form" hidden=""><strong class="sidebar-workspace-form-title">新增空间</strong><label for="command-workspace-path">文件夹路径</label><input id="command-workspace-path" placeholder="/Users/me/project" value="/repo/frontend"/><p class="sidebar-workspace-form-hint">填写本地绝对路径，会话会绑定到这个目录。</p><div class="sidebar-workspace-form-actions"><button type="button">取消</button><button class="primary" type="submit" disabled="">打开</button></div></form></div><div class="space-node current real-workspace-node"><div class="space-title real-workspace-title"><button aria-controls="current-workspace-thread-list" aria-expanded="true" class="workspace-title-toggle" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder-open" aria-hidden="true"><path d="m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2"></path></svg><strong>frontend</strong></button><span class="workspace-row-actions"><button aria-label="新建会话" title="新建会话" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-pen" aria-hidden="true"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"></path></svg></button><button aria-label="将 frontend 移出空间列表" class="workspace-remove-action" title="将 frontend 移出空间列表" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2" aria-hidden="true"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path><line x1="10" x2="10" y1="11" y2="17"></line><line x1="14" x2="14" y1="11" y2="17"></line></svg></button></span></div><div class="conversation-list recent-thread-list" id="current-workspace-thread-list"><p clas