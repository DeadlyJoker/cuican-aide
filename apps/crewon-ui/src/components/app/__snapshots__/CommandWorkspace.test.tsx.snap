exports[`CommandWorkspace > groups add-menu resource types with visible separators 1`] = `"<div class="context-palette add-palette" data-od-id="add-menu" data-composer-palette="" id="add-menu"><label class="visually-hidden" for="add-menu-search">添加资源</label><input id="add-menu-search" placeholder="添加资源" type="search" value=""/><div class="context-list"><section class="add-palette-group"><button class="add-palette-item" data-kind="file" data-label="选择文件" type="button"><span class="add-palette-item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-paperclip" aria-hidden="true"><path d="M13.234 20.252 21 12.3"></path><path d="m16 6-8.414 8.586a2 2 0 0 0 0 2.828 2 2 0 0 0 2.828 0l8.414-8.586a4 4 0 0 0 0-5.656 4 4 0 0 0-5.656 0l-8.415 8.585a6 6 0 1 0 8.486 8.486"></path></svg></span><span class="add-palette-item-copy"><strong>选择文件</strong><em>选择本地内容</em></span></button><button class="add-palette-item" data-kind="folder" data-label="选择文件夹" type="button"><span class="add-palette-item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder-open" aria-hidden="true"><path d="m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2"></path></svg></span><span class="add-palette-item-copy"><strong>选择文件夹</strong><em>选择本地目录</em></span></button></section><section class="add-palette-group"><div class="add-palette-group-label">知识库</div><button class="add-palette-item" data-kind="knowledge" data-label="产品知识" type="button"><span class="add-palette-item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open" aria-hidden="true"><path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg></span><span class="add-palette-item-copy"><strong>产品知识</strong><em>引用知识</em></span></button></section><section class="add-palette-group"><div class="add-palette-group-label">插件</div><button class="add-palette-item" data-kind="skill" data-label="页面审阅" type="button"><span class="add-palette-item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg></span><span class="add-palette-item-copy"><strong>页面审阅</strong><em>检查页面</em></span></button><button class="add-palette-item" data-kind="mcp" data-label="Filesystem" type="button"><span class="add-palette-item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plug" aria-hidden="true"><path d="M12 22v-5"></path><path d="M9 8V2"></path><path d="M15 8V2"></path><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"></path></svg></span><span class="add-palette-item-copy"><strong>Filesystem</strong><em>访问文件</em></span></button></section></div></div>"`;

exports[`CommandWorkspace > renders immutable Control Knowledge in the homepage palettes 1`] = `
{
  "addPalette": true,
  "contextPalette": true,
  "title": true,
}
`;

exports[`CommandWorkspace > snapshots a Provider Agent in the execution target selector, not the add palette 1`] = `"<section class="screen-shell command-screen desktop-command-screen" data-od-id="desktop-command-screen" data-force-new-task="false" data-locale="zh"><input aria-label="从本地电脑选择文件" hidden="" multiple="" type="file"/><input aria-label="从本地电脑选择文件夹" hidden="" multiple="" type="file"/><section class="desktop-window command-window" data-od-id="desktop-window"><aside class="command-sidebar" data-od-id="desktop-sidebar" data-sidebar-current="command" data-sidebar-log="command-log" data-sidebar-prefix="desktop" data-sidebar-shell=""><div class="sidebar-topbar" data-od-id="desktop-sidebar-topbar"><div class="sidebar-tools" aria-label="侧栏工具"><button aria-label="折叠侧栏" aria-pressed="false" class="sidebar-tool" data-od-id="sidebar-collapse-button" data-sidebar-collapse="" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-panel-left" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M9 3v18"></path></svg></button><button aria-controls="sidebar-search-panel" aria-expanded="false" aria-label="搜索" class="sidebar-tool" data-od-id="sidebar-search-button" data-sidebar-search-open="" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg></button></div></div><section class="sidebar-search-panel" data-od-id="sidebar-search-panel" data-sidebar-search="" hidden="" id="sidebar-search-panel"><div class="sidebar-search-field"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg><input aria-label="搜索对话和能力" data-sidebar-search-input="" placeholder="搜索对话和能力" type="search" value=""/><kbd>⌘K</kbd></div><div class="sidebar-search-results" role="listbox" aria-label="搜索结果"><button class="sidebar-search-result" data-search-action="view" data-search-result="" type="button"><span><strong>产品审阅智能体</strong><small>智能体配置</small></span><em>功能</em></button><p class="sidebar-search-empty" data-search-empty="" hidden="">没有匹配</p></div></section><a class="sidebar-brand" data-od-id="desktop-brand" href="#view-command"><span>Crewon</span><small>v0.2</small></a><nav class="sidebar-nav" data-od-id="desktop-nav"><button aria-current="page" class="active" data-nav-key="command" data-shell-view-target="command" type="button"><span class="nav-glyph" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></span><span class="sidebar-nav-copy"><strong>新建任务</strong></span></button><button class="" data-nav-key="assist" data-shell-view-target="assist" type="button"><span class="nav-glyph" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg></span><span class="sidebar-nav-copy"><strong>助理</strong></span></button><button class="" data-nav-key="agents" data-shell-view-target="agents" type="button"><span class="nav-glyph" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bot" aria-hidden="true"><path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path d="M2 14h2"></path><path d="M20 14h2"></path><path d="M15 13v2"></path><path d="M9 13v2"></path></svg></span><span class="sidebar-nav-copy"><strong>智能体</strong><em>技能 · 连接器</em></span></button><button class="" data-nav-key="schedule" data-shell-view-target="schedule" type="button"><span class="nav-glyph" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar-days" aria-hidden="true"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path><path d="M8 14h.01"></path><path d="M12 14h.01"></path><path d="M16 14h.01"></path><path d="M8 18h.01"></path><path d="M12 18h.01"></path><path d="M16 18h.01"></path></svg></span><span class="sidebar-nav-copy"><strong>日程安排</strong><em>计划 · 提醒</em></span></button><button class="" data-nav-key="team" data-shell-view-target="team" type="button"><span class="nav-glyph" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></span><span class="sidebar-nav-copy"><strong>团队</strong></span></button><button class="" data-run-title-zh="知识库" data-run-title-en="Knowledge base" type="button"><span class="nav-glyph" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open" aria-hidden="true"><path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg></span><strong>知识库</strong></button></nav><section aria-label="任务和对话" class="space-tree" data-od-id="desktop-workspace-tree"><div class="tree-head"><strong class="tree-head-label">工作空间</strong><button aria-label="新建会话" class="tree-head-action" title="新建会话" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></button></div><p class="sidebar-empty-hint">开始一次任务后，对话会出现在这里。</p></section><footer aria-label="本地运行时" class="sidebar-account sidebar-runtime-account" data-od-id="desktop-account-entry"><button type="button"><span class="account-mark" aria-hidden="true">C</span><span class="sidebar-account-copy"><strong>本地工作台</strong><small>Standalone Control</small></span></button></footer></aside><section class="command-canvas" data-od-id="desktop-main-pane"><section class="shell-view command-home-view active" data-shell-view="command" data-shell-view-title-zh="新建任务" data-shell-view-title-en="New task" data-od-id="shell-view-command" data-has-thread="false"><button class="workspace-pill" data-od-id="workspace-pill" type="button"><span aria-hidden="true"></span><strong>CrewON Control · 已连接</strong></button><section class="hero-center" data-od-id="primary-work-area"><header class="home-title" data-od-id="desktop-command-header"><span class="home-eyebrow">CREWON</span><h1>让 CrewON 完成你的工作</h1><p class="scene-subtitle" data-scene-subtitle="">整理、撰写和推进你的工作</p></header><div class="scene-tabs scene-pills" data-od-id="scene-tabs" role="tablist" aria-label="场景" style="--scene-count:3;--scene-index:0"><span aria-hidden="true" class="scene-pill-thumb"></span><button aria-selected="true" class="active" data-scene-target="office" role="tab" tabindex="0" title="整理、撰写和推进你的工作" type="button">日常办公</button><button aria-selected="false" class="" data-scene-target="code" role="tab" tabindex="-1" title="围绕仓库完成询问、计划与实现" type="button">生码</button><button aria-selected="false" class="" data-scene-target="design" role="tab" tabindex="-1" title="从 Brief 完成探索、制作与走查" type="button">设计创意</button></div><section class="command-home-capability-strip"><div class="command-home-summary"><span><small>任务方式</small><strong>自动判断</strong></span><span><small>核心上下文</small><strong>文档 / 日历 / 知识库</strong></span><span><small>默认交付</small><strong>文档与行动项</strong></span></div><p class="command-home-recommendation"><strong>推荐能力</strong>Word / PPT / Excel · 知识库</p></section><form class="command-input" data-command-composer="true" data-od-id="ai-composer"><button aria-hidden="true" class="shortcut-proxy" data-context-open="" data-palette-trigger="context" hidden="" tabindex="-1" type="button"></button><button aria-hidden="true" class="shortcut-proxy" data-slash-open="" data-palette-trigger="slash" hidden="" tabindex="-1" type="button"></button><label class="visually-hidden" for="desktop-task-input">任务输入</label><textarea aria-describedby="composer-status composer-error" aria-label="任务输入" data-composer="" data-od-id="composer-input" id="desktop-task-input" placeholder="例如：整理今天的项目事项，安排会议、跟进阻塞，并把结论写入知识库" rows="2"></textarea><div class="input-tools" data-od-id="composer-tools"><div class="composer-controls" data-od-id="composer-control-row"><button aria-label="添加上下文" class="icon-action composer-plus-action" data-palette-trigger="add" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></button><div class="control-select mode-dropdown" data-open="false" data-selected-tone="normal"><span class="visually-hidden">任务类型</span><button aria-controls="_R_1iqov_" aria-expanded="false" aria-haspopup="listbox" aria-label="任务类型" class="select-trigger" type="button">自动判断</button><div class="select-menu" hidden="" id="_R_1iqov_" role="listbox"><div class="select-group" role="presentation"><button aria-selected="true" class="select-option" data-tone="normal" data-value="auto" role="option" type="button"><span><strong>自动判断</strong><em>根据任务对象、交付物和风险自动判断</em></span></button><button aria-selected="false" class="select-option" data-tone="normal" data-value="organize" role="option" type="button"><span><strong>整理</strong><em>整理事项、来源与行动项</em></span></button><button aria-selected="false" class="select-option" data-tone="normal" data-value="write" role="option" type="button"><span><strong>撰写</strong><em>生成面向受众的可用成稿</em></span></button><button aria-selected="false" class="select-option" data-tone="normal" data-value="analyze" role="option" type="button"><span><strong>分析</strong><em>基于来源说明方法与结论</em></span></button><button aria-selected="false" class="select-option" data-tone="normal" data-value="coordinate" role="option" type="button"><span><strong>协同</strong><em>准备消息、会议或共享写入草稿</em></span></button></div></div></div><div class="control-select model-dropdown" data-open="false" data-selected-tone="normal"><span class="visually-hidden">模型与推理档位</span><button aria-controls="_R_2iqov_" aria-expanded="false" aria-haspopup