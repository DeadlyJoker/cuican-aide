exports[`commandSceneSlashItems > exposes the connected online workspace as a selectable service 1`] = `"<div class="context-palette add-palette" data-od-id="online-workspace-menu" data-composer-palette="" id="online-workspace-menu"><label class="visually-hidden" for="online-workspace-search">添加资源</label><input id="online-workspace-search" placeholder="添加资源" type="search" value=""/><div class="context-list"><section class="add-palette-group"><div class="add-palette-group-label">MCP</div><button class="add-palette-item" data-kind="mcp" data-label="在线工作区" type="button"><span class="add-palette-item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plug" aria-hidden="true"><path d="M12 22v-5"></path><path d="M9 8V2"></path><path d="M15 8V2"></path><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"></path></svg></span><span class="add-palette-item-copy"><strong>在线工作区</strong><em>查看和运行线上项目文件</em></span></button></section></div></div>"`;
