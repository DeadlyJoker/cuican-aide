r-circle" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg><strong>进行中</strong></span><em>0</em></header><div class="command-task-column-list"><p class="command-task-column-empty">暂无任务</p></div></section><section class="command-task-column" data-task-stage="attention"><header><span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-alert" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg><strong>需处理</strong></span><em>0</em></header><div class="command-task-column-list"><p class="command-task-column-empty">暂无任务</p></div></section><section class="command-task-column" data-task-stage="ready"><header><span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg><strong>可继续</strong></span><em>0</em></header><div class="command-task-column-list"><p class="command-task-column-empty">暂无任务</p></div></section></div></section></div></section><section class="shell-view shell-page-view command-library-shell-view" data-shell-view="agents" hidden=""><div class="route-loading-state" role="status" aria-live="polite"><strong>正在读取 Control 数据…</strong><small>页面会保留在当前工作台中</small></div></section><section class="shell-view shell-page-view command-library-shell-view" data-shell-view="schedule" hidden=""><div class="route-loading-state" role="status" aria-live="polite"><strong>正在读取 Control 数据…</strong><small>页面会保留在当前工作台中</small></div></section><section class="shell-view shell-page-view command-library-shell-view" data-shell-view="knowledge" hidden=""><div class="route-loading-state" role="status" aria-live="polite"><strong>正在读取 Control 数据…</strong><small>页面会保留在当前工作台中</small></div></section><section class="shell-view shell-page-view" data-filter-scope="" data-od-id="shell-view-team" data-shell-view="team" hidden=""><div class="page-stack" data-filter-scope=""><header class="catalog-market-header function-market-header" data-od-id="team-header-inline"><div class="catalog-mode-tabs" role="group" aria-label="团队视图筛选"><button aria-pressed="true" class="filter-chip mode-tab active" data-filter="office" data-filter-group="team-mode" type="button"><span>办公室</span></button><button aria-pressed="false" class="filter-chip mode-tab" data-filter="workflow" data-filter-group="team-mode" type="button"><span>协作流</span></button><button aria-pressed="false" class="filter-chip mode-tab" data-filter="experts" data-filter-group="team-mode" type="button"><span>专家</span></button></div><div class="catalog-header-actions"><label class="catalog-search" aria-label="搜索办公室"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg><input placeholder="搜索办公室、目标或成员" type="search" value=""/></label><button class="button" type="button">同步真实数据</button><button class="button primary" type="button" data-team-action="office" disabled="">创建办公室</button><button class="button primary" type="button" data-team-action="experts" disabled="" hidden="">组建专家团队</button></div></header><section class="team-office-shell" data-card-filter="office" data-office-shell="" data-od-id="team-office-shell"><div class="office-card-grid" data-office-list="" aria-label="办公室卡片"><section aria-labelledby="_R_2jv_" class="team-office-empty" data-office-empty-state="unavailable"><header class="team-office-empty-head"><span class="team-office-empty-kicker">CONTROL OFFICE</span><h3 id="_R_2jv_">Office 定义暂不可用</h3><p>Control Office 定义暂时无法读取，系统会自动重试；不会使用演示数据替代。</p></header><footer class="team-office-empty-footer"><span class="team-office-connection-state" data-state="unavailable" role="status">等待自动重试</span></footer></section></div><section class="office-room-inline team-office-runtime-room" data-office-room="" hidden="" tabindex="-1"><div class="team-office-room-loading" role="status">正在读取 Office 定义…</div></section></section><section class="team-workflow-shell" data-card-filter="workflow" data-od-id="team-workflow-shell" data-workflow-shell="" hidden=""><section class="team-office-empty team-capability-live-empty"><h2>协作流服务暂不可用</h2><p>CrewON Control 未提供 Workflow authority。</p></section></section><section class="team-experts-shell" data-card-filter="experts" hidden=""><header class="team-experts-header"><div><span>Agent roster</span><h2>团队专家</h2><p>从已发布 Agent 选择成员，创建真实 Control Office 团队。</p></div><strong>0</strong></header><div class="agent-grid team-expert-grid"></div><section class="team-office-empty team-capability-live-empty"><h2>暂无已发布专家</h2><p>先在智能体目录创建并发布 Agent，再把它加入办公室。</p></section></section><div id="team-log" class="sr-log" aria-live="polite"></div></div></section></section></section></section>"`;

