exports[`CommandWorkspace > keeps resource cards on the new-task surface and out of conversations 1`] = `"<section class="resource-dock" data-od-id="capability-dock"><header><strong>Agent / Skill / MCP / Knowledge / Workflow</strong><span>资源入口已就绪</span></header><div class="resource-grid"><article class="resource-card"><span>Agent</span><strong>Delivery Agent</strong><p>Has all bindings.</p></article><article class="resource-card"><span>Skill</span><strong>Schema 校验</strong><p>Validate schema.</p></article><article class="resource-card"><span>MCP</span><strong>Filesystem MCP</strong><p>Read files.</p></article><article class="resource-card"><span>空间</span><strong>Delivery Knowledge</strong><p>3 个文档 · text-embedding-v2</p></article><article class="resource-card"><span>Workflow</span><strong>Workflow Gate</strong><p>Gate approval.</p></article></div></section>"`;

exports[`CommandWorkspace > renders only real workspaces and conversations in the sidebar 1`] = `"class="space-tree project-tree" aria-label="项目和任务"><div class="tree-head project-tree-head"><strong>项目</strong><span><details class="project-menu"><summary aria-label="整理项目"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-ellipsis" aria-hidden="true"><circle cx="12" cy="12" r="1"></circle><circle cx="19" cy="12" r="1"></circle><circle cx="5" cy="12" r="1"></circle></svg></summary><div class="project-menu-popover project-sort-menu" role="menu"><small>整理</small><button type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"></path></svg>按项目</button><button type="button"><span></span>在一个列表中</button><hr/><small>排序方式</small><button type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"></path></svg>优先级</button><button type="button"><span></span>最近更新</button><button type="button"><span></span>手动排序</button></div></details><details class="project-menu"><summary aria-label="添加项目"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></summary><div class="project-menu-popover project-add-menu" role="menu"><button type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>新建空白项目</button><button type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>使用现有文件夹</button></div></details></span></div><div class="project-groups"><section class="project-group"><header class="project-row"><button aria-label="折叠项目 crewon" type="button" class="project-row-main"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder-open"><path d="m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2"></path></svg><strong>crewon</strong></button><span class="project-row-actions"><details class="project-menu project-row-menu"><summary aria-label="项目 crewon 菜单" title="项目菜单"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-ellipsis"><circle cx="12" cy="12" r="1"></circle><circle cx="19" cy="12" r="1"></circle><circle cx="5" cy="12" r="1"></circle></svg></summary><div class="project-menu-popover project-row-menu-popover" role="menu"><button type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>复制项目路径</button></div></details><button aria-label="在 crewon 新建任务" title="新建任务" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-pen"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"></path></svg></button></span></header><div class="project-thread-list"><p class="sidebar-empty-hint">新建任务后会显示在这里。</p></div></section></div></section>"`;

