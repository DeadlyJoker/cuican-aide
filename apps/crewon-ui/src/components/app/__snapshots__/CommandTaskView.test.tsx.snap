// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ProjectsView > shows real personal and team tasks with attention first 1`] = `"<section class="shell-view shell-page-view active" data-od-id="shell-view-projects" data-shell-view="projects"><div class="page-stack command-task-page"><header class="page-header command-task-page-header"><div><h1>任务</h1><p>需要处理的任务优先显示，其他任务按最近活动排列</p></div><button class="button primary" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>新建任务</button></header><div class="catalog-source-bar command-task-page-filters"><div class="catalog-mode-tabs" role="group" aria-label="任务范围"><button aria-pressed="true" class="filter-chip mode-tab active" data-filter="all" data-filter-group="task-scope" type="button"><span>全部</span></button><button aria-pressed="false" class="filter-chip mode-tab" data-filter="personal" data-filter-group="task-scope" type="button"><span>个人</span></button><button aria-pressed="false" class="filter-chip mode-tab" data-filter="team" data-filter-group="task-scope" type="button"><span>团队</span></button></div></div><section aria-live="polite" class="page-panel command-task-page-list" data-od-id="project-task-catalog"><div class="compact-list"><button class="capability-row command-task-page-row" data-task-scope="team" data-thread-state="pendingUnread" type="button"><span class="command-task-page-state"><span aria-label="新的待确认" class="command-thread-status is-pending-unread" role="img"></span></span><span class="command-task-page-copy"><strong title="确认发布范围">确认发布范围</strong><small>产品交付小队 · 团队任务</small></span><time>12 分钟前</time></button><button class="capability-row command-task-page-row" data-task-scope="personal" data-thread-state="running" type="button"><span class="command-task-page-state"><span aria-label="进行中" class="command-thread-status is-running" role="img"><i></i><i></i><i></i></span></span><span class="command-task-page-copy"><strong title="整理发布计划">整理发布计划</strong><small>cuican-aide · 个人任务</small></span><time></time></button><button class="capability-row command-task-page-row" data-task-scope="personal" data-thread-state="completedViewed" type="button"><span class="command-task-page-state"></span><span class="command-task-page-copy"><strong title="撰写发布说明">撰写发布说明</strong><small>cuican-aide · 个人任务</small></span><time>20 分钟前</time></button></div></section></div></section>"`;
