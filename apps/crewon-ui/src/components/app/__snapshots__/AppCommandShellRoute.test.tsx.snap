exports[`CommandShellNotice > renders command-route failures as a visible dismissible notice 1`] = `"<div class="notice-stack command-shell-notice"><div class="connection-notice" data-tone="warning" role="status"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-triangle-alert" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg><span>没有可用于创建自动化的 Control 任务。</span><button aria-label="关闭通知" title="关闭通知" type="button"><span aria-hidden="true">×</span></button></div></div>"`;
