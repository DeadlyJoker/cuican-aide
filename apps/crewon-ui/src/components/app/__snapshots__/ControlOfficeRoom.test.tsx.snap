// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ControlOfficeRoomView > fails closed when no WorkflowVersion is published 1`] = `"<section class="office-workspace-view" data-control-office-room=""><header class="office-workspace-header"><div><span class="modal-kicker">CONTROL OFFICE</span><h2>Release office</h2><p>office-version-1 · r2</p></div><div class="inline-actions"><button class="button" type="button">Back to offices</button></div></header><div class="page-panel"><strong>Member boundary</strong><p>Release agent · agent-version-1</p></div><div class="page-panel capability-field-list"><strong>Explicit Workflow delegation</strong><label><span>Workflow version</span><select></select></label><label><span>Workflow input (JSON)</span><textarea rows="5">{}</textarea></label><p class="team-office-room-warning" role="status">No WorkflowVersion is available. Publish a Workflow in Control first.</p><button class="button primary" type="button" disabled="">Start workflow</button></div><p class="team-office-room-warning" role="note">Office defines the member boundary; execution, retry, verification, and recovery belong to the canonical Workflow Run.</p></section>"`;

exports[`ControlOfficeRoomView > renders the explicit Workflow delegation authority 1`] = `"<section class="office-workspace-view" data-control-office-room=""><header class="office-workspace-header"><div><span class="modal-kicker">CONTROL OFFICE</span><h2>Release office</h2><p>office-version-1 · r2</p></div><div class="inline-actions"><button class="button" type="button">返回办公室</button></div></header><div class="page-panel"><strong>成员边界</strong><p>Release agent · agent-version-1</p></div><div class="page-panel capability-field-list"><strong>显式 Workflow 委派</strong><label><span>Workflow 版本</span><select><option value="workflow-version-1" selected="">Release workflow · workflow-version-1</option></select></label><label><span>Workflow 输入（JSON）</span><textarea rows="5">{&quot;topic&quot;:&quot;release&quot;}</textarea></label><button class="button primary" type="button">启动 Workflow</button></div><p class="team-office-room-warning" role="status">执行已启动：run-1</p><p class="team-office-room-warning" role="note">Office 只定义成员边界；执行、重试、验证与恢复均由 canonical Workflow Run 负责。</p></section>"`;
