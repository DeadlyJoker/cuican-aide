exports[`TaskDetailPopover > keeps loading and error feedback while hiding empty resolved sections 1`] = `"<aside aria-labelledby="task-detail-popover-title" aria-modal="false" class="task-detail-popover" id="task-detail-popover" role="dialog" tabindex="-1"><header class="task-detail-popover__header"><h2 id="task-detail-popover-title">任务详细信息</h2><span class="task-detail-popover__actions"><button aria-label="关闭任务详细信息" class="task-detail-icon-button task-detail-popover__close" type="button"><svg></svg></button></span></header><div class="task-detail-popover__content"><section class="task-detail-section" data-status="error"><header><h3>环境信息</h3><span class="task-detail-section__meta"><svg></svg></span></header><div class="task-detail-section__rows"><div class="task-detail-row"><span aria-hidden="true" class="task-detail-row__icon"><svg></svg></span><span class="task-detail-row__copy"><strong title="分支">分支</strong></span><span class="task-detail-row__trailing">main</span></div></div><p class="task-detail-feedback is-error" role="status"><svg></svg>Git 状态刷新失败</p></section><section class="task-detail-section" data-status="loading"><header><h3>子智能体</h3><span class="task-detail-section__meta"><svg></svg></span></header><div aria-hidden="true" class="task-detail-skeleton"><i></i><i></i><i></i></div></section></div></aside>"`;

exports[`TaskDetailPopover > renders populated task sections without runtime implementation details 1`] = `"<aside aria-labelledby="task-detail-popover-title" aria-modal="false" class="task-detail-popover" id="task-detail-popover" role="dialog" tabindex="-1"><header class="task-detail-popover__header"><h2 id="task-detail-popover-title">修复团队协作回归</h2><span class="task-detail-popover__actions"><button aria-label="停止任务" class="task-detail-icon-button is-danger" title="停止任务" type="button"><svg></svg></button><button aria-label="关闭任务详细信息" class="task-detail-icon-button task-detail-popover__close" type="button"><svg></svg></button></span></header><div class="task-detail-popover__content"><section class="task-detail-section" data-status="ready"><header><h3>环境信息</h3><span class="task-detail-section__meta"></span></header><div class="task-detail-section__rows"><button class="task-detail-row is-interactive" type="button"><span aria-hidden="true" class="task-detail-row__icon"><svg></svg></span><span class="task-detail-row__copy"><strong title="变更">变更</strong><small title="6 个文件 · 当前分支">6 个文件 · 当前分支</small></span><span class="task-detail-row__trailing"><span class="task-detail-change"><b>+124</b><b>-18</b><svg></svg></span></span></button><div class="task-detail-row"><span aria-hidden="true" class="task-detail-row__icon"><svg></svg></span><span class="task-detail-row__copy"><strong title="分支">分支</strong><small title="当前工作区">当前工作区</small></span><span class="task-detail-row__trailing">codex/task-detail</span></div><div class="task-detail-row"><span aria-hidden="true" class="task-detail-row__icon"><svg></svg></span><span class="task-detail-row__copy"><strong title="状态">状态</strong></span><span class="task-detail-row__trailing"><span class="task-detail-tone" data-tone="success"><i aria-hidden="true"></i>运行中</span></span></div></div></section><section class="task-detail-section" data-status="ready"><header><h3>子智能体</h3><span class="task-detail-section__meta"><span>2 个活跃</span></span></header><div class="task-detail-section__rows"><div class="task-detail-row"><span aria-hidden="true" class="task-detail-row__icon"><svg></svg></span><span class="task-detail-row__copy"><strong title="安全审查">安全审查</strong><small title="成员">成员</small></span><span class="task-detail-row__trailing"><span class="task-detail-tone" data-tone="neutral"><i aria-hidden="true"></i>运行中</span></span></div><div class="task-detail-row"><span aria-hidden="true" class="task-detail-row__icon"><svg></svg></span><span class="task-detail-row__copy"><strong title="回归测试">回归测试</strong><small title="组件测试">组件测试</small></span><span class="task-detail-row__trailing"><span class="task-detail-tone" data-tone="success"><i aria-hidden="true"></i>已完成</span></span></div></div></section><section class="task-detail-section" data-status="ready"><header><h3>后台进程</h3><span class="task-detail-section__meta"><span>2</span><button aria-label="打开终端" class="task-detail-icon-button" type="button"><svg></svg></button></span></header><div class="task-detail-section__rows"><div class="task-detail-row"><span aria-hidden="true" class="task-detail-row__icon"><svg></svg></span><span class="task-detail-row__copy"><strong class="is-mono" title="pnpm test -- TaskDetailPopover">pnpm test -- TaskDetailPopover</strong><small title="PID 4312">PID 4312</small></span><span class="task-detail-row__trailing"><span class="task-detail-process"><span class="task-detail-tone" data-tone="neutral"><i aria-hidden="true"></i>运行中</span><button aria-label="停止进程: pnpm test -- TaskDetailPopover" class="task-detail-stop" type="button"><svg></svg></button></span></span></div><div class="task-detail-row"><span aria-hidden="true" class="task-detail-row__icon"><svg></svg></span><span class="task-detail-row__copy"><strong class="is-mono" title="pnpm build">pnpm build</strong></span><span class="task-detail-row__trailing"><span class="task-detail-process"><span class="task-detail-tone" data-tone="success"><i aria-hidden="true"></i>已结束</span></span></span></div></div></section><section class="task-detail-section" data-status="ready"><header><h3>来源</h3><span class="task-detail-section__meta"><span>2</span></span></header><div class="task-detail-section__rows"><div class="task-detail-row"><span aria-hidden="true" class="task-detail-row__icon"><img alt="" loading="lazy" src="/reference.png"/></span><span class="task-detail-row__copy"><strong title="reference.png">reference.png</strong></span></div><div class="task-detail-row"><span aria-hidden="true" class="task-detail-row__icon"><svg></svg></span><span class="task-detail-row__copy"><strong title="TaskDetailPopover.tsx">TaskDetailPopover.tsx</strong><small title="工作区文件">工作区文件</small></span></div></div></section></div></aside>"`;
