// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ComposerProgressPill > keeps ProposedPlan as a non-interactive status 1`] = `"<div class="composer-progress-pill" data-od-id="composer-progress-pill" role="status"><span class="composer-progress-step">计划已生成</span></div>"`;

exports[`ComposerProgressPill > renders a structured execution Plan as an accessible popover trigger 1`] = `"<button aria-controls="_R_0_" aria-label="第 2 / 5 步 · 2 个文件已更改 +15 -4，查看执行计划" class="composer-progress-pill composer-progress-trigger" data-od-id="composer-progress-pill" type="button" aria-haspopup="dialog" aria-expanded="false" data-state="closed" data-slot="popover-trigger"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-loader-circle spin composer-progress-spinner" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg><span class="composer-progress-step">第 2 / 5 步</span><span aria-hidden="true" class="composer-progress-separator">·</span><span class="composer-progress-files">2 个文件已更改</span><span class="composer-progress-additions">+15</span><span class="composer-progress-deletions">-4</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-up composer-progress-disclosure" aria-hidden="true"><path d="m18 15-6-6-6 6"></path></svg></button><span aria-live="polite" class="visually-hidden" role="status">第 2 / 5 步 · 2 个文件已更改 +15 -4</span>"`;

exports[`ComposerProgressPill > renders every status as text and escapes untrusted Plan titles 1`] = `"<div data-slot="popover-header" class="flex flex-col gap-1 text-sm composer-progress-popover-header"><h2 data-slot="popover-title" class="font-medium" id="title">执行计划</h2><p data-slot="popover-description" class="text-muted-foreground" id="description">先核对边界，再完成交付。</p><div aria-label="已完成 1 / 5 项" aria-valuemax="5" aria-valuemin="0" aria-valuenow="1" aria-valuetext="已完成 1 / 5 项" class="composer-progress-meter" role="progressbar">已完成 1 / 5 项</div></div><ol class="composer-progress-checklist"><li data-status="completed"><span class="composer-progress-item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg></span><span class="composer-progress-item-title">读取 &lt;AGENTS.md&gt;</span><span class="composer-progress-item-status">已完成</span></li><li aria-current="step" data-status="inProgress"><span class="composer-progress-item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-dot" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="1"></circle></svg></span><span class="composer-progress-item-title">实现结构化投影</span><span class="composer-progress-item-status">进行中</span></li><li data-status="blocked"><span class="composer-progress-item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-octagon-alert" aria-hidden="true"><path d="M12 16h.01"></path><path d="M12 8v4"></path><path d="M15.312 2a2 2 0 0 1 1.414.586l4.688 4.688A2 2 0 0 1 22 8.688v6.624a2 2 0 0 1-.586 1.414l-4.688 4.688a2 2 0 0 1-1.414.586H8.688a2 2 0 0 1-1.414-.586l-4.688-4.688A2 2 0 0 1 2 15.312V8.688a2 2 0 0 1 .586-1.414l4.688-4.688A2 2 0 0 1 8.688 2z"></path></svg></span><span class="composer-progress-item-title">等待外部依赖</span><span class="composer-progress-item-status">受阻</span></li><li data-status="canceled"><span class="composer-progress-item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-ban" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m4.9 4.9 14.2 14.2"></path></svg></span><span class="composer-progress-item-title">移除旧路径</span><span class="composer-progress-item-status">已取消</span></li><li data-status="pending"><span class="composer-progress-item-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle></svg></span><span class="composer-progress-item-title">运行验证</span><span class="composer-progress-item-status">待处理</span></li></ol>"`;

exports[`ComposerProgressPill > shows the current task's recorded edit operations without a Plan 1`] = `"<div class="composer-progress-pill" data-od-id="composer-progress-pill" role="status"><span class="composer-progress-files">12 files changed</span><span class="composer-progress-additions">+727</span><span class="composer-progress-deletions">-86</span></div>"`;
