// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`settings layout contracts > keeps narrow notification controls below the fixed account pill 1`] = `
".screen-shell.command-screen .settings-command-notice {
  position: fixed;
  z-index: 30;
  top: 14px;
  right: 18px;
  display: flex;
  max-width: min(360px, calc(100vw - 32px));
  align-items: center;
  gap: 8px;
  padding: 7px 8px 7px 10px;
  border: 1px solid var(--settings-border);
  border-radius: var(--radius-md);
  background: color-mix(in srgb, var(--settings-card) 92%, transparent);
  color: var(--settings-muted);
  box-shadow: var(--shadow-modal);
  font-size: calc(11px + var(--user-ui-font-delta));
}

.screen-shell.command-screen .settings-command-notice button {
  display: grid;
  width: 22px;
  height: 22px;
  place-items: center;
  border: 0;
  border-radius: var(--radius-sm);
  background: transparent;
  color: inherit;
  cursor: pointer;
}

@media (max-width: 840px) {
  .screen-shell.command-screen .settings-command-notice {
    /* The compact account controls occupy y=12..42; never overlap logout. */
    top: 52px;
  }
}"
`;

exports[`settings layout contracts > keeps task pack controls scoped and responsive 1`] = `
".bundled-task-packs {
  display: grid;
  gap: 16px;
  color: var(--settings-fg);
  font-size: calc(12px + var(--user-ui-font-delta));
  line-height: 1.65;
}
.bundled-task-packs h2 {
  margin: 0;
  font-size: 16px;
}
.bundled-task-packs h3 {
  margin: 0;
  font-size: 14px;
}
.bundled-task-packs p {
  margin: 4px 0 0;
  color: var(--settings-muted);
  overflow-wrap: anywhere;
}
.task-pack-card {
  border: 1px solid var(--settings-border);
  border-radius: var(--radius-lg);
  background: var(--settings-card);
  padding: 18px;
}
.task-pack-card > header {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 12px;
  align-items: start;
}
.task-pack-card > header small {
  color: var(--settings-muted);
  overflow-wrap: anywhere;
}
.task-pack-card > header > span {
  border: 1px solid var(--settings-border);
  padding: 1px 7px;
  border-radius: var(--radius-pill);
  font-size: 11px;
}
.task-pack-preferences {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin: 18px 0;
}
.task-pack-preferences label,
.task-pack-prepare label {
  display: grid;
  gap: 6px;
}
.task-pack-preferences select,
.task-pack-prepare textarea {
  width: 100%;
  min-width: 0;
  padding: 8px 10px;
  border: 1px solid var(--settings-border);
  border-radius: var(--radius-md);
  background: var(--settings-bg, var(--settings-card));
  color: var(--settings-fg);
  font: inherit;
}
.task-pack-prepare textarea {
  resize: vertical;
  min-height: 140px;
}
.task-pack-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.task-pack-actions button {
  height: auto;
  min-height: 32px;
  white-space: normal;
  text-align: left;
}
.task-pack-card .task-pack-save-state {
  margin-top: 10px;
}
.task-pack-prepare {
  display: grid;
  gap: 12px;
  margin-top: 16px;
  padding-top: 16px;
  border-top: 1px solid var(--settings-border);
}
.task-pack-prepare [role="alert"] {
  color: var(--danger);
}
.bundled-task-packs :is(select, textarea, button):focus-visible {
  outline: 2px solid var(--settings-fg);
  outline-offset: 3px;
}
@media (max-width: 600px) {
  .task-pack-preferences {
    grid-template-columns: 1fr;
  }
}
"
`;

exports[`settings layout contracts > wraps authored capability explanations and scopes compact cards 1`] = `
".settings-section-help {
  border-left: 2px solid var(--settings-border, var(--border));
  padding: 4px 0 4px 14px;
  color: var(--settings-muted, var(--text-muted));
  font-size: calc(12px + var(--user-ui-font-delta));
  line-height: 1.65;
}
.settings-section-help strong {
  color: var(--settings-fg, var(--text));
  font-weight: 550;
}
.settings-section-help p {
  margin: 4px 0 0;
}
.settings-section-help button {
  display: block;
  margin-top: 8px;
  padding: 0;
  background: none;
  border: none;
  color: var(--settings-fg, var(--text));
  font: inherit;
  text-decoration: underline;
  text-underline-offset: 3px;
  cursor: pointer;
}
.settings-section-help button:focus-visible {
  outline: 2px solid var(--text);
  outline-offset: 4px;
}
.settings-page .settings-row-subtitle {
  overflow-wrap: anywhere;
}

.screen-shell.command-screen
  .settings-page[data-presentation="authored"]
  .settings-row-copy
  small {
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
  line-height: 1.65;
}
.screen-shell.command-screen
  .settings-page[data-presentation="authored"]
  .settings-card {
  padding: 0;
  gap: 0;
}
.screen-shell.command-screen
  .settings-page[data-presentation="authored"]
  .settings-row-list,
.screen-shell.command-screen
  .settings-page[data-presentation="authored"]
  .settings-row-list
  ~ [data-slot="card-content"] {
  padding: 0;
}
.screen-shell.command-screen
  .settings-page[data-presentation="authored"]
  .settings-summary-sections {
  padding: 16px 18px;
}
"
`;
