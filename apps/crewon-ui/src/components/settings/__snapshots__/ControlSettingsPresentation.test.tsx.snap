exports[`Control settings presentation > renders honest browser content and available actions 1`] = `"<section class="settings-page" aria-label="设置" data-mode="live" data-presentation="authored" data-section="browser"><main class="settings-content"><header class="settings-heading"><span class="settings-heading-icon"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-globe" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg></span><span class="settings-heading-copy"><h1>网页应用</h1><p>在任务中查看和使用网页</p></span></header><section class="settings-group"><div data-slot="card" class="flex flex-col gap-6 rounded-xl border bg-card py-6 text-card-foreground shadow-sm settings-card settings-rows-card"><div data-slot="card-content" class="px-6 settings-row-list pt-6"><div class="settings-row"><span class="settings-row-copy"><strong>工作台浏览器</strong><small class="settings-row-subtitle">返回任务后，在右侧工作台选择浏览器，或点击任务产物中的网页链接。</small></span></div><div class="settings-row"><span class="settings-row-copy"><strong>智能体网页操作</strong><small class="settings-row-subtitle">需要选择支持网页操作的智能体。你在工作台打开的网页不会自动交给智能体操作。</small></span></div></div></div></section><section class="settings-group"><div data-slot="card" class="flex flex-col gap-6 rounded-xl border bg-card py-6 text-card-foreground shadow-sm settings-card settings-summary-card"><div data-slot="card-content" class="px-6 settings-summary-sections pt-6"><section class="settings-summary-section"><p>网页版嵌入预览可能被网站拒绝。需要登录或不允许嵌入的网站，请在独立浏览器中操作。</p></section></div></div></section></main></section>"`;

exports[`Control settings presentation > renders honest computer-control content and available actions 1`] = `"<section class="settings-page" aria-label="设置" data-mode="live" data-presentation="authored" data-section="computer-control"><main class="settings-content"><header class="settings-heading"><span class="settings-heading-icon"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-terminal" aria-hidden="true"><path d="m7 11 2-2-2-2"></path><path d="M11 13h4"></path><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect></svg></span><span class="settings-heading-copy"><h1>设备协助</h1><p>使用本地文件与终端</p></span></header><section class="settings-group"><div data-slot="card" class="flex flex-col gap-6 rounded-xl border bg-card py-6 text-card-foreground shadow-sm settings-card settings-summary-card"><div data-slot="card-content" class="px-6 settings-summary-sections pt-6"><section class="settings-summary-section"><p>暂不支持在这里添加设备。使用本地文件或终端，请在桌面端为任务选择工作空间，再打开右侧工作台。</p></section></div></div></section></main></section>"`;

exports[`Control settings presentation > renders honest config content and available actions 1`] = `"<section class="settings-page" aria-label="设置" data-mode="live" data-presentation="authored" data-section="config"><main class="settings-content"><header class="settings-heading"><span class="settings-heading-icon"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sliders-horizontal" aria-hidden="true"><line x1="21" x2="14" y1="4" y2="4"></line><line x1="10" x2="3" y1="4" y2="4"></line><line x1="21" x2="12" y1="12" y2="12"></line><line x1="8" x2="3" y1="12" y2="12"></line><line x1="21" x2="16" y1="20" y2="20"></line><line x1="12" x2="3" y1="20" y2="20"></line><line x1="14" x2="14" y1="2" y2="6"></line><line x1="8" x2="8" y1="10" y2="14"></line><line x1="16" x2="16" y1="18" y2="22"></line></svg></span><span class="settings-heading-copy"><h1>常规</h1><p>使用环境与任务偏好</p></span></header><section class="settings-group"><div data-slot="card" class="flex flex-col gap-6 rounded-xl border bg-card py-6 text-card-foreground shadow-sm settings-card settings-rows-card"><div data-slot="card-content" class="px-6 settings-row-list pt-6"><div class="settings-row"><span class="settings-row-copy"><strong>使用环境</strong><small class="settings-row-subtitle">网页版</small></span></div><div class="settings-row"><span class="settings-row-copy"><strong>单次任务调整</strong><small class="settings-row-subtitle">发送任务前，可在输入框下方调整模型、执行方式和权限。</small></span></div></div><div data-slot="card-content" class="px-6 pt-0"><div class="settings-actions flex flex-wrap gap-2"><button data-slot="button" data-variant="outline" data-size="sm" class="inline-flex shrink-0 items-center justify-center text-sm font-medium whitespace-nowrap transition-all outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:op