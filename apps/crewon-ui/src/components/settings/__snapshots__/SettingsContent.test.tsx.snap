// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`SettingsContent > marks demo settings as read-only and does not expose fake saves 1`] = `"<section class="settings-page" aria-label="设置" data-mode="demo"><main class="settings-content"><header class="settings-heading"><h1>外观</h1><p>演示配置</p></header><section class="settings-trust-callout" data-mode="demo"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-triangle-alert" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg><span><strong>演示模式不会保存</strong><small>当前仅展示演示内容，所有输入和操作均已锁定。</small></span></section><section class="settings-group"><h2>设置</h2><div class="settings-card settings-form-card"><div class="settings-field-list"><label><span class="settings-field-copy"><strong>主题</strong></span><select disabled=""><option value="dark" selected="">深色</option></select></label></div><div class="settings-actions"><button type="button" data-tone="primary" disabled="">保存外观</button></div></div></section></main></section>"`;

exports[`SettingsContent > renders the assistant role, soul, and memory controls 1`] = `"<section class="settings-page" aria-label="设置" data-mode="live"><main class="settings-content"><header class="settings-heading"><h1>助理人格与记忆</h1><p>全局配置</p></header><section class="settings-group"><h2>设置</h2><div class="settings-card settings-form-card"><div class="settings-field-list"><label><span class="settings-field-copy"><strong>角色定位</strong><small>定义助理是谁、负责什么。</small></span><textarea rows="6">你是我的产品与工程助理。</textarea></label><label><span class="settings-field-copy"><strong>灵魂与原则</strong><small>定义价值取向与长期行为原则。</small></span><textarea rows="7">诚实标注未验证边界。</textarea></label><label><span class="settings-field-copy"><strong>长期记忆</strong><small>控制记忆的形成与检索。</small></span><select><option value="on" selected="">生成并使用（推荐）</option><option value="off">关闭长期记忆</option></select></label></div><div class="settings-actions"><button type="button" data-tone="primary">保存助理设置</button></div></div></section></main></section>"`;
