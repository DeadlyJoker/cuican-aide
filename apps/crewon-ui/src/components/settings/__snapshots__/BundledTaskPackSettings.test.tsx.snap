exports[`bundled task pack settings > renders bounded preferences and explicit preparation in en 1`] = `"<section class="bundled-task-packs" aria-label="Task templates"><header><h2>Task templates</h2><p>Save your preferences for the next task you prepare.</p></header><article class="task-pack-card"><header><div><h3>Meeting notes &amp; actions</h3></div><span>Built in</span></header><p>Turn meeting material into reviewable notes, action items and open questions, with sources. No sending or scheduling.</p><div class="task-pack-preferences"><label><strong>Output language</strong><select><option value="zh" selected="">Chinese</option><option value="en">English</option></select></label><label><strong>Detail level</strong><select><option value="concise" selected="">Concise, all key facts</option><option value="detailed">Detailed, include reasoning basis</option></select></label></div><div class="task-pack-actions"><button data-slot="button" data-variant="outline" data-size="default" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-md text-sm font-medium whitespace-nowrap transition-all outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 border bg-background shadow-xs hover:bg-accent hover:text-accent-foreground dark:border-input dark:bg-input/30 dark:hover:bg-input/50 h-9 px-4 py-2 has-[&gt;svg]:px-3" type="button">Save preferences</button><button data-slot="button" data-variant="outline" data-size="default" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-md text-sm font-medium whitespace-nowrap transition-all outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 border bg-background shadow-xs hover:bg-accent hover:text-accent-foreground dark:border-input dark:bg-input/30 dark:hover:bg-input/50 h-9 px-4 py-2 has-[&gt;svg]:px-3" type="button" aria-expanded="false">Use template</button></div><p class="task-pack-save-state" role="status">Could not load preferences. Defaults are shown; please save again.</p><div hidden=""><form class="task-pack-prepare"><label><strong>Meeting material</strong><textarea rows="7" required="" aria-describedby="task-pack-source-hint-crewon.meeting-notes" placeholder="Paste raw notes, decisions and actions with speakers, dates and sources."></textarea></label><p id="task-pack-source-hint-crewon.meeting-notes">1 / 200 lines · 0 / 16 kB · Once sent, the material is saved in this conversation.</p><div class="task-pack-actions"><button data-slot="button" data-variant="default" data-size="default" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-md text-sm font-medium whitespace-nowrap transition-all outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4 py-2 has-[&gt;svg]:px-3" type="submit" disabled="">Prepare draft</button></div><p>The draft opens in a new task without being sent. Check its content, model, execution mode and permissions before sending. View results in the right workbench.</p></form></div></article></section>"`;

exports[`bundled task pack settings > renders bounded preferences and explicit preparation in zh 1`] = `"<section class="bundled-task-packs" aria-label="任务模板"><header><h2>任务模板</h2><p>保存常用偏好，下次准备任务时自动使用。</p></header><article class="task-pack-card"><header><div><h3>会议纪要与行动项</h3></div><span>内置</span></header><p>把会议材料整理成可核对的纪要、行动项与待确认问题。保留来源，不替你发送或安排日程。</p><div class="task-pack-preferences"><label><strong>输出语言</strong><select><option value="zh" selected="">中文</option><option value="en">英文</option></select></label><label><strong>纪要详略</strong><select><option value="concise" selected="">精简，保留关键事实</option><option value="detailed">详细，说明判断依据</option></select></label></div><div class="task-pack-actions"><button data-slot="button" data-variant="outline" data-size="default" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-md text-sm font-medium whitespace-nowrap transition-all outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 border bg-background shadow-xs hover:bg-accent hover:text-accent-foreground dark:border-input dark:bg-input/30 dark:hover:bg-input/50 h-9 px-4 py-2 has-[&gt;svg]:px-3" type="button">保存偏好</button><button data-slot="button" data-variant="outline" data-size="default" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-md text-sm font-medium whitespace-nowrap transition-all outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 border bg-background shadow-xs hover:bg-accent hover:text-accent-foreground dark:border-input dark:bg-input/30 dark:hover:bg-input/50 h-9 px-4 py-2 has-[&gt;svg]:px-3" type="button" aria-expanded="false">使用模板</button></div><p class="task-pack-save-state" role="status">读取偏好失败，已使用默认值。请重新保存。</p><div hidden=""><form class="task-pack-prepare"><label><strong>会议材料</strong><textarea rows="7" required="" aria-describedby="task-pack-source-hint-crewon.meeting-notes" placeholder="粘贴原始记录、决定和行动项。保留发言人、时间与资料来源；不必预先整理。"></textarea></label><p id="task-pack-source-hint-crewon.meeting-notes">1 / 200 行 · 0 / 16 kB · 发送后，材料将保存在本次会话中。</p><div class="task-pack-actions"><button data-slot="button" data-variant="default" data-size="default" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-md text-sm font-medium whitespace-nowrap transition-all outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4 py-2 has-[&gt;svg]:px-3" type="submit" disabled="">准备草稿</button></div><p>草稿会放入新任务，不会自动发送。发送前请检查内容、模型、执行方式和权限。结果可在右侧工作台查看。</p></form></div></article></section>"`;
