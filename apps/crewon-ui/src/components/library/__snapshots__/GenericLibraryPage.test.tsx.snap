// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`GenericLibraryPage capability market > snapshots the unified Skill and MCP catalog controls 1`] = `"<main class="library-page" aria-label="能力"><header class="library-heading"><button type="button">返回对话</button><div><h1>能力</h1><p>0 个已添加 · 2 个预制能力</p></div></header><pre>能力统一分为技能和服务。</pre><div class="capability-library-toolbar"><div class="capability-library-tabs" role="tablist"><button aria-selected="true" data-active="true" role="tab" type="button">全部</button><button aria-selected="false" data-active="false" role="tab" type="button">技能</button><button aria-selected="false" data-active="false" role="tab" type="button">服务</button></div><div class="capability-library-tabs capability-location-tabs" role="tablist" aria-label="运行位置"><button aria-selected="true" data-active="true" role="tab" type="button">全部位置</button><button aria-selected="false" data-active="false" role="tab" type="button">本地</button><button aria-selected="false" data-active="false" role="tab" type="button">云端</button></div><input aria-label="搜索能力" placeholder="搜索技能或服务" type="search" value=""/></div><div class="library-actions"><button type="button" aria-busy="false" data-tone="primary">创建技能</button><button type="button" aria-busy="false">创建服务</button></div><section class="library-list"><div class="library-section"><strong>精选技能</strong><span>1 个模板</span></div><button class="library-item" data-accent="green" type="button"><span class="library-card-glyph" data-accent="green" aria-hidden="true"><span class="capability-brand-logo" data-logo="excel" style="--capability-logo-bg:#e9f7ef;--capability-logo-color:#107c41">X</span></span><span class="library-card-main"><span class="library-card-title-row"><strong>表格分析</strong></span><span class="library-card-meta">技能</span><p>创建、清洗和分析 Excel/CSV。</p></span><span class="library-card-chevron" data-add="true" aria-hidden="true">+</span></button><div class="library-section"><strong>服务</strong><span>1 个预制配置</span></div><button class="library-item" data-accent="blue" type="button"><span class="library-card-glyph" data-accent="blue" aria-hidden="true"><span class="capability-brand-logo" data-logo="browser" style="--capability-logo-bg:#eef4ff;--capability-logo-color:#3667e8"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></circle><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></circle><path d="M12 3.5 17 12M4.7 8h9.8M8 19.5l4-7.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path></svg></span></span><span class="library-card-main"><span class="library-card-title-row"><strong>浏览器自动化</strong></span><span class="library-card-meta">服务</span><p>通过结构化页面信息执行浏览和测试。</p></span><span class="library-card-chevron" data-add="true" aria-hidden="true">+</span></button></section></main>"`;
