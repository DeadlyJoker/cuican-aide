exports[`CapabilityEditorDialog > renders OAuth and managed-service states 1`] = `"<div class="modal-backdrop capability-editor-backdrop open" role="dialog" aria-modal="true" aria-labelledby="capability-editor-title"><form class="arrangement-modal-card capability-editor-modal"><header class="arrangement-modal-header"><div><h2 id="capability-editor-title">创建服务</h2><p>选择服务并填写必要信息。MCP Server 地址和启动方式由 CrewON 维护。</p></div><button aria-label="关闭" class="icon-action compact" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></header><label class="form-field"><span>服务名称</span><input required="" value="notion"/></label><div class="capability-editor-form"><label class="form-field"><span>服务类型</span><select><optgroup label="可直接连接"><option value="filesystem">文件系统</option><option value="memory">长期记忆</option><option value="git">Git 仓库</option><option value="fetch">网页抓取</option><option value="time">时间与时区</option><option value="sequential-thinking">结构化思考</option><option value="playwright">浏览器自动化</option><option value="github">GitHub · 登录授权</option><option value="notion" selected="">Notion · 登录授权</option><option value="figma">Figma · 登录授权</option><option value="sentry">Sentry · 登录授权</option><option value="brave-search">Brave Search</option></optgroup><optgroup label="组织托管"><option disabled="" value="tongdaxin-market-data">通达信 · 等待组织下发</option><option disabled="" value="tencent-stock">腾讯自选股 · 等待组织下发</option><option disabled="" value="qq-mail">QQ 邮箱 · 等待组织下发</option><option disabled="" value="ima-knowledge">ima 知识库 · 等待组织下发</option><option disabled="" value="lexiang-knowledge">乐享知识库 · 等待组织下发</option><option disabled="" value="tencent-docs">腾讯文档 · 等待组织下发</option><option disabled="" value="tencent-meeting">腾讯会议 · 等待组织下发</option><option disabled="" value="wecom">企业微信 · 等待组织下发</option><option disabled="" value="feishu">飞书 · 等待组织下发</option><option disabled="" value="dingtalk">钉钉 · 等待组织下发</option><option disabled="" value="tencent-questionnaire">腾讯问卷 · 等待组织下发</option><option disabled="" value="tapd">TAPD · 等待组织下发</option><option disabled="" value="cnb">CNB · 等待组织下发</option><option disabled="" value="tencent-weiyun">腾讯微云 · 等待组织下发</option><option disabled="" value="fubang-assistant">福帮手 · 等待组织下发</option><option disabled="" value="wps-docs">金山文档 · 等待组织下发</option><option disabled="" value="imap-smtp">IMAP/SMTP 邮件 · 等待组织下发</option><option disabled="" value="tencent-map">腾讯地图 · 等待组织下发</option><option disabled="" value="tencent-news">腾讯新闻 · 等待组织下发</option><option disabled="" value="qq-music">QQ 音乐 · 等待组织下发</option></optgroup></select></label><p class="capability-editor-setup-note">服务地址由 CrewON 内置。保存后会自动打开官方登录页完成 OAuth 授权。</p></div><footer class="arrangement-modal-actions"><button class="button" type="button">取消</button><button class="button primary" type="submit">保存并登录</button></footer></form></div>"`;

exports[`CapabilityEditorDialog > renders OAuth and managed-service states 2`] = `"<div class="modal-backdrop capability-editor-backdrop open" role="dialog" aria-modal="true" aria-labelledby="capability-editor-title"><form class="arrangement-modal-card capability-editor-modal"><header class="arrangement-modal-header"><div><h2 id="capability-editor-title">创建服务</h2><p>选择服务并填写必要信息。MCP Server 地址和启动方式由 CrewON 维护。</p></div><button aria-label="关闭" class="icon-action compact" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></header><label class="form-field"><span>服务名称</span><input required="" value="wecom"/></label><div class="capability-editor-form"><label class="form-field"><span>服务类型</span><select><optgroup label="可直接连接"><option value="filesystem">文件系统</option><option value="memory">长期记忆</option><option value="git">Git 仓库</option><option value="fetch">网页抓取</option><option value="time">时间与时区</option><option value="sequential-thinking">结构化思考</option><option value="playwright">浏览器自动化</option><option value="github">GitHub · 登录授权</option><option value="notion">Notion · 登录授权</option><option value="figma">Figma · 登录授权</option><option value="sentry">Sentry · 登录授权</option><option value="brave-search">Brave Search</option></optgroup><optgroup label="组织托管"><option disabled="" value="tongdaxin-market-data">通达信 · 等待组织下发</option><option disabled="" value="tencent-stock">腾讯自选股 · 等待组织下发</option><option disabled="" value="qq-mail">QQ 邮箱 · 等待组织下发</option><option disabled="" value="ima-knowledge">ima 知识库 · 等待组织下发</option><option disabled="" value="lexiang-knowledge">乐享知识库 · 等待组织下发</option><option disabled="" value="tencent-docs">腾讯文档 · 等待组织下发</option><option disabled="" value="tencent-meeting">腾讯会议 · 等待组织下发</option><option disabled="" value="wecom" selected="">企业微信 · 等待组织下发</option><option disabled="" value="feishu">飞书 · 等待组织下发</option><option disabled="" value="dingtalk">钉钉 · 等待组织下发</option><option disabled="" value="tencent-questionnaire">腾讯问卷 · 等待组织下发</option><option disabled="" value="tapd">TAPD · 等待组织下发</option><option disabled="" value="cnb">CNB · 等待组织下发</option><option disabled="" value="tencent-weiyun">腾讯微云 · 等待组织下发</option><option disabled="" value="fubang-assistant">福帮手 · 等待组织下发</option><option disabled="" value="wps-docs">金山文档 · 等待组织下发</option><option disabled="" value="imap-smtp">IMAP/SMTP 邮件 · 等待组织下发</option><option disabled="" value="tencent-map">腾讯地图 · 等待组织下发</option><option disabled="" value="tencent-news">腾讯新闻 · 等待组织下发</option><option disabled="" value="qq-music">QQ 音乐 · 等待组织下发</option></optgroup></select></label><p class="capability-editor-setup-note is-managed">该服务没有公开 MCP Server 地址，必须由组织服务目录下发；CrewON 不允许手工填写或猜测 URL。</p></div><footer class="arrangement-modal-actions"><button class="button" type="button">取消</button><button class="button primary" disabled="" type="submit">保存服务</button></footer></form></div>"`;

exports[`CapabilityEditorDialog > renders typed MCP fields without a server URL or JSON editor 1`] = `"<div class="modal-backdrop capability-editor-backdrop open" role="dialog" aria-modal="true" aria-labelledby="capability-editor-title"><form class="arrangement-modal-card capability-editor-modal"><header class="arrangement-modal-header"><div><h2 id="capability-editor-title">创建服务</h2><p>选择服务并填写必要信息。MCP Server 地址和启动方式由 CrewON 维护。</p></div><button aria-label="关闭" class="icon-action compact" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></header><label class="form-field"><span>服务名称</span><input required="" value="filesystem"/></label><div class="capability-editor-form"><label class="form-field"><span>服务类型</span><select><optgroup label="可直接连接"><option value="filesystem" selected="">文件系统</option><option value="memory">长期记忆</option><option value="git">Git 仓库</option><option value="fetch">网页抓取</option><option value="time">时间与时区</option><option value="sequential-thinking">结构化思考</option><option value="playwright">浏览器自动化</option><option value="github">GitHub · 登录授权</option><option value="notion">Notion · 登录授权</option><option value="figma">Figma · 登录授权</option><option value="sentry">Sentry · 登录授权</option><option value="brave-search">Brave Search</option></optgroup><optgroup label="组织托管"><option disabled="" value="tongdaxin-market-data">通达信 · 等待组织下发</option><option disabled="" value="tencent-stock">腾讯自选股 · 等待组织下发</option><option disabled="" value="qq-mail">QQ 邮箱 · 等待组织下发</option><option disabled="" value="ima-knowledge">ima 知识库 · 等待组织下发</option><option disabled="" value="lexiang-knowledge">乐享知识库 · 等待组织下发</option><option disabled="" value="tencent-docs">腾讯文档 · 等待组织下发</option><option disabled="" value="tencent-meeting">腾讯会议 · 等待组织下发</option><option disabled="" value="wecom">企业微信 · 等待组织下发</option><option disabled="" value="feishu">飞书 · 等待组织下发</option><option disabled="" value="dingtalk">钉钉 · 等待组织下发</option><option disabled="" value="tencent-questionnaire">腾讯问卷 · 等待组织下发</option><option disabled="" value="tapd">TAPD · 等待组织下发</option><option disabled="" value="cnb">CNB · 等待组织下发</option><option disabled="" value="tencent-weiyun">腾讯微云 · 等待组织下发</option><option disabled="" value="fubang-assistant">福帮手 · 等待组织下发</option><option disabled="" value="wps-docs">金山文档 · 等待组织下发</option><option disabled="" value="imap-smtp">IMAP/SMTP 邮件 · 等待组织下发</option><option disabled="" value="tencent-map">腾讯地图 · 等待组织下发</option><option disabled="" value="tencent-news">腾讯新闻 · 等待组织下发</option><option disabled="" value="qq-music">QQ 音乐 · 等待组织下发</option></optgroup></select></label><p class="capability-editor-setup-note">服务地址和启动方式由 CrewON 内置，无需填写 MCP Server URL；只需填写下面的授权或本地范围信息。</p><label class="form-field"><span>允许访问的目录</span><input autoComplete="off" placeholder="/Users/name/project" required="" type="text" value=""/></label></div><footer class="arrangement-modal-actions"><button class="button" type="button">取消</button><button class="button primary" type="submit">保存服务</button></footer></form></div>"`;
