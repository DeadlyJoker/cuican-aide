{
  "name": "crewon-monorepo",
  "private": true,
  "description": "Tools for repo-wide maintenance.",
  "scripts": {
    "agent:harness": "bash scripts/crewon-agent-harness.sh",
    "agent:smoke": "pnpm --filter @crewon/ui test:agent-platform-multiturn",
    "control:web": "node scripts/crewon-control-web-dev.mjs",
    "ui:dev": "node scripts/crewon-control-web-dev.mjs",
    "ui:dev:frontend": "pnpm --filter @crewon/ui dev",
    "ui:build": "pnpm --filter @crewon/ui build",
    "ui:desktop": "pnpm --filter @crewon/ui desktop",
    "release:desktop": "node scripts/release-desktop.mjs",
    "release:publish": "node scripts/release-local.mjs",
    "crewon:dev": "node scripts/crewon-control-web-dev.mjs",
    "crewon:boundary:check": "node scripts/verify-crewon-typescript-boundary.mjs",
    "control-api:start": "pnpm --filter @crewon/control-api start",
    "control-api:test": "pnpm --filter @crewon/control-api test",
    "runtime-worker:start": "pnpm --filter @crewon/runtime-worker start",
    "runtime-worker:test": "pnpm --filter @crewon/runtime-worker test",
    "device-gateway:start": "pnpm --filter @crewon/device-gateway start",
    "device-gateway:test": "pnpm --filter @crewon/device-gateway test",
    "format": "prettier --check *.json *.md docs/*.md .github/workflows/*.yml **/*.js",
    "format:fix": "prettier --write *.json *.md docs/*.md .github/workflows/*.yml **/*.js",
    "write-hooks-schema": "cargo run --manifest-path ./codex-rs/Cargo.toml -p crewon-hooks --bin write_hooks_schema_fixtures"
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  },
  "resolutions": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "braces": "^3.0.3",
    "flatted": "3.4.2",
    "glob@10.4.5": "10.5.0",
    "handlebars": "4.7.9",
    "micromatch": "^4.0.8",
    "minimatch@3.1.2": "3.1.4",
    "minimatch@9.0.5": "9.0.7",
    "path-to-regexp": "8.4.0",
    "picomatch@2.3.1": "2.3.2",
    "picomatch@4.0.3": "4.0.4",
    "rollup": "4.59.0",
    "semver": "^7.7.1"
  },
  "overrides": {
    "punycode": "^2.3.1"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10.33.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "dependencies": {
    "docx": "^9.7.1"
  }
}
