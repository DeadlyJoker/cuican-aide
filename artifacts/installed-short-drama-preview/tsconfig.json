{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["node", "react", "react-dom"],
    "baseUrl": "../..",
    "paths": {
      "@/*": ["apps/crewon-ui/src/*"],
      "@crewon/control-client": ["packages/control-client/src/index.ts"],
      "vite": ["apps/crewon-ui/node_modules/vite"]
    }
  },
  "include": [
    "preview-server.ts",
    "preview-fixture.ts",
    "preview-http-proof.ts"
  ]
}
