{
  "schemaVersion": "crewon.extension-manifest.v0",
  "hostApi": "crewon.extensions.v0",
  "pluginId": "crewon.short-drama",
  "version": "16.0.0",
  "title": "AI 短剧工作台",
  "description": "一个短剧插件内包含项目、需求、大纲、分集剧本的Agent工具与Krea2预设，手动入口共享同一项目版本。",
  "task": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "maxLength": 9999,
          "enum": null
        }
      },
      "required": ["prompt"],
      "additionalProperties": false
    },
    "instructions": "先调用 project_context_read 读取实际执行范围。scope 非空时，只处理其 projectId、阶段与确切来源；讨论阶段只读取和提出建议，需求阶段追加需求修订，大纲、剧本阶段分别使用允许的写工具保存候选，不能创建另一项目、跨集写入、自动采用/锁定或执行媒体工具。若所需阶段或来源未获准，说明缺口并请用户在对话中切换阶段。scope 为 null 的原独立任务沿原行为：先读取或创建项目，读取当前需求和阶段元数据。文字创作由当前 Agent 模型完成，业务工具校验需求修订和成果候选；大纲/剧本保存不自动采用。每个工具 resultJson 为实际宿主结果，ID、版本和摘要从真实结果取得。content_read 沿 nextOffset 读取至 null，不把部分 JSON 当全文，不一次注入全项目和历史。版本冲突先读取并说明差异，不能盲目覆盖。原媒体任务仅在用户授权且 Krea2 已配置时 submit 一次，再 observe 原 operation；unknownOutcome 不能重新提交。视频、声音和合成尚未接通，不能假称完成。"
  },
  "configurationSchema": {
    "type": "object",
    "properties": {
      "baseUrl": {
        "type": "string",
        "maxLength": 2048,
        "enum": null
      },
      "preset": {
        "type": "string",
        "maxLength": 64,
        "enum": ["krea2-portrait", "krea2-character-three-view"]
      }
    },
    "required": ["baseUrl", "preset"],
    "additionalProperties": false
  },
  "credentialSlots": [],
  "tools": [
    {
      "operationId": "submit",
      "adapterId": "crewon.comfyui-api",
      "description": "Generate one image from a text prompt. Submit once, save operationId, then use observe. A submitted status is not a finished image. Never resubmit an uncertain request.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "maxLength": 2000,
            "enum": null
          }
        },
        "required": ["prompt"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string",
            "maxLength": 36,
            "enum": null
          },
          "submission": {
            "type": "string",
            "maxLength": 16,
            "enum": ["accepted"]
          },
          "next": {
            "type": "string",
            "maxLength": 64,
            "enum": ["crewon_short_drama__observe"]
          }
        },
        "required": ["operationId", "submission", "next"],
        "additionalProperties": false
      },
      "execution": "serial",
      "effect": "mutation",
      "recovery": "reconcilable",
      "capability": "extension.image.generate"
    },
    {
      "operationId": "observe",
      "adapterId": "crewon.comfyui-api",
      "description": "Read a previously submitted image operation in this Run, or the original operation explicitly attached by the host to a query Run. Returns its actual status and image URLs only when generation succeeded. Never invent an operationId or treat unknownOutcome as failure to submit.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string",
            "maxLength": 36,
            "enum": null
          }
        },
        "required": ["operationId"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string",
            "maxLength": 36,
            "enum": null
          },
          "status": {
            "type": "string",
            "maxLength": 32,
            "enum": [
              "submitting",
              "submitted",
              "queued",
              "running",
              "succeeded",
              "failed",
              "unknownOutcome"
            ]
          },
          "images": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "properties": {
                "filename": {
                  "type": "string",
                  "maxLength": 255,
                  "enum": null
                },
                "subfolder": {
                  "type": "string",
                  "maxLength": 512,
                  "enum": null
                },
                "type": {
                  "type": "string",
                  "maxLength": 16,
                  "enum": ["output"]
                },
                "url": {
                  "type": "string",
                  "maxLength": 2048,
                  "enum": null
                }
              },
              "required": ["filename", "subfolder", "type", "url"],
              "additionalProperties": false
            }
          }
        },
        "required": ["operationId", "status"],
        "additionalProperties": false
      },
      "execution": "serial",
      "effect": "readOnly",
      "recovery": "replaySafe",
      "capability": "extension.image.read"
    },
    {
      "operationId": "project_list",
      "adapterId": "crewon.project-tools",
      "description": "List accessible short-drama projects, at most four. Continue only using the returned cursor.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "maxLength": 16,
            "enum": ["active", "archived", "all"]
          },
          "after": {
            "type": "object",
            "properties": {
              "updatedAt": {
                "type": "string",
                "maxLength": 32,
                "enum": null
              },
              "projectId": {
                "type": "string",
                "maxLength": 128,
                "enum": null
              }
            },
            "required": ["updatedAt", "projectId"],
            "additionalProperties": false
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          }
        },
        "required": ["state", "limit"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "resultJson": {
            "type": "string",
            "maxLength": 8192,
            "enum": null
          }
        },
        "required": ["resultJson"],
        "additionalProperties": false
      },
      "execution": "serial",
      "effect": "readOnly",
      "recovery": "replaySafe",
      "capability": "project.read"
    },
    {
      "operationId": "project_read",
      "adapterId": "crewon.project-tools",
      "description": "Read actual project and current brief metadata; use content_read for the exact brief text.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "maxLength": 128,
            "enum": null
          }
        },
        "required": ["projectId"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "resultJson": {
            "type": "string",
            "maxLength": 8192,
            "enum": null
          }
        },
        "required": ["resultJson"],
        "additionalProperties": false
      },
      "execution": "serial",
      "effect": "readOnly",
      "recovery": "replaySafe",
      "capability": "project.read"
    },
    {
      "operationId": "project_create",
      "adapterId": "crewon.project-tools",
      "description": "Save a user idea as a new project and brief. Does not submit media. Record the returned actual projectId.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160,
            "enum": null
          },
          "briefText": {
            "type": "string",
            "maxLength": 8192,
            "enum": null
          }
        },
        "required": ["title", "briefText"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "resultJson": {
            "type": "string",
            "maxLength": 8192,
            "enum": null
          }
        },
        "required": ["resultJson"],
        "additionalProperties": false
      },
      "execution": "serial",
      "effect": "mutation",
      "recovery": "reconcilable",
      "capability": "project.write"
    },
    {
      "operationId": "brief_append",
      "adapterId": "crewon.project-tools",
      "description": "Append a new brief based on the actual project revision. Preserve user wording; never overwrite history.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "maxLength": 128,
            "enum": null
          },
          "expectedProjectRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "text": {
            "type": "string",
            "maxLength": 8192,
            "enum": null
          }
        },
        "required": ["projectId", "expectedProjectRevision", "text"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "resultJson": {
            "type": "string",
            "maxLength": 8192,
            "enum": null
          }
        },
        "required": ["resultJson"],
        "additionalProperties": false
      },
      "execution": "serial",
      "effect": "mutation",
      "recovery": "reconcilable",
      "capability": "project.write"
    },
    {
      "operationId": "outline_read",
      "adapterId": "crewon.project-tools",
      "description": "Read current outline head, selection and dependency state. Content is read separately by immutable revision.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "maxLength": 128,
            "enum": null
          }
        },
        "required": ["projectId"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "resultJson": {
            "type": "string",
            "maxLength": 8192,
            "enum": null
          }
        },
        "required": ["resultJson"],
        "additionalProperties": false
      },
      "execution": "serial",
      "effect": "readOnly",
      "recovery": "replaySafe",
      "capability": "project.read"
    },
    {
      "operationId": "script_read",
      "adapterId": "crewon.project-tools",
      "description": "Read one episode script head, selection and dependency state. Missing script is a real empty stage.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "maxLength": 128,
            "enum": null
          },
          "episodeId": {
            "type": "string",
            "maxLength": 128,
            "enum": null
          }
        },
        "required": ["projectId", "episodeId"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "resultJson": {
            "type": "string",
            "maxLength": 8192,
            "enum": null
          }
        },
        "required": ["resultJson"],
        "additionalProperties": false
      },
      "execution": "serial",
      "effect": "readOnly",
      "recovery": "replaySafe",
      "capability": "project.read"
    },
    {
      "operationId": "content_read",
      "adapterId": "crewon.project-tools",
      "description": "Read up to 1024 Unicode code points of one exact immutable brief or text revision. Start offset 0 and concatenate until nextOffset is null; do not use incomplete JSON as complete content.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "maxLength": 128,
            "enum": null
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "maxLength": 8,
                "enum": ["brief", "text"]
              },
              "briefRevision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "artifactId": {
                "type": "string",
                "maxLength": 128,
                "enum": null
              },
              "contentRevision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": ["kind"],
            "additionalProperties": false
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["projectId", "source", "offset"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "resultJson": {
            "type": "string",
            "maxLength": 8192,
            "enum": null
          }
        },
        "required": ["resultJson"],
        "additionalProperties": false
      },
      "execution": "serial",
      "effect": "readOnly",
      "recovery": "replaySafe",
      "capability": "project.read"
    },
    {
      "operationId": "text_history",
      "adapterId": "crewon.project-tools",
      "description": "Read at most four revision metadata records; use content_read for a chosen exact revision.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "maxLength": 128,
            "enum": null
          },
          "artifactId": {
            "type": "string",
            "maxLength": 128,
            "enum": null
          },
          "afterContentRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          }
        },
        "required": [
          "projectId",
          "artifactId",
          "afterContentRevision",
          "limit"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "resultJson": {
            "type": "string",
            "maxLength": 8192,
            "enum": null
          }
        },
        "required": ["resultJson"],
        "additionalProperties": false
      },
      "execution": "serial",
      "effect": "readOnly",
      "recovery": "replaySafe",
      "capability": "project.read"
    },
    {
      "operationId": "outline_save",
      "adapterId": "crewon.project-tools",
      "description": "Validate and append an outline candidate against the actual brief revision and artifact head. Zero head means absent outline. Does not select or replace current content.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "maxLength": 128,
            "enum": null
          },
          "expectedArtifactRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "briefRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "content": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 160,
                "enum": null
              },
              "logline": {
                "type": "string",
                "maxLength": 2048,
                "enum": null
              },
              "synopsis": {
                "type": "string",
                "maxLength": 8192,
                "enum": null
              },
              "episodes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "episodeId": {
                      "type": "string",
                      "maxLength": 128,
                      "enum": null
                    },
                    "title": {
                      "type": "string",
                      "maxLength": 160,
                      "enum": null
                    },
                    "summary": {
                      "type": "string",
                      "maxLength": 8192,
                      "enum": null
                    }
                  },
                  "required": ["episodeId", "title", "summary"],
                  "additionalProperties": false
                },
                "maxItems": 16
              }
            },
            "required": ["title", "logline", "synopsis", "episodes"],
            "additionalProperties": false
          }
        },
        "required": [
          "projectId",
          "expectedArtifactRevision",
          "briefRevision",
          "content"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "resultJson": {
            "type": "string",
            "maxLength": 8192,
            "enum": null
          }
        },
        "required": ["resultJson"],
        "additionalProperties": false
      },
      "execution": "serial",
      "effect": "mutation",
      "recovery": "reconcilable",
      "capability": "project.write"
    },
    {
      "operationId": "script_save",
      "adapterId": "crewon.project-tools",
      "description": "Append one episode script candidate citing an exact outline revision. Omit outline only for importing a preexisting script without claimed outline provenance. Never silently replace selected content.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "maxLength": 128,
            "enum": null
          },
          "episodeId": {
            "type": "string",
            "maxLength": 128,
            "enum": null
          },
          "expectedArtifactRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "briefRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "outline": {
            "type": "object",
            "properties": {
              "artifactId": {
                "type": "string",
                "maxLength": 128,
                "enum": null
              },
              "contentRevision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": ["artifactId", "contentRevision"],
            "additionalProperties": false
          },
          "content": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 160,
                "enum": null
              },
              "scenes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "sceneId": {
                      "type": "string",
                      "maxLength": 128,
                      "enum": null
                    },
                    "location": {
                      "type": "string",
                      "maxLength": 640,
                      "enum": null
                    },
                    "timeOfDay": {
                      "type": "string",
                      "maxLength": 320,
                      "enum": null
                    },
                    "action": {
                      "type": "string",
                      "maxLength": 8192,
                      "enum": null
                    },
                    "dialogue": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "speaker": {
                            "type": "string",
                            "maxLength": 640,
                            "enum": null
                          },
                          "text": {
                            "type": "string",
                            "maxLength": 8192,
                            "enum": null
                          }
                        },
                        "required": ["speaker", "text"],
                        "additionalProperties": false
                      },
                      "maxItems": 64
                    }
                  },
                  "required": [
                    "sceneId",
                    "location",
                    "timeOfDay",
                    "action",
                    "dialogue"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 32
              }
            },
            "required": ["title", "scenes"],
            "additionalProperties": false
          }
        },
        "required": [
          "projectId",
          "episodeId",
          "expectedArtifactRevision",
          "briefRevision",
          "content"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "resultJson": {
            "type": "string",
            "maxLength": 8192,
            "enum": null
          }
        },
        "required": ["resultJson"],
        "additionalProperties": false
      },
      "execution": "serial",
      "effect": "mutation",
      "recovery": "reconcilable",
      "capability": "project.write"
    },
    {
      "operationId": "text_select",
      "adapterId": "crewon.project-tools",
      "description": "Select an exact candidate using the actual head revision and current dependencies. Only select when the user or an actual plan has authorized adoption.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "maxLength": 128,
            "enum": null
          },
          "artifactId": {
            "type": "string",
            "maxLength": 128,
            "enum": null
          },
          "expectedArtifactRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "contentRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "projectId",
          "artifactId",
          "expectedArtifactRevision",
          "contentRevision"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "resultJson": {
            "type": "string",
            "maxLength": 8192,
            "enum": null
          }
        },
        "required": ["resultJson"],
        "additionalProperties": false
      },
      "execution": "serial",
      "effect": "mutation",
      "recovery": "reconcilable",
      "capability": "project.write"
    },
    {
      "operationId": "text_lock",
      "adapterId": "crewon.project-tools",
      "description": "Lock or unlock an actual selected artifact on user instruction. Lock protects selected content while retaining candidate history.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "maxLength": 128,
            "enum": null
          },
          "artifactId": {
            "type": "string",
            "maxLength": 128,
            "enum": null
          },
          "expectedArtifactRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "locked": {
            "type": "boolean"
          }
        },
        "required": [
          "projectId",
          "artifactId",
          "expectedArtifactRevision",
          "locked"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "resultJson": {
            "type": "string",
            "maxLength": 8192,
            "enum": null
          }
        },
        "required": ["resultJson"],
        "additionalProperties": false
      },
      "execution": "serial",
      "effect": "mutation",
      "recovery": "reconcilable",
      "capability": "project.write"
    },
    {
      "operationId": "project_context_read",
      "adapterId": "crewon.project-context",
      "description": "Read the host-persisted project, stage and exact source revisions for this Run. A null scope denotes a legacy standalone task. Use actual IDs and stay within allowedOperations; this metadata never grants execution rights.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "resultJson": {
            "type": "string",
            "maxLength": 8192,
            "enum": null
          }
        },
        "required": ["resultJson"],
        "additionalProperties": false
      },
      "execution": "serial",
      "effect": "readOnly",
      "recovery": "replaySafe",
      "capability": "project.read"
    }
  ],
  "resultViews": ["text", "externalOperation", "externalResult"]
}
