        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "maxLength": 128,
            "enum": null
          },
          "expectedArtifactRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "briefRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "content": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 160,
                "enum": null
              },
              "logline": {
                "type": "string",
                "maxLength": 2048,
                "enum": null
              },
              "synopsis": {
                "type": "string",
                "maxLength": 8192,
                "enum": null
              },
              "episodes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "episodeId": {
                      "type": "string",
                      "maxLength": 128,
                      "enum": null
                    },
                    "title": {
                      "type": "string",
                      "maxLength": 160,
                      "enum": null
                    },
                    "summary": {
                      "type": "string",
                      "maxLength": 8192,
                      "enum": null
                    }
                  },
                  "required": ["episodeId", "title", "summary"],
                  "additionalProperties": false
                },
                "maxItems": 16
              }
            },
            "required": ["title", "logline", "synopsis", "episodes"],
            "additionalProperties": false
          }
        },
        "required": [
          "projectId",
          "expectedArtifactRevision",
          "briefRevision",
          "content"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "resultJson": {
            "type": "string",
            "maxLength": 8192,
            "enum": null
          }
        },
        "required": ["resultJson"],
        "additionalProperties": false
      },
      "execution": "serial",
      "effect": "mutation",
      "recovery": "reconcilable",
      "capability": "project.write"
    },
