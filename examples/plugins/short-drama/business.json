      "recovery": "replaySafe",
      "capability": "project.read"
    },
    {
      "operationId": "content_read",
      "adapterId": "crewon.project-tools",
      "description": "Read up to 1024 Unicode code points of one exact immutable brief or text revision. Start offset 0 and concatenate until nextOffset is null; do not use incomplete JSON as complete content.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "maxLength": 128,
            "enum": null
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "maxLength": 8,
                "enum": ["brief", "text"]
              },
              "briefRevision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "artifactId": {
                "type": "string",
                "maxLength": 128,
                "enum": null
              },
              "contentRevision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": ["kind"],
            "additionalProperties": false
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["projectId", "source", "offset"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "resultJson": {
            "type": "string",
            "maxLength": 8192,
            "enum": null
          }
        },
        "required": ["resultJson"],
        "additionalProperties": false
      },
      "execution": "serial",
      "effect": "readOnly",
      "recovery": "replaySafe",
      "capability": "project.read"
    },
    {
