{
  "schemaVersion": "crewon.extension-manifest.v1",
  "hostApi": "crewon.extensions.v1",
  "pluginId": "crewon.short-drama",
  "version": "21.0.1",
  "title": "AI 短剧工作台",
  "description": "短剧插件内的项目、文字成果、角色场景道具和Krea2能力共用同一版本；Agent按当前阶段执行，用户可以手动探索、编辑、采用和锁定。",
  "task": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "maxLength": 9999,
          "enum": null
        },
        "kind": {
          "type": "string",
          "maxLength": 128,
          "enum": ["crewon.short-drama.reference-generation.v1"]
        },
        "projectId": {
          "type": "string",
          "maxLength": 128,
          "enum": null
        },
        "mediaInputId": {
          "type": "string",
          "maxLength": 128,
          "enum": null
        },
        "inputRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": null
        },
        "executionId": {
          "type": "string",
          "maxLength": 128,
          "enum": null
        },
        "mediaInputDigest": {
          "type": "string",
          "maxLength": 71,
          "enum": null
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "instructions": "对于宿主已确认的 crewon.short-drama.reference-generation.v1 任务，只调用 media_submit 和 media_observe，输入为空对象。提示词、参考与工作流从原宿主服务读取；未知请求只查询原记录。工具返回实际供应商状态，submitted不表示图片成功，成功也不表示项目已采用。不得调用其他创作/编辑或原自由生图工具。原非媒体任务遵守后续阶段规则：每轮先调用 asset_context_read，读取真实资产阶段范围。其scope非空时，只处理该项目、assetKind和冻结的需求/剧本来源；只调用allowedOperations中的工具。asset_save仅保存候选，不能自动采用、锁定、选参考图或执行媒体。使用原实际来源，不猜测最新版本；asset_content_read逐段读取至nextOffset=null，并核对同一contentDigest。资产scope为null时，调用project_context_read读取原项目执行范围：讨论只读和建议，需求追加需求修订，大纲/剧本仅保存当前获准阶段及分集的候选，不能跨项目、跨集、自动采用/锁定或执行媒体。两种scope均为null的原独立任务沿原行为：先读取或创建项目，再读取需求和阶段元数据。每个resultJson是实际宿主结果，ID、版本和摘要从真实结果取得。旧content_read沿nextOffset读至null，不把片段当全文，不一次注入全项目与历史。文字创作由当前Agent模型完成；保存候选不代表选用。版本冲突先读取并说明差异，不能盲目覆盖。原媒体任务仅在用户授权且Krea2配置完整时提交一次，再观察原operation；unknownOutcome只查询，不能重新提交。缺少服务、权限或来源时说明缺口，不绕过宿主协议。视频、声音和合成尚未接通，不能假称完成。"
  },
  "configurationSchema": {
    "type": "object",
    "properties": {
      "baseUrl": {
        "type": "string",
        "maxLength": 2048,
        "enum": null
      },
      "preset": {
        "type": "string",
        "maxLength": 64,
        "enum": ["krea2-portrait", "krea2-character-three-view"]
      }
    },
    "required": ["baseUrl", "preset"],
    "additionalProperties": false
  },
  "credentialSlots": [],
  "tools": [
    {
      "operationId": "submit",
      "adapterId": "crewon.comfyui-api",
      "description": "Generate one image from a text prompt. Submit once, save operationId, then use observe. A submitted status is not a finished image. Never resubmit an uncertain request.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "maxLength": 2000,
            "enum": null
          }
        },
        "required": ["prompt"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string",
            "maxLength": 36,
            "enum": null
          },
          "submission": {
            "type": "string",
            "maxLength": 16,
            "enum": ["accepted"]
          },
          "next": {
            "type": "string",
            "maxLength": 64,
            "enum": ["crewon_short_drama__observe"]
          }
        },
        "required": ["operationId", "submission", "next"],
        "additionalProperties": false
      },
      "execution": "serial",
      "effect": "mutation",
      "recovery": "reconcilable",
      "capability": "extension.image.generate"
    },
    {
      "operationId": "observe",
      "adapterId": "crewon.comfyui-api",
      "description": "Read a previously submitted image operation in this Run, or the original operation explicitly attached by the host to a query Run. Returns its actual status and image URLs only when generation succeeded. Never invent an operationId or treat unknownOutcome as failure to submit.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string",
            "maxLength": 36,
            "enum": null
          }
        },
        "required": ["operationId"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string",
            "maxLength": 36,
            "enum": null
          },
          "status": {
            "type": "string",
            "maxLength": 32,
            "enum": [
              "submitting",
              "submitted",
              "queued",
              "running",
              "succeeded",
              "failed",
              "unknownOutcome"
            ]
          },
          "images": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "properties": {
                "filename": {
                  "type": "string",
                  "maxLength": 255,
                  "enum": null
                },
                "subfolder": {
                  "type": "string",
                  "maxLength": 512,
                  "enum": null
                },
                "type": {
                  "type": "string",
                  "maxLength": 16,
                  "enum": ["output"]
                },
                "url": {
                  "type": "string",
                  "maxLength": 2048,
                  "enum": null
                }
              },
              "required": ["filename", "subfolder", "type", "url"],
              "additionalProperties": false
            }
          }
        },
        "required": ["operationId", "status"],
        "additionalProperties": false
      },
      "execution": "serial",
      "effect": "readOnly",
      "recovery": "replaySafe",
      "capability": "extension.image.read"
    },
    {
      "operationId": "project_list",
      "adapterId": "crewon.project-tools",
      "description": "List accessible short-drama projects, at most four. Continue only using the returned cursor.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "maxLength": 16,
            "enum": ["active", "archived", "all"]
          },
          "after": {
            "type": "object",
            "properties": {
              "updatedAt": {
                "type": "string",
                "maxLength": 32,
                "enum": null
              },
              "projectId": {
                "type": "string",
                "maxLength": 128,
                "enum": null
              }
            },
            "required": ["updatedAt", "projectId"],
            "additionalProperties": false
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          }
        },
        "required": ["state", "limit"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "resultJson": {
            "type": "string",
            "maxLength": 8192,
            "enum": null
          }
        },
        "required": ["resultJson"],
        "additionalProperties": false
      },
      "execution": "serial",
      "effect": "readOnly",
      "recovery": "replaySafe",
      "capability": "project.read"
    },
    {
      "operationId": "project_read",
      "adapterId": "crewon.project-tools",
      "description": "Read actual project and current brief metadata; use content_read for the exact brief text.",
      "inputSchema": {
        "type": "object",
